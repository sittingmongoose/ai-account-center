<Window x:Class="CCSBar.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI Account Center" Width="760" Height="850" MinHeight="320"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" UseLayoutRounding="True"
 Background="Transparent" ShowInTaskbar="False" Topmost="True">
 <!-- Daylight Atlas Windows panel (trays/ concept, Windows view): today's layout and order. Header; Claude, Codex,
      Antigravity; the other providers; footer (auto-switch, Dashboard, Refresh, Settings). Settings slides over the
      list inside the panel; the gear toggles it, the X and Escape close it. -->
 <Border x:Name="Root" CornerRadius="9" BorderThickness="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Rule}">
  <Border.RenderTransform><TranslateTransform x:Name="RootShift" /></Border.RenderTransform>
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid x:Name="HeaderBar" Margin="18,12,16,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <ContentControl x:Name="HeaderLogo" Width="22" Height="22" VerticalAlignment="Center" Focusable="False" />
    <TextBlock Grid.Column="1" x:Name="HeaderName" Text="AI Account Center" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
    <TextBlock Grid.Column="2" x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ink3}" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
   </Grid>
   <Grid x:Name="Body" Grid.Row="1" ClipToBounds="True">
    <Grid x:Name="ListLayer">
     <Grid.RenderTransform><TranslateTransform x:Name="ListShift" /></Grid.RenderTransform>
     <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,2,10,10" Focusable="False">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" /></ScrollViewer.Resources>
      <StackPanel x:Name="ContentPanel" />
     </ScrollViewer>
     <Border x:Name="Fade" Height="34" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0" />
    </Grid>
    <!-- Settings draws above the sign-in screen, so the gear works there too; X and Escape return to it. -->
    <Grid x:Name="SignInLayer" Visibility="Collapsed" Background="{DynamicResource Panel}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" /></ScrollViewer.Resources>
      <StackPanel x:Name="SignInPanel" Width="440" VerticalAlignment="Center" Margin="0,18,0,18" />
     </ScrollViewer>
    </Grid>
    <Grid x:Name="SettingsLayer" Visibility="Collapsed" Background="{DynamicResource Panel}">
     <Grid.RenderTransform><TranslateTransform x:Name="SettingsShift" /></Grid.RenderTransform>
     <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,2,10,14" Focusable="False">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" /></ScrollViewer.Resources>
      <StackPanel x:Name="SettingsPanel" />
     </ScrollViewer>
    </Grid>
   </Grid>
   <Border x:Name="Footer" Grid.Row="2" Padding="16,10,16,11" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Rule}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <ContentControl x:Name="AutoSwitchPanel" VerticalAlignment="Center" Focusable="False" />
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="DashboardButton" Style="{StaticResource AtlasButton}" Height="30" Margin="0,0,8,0" Click="DashboardClicked" />
      <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,8,0" Click="RefreshClicked" />
      <ToggleButton x:Name="SettingsButton" Style="{StaticResource GearButton}" Click="SettingsClicked" />
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
