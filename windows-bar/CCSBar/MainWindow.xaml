<Window x:Class="CCSBar.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI Account Center" Width="760" Height="850" MinHeight="320"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="False" Topmost="True">
 <Border Background="#0B1728" BorderBrush="#284361" BorderThickness="1" CornerRadius="12" Padding="0,0,0,3">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid Margin="18,12,18,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Viewbox Width="25" Height="27" Margin="0,0,10,0"><Canvas Width="32" Height="35">
     <Path Fill="#3498FF" Data="M0,21 L16,30 32,21 32,26 16,35 0,26Z" />
     <Path Fill="#42A8FF" Data="M0,12 L16,21 32,12 32,17 16,26 0,17Z" />
     <Path Fill="#61B8FF" Data="M0,8 L16,0 32,8 16,17Z" />
    </Canvas></Viewbox>
    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="AI Account Center" FontWeight="SemiBold" FontSize="18" />
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="StatusDot" Fill="#69809A" Width="9" Height="9" Margin="0,0,7,0" />
     <TextBlock x:Name="StatusText" Text="Connecting…" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MaxWidth="420" />
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="ContentPanel" Margin="18,0,18,7" />
   </ScrollViewer>
   <Border Grid.Row="2" Padding="18,9,18,10" BorderBrush="#20364E" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
    <StackPanel x:Name="FooterSection">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ContentControl x:Name="AutoSwitchPanel" VerticalAlignment="Center" Margin="0,0,15,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="DashboardButton" Content="Dashboard" Height="32" Padding="10,4" Margin="0,0,7,0" VerticalAlignment="Center" Click="DashboardClicked">
        <Button.ToolTip><ToolTip Content="Open the AI Account Center dashboard" /></Button.ToolTip>
       </Button>
       <Button x:Name="RefreshButton" Width="32" Height="32" Padding="5" Margin="0,0,7,0" VerticalAlignment="Center" Click="RefreshClicked" AutomationProperties.Name="Refresh usage">
        <Viewbox Width="17" Height="17"><Path Stroke="#A4C1E4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M19,8 A8,8 0 1 0 20,15 M19,3 L19,8 14,8" AutomationProperties.Name="Refresh clockwise glyph" /></Viewbox>
        <Button.ToolTip><ToolTip Content="Refresh account usage" /></Button.ToolTip>
       </Button>
       <Button x:Name="SettingsButton" Width="32" Height="32" Padding="5" VerticalAlignment="Center" Click="SettingsClicked" AutomationProperties.Name="Settings">
        <Viewbox Width="18" Height="18"><Path Fill="#A4C1E4" Data="F0 M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.43,11.02 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.97 19.04,5.05 L16.55,6.05 C16.03,5.65 15.47,5.32 14.86,5.07 L14.48,2.42 C14.45,2.18 14.24,2 14,2 L10,2 C9.76,2 9.55,2.18 9.52,2.42 L9.14,5.07 C8.53,5.32 7.97,5.66 7.45,6.05 L4.96,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11.02 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.66 4.57,12.98 L2.46,14.63 C2.27,14.78 2.22,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.03 4.96,18.95 L7.45,17.95 C7.97,18.35 8.53,18.68 9.14,18.93 L9.52,21.58 C9.55,21.82 9.76,22 10,22 L14,22 C14.24,22 14.45,21.82 14.48,21.58 L14.86,18.93 C15.47,18.68 16.03,18.34 16.55,17.95 L19.04,18.95 C19.27,19.04 19.54,18.95 19.66,18.73 L21.66,15.27 C21.79,15.05 21.73,14.78 21.54,14.63 Z M12,8.5 A3.5,3.5 0 1 1 12,15.5 A3.5,3.5 0 1 1 12,8.5 Z" AutomationProperties.Name="Settings gear glyph" /></Viewbox>
        <Button.ToolTip><ToolTip Content="Configure the AI Account Center connection" /></Button.ToolTip>
       </Button>
      </StackPanel>
     </Grid>
     <ContentControl x:Name="AutoSwitchDetails" Visibility="Collapsed" Margin="0,9,0,0" />
    </StackPanel>
   </Border>
  </Grid>
 </Border>
</Window>
