import { ScrollView, ComboBox } from "std-widgets.slint";

export struct AnalyticsSummaryView { label: string, value: string, note: string }
export struct AnalyticsProviderView { id: string, label: string, accounts: string, availability: string, sample: string }
export struct AnalyticsMetricView { key: string, label: string, amount: string, reset: string, expiration: string, note: string }
export struct AnalyticsPointView { x: float, percent: float, label: string }
export struct AnalyticsAccountView { id: string, label: string, provider: string, status: string, platform: string, source: string, plan: string, active: bool, samples: string }
export struct AnalyticsModelView { label: string, provider: string, input: string, output: string, cache: string, cost: string, cache-created: string, cache-read: string, total: string, share: string, cost-percent: float, token-percent: float, has-cost: bool }
export struct AnalyticsChartView { key: string, title: string, subtitle: string, note: string, top: string, middle: string, bottom: string, start: string, end: string, points: [AnalyticsPointView] }
export struct AnalyticsStackPointView { x: float, input: float, output: float, cache-created: float, cache-read: float, label: string }

export global AnalyticsPalette {
    in-out property <bool> dark: true;
    out property <color> page: dark ? #0b1522 : #f4f8fd;
    out property <color> surface: dark ? #142130 : white;
    out property <color> inset: dark ? #101c2a : #f7f9fc;
    out property <color> border: dark ? #293d52 : #e2e9f2;
    out property <color> text: dark ? #f2f6ff : #101b36;
    out property <color> muted: dark ? #a4bad5 : #536b8f;
    out property <color> blue: #2d91ff;
    out property <color> track: dark ? #243b52 : #e3ecf7;
}
component AnalyticsButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback pressed();
    border-radius: 7px; border-width: 1px; border-color: AnalyticsPalette.border;
    background: touch.has-hover ? AnalyticsPalette.track : AnalyticsPalette.inset;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button; accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.pressed(); } }
    Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.text; color: AnalyticsPalette.text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.pressed(); } }
}
component SummaryGrid inherits Rectangle {
    in property <[AnalyticsSummaryView]> items;
    in property <int> columns: 4;
    background: transparent;
    for item[index] in root.items: Rectangle {
        x: mod(index, root.columns) * (parent.width + 12px) / root.columns;
        y: floor(index / root.columns) * 102px;
        width: (parent.width - (root.columns - 1) * 12px) / root.columns; height: 90px;
        border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
        Text { x: 15px; y: 13px; width: parent.width - 30px; text: item.label; color: AnalyticsPalette.muted; font-size: 10px; overflow: elide; }
        Text { x: 15px; y: 33px; width: parent.width - 30px; text: item.value; color: AnalyticsPalette.text; font-size: 24px; font-weight: 700; overflow: elide; }
        Text { x: 15px; y: 66px; width: parent.width - 30px; text: item.note; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
        Tooltip { text: @markdown("\{item.label + " · " + item.value + " · " + item.note}"); }
    }
}
component ObservationPlot inherits Rectangle {
    in property <[AnalyticsStackPointView]> stack-points;
    in property <[AnalyticsPointView]> points;
    in property <string> top;
    in property <string> middle;
    in property <string> bottom;
    in property <string> start;
    in property <string> end;
    in property <string> empty: "No historical observations yet";
    property <length> plot-height: root.height - 38px;
    property <length> plot-width: root.width - 76px;
    background: transparent;
    Text { x: 0px; y: 0px; width: 59px; text: root.top; color: AnalyticsPalette.muted; font-size: 9px; horizontal-alignment: right; overflow: elide; }
    Text { x: 0px; y: root.plot-height / 2 - 6px; width: 59px; text: root.middle; color: AnalyticsPalette.muted; font-size: 9px; horizontal-alignment: right; overflow: elide; }
    Text { x: 0px; y: root.plot-height - 12px; width: 59px; text: root.bottom; color: AnalyticsPalette.muted; font-size: 9px; horizontal-alignment: right; overflow: elide; }
    Rectangle { x: 69px; y: 5px; width: root.plot-width; height: 1px; background: AnalyticsPalette.border; }
    Rectangle { x: 69px; y: root.plot-height / 2; width: root.plot-width; height: 1px; background: AnalyticsPalette.border; }
    Rectangle { x: 69px; y: root.plot-height; width: root.plot-width; height: 1px; background: AnalyticsPalette.border; }
    for point in root.points: Rectangle {
        x: 69px + point.x * (root.plot-width - 5px); y: root.plot-height * (1 - point.percent / 100);
        width: 5px; height: max(3px, root.plot-height * point.percent / 100);
        background: AnalyticsPalette.blue; border-radius: 2px;
        Tooltip { text: @markdown("\{point.label}"); }
    }
    for point in root.stack-points: Rectangle {
        property <float> total: point.input + point.output + point.cache-created + point.cache-read;
        x: 69px + point.x * (root.plot-width - 5px); y: root.plot-height * (1 - self.total / 100);
        width: min(16px, max(3px, root.plot-width / max(1, root.stack-points.length) * 0.65)); height: max(3px, root.plot-height * self.total / 100);
        background: self.total == 0 ? AnalyticsPalette.blue : transparent;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: root.plot-height * point.cache-read / 100; background: #f3af49; }
        Rectangle { x: 0px; y: root.plot-height * point.cache-read / 100; width: parent.width; height: root.plot-height * point.cache-created / 100; background: #36b8b0; }
        Rectangle { x: 0px; y: root.plot-height * (point.cache-read + point.cache-created) / 100; width: parent.width; height: root.plot-height * point.output / 100; background: #8268f4; }
        Rectangle { x: 0px; y: root.plot-height * (point.cache-read + point.cache-created + point.output) / 100; width: parent.width; height: root.plot-height * point.input / 100; background: AnalyticsPalette.blue; }
        Tooltip { text: @markdown("\{point.label}"); }
    }
    if root.points.length == 0 && root.stack-points.length == 0: Text { x: 79px; y: root.plot-height / 2 + 14px; width: root.plot-width - 30px; text: root.empty; color: AnalyticsPalette.muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
    Text { x: 69px; y: root.plot-height + 14px; width: root.plot-width / 2; text: root.start; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
    Text { x: 69px + root.plot-width / 2; y: root.plot-height + 14px; width: root.plot-width / 2; text: root.end; color: AnalyticsPalette.muted; font-size: 9px; horizontal-alignment: right; overflow: elide; }
}
component ModelBars inherits Rectangle {
    in property <[AnalyticsModelView]> models;
    in property <bool> cost;
    border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
    Text { x: 16px; y: 15px; text: root.cost ? "Top models · estimated API-equivalent cost" : "Top models · share of listed model tokens"; color: AnalyticsPalette.text; font-size: 13px; font-weight: 600; }
    Text { x: 16px; y: 39px; text: root.cost ? "Largest reported estimates first · USD" : "Same models · input + output + both cache categories"; color: AnalyticsPalette.muted; font-size: 9px; }
    for item[index] in root.models: Rectangle {
        visible: index < 8; x: 16px; y: 65px + index * 34px; width: parent.width - 32px; height: 29px;
        background: transparent;
        Text { x: 0px; y: 1px; width: parent.width * 0.48; text: item.provider + " · " + item.label; color: AnalyticsPalette.text; font-size: 9px; overflow: elide; }
        Text { x: parent.width * 0.52; y: 1px; width: parent.width * 0.48; text: root.cost ? item.cost : item.share + " · " + item.total + " tokens"; color: AnalyticsPalette.muted; font-size: 9px; horizontal-alignment: right; overflow: elide; }
        Rectangle { x: 0px; y: 19px; width: parent.width; height: 5px; border-radius: 3px; background: AnalyticsPalette.track;
            Rectangle { x: 0px; y: 0px; width: parent.width * (root.cost ? item.cost-percent : item.token-percent) / 100; height: parent.height; border-radius: 3px; background: root.cost ? AnalyticsPalette.blue : #8268f4; }
        }
        Tooltip { text: @markdown("\{item.provider + " · " + item.label + " · " + item.cost + " estimated API-equivalent cost · " + item.total + " tokens · " + item.share + " of listed model tokens"}"); }
    }
}
component ModelDetails inherits Rectangle {
    in property <[AnalyticsModelView]> models;
    border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
    Text { x: 12px; y: 16px; text: "Model / provider"; color: AnalyticsPalette.muted; font-size: 9px; }
    Text { x: parent.width * 0.32; y: 16px; text: "Input"; color: AnalyticsPalette.muted; font-size: 9px; }
    Text { x: parent.width * 0.43; y: 16px; text: "Output"; color: AnalyticsPalette.muted; font-size: 9px; }
    Text { x: parent.width * 0.54; y: 16px; text: "Cache created"; color: AnalyticsPalette.muted; font-size: 9px; }
    Text { x: parent.width * 0.67; y: 16px; text: "Cache read"; color: AnalyticsPalette.muted; font-size: 9px; }
    Text { x: parent.width * 0.80; y: 16px; text: "Est. API USD"; color: AnalyticsPalette.muted; font-size: 9px; }
    for item[index] in root.models: Rectangle { x: 0px; y: 46px + index * 46px; width: parent.width; height: 46px; background: transparent;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: AnalyticsPalette.border; }
        Text { x: 12px; y: 8px; width: parent.width * 0.29; text: item.label; color: AnalyticsPalette.text; font-size: 10px; overflow: elide; }
        Text { x: 12px; y: 26px; text: item.provider; color: AnalyticsPalette.muted; font-size: 8px; }
        Text { x: parent.width * 0.32; y: 15px; width: parent.width * 0.10; text: item.input; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
        Text { x: parent.width * 0.43; y: 15px; width: parent.width * 0.10; text: item.output; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
        Text { x: parent.width * 0.54; y: 15px; width: parent.width * 0.12; text: item.cache-created; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
        Text { x: parent.width * 0.67; y: 15px; width: parent.width * 0.12; text: item.cache-read; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
        Text { x: parent.width * 0.80; y: 15px; width: parent.width * 0.18; text: item.cost; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
        Tooltip { text: @markdown("\{item.label + " · " + item.provider + " · " + item.input + " input · " + item.output + " output · " + item.cache-created + " cache created · " + item.cache-read + " cache read · " + item.cost + " estimated API equivalent"}"); }
    }
}
export component AnalyticsPage inherits Rectangle {
    in-out property <bool> dark <=> AnalyticsPalette.dark;
    in property <bool> loading: false;
    in property <string> error;
    in property <string> updated;
    in property <string> history-note;
    in-out property <string> range-value;
    in-out property <string> provider-value;
    in-out property <string> account-value;
    in-out property <string> metric-value;
    in property <[string]> provider-options;
    in property <[string]> account-options;
    in property <[string]> metric-options;
    in property <[AnalyticsSummaryView]> summary;
    in property <[AnalyticsProviderView]> providers;
    in property <[AnalyticsAccountView]> accounts;
    in property <[AnalyticsMetricView]> metrics;
    in property <[AnalyticsPointView]> points;
    in property <string> selected-account-note;
    in property <string> chart-title;
    in property <string> chart-note;
    in property <string> chart-start;
    in property <string> chart-end;
    in property <string> chart-top;
    in property <string> chart-middle;
    in property <string> chart-bottom;
    in property <bool> chart-has-points;
    in property <bool> metric-percent;
    in property <string> activity-title;
    in property <string> activity-note;
    in property <string> activity-chart-top;
    in property <string> activity-chart-middle;
    in property <string> activity-chart-bottom;
    in property <string> activity-chart-start;
    in property <string> activity-chart-end;
    in property <bool> activity-has-data;
    in property <[AnalyticsSummaryView]> activity-summary;
    in property <[AnalyticsPointView]> activity-points;
    in property <[AnalyticsModelView]> activity-models;
    in property <[AnalyticsMetricView]> activity-providers;
    in property <[AnalyticsChartView]> quota-charts;
    in property <string> overview-note;
    in-out property <string> activity-interval-value: "Daily";
    in property <[AnalyticsStackPointView]> activity-stack-points;
    in property <[AnalyticsPointView]> activity-cost-points;
    in property <string> activity-cost-top;
    in property <string> activity-cost-middle;
    in property <string> activity-cost-bottom;
    in property <string> activity-model-note;
    callback action(string, string);
    property <bool> wide: root.width >= 850px;
    property <bool> filters-wide: root.width >= 850px;
    property <bool> filters-narrow: root.width < 500px;
    property <int> columns: root.width >= 1250px ? 6 : root.width >= 850px ? 3 : root.width >= 450px ? 2 : 1;
    property <int> grid-columns: root.width >= 1650px ? 4 : root.width >= 1150px ? 3 : root.width >= 720px ? 2 : 1;
    property <int> provider-columns: root.width >= 1150px ? 5 : root.width >= 720px ? 3 : 2;
    property <bool> show-model-details: false;
    property <length> head-height: root.filters-wide ? 135px : root.filters-narrow ? 238px : 184px;
    property <length> activity-y: root.head-height + (root.error != "" ? 28px : 0px);
    property <length> activity-summary-y: root.activity-y + 110px;
    property <length> activity-summary-height: ceil(root.activity-summary.length / root.columns) * 102px;
    property <length> trends-y: root.activity-summary-y + root.activity-summary-height;
    property <length> trends-height: root.activity-has-data ? (root.wide ? 272px : 558px) : 0px;
    property <length> models-y: root.trends-y + root.trends-height + (root.activity-has-data ? 14px : 0px);
    property <length> model-bars-height: root.activity-models.length > 0 ? 84px + min(8, root.activity-models.length) * 34px : 0px;
    property <length> models-height: root.activity-models.length > 0 ? (root.wide ? root.model-bars-height : root.model-bars-height * 2 + 14px) + 80px + (root.show-model-details ? 58px + root.activity-models.length * 46px : 0px) : 0px;
    property <length> overview-y: root.models-y + root.models-height + 14px;
    property <length> provider-height: ceil(root.providers.length / root.provider-columns) * 50px;
    property <length> overview-height: 82px + root.provider-height + ceil(root.accounts.length / root.grid-columns) * 72px;
    property <length> histories-y: root.overview-y + root.overview-height + 18px;
    property <length> history-head-height: root.wide ? 106px : 143px;
    background: AnalyticsPalette.page;
    ScrollView {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        content-width: parent.width - 1px;
        content-height: root.histories-y + root.history-head-height + max(1, ceil(root.quota-charts.length / root.grid-columns)) * 242px + 30px;
        content := Rectangle { x: 14px; y: 0px; width: root.width - 28px; height: parent.height;
            Text { x: 2px; y: 16px; text: "Analytics"; color: AnalyticsPalette.text; font-size: 24px; font-weight: 700; }
            Text { x: 2px; y: 47px; width: parent.width - 120px; text: root.loading ? "Collecting account observations…" : root.updated; color: AnalyticsPalette.muted; font-size: 10px; overflow: elide; }
            AnalyticsButton { x: parent.width - 104px; y: 20px; width: 102px; height: 32px; text: "↻ Refresh usage"; enabled: !root.loading; pressed => { root.action("analytics-refresh", ""); } }
            Text { x: 2px; y: 70px; text: "Time range"; color: AnalyticsPalette.muted; font-size: 9px; }
            ComboBox { x: 2px; y: 87px; width: 150px; height: 31px; model: ["Last 24 hours", "Last 7 days", "Last 30 days"]; current-value <=> root.range-value; enabled: !root.loading; selected(value) => { root.action("analytics-range", value); } }
            Text { x: root.filters-narrow ? 2px : 168px; y: root.filters-narrow ? 125px : 70px; text: "Provider"; color: AnalyticsPalette.muted; font-size: 9px; }
            ComboBox { x: root.filters-narrow ? 2px : 168px; y: root.filters-narrow ? 142px : 87px; width: root.filters-wide ? 235px : root.filters-narrow ? parent.width - 4px : parent.width - 170px; height: 31px; model: root.provider-options; current-value <=> root.provider-value; enabled: !root.loading; selected(value) => { root.action("analytics-provider", value); } }
            Text { x: root.filters-wide ? 421px : 2px; y: root.filters-wide ? 70px : root.filters-narrow ? 180px : 125px; text: "Account"; color: AnalyticsPalette.muted; font-size: 9px; }
            ComboBox { x: root.filters-wide ? 421px : 2px; y: root.filters-wide ? 87px : root.filters-narrow ? 197px : 142px; width: root.filters-wide ? parent.width - 423px : parent.width - 4px; height: 31px; model: root.account-options; current-value <=> root.account-value; enabled: !root.loading; selected(value) => { root.action("analytics-account", value); } }
            if root.error != "": Text { x: 2px; y: root.head-height; width: parent.width - 4px; height: 24px; text: root.error; color: #ffad66; font-size: 10px; overflow: elide; }

            Text { x: 2px; y: root.activity-y; text: root.activity-title; color: AnalyticsPalette.text; font-size: 20px; font-weight: 700; }
            ComboBox { x: parent.width - 102px; y: root.activity-y; width: 100px; height: 30px; model: ["Daily", "Hourly"]; current-value <=> root.activity-interval-value; enabled: root.activity-has-data; selected(value) => { root.action("analytics-activity-interval", value); } }
            Text { x: 2px; y: root.activity-y + 38px; width: parent.width - 4px; height: 66px; text: root.activity-note; color: AnalyticsPalette.muted; font-size: 10px; wrap: word-wrap; }
            SummaryGrid { x: 0px; y: root.activity-summary-y; width: parent.width; height: root.activity-summary-height; items: root.activity-summary; columns: root.columns; }
            if root.activity-has-data: Rectangle { x: 0px; y: root.trends-y; width: root.wide ? (parent.width - 14px) / 2 : parent.width; height: 272px; border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
                Text { x: 16px; y: 15px; text: "Actual tokens · " + root.activity-interval-value + " · UTC"; color: AnalyticsPalette.text; font-size: 14px; font-weight: 600; }
                Text { x: 16px; y: 39px; text: "● Input    ● Output    ● Cache created    ● Cache read"; color: AnalyticsPalette.muted; font-size: 9px; }
                Rectangle { x: 17px; y: 41px; width: 5px; height: 5px; background: AnalyticsPalette.blue; }
                Rectangle { x: 63px; y: 41px; width: 5px; height: 5px; background: #8268f4; }
                Rectangle { x: 118px; y: 41px; width: 5px; height: 5px; background: #36b8b0; }
                Rectangle { x: 207px; y: 41px; width: 5px; height: 5px; background: #f3af49; }
                ObservationPlot { x: 12px; y: 69px; width: parent.width - 28px; height: 184px; stack-points: root.activity-stack-points; top: root.activity-chart-top; middle: root.activity-chart-middle; bottom: root.activity-chart-bottom; start: root.activity-chart-start; end: root.activity-chart-end; empty: "No parsed activity buckets in this time range"; }
            }
            if root.activity-has-data: Rectangle { x: root.wide ? (parent.width + 14px) / 2 : 0px; y: root.trends-y + (root.wide ? 0px : 286px); width: root.wide ? (parent.width - 14px) / 2 : parent.width; height: 272px; border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
                Text { x: 16px; y: 15px; text: "Estimated API-equivalent cost · " + root.activity-interval-value; color: AnalyticsPalette.text; font-size: 14px; font-weight: 600; }
                Text { x: 16px; y: 39px; width: parent.width - 32px; text: "USD estimates from local usage logs; not subscription charges"; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
                ObservationPlot { x: 12px; y: 69px; width: parent.width - 28px; height: 184px; points: root.activity-cost-points; top: root.activity-cost-top; middle: root.activity-cost-middle; bottom: root.activity-cost-bottom; start: root.activity-chart-start; end: root.activity-chart-end; empty: "No complete estimated-cost buckets in this range"; }
            }
            if root.activity-models.length > 0: ModelBars { x: 0px; y: root.models-y; width: root.wide ? (parent.width - 14px) / 2 : parent.width; height: root.model-bars-height; models: root.activity-models; cost: true; }
            if root.activity-models.length > 0: ModelBars { x: root.wide ? (parent.width + 14px) / 2 : 0px; y: root.models-y + (root.wide ? 0px : root.model-bars-height + 14px); width: root.wide ? (parent.width - 14px) / 2 : parent.width; height: root.model-bars-height; models: root.activity-models; cost: false; }
            if root.activity-models.length > 0: Text { x: 2px; y: root.models-y + (root.wide ? root.model-bars-height : root.model-bars-height * 2 + 14px) + 8px; width: parent.width - 4px; height: 37px; text: root.activity-model-note; color: AnalyticsPalette.muted; font-size: 9px; wrap: word-wrap; }
            if root.activity-models.length > 0: AnalyticsButton { x: 2px; y: root.models-y + (root.wide ? root.model-bars-height : root.model-bars-height * 2 + 14px) + 47px; width: 185px; height: 28px; text: root.show-model-details ? "Hide model token details" : "Show all model token details"; pressed => { root.show-model-details = !root.show-model-details; } }
            if root.show-model-details && root.activity-models.length > 0: ModelDetails { x: 0px; y: root.models-y + (root.wide ? root.model-bars-height : root.model-bars-height * 2 + 14px) + 80px; width: parent.width; height: 58px + root.activity-models.length * 46px; models: root.activity-models; }

            Rectangle { x: 0px; y: root.overview-y; width: parent.width; height: root.overview-height; border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
                Text { x: 15px; y: 14px; text: "Providers, accounts and sources"; color: AnalyticsPalette.text; font-size: 15px; font-weight: 700; }
                Text { x: 15px; y: 38px; width: parent.width - 30px; text: root.overview-note; color: AnalyticsPalette.muted; font-size: 10px; overflow: elide; }
                for provider[index] in root.providers: Rectangle { x: 10px + mod(index, root.provider-columns) * (parent.width - 20px) / root.provider-columns; y: 64px + floor(index / root.provider-columns) * 50px; width: (parent.width - 20px) / root.provider-columns - 6px; height: 43px; border-radius: 6px; background: provider-touch.has-hover ? AnalyticsPalette.track : AnalyticsPalette.inset;
                    Text { x: 8px; y: 6px; width: parent.width - 16px; text: provider.label; color: AnalyticsPalette.text; font-size: 10px; font-weight: 600; overflow: elide; }
                    Text { x: 8px; y: 23px; width: parent.width - 16px; text: provider.accounts + " · " + provider.availability; color: AnalyticsPalette.muted; font-size: 8px; overflow: elide; }
                    provider-touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: !root.loading; mouse-cursor: root.loading ? default : pointer; clicked => { root.action("analytics-provider", provider.label); } }
                    Tooltip { text: @markdown("\{provider.label + " · " + provider.accounts + " · " + provider.availability + " · " + provider.sample}"); }
                }
                for account[index] in root.accounts: Rectangle { x: 10px + mod(index, root.grid-columns) * (parent.width - 20px) / root.grid-columns; y: 68px + root.provider-height + floor(index / root.grid-columns) * 72px; width: (parent.width - 20px) / root.grid-columns - 6px; height: 66px; border-radius: 6px; border-width: 1px; border-color: account.active ? AnalyticsPalette.blue : AnalyticsPalette.border; background: account-touch.has-hover ? AnalyticsPalette.track : transparent;
                    Text { x: 8px; y: 7px; width: parent.width - 16px; text: account.label + (account.active ? " · Active Codex" : ""); color: account.active ? AnalyticsPalette.blue : AnalyticsPalette.text; font-size: 10px; font-weight: 600; overflow: elide; }
                    Text { x: 8px; y: 26px; width: parent.width - 16px; text: account.provider + " · " + account.plan + " · " + account.status; color: AnalyticsPalette.muted; font-size: 8px; overflow: elide; }
                    Text { x: 8px; y: 44px; width: parent.width - 16px; text: account.platform + " · " + account.samples + " · " + account.source; color: AnalyticsPalette.muted; font-size: 8px; overflow: elide; }
                    account-touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: !root.loading; mouse-cursor: root.loading ? default : pointer; clicked => { root.action("analytics-account-id", account.id); } }
                    Tooltip { text: @markdown("\{account.label + " · " + account.provider + " · " + account.plan + " · " + account.platform + " · " + account.source + " · " + account.status + " · " + account.samples}"); }
                }
            }
            Text { x: 2px; y: root.histories-y; text: "Account usage histories"; color: AnalyticsPalette.text; font-size: 20px; font-weight: 700; }
            ComboBox { x: root.wide ? parent.width * 0.42 : 2px; y: root.histories-y + (root.wide ? 0px : 35px); width: root.wide ? parent.width * 0.58 - 2px : parent.width - 4px; height: 31px; model: root.metric-options; current-value <=> root.metric-value; enabled: !root.loading; selected(value) => { root.action("analytics-metric", value); } }
            Text { x: 2px; y: root.histories-y + (root.wide ? 43px : 78px); width: parent.width - 4px; height: 58px; text: root.history-note; color: AnalyticsPalette.muted; font-size: 9px; wrap: word-wrap; }
            for chart[index] in root.quota-charts: Rectangle { x: mod(index, root.grid-columns) * (parent.width + 12px) / root.grid-columns; y: root.histories-y + root.history-head-height + floor(index / root.grid-columns) * 242px; width: (parent.width - (root.grid-columns - 1) * 12px) / root.grid-columns; height: 230px; border-radius: 10px; border-width: 1px; border-color: AnalyticsPalette.border; background: AnalyticsPalette.surface;
                Text { x: 12px; y: 12px; width: parent.width - 24px; text: chart.title; color: AnalyticsPalette.text; font-size: 11px; font-weight: 600; overflow: elide; }
                Text { x: 12px; y: 33px; width: parent.width - 24px; text: chart.subtitle; color: AnalyticsPalette.muted; font-size: 9px; overflow: elide; }
                ObservationPlot { x: 8px; y: 61px; width: parent.width - 20px; height: 136px; points: chart.points; top: chart.top; middle: chart.middle; bottom: chart.bottom; start: chart.start; end: chart.end; }
                Text { x: 12px; y: 204px; width: parent.width - 24px; text: chart.note; color: AnalyticsPalette.muted; font-size: 8px; overflow: elide; }
                Tooltip { text: @markdown("\{chart.title + " · " + chart.subtitle + " · " + chart.note}"); }
            }
            if root.quota-charts.length == 0: Text { x: 2px; y: root.histories-y + root.history-head-height + 35px; width: parent.width - 4px; text: "No usable account history has been collected for this filter yet. No zero usage is assumed."; color: AnalyticsPalette.muted; font-size: 12px; wrap: word-wrap; }
        }
    }
}
