// AI Account Center dashboard shell (Slint 1.18.1, Daylight Atlas).
// The header (logo, navigation, status, Refresh, Update apps, appearance, account menu), page routing
// with transitions, the overlays (Details slide-over, confirmation dialog, toasts, hover cards) and the
// sign-in layer. Pages live in pages/, components in components/, tokens in theme.slint and the
// view-model structs in models.slint. See README-ARCHITECTURE.md.
import { Palette } from "std-widgets.slint";
import { Theme, Motion, Type, Breakpoints, Device } from "theme.slint";
import {
    MeterView, AmountView, RunView, FootView, ColumnView, AccountRowView, AutoSwitchView, SectionView, ProviderCardView,
    RegistryView, ChromeView, UpdateView, ToastView, FactView, DetailsView, ProcessView, ConfirmationView,
    AuthView, StrengthView, AnalyticsHeadView, LoginBox, LoginOverlay
} from "models.slint";
import { Icon } from "components/icon.slint";
import { MarksPreloader } from "components/mark.slint";
import { ProbeMark } from "components/probe.slint";
import { AppLogo } from "components/logo.slint";
import { Caps } from "components/text.slint";
import { Button } from "components/button.slint";
import { IconButton } from "components/icon-button.slint";
import { NavBar } from "components/nav.slint";
import { MenuPanel, MenuHead, MenuItem, MenuSeparator } from "components/menu.slint";
import { UpdateButton } from "components/update-button.slint";
import { SlideOver } from "components/slide-over.slint";
import { Sheet, SidePanel, Overlays } from "components/sheet.slint";
import { Popover } from "components/popover.slint";
import { Dialog } from "components/dialog.slint";
import { ToastStack } from "components/toast.slint";
import { Hover, HoverLayer } from "components/hover-card.slint";
import { MobileHeader, TabBar } from "shell/chrome.slint";
import { HomePage } from "pages/home.slint";
import { AnalyticsPage } from "pages/analytics.slint";
import { AccountsPage } from "pages/accounts.slint";
import { DetailsPanel } from "pages/details.slint";
import { SignInLayer } from "shell/signin.slint";

// Re-exported so Rust (slint::include_modules!) sees every view-model struct.
export {
    MeterView, AmountView, RunView, FootView, ColumnView, AccountRowView, AutoSwitchView, SectionView, ProviderCardView,
    RegistryView, ChromeView, UpdateView, ToastView, FactView, DetailsView, ProcessView, ConfirmationView,
    AuthView, StrengthView, AnalyticsHeadView, LoginBox, LoginOverlay
}
// The Analytics view model (version 7): Rust fills the AxData global directly.
export {
    AxData, AxScopeLine, AxKpi, AxYTick, AxXTick, AxLegendItem, AxBucket, AxTrendPaths, AxTrend, AxModelType,
    AxModelRow, AxCardText, AxDonutSeg, AxDonut, AxStat, AxSessRow, AxTokRow, AxCache, AxHeatCell, AxHeat, AxBar,
    AxDaily, AxDay, AxCalendar, AxTick, AxShape, AxLabel, AxDot, AxFocusLegend, AxStopRow, AxStop, AxFocus,
    AxQuotaRow, AxQuotaGroup, AxAgendaRow
} from "pages/analytics/ax-data.slint";
// The Accounts & Settings view model (version 2): Rust fills the AcData global directly.
export {
    AcData, AcAction, AcLine, AcRow, AcFlow, AcTrashRow, AcProvider, AcAgPolicy, AcPolicy, AcUpdItem, AcUpdHost,
    AcDevice, AcNetwork, AcSignin
} from "pages/accounts/ac-data.slint";
// End-to-end probes (only with ?e2e): Rust forwards Probe.rect to bridge.js.
export { Probe } from "components/probe.slint";
// Phase 5: the first-run form's covered confirmation and setup code (lib.rs set_login_setup writes them).
export { LoginExtra } from "shell/signin.slint";
// The device environment (safe areas, keyboard, input profile): Rust fills it from bridge.js.
export { Device } from "theme.slint";
// The overlay layers (Back/history): Rust bumps pop-request when bridge.js pops a history entry.
export { Overlays } from "components/sheet.slint";
export { SegItem } from "components/segmented.slint";

// The faint cartographic grid behind the pages: 24 px minor and 96 px major lines.
component PaperGrid inherits Rectangle {
    property <int> cols: ceil(root.width / 24px) + 1;
    property <int> rows: ceil(root.height / 24px) + 1;
    for i in root.cols: Rectangle {
        x: i * 24px;
        y: 0px;
        width: 1px;
        height: root.height;
        background: mod(i, 4) == 0 ? Theme.paper-grid-major : Theme.paper-grid-minor;
    }
    for j in root.rows: Rectangle {
        x: 0px;
        y: j * 24px;
        width: root.width;
        height: 1px;
        background: mod(j, 4) == 0 ? Theme.paper-grid-major : Theme.paper-grid-minor;
    }
}

component Header inherits Rectangle {
    in property <string> page;
    in property <ChromeView> chrome;
    in property <UpdateView> update;
    in property <bool> busy;
    in property <bool> shown;
    callback navigate(string);
    callback refresh();
    callback update-apps();
    callback theme-picked(int);
    callback sign-out();

    height: 62px;
    background: Theme.paper;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.rule; }

    bar := HorizontalLayout {
        x: max(0px, (root.width - Breakpoints.max-content) / 2);
        width: min(root.width, Breakpoints.max-content);
        y: root.shown ? 0px : -8px;
        height: root.height;
        opacity: root.shown ? 1 : 0;
        animate y { duration: Motion.on ? 460ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: Motion.on ? 380ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        padding-left: Breakpoints.gutter;
        padding-right: Breakpoints.gutter;
        spacing: Breakpoints.compact ? 16px : 24px;
        // Only the spacer stretches, so nothing in the header moves when the status text changes.
        brand := Rectangle {
            horizontal-stretch: 0;
            min-width: brand-row.preferred-width;
            brand-row := HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    AppLogo {
                        size: 26px;
                        transform-rotation: brand-ta.has-hover ? -8deg : 0deg;
                        transform-scale: brand-ta.has-hover ? 1.06 : 1;
                        animate transform-rotation, transform-scale { duration: Motion.med; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                    }
                }
                if !Breakpoints.compact: Text {
                    text: "AI Account Center";
                    font-size: 15.5px;
                    font-weight: 640;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
            }
            brand-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate("home"); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            NavBar { page: root.page; navigate(p) => { root.navigate(p); } }
        }
        Rectangle { horizontal-stretch: 1; }
        // the concept's .chrome-right: the status line and the controls 8 px apart (the bar keeps 24 px between
        // the brand, the nav and this group)
        right := HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            status := Rectangle {
                horizontal-stretch: 0;
                // the concept's .status-line keeps 6 px more room before the refresh button. Whole pixels:
                // this cell is what places every control to its right, so a fractional width here puts the
                // Update apps label on a fractional x and re-rasterises it whenever the status text changes.
                min-width: ceil((status-row.preferred-width + 6px) / 1px) * 1px;
                status-row := HorizontalLayout {
                    x: 0px;
                    width: self.preferred-width;
                    spacing: 4px;
                    Text {
                        text: root.chrome.status-lead;
                        font-family: Type.tab;
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                    }
                    if root.chrome.status-strong != "": Text {
                        text: root.chrome.status-strong;
                        font-family: Type.tab;
                        font-size: 12.5px;
                        font-weight: 580;
                        color: Theme.ink-2;
                        vertical-alignment: center;
                    }
                    if root.chrome.status-more != "" && Breakpoints.width >= 1440px: Text {
                        text: "· " + root.chrome.status-more;
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    changed has-hover => {
                        if self.has-hover {
                            Hover.tip("status", self.absolute-position, self.width, self.height, root.chrome.status-tip);
                        } else {
                            Hover.leave("status");
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: "refresh";
                    hint: "Refresh usage now";
                    spinning: root.chrome.refreshing;
                    enabled: !root.busy || root.chrome.refreshing;
                    clicked => { root.refresh(); }
                }
            }
            VerticalLayout {
                alignment: center;
                UpdateButton {
                    data: root.update;
                    enabled: !root.busy;
                    clicked => { root.update-apps(); }
                    ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "update-apps"; }
                }
            }
            // .chrome-sep: a 22 px hairline with 4 px on each side
            Rectangle {
                width: 9px;
                Rectangle { x: 4px; y: (parent.height - 22px) / 2; width: 1px; height: 22px; background: Theme.rule; }
            }
            theme-anchor := Rectangle {
                width: theme-btn.width;
                theme-btn := IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Theme.mode == 1 ? "sun" : Theme.mode == 2 ? "moon" : "monitor";
                    chevron: true;
                    hint: "Appearance";
                    pressed-look: theme-pop.is-open;
                    clicked => { theme-pop.show(); }
                }
                theme-pop := PopupWindow {
                    x: parent.width - 212px;
                    y: (parent.height + theme-btn.height) / 2 + 8px;
                    width: 212px;
                    height: 28px + 3 * 36px + 12px;
                    close-policy: close-on-click-outside;
                    MenuPanel {
                        width: 212px;
                        height: 28px + 3 * 36px + 12px;
                        MenuHead { text: "Appearance"; }
                        MenuItem { icon: "sun"; text: "Light"; checked: Theme.mode == 1; activated => { theme-pop.close(); root.theme-picked(1); } }
                        MenuItem { icon: "moon"; text: "Dark"; checked: Theme.mode == 2; activated => { theme-pop.close(); root.theme-picked(2); } }
                        MenuItem { icon: "monitor"; text: "Auto, follows the system"; checked: Theme.mode == 0; activated => { theme-pop.close(); root.theme-picked(0); } }
                    }
                }
            }
            account-anchor := Rectangle {
                width: account-btn.width;
                account-btn := IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: "user";
                    chevron: true;
                    hint: "Signed-in user";
                    pressed-look: account-pop.is-open;
                    clicked => { account-pop.show(); }
                }
                account-pop := PopupWindow {
                    x: parent.width - 260px;
                    y: (parent.height + account-btn.height) / 2 + 8px;
                    width: 260px;
                    height: 70px + 13px + 36px + 12px;
                    close-policy: close-on-click-outside;
                    MenuPanel {
                        width: 260px;
                        height: 70px + 13px + 36px + 12px;
                        HorizontalLayout {
                            height: 70px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 11px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    border-width: 1px;
                                    border-color: Theme.rule;
                                    Icon { x: 6px; y: 6px; name: "user"; tint: Theme.ink-2; width: 20px; height: 20px; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text { text: root.chrome.username != "" ? root.chrome.username : "Owner"; font-size: 13.5px; font-weight: 640; color: Theme.ink; overflow: elide; }
                                Text {
                                    text: root.chrome.host != "" ? "Signed in to this dashboard on " + root.chrome.host : "Signed in to this dashboard";
                                    font-size: Type.small;
                                    color: Theme.ink-3;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        MenuSeparator { }
                        MenuItem { icon: "logout"; text: "Sign out"; activated => { account-pop.close(); root.sign-out(); } }
                    }
                }
            }
        }
    }
}

// A Flickable with a thin draggable scrollbar thumb. `last-ch` publishes the content height as it
// changes so the dashboard can keep the scroll position across a tier reflow (1.6).
component PageScroll inherits Rectangle {
    in property <length> content-height;
    in-out property <length> content-y <=> flick.content-y;
    in-out property <length> last-ch: 0px;
    property <length> max-scroll: max(0px, root.content-height - root.height);
    flick := Flickable {
        width: root.width;
        height: root.height;
        // a hover card belongs to the element under the pointer: scrolling moves that element away
        changed content-y => { Hover.clear(); }
        content-width: root.width;
        content-height: max(root.height, root.content-height);
        @children
    }
    changed content-height => { root.last-ch = self.content-height; }
    if root.max-scroll > 0: thumb := Rectangle {
        property <length> thumb-h: max(40px, root.height * root.height / root.content-height);
        x: root.width - 10px;
        y: 2px + (-flick.content-y / root.max-scroll) * (root.height - 4px - self.thumb-h);
        width: 8px;
        height: self.thumb-h;
        Rectangle {
            x: drag.has-hover || drag.pressed ? 1px : 3px;
            width: drag.has-hover || drag.pressed ? 6px : 4px;
            height: parent.height;
            border-radius: 3px;
            background: drag.pressed ? Theme.ink-3 : Theme.rule-strong;
            opacity: drag.has-hover || drag.pressed ? 1 : 0.7;
            animate x, width, opacity { duration: Motion.fast; }
        }
        drag := TouchArea {
            property <length> start-y;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down { self.start-y = flick.content-y; }
            }
            moved => {
                if self.pressed {
                    flick.content-y = clamp(self.start-y - (self.mouse-y - self.pressed-y) * root.max-scroll / max(1px, root.height - 4px - thumb.thumb-h), -root.max-scroll, 0px);
                }
            }
        }
    }
}

export component Dashboard inherits Window {
    title: "AI Account Center";
    preferred-width: 1440px;
    preferred-height: 900px;
    default-font-family: Type.sans;
    background: Theme.bg;

    // ---------- bridge-facing state ----------
    in-out property <int> theme-mode <=> Theme.mode;
    in-out property <bool> system-dark <=> Theme.system-dark;
    in-out property <bool> reduced-motion <=> Motion.reduced;
    in-out property <bool> authenticated: false;
    in-out property <AuthView> auth: { state: "loading" };
    in-out property <StrengthView> strength;
    in-out property <bool> busy: false;
    in-out property <string> current-page: "home";
    in-out property <bool> data-ready: false;
    in-out property <ChromeView> chrome: { status-lead: "Waiting for account data" };
    in-out property <UpdateView> update: { total: 21 };
    in-out property <[SectionView]> sections;
    in-out property <[ProviderCardView]> cards;
    in-out property <[RegistryView]> registry;
    in-out property <[ToastView]> toasts;
    in-out property <string> selected-id;
    in-out property <bool> details-open: false;
    in-out property <DetailsView> details;
    in-out property <ConfirmationView> confirmation;
    in-out property <[ProcessView]> confirmation-processes;
    in-out property <string> refresh-interval-label: "60 s";
    in-out property <bool> refresh-interval-known: false;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> remember-me: true;
    // The login form's HTML inputs (public/login-bridge.mjs): which one has keyboard focus or the pointer
    // ("user", "pass" or ""), so the Slint boxes under them draw their focus halo and hover border.
    in-out property <string> login-focus;
    in-out property <string> login-hover;
    callback action(string, string);
    callback toast-dismissed(int);
    // where those inputs go and whether they are on screen (lib.rs hands it to bridge.js)
    callback login-overlay(LoginOverlay);

    // ---------- theme cross-fade (globals cannot animate) ----------
    property <float> theme-mix: Theme.dark ? 1 : 0;
    animate theme-mix { duration: Motion.on ? Motion.theme : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    changed theme-mix => {
        Motion.theme-shift = self.theme-mix > 0.001 && self.theme-mix < 0.999;
        Theme.mix = self.theme-mix;
    }
    property <bool> dark: Theme.dark;
    changed dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    init => {
        Theme.mix = self.theme-mix;
        Breakpoints.width = self.width;
        Breakpoints.height = self.height;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        keys.focus();
    }
    changed width => {
        Breakpoints.width = self.width;
        root.begin-reflow();
    }
    changed height => {
        Breakpoints.height = self.height;
        root.begin-reflow();
    }

    // ---------- chrome geometry (DESIGN-MOBILE.md 2.4, 3.1-3.4) ----------
    // The chrome's total height: safe-top plus the tier's rows. D keeps its flat 62 px. The page
    // scroll and every overlay band derive from this, so a tier reflow moves them on the same frame.
    property <length> chrome-h: Breakpoints.tier-d ? 62px
        : Breakpoints.short ? Device.safe-top + 48px
        : Breakpoints.tier-p ? Device.safe-top + 52px
        : Breakpoints.tier-f ? Device.safe-top + 108px
        : Device.safe-top + 60px;
    // The P tab bar (never while the keyboard is up; 2.5). Its height is TabBar's own rule
    // (52 px of cells plus the home-indicator strip), restated here because the bar element is
    // conditional and cannot be referenced from outside its `if`.
    property <bool> tab-bar-shown: Breakpoints.tier-p && !Breakpoints.short && Device.keyboard == 0px;
    property <length> tab-bar-h: tab-bar-shown ? 52px + max(Device.safe-bottom, 8px) : 0px;

    // ---------- overlays below D (DESIGN-MOBILE.md 3.5-3.9) ----------
    // `pop` is the open header popover (1 status, 2 appearance, 3 account); the account menu is a
    // sheet on P (3.5) and Details is a bottom sheet below 760 and a side panel from 760. Every
    // open overlay counts itself in the Overlays global so bridge.js pops the top one on Back.
    property <int> pop: 0;
    property <length> pop-ax: 0px;
    property <length> pop-ay: 0px;
    property <length> pop-aw: 0px;
    property <length> pop-ah: 0px;
    property <bool> account-sheet: false;
    property <bool> details-as-sheet: Breakpoints.below-d
        && (Breakpoints.tier-p || (Breakpoints.tier-f && Breakpoints.width < 760px));
    // The overlay layers for Back (the Overlays global): set where the state changes. The dialog
    // and Details flags follow the bridge-facing properties; globals cannot carry bindings from a
    // component, so they are assigned in change handlers.
    changed confirmation => { Overlays.dialog = self.confirmation.open; }
    changed details-open => { Overlays.details = self.details-open && Breakpoints.below-d; }
    changed account-sheet => { Overlays.sheet = self.account-sheet; }

    function open-pop(kind: int, ax: length, ay: length, aw: length, ah: length) {
        if root.pop != kind {
            root.pop = 0;
            root.pop-ax = ax;
            root.pop-ay = ay;
            root.pop-aw = aw;
            root.pop-ah = ah;
            root.pop = kind;
            Overlays.pops += 1;
            root.action("overlay-open", "pop");
        }
    }
    function close-pop() {
        if root.pop != 0 {
            root.pop = 0;
            Overlays.pops = max(0, Overlays.pops - 1);
        }
    }
    function close-account-sheet() {
        if root.account-sheet {
            root.account-sheet = false;
            root.action("overlay-close", "sheet");
        }
    }

    // Back (3.9): bridge.js pops one entry and bumps pop-request; the top layer closes itself.
    property <int> pop-request-watch: Overlays.pop-request;
    changed pop-request-watch => {
        if Overlays.top == 100 {
            root.action("activation-cancel", "");
        } else if Overlays.top == 90 && root.details-open {
            root.close-details();
        } else if Overlays.top == 80 && root.account-sheet {
            root.close-account-sheet();
        } else if Overlays.top == 70 {
            Overlays.pop-close += 1;
        }
    }
    // History consume for page-owned overlays: a select bumps Overlays.pops itself, so a change
    // here means one opened (push an entry) or closed (consume its entry).
    property <int> pops-watch: Overlays.pops;
    property <int> last-pops: 0;
    changed pops-watch => {
        if root.pops-watch > root.last-pops && root.pop == 0 && !root.account-sheet {
            root.action("overlay-open", "pop");
        }
        if root.pops-watch < root.last-pops {
            root.action("overlay-close", "pop");
        }
        root.last-pops = root.pops-watch;
    }

    // ---------- live reflow (1.6): keep the read position across a fold, rotation or split ----------
    // Before the relayout the scroll offset and the content height are captured; after it, the
    // offset is scaled by the height ratio so the same part of the page stays in view. A popover's
    // anchor moves, so popovers close; sheets, Details and the page itself stay as they are.
    property <length> reflow-y: 0px;
    property <length> reflow-ch: 0px;
    reflow-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            if root.reflow-ch > 0px && scroller.content-height > 0px {
                scroller.content-y = clamp(root.reflow-y * scroller.content-height / root.reflow-ch,
                    -max(0px, scroller.content-height - scroller.height), 0px);
            }
        }
    }
    function begin-reflow() {
        if Breakpoints.below-d && root.data-ready {
            root.reflow-y = scroller.content-y;
            root.reflow-ch = scroller.last-ch;
            root.close-pop();
            reflow-timer.running = true;
        }
    }

    // The first page of the session loads in more slowly than a page change.
    property <bool> home-seen: false;
    seen-timer := Timer {
        interval: 2s;
        running: root.data-ready && !root.home-seen;
        triggered => { self.running = false; root.home-seen = true; }
    }

    // Image-settle keep-alive (dark-marks fix): provider and platform images decode asynchronously
    // in the browser, and Slint core only pokes the event loop when a load completes. If that lands
    // while the loop is asleep with no timer scheduled, the frame is lost and the image stays blank
    // until the next repaint. A scheduled timer keeps the loop out of that state; ~5s from boot
    // covers every load with margin, then the timer stops and the dashboard idles cleanly again.
    property <int> settle-ticks: 0;
    settle-timer := Timer {
        interval: 450ms;
        running: root.settle-ticks < 11;
        triggered => { root.settle-ticks += 1; }
    }

    // ---------- page routing with a leave/enter transition ----------
    property <string> shown-page: "home";
    property <bool> leaving: false;
    changed current-page => {
        Hover.clear();
        root.close-details();
        root.close-pop();
        root.close-account-sheet();
        if Motion.on {
            root.leaving = true;
            swap-page.running = true;
        } else {
            root.shown-page = root.current-page;
            scroller.content-y = 0px;
        }
    }
    swap-page := Timer {
        interval: 190ms;
        running: false;
        triggered => {
            self.running = false;
            root.shown-page = root.current-page;
            scroller.content-y = 0px;
            root.leaving = false;
        }
    }
    function go(page: string) {
        if page != root.current-page {
            root.current-page = page;
            root.action("navigate", page);
        }
    }
    function open-details(id: string) {
        if id == "" { return; }
        root.selected-id = id;
        root.action("details", id);
    }
    function close-details() {
        if root.details-open {
            root.details-open = false;
            root.selected-id = "";
            root.action("details-closed", "");
        }
    }

    keys := FocusScope {
        width: root.width;
        height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.confirmation.open && !root.confirmation.busy {
                    root.action("activation-cancel", "");
                    return accept;
                }
                if Breakpoints.below-d && root.pop != 0 {
                    root.close-pop();
                    return accept;
                }
                if Breakpoints.below-d && root.account-sheet {
                    root.close-account-sheet();
                    return accept;
                }
                if root.details-open {
                    root.close-details();
                    return accept;
                }
                Hover.clear();
            }
            return reject;
        }

        // ~100 hairlines: a cached layer, redrawn only when the window resizes or the theme changes
        PaperGrid {
            width: root.width;
            height: root.height;
            cache-rendering-hint: true;
        }
        // A click that nothing else takes (the header's empty space, the gaps between sections) closes
        // Details; a click on a row opens that row instead.
        TouchArea {
            width: root.width;
            height: root.height;
            enabled: root.details-open;
            clicked => { root.close-details(); }
        }

        scroller := PageScroll {
            y: root.chrome-h;
            width: root.width;
            height: root.height - root.chrome-h - root.tab-bar-h;
            content-height: pages.preferred-height;
            Rectangle {
                x: max(0px, (root.width - Breakpoints.max-content) / 2);
                width: min(root.width, Breakpoints.max-content);
                height: max(scroller.height, pages.preferred-height);
                TouchArea {
                    enabled: root.details-open;
                    clicked => { root.close-details(); }
                }
                pages := VerticalLayout {
                    // Below D the gutters add the live safe-side insets and the bottom padding the
                    // safe area plus the keyboard (2.4, 2.5); the tab bar takes its share of the
                    // height instead (the scroll area ends above it). D is unchanged.
                    padding-left: Breakpoints.gutter + (Breakpoints.below-d ? Device.safe-left : 0px);
                    padding-right: Breakpoints.gutter + (Breakpoints.below-d ? Device.safe-right : 0px);
                    padding-top: Breakpoints.tier-d ? 26px : Breakpoints.tier-p ? 12px : Breakpoints.tier-f ? 16px : 20px;
                    padding-bottom: Breakpoints.tier-d ? 120px
                        : Breakpoints.tier-p ? 16px + Device.keyboard
                        : 32px + Device.safe-bottom + Device.keyboard;
                    alignment: start;
                    y: root.leaving ? -8px : 0px;
                    opacity: root.leaving ? 0 : 1;
                    animate y { duration: Motion.on ? 190ms : 0ms; easing: cubic-bezier(0.4, 0, 1, 1); }
                    animate opacity { duration: Motion.on ? 180ms : 0ms; easing: cubic-bezier(0.4, 0, 1, 1); }
                    if root.authenticated && root.shown-page == "home": HomePage {
                        sections: root.sections;
                        cards: root.cards;
                        busy: root.busy;
                        ready: root.data-ready;
                        selected-id: root.selected-id;
                        open-details(id) => { root.open-details(id); }
                        launch(id, target) => { root.action("launch", id + ":" + target); }
                        activate(kind, profile) => { root.action(kind, profile); }
                        auto-toggled(id, on) => { root.action(id == "antigravity" ? "antigravity-automatic" : "automatic", on ? "true" : "false"); }
                        threshold-picked(id, v) => { root.action(id == "antigravity" ? "antigravity-threshold" : "threshold", v); }
                        go-analytics => { root.go("analytics"); }
                        go-accounts => { root.go("accounts"); }
                        first: !root.home-seen;
                    }
                    if root.authenticated && root.shown-page == "analytics": AnalyticsPage {
                        scroll: -scroller.content-y;
                        view-bottom: root.height;
                        win-h: root.height;
                    }
                    if root.authenticated && root.shown-page == "accounts": AccountsPage {
                        busy: root.busy;
                        selected-id: root.selected-id;
                        first: !root.home-seen;
                        theme-value: Theme.mode == 1 ? "light" : Theme.mode == 2 ? "dark" : "auto";
                        theme-picked(v) => {
                            Theme.mode = v == "light" ? 1 : v == "dark" ? 2 : 0;
                            root.action("theme", v);
                        }
                        open-details(id) => { root.open-details(id); }
                        act(kind, value) => { root.action(kind, value); }
                    }
                }
            }
        }

        // The desktop header is exactly today's; the P/F/T tiers and the short row use the mobile
        // chrome (shell/chrome.slint). A tier reflow swaps them on the next frame, unanimated.
        if Breakpoints.tier-d: Header {
            x: 0px;
            y: 0px;
            width: root.width;
            page: root.current-page;
            chrome: root.chrome;
            update: root.update;
            busy: root.busy;
            shown: root.authenticated;
            navigate(p) => { root.go(p); }
            refresh() => { root.action("refresh", ""); }
            update-apps() => { root.action("update-apps", ""); }
            theme-picked(mode) => {
                Theme.mode = mode;
                root.action("theme", mode == 1 ? "light" : mode == 2 ? "dark" : "auto");
            }
            sign-out() => { root.action("logout", ""); }
        }
        if !Breakpoints.tier-d: MobileHeader {
            x: 0px;
            y: 0px;
            width: root.width;
            page: root.current-page;
            chrome: root.chrome;
            update: root.update;
            busy: root.busy;
            shown: root.authenticated;
            navigate(p) => { root.go(p); }
            refresh() => { root.action("refresh", ""); }
            update-apps() => { root.action("update-apps", ""); }
            logo-tapped => { scroller.content-y = 0px; }
            status-tapped(anchor, w, h) => {
                if root.pop == 1 { root.close-pop(); } else { root.open-pop(1, anchor.x, anchor.y, w, h); }
            }
            theme-tapped(anchor, w, h) => {
                if root.pop == 2 { root.close-pop(); } else { root.open-pop(2, anchor.x, anchor.y, w, h); }
            }
            account-tapped(anchor, w, h) => {
                if Breakpoints.tier-p && !Breakpoints.short {
                    if root.account-sheet { root.close-account-sheet(); } else { root.account-sheet = true; root.action("overlay-open", "sheet"); }
                } else if root.pop == 3 {
                    root.close-pop();
                } else {
                    root.open-pop(3, anchor.x, anchor.y, w, h);
                }
            }
        }

        // The P bottom tab bar: hidden while the keyboard is up; sheets and scrims draw above it.
        if root.tab-bar-shown: tab-bar := TabBar {
            x: 0px;
            y: root.height - self.height;
            width: root.width;
            page: root.current-page;
            navigate(p) => { root.go(p); }
        }

        // ---- Details: D keeps the slide-over; below D it is a bottom sheet below 760 and a side
        // panel from 760 and on T and short (3.5). The account stays; the container reflows with
        // the tier on the next frame, unanimated.
        if Breakpoints.tier-d: overlay := SlideOver {
            view-w: root.width;
            view-h: root.height;
            open: root.details-open;
            close-requested => { root.close-details(); }
            // A click on another row swaps the content under the staying panel (the dip). The id
            // is watched here because the element only exists on D.
            property <string> prev-id: "";
            property <string> id-watch: root.details.id;
            changed id-watch => {
                if root.details-open && self.prev-id != "" && self.id-watch != self.prev-id { self.swap(); }
                self.prev-id = self.id-watch;
            }
            // Fills the panel's content area (no explicit size: `parent` here would be the SlideOver).
            DetailsPanel {
                data: root.details;
                open: root.details-open;
                busy: root.busy;
                close => { root.close-details(); }
                launch(id, target) => { root.action("launch", id + ":" + target); }
                activate(kind, profile) => { root.action(kind, profile); }
                go-accounts => { root.close-details(); root.go("accounts"); }
            }
        }
        if Breakpoints.below-d && root.details-as-sheet: Sheet {
            tall: true;
            open: root.details-open;
            probe: "details-sheet";
            close-requested => { root.close-details(); }
            DetailsPanel {
                width: 100%;
                height: 100%;
                data: root.details;
                open: root.details-open;
                busy: root.busy;
                close => { root.close-details(); }
                launch(id, target) => { root.action("launch", id + ":" + target); }
                activate(kind, profile) => { root.action(kind, profile); }
                go-accounts => { root.close-details(); root.go("accounts"); }
            }
        }
        if Breakpoints.below-d && !root.details-as-sheet: SidePanel {
            open: root.details-open;
            probe: "details-panel";
            close-requested => { root.close-details(); }
            DetailsPanel {
                width: 100%;
                height: 100%;
                data: root.details;
                open: root.details-open;
                busy: root.busy;
                close => { root.close-details(); }
                launch(id, target) => { root.action("launch", id + ":" + target); }
                activate(kind, profile) => { root.action(kind, profile); }
                go-accounts => { root.close-details(); root.go("accounts"); }
            }
        }

        // ---- Header menus below D (3.5-3.6): the status detail, the Appearance menu (F/T) and the
        // Account menu (F/T and short) as anchored popovers. On P the Account menu is a sheet. ----
        if root.pop == 1: Popover {
            anchor-x: root.pop-ax;
            anchor-y: root.pop-ay;
            anchor-w: root.pop-aw;
            anchor-h: root.pop-ah;
            design-w: Breakpoints.tier-p ? root.width - 24px : 340px;
            band-top: root.chrome-h;
            close-requested => { root.close-pop(); }
            VerticalLayout {
                padding: 12px;
                Text {
                    text: root.chrome.status-tip;
                    font-size: Type.small;
                    color: Theme.ink-2;
                    wrap: word-wrap;
                }
            }
        }
        if root.pop == 2: Popover {
            anchor-x: root.pop-ax;
            anchor-y: root.pop-ay;
            anchor-w: root.pop-aw;
            anchor-h: root.pop-ah;
            design-w: 212px;
            band-top: root.chrome-h;
            close-requested => { root.close-pop(); }
            MenuHead { text: "Appearance"; }
            MenuItem { icon: "sun"; text: "Light"; checked: Theme.mode == 1; activated => { root.close-pop(); Theme.mode = 1; root.action("theme", "light"); } }
            MenuItem { icon: "moon"; text: "Dark"; checked: Theme.mode == 2; activated => { root.close-pop(); Theme.mode = 2; root.action("theme", "dark"); } }
            MenuItem { icon: "monitor"; text: "Auto, follows the system"; checked: Theme.mode == 0; activated => { root.close-pop(); Theme.mode = 0; root.action("theme", "auto"); } }
        }
        if root.pop == 3: Popover {
            anchor-x: root.pop-ax;
            anchor-y: root.pop-ay;
            anchor-w: root.pop-aw;
            anchor-h: root.pop-ah;
            design-w: 260px;
            band-top: root.chrome-h;
            close-requested => { root.close-pop(); }
            HorizontalLayout {
                height: 70px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 11px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.rule;
                        Icon { x: 6px; y: 6px; name: "user"; tint: Theme.ink-2; width: 20px; height: 20px; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text { text: root.chrome.username != "" ? root.chrome.username : "Owner"; font-size: 13.5px; font-weight: 640; color: Theme.ink; overflow: elide; }
                    Text {
                        text: root.chrome.host != "" ? "Signed in to this dashboard on " + root.chrome.host : "Signed in to this dashboard";
                        font-size: Type.small;
                        color: Theme.ink-3;
                        wrap: word-wrap;
                    }
                }
            }
            MenuSeparator { }
            MenuItem { icon: "logout"; text: "Sign out"; activated => { root.close-pop(); root.action("logout", ""); } }
        }

        // The P account sheet (3.5): the identity and Sign out only, 52 px rows. It stays a
        // sheet until closed even if a reflow leaves P (1.6); opening is gated in account-tapped.
        if root.account-sheet: Sheet {
            open: true;
            title: "Account";
            probe: "account-sheet";
            close-requested => { root.close-account-sheet(); }
            VerticalLayout {
                // The titled sheet already pads its content 16 px at the sides.
                padding-top: 8px;
                spacing: 0px;
                HorizontalLayout {
                    height: 64px;
                    spacing: 11px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: Theme.rule;
                            Icon { x: 6px; y: 6px; name: "user"; tint: Theme.ink-2; width: 20px; height: 20px; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: root.chrome.username != "" ? root.chrome.username : "Owner"; font-size: Type.body; font-weight: 640; color: Theme.ink; overflow: elide; }
                        Text {
                            text: root.chrome.host != "" ? "Signed in to this dashboard on " + root.chrome.host : "Signed in to this dashboard";
                            font-size: Type.small;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }
                }
                MenuSeparator { }
                // One 52 px sheet row: the label in body size, the icon on the left (3.5).
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 0px;
                        padding-right: 0px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Icon { name: "logout"; tint: Theme.ink-3; width: 20px; height: 20px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "Sign out"; font-size: Type.body; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-account-sheet(); root.action("logout", ""); }
                    }
                }
            }
        }

        dialog := Dialog {
            view-w: root.width;
            view-h: root.height;
            open: root.confirmation.open;
            dismissable: !root.confirmation.busy;
            card-w: 600px;
            band-top: Breakpoints.below-d ? root.chrome-h : 0px;
            band-inset: Breakpoints.below-d ? max(Device.keyboard, Device.safe-bottom) : 0px;
            close-requested => { root.action("activation-cancel", ""); }
            Text {
                text: "Another " + root.confirmation.product + " process is running";
                font-size: 20px;
                font-weight: 640;
                color: Theme.ink;
                wrap: word-wrap;
            }
            Text { text: "Switch to " + root.confirmation.target + "?"; font-size: 13px; color: Theme.accent-text; }
            Text { text: root.confirmation.warning; font-size: 12.5px; color: Theme.ink-2; wrap: word-wrap; }
            Rectangle {
                min-height: 60px;
                preferred-height: min(220px, root.confirmation-processes.length * 44px + 20px);
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.rule;
                background: Theme.paper-2;
                Flickable {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    content-height: procs.preferred-height;
                    procs := VerticalLayout {
                        spacing: 6px;
                        for p in root.confirmation-processes: VerticalLayout {
                            Text { text: p.label; font-size: 12.5px; font-weight: 600; color: Theme.ink; overflow: elide; }
                            Text { text: "PID " + p.pid + (p.role != "" ? " · " + p.role : ""); font-family: Type.tab; font-size: Type.small; color: Theme.ink-3; }
                        }
                        if root.confirmation-processes.length == 0: Text { text: "No running processes were listed."; font-size: 12.5px; color: Theme.ink-3; }
                    }
                }
            }
            Text { text: root.confirmation.expires; font-family: Type.tab; font-size: Type.small; color: Theme.ink-3; }
            Text {
                text: root.confirmation.busy ? "Stopping the listed processes and restoring " + root.confirmation.product + "…" : root.confirmation.error;
                font-size: 12.5px;
                color: root.confirmation.error != "" && !root.confirmation.busy ? Theme.crit-text : Theme.ink-3;
                wrap: word-wrap;
            }
            // Buttons: side by side as today; on a card narrower than 400 they stack full width
            // with the primary on top (3.8).
            if Breakpoints.below-d && dialog.shown-card-w < 400px: VerticalLayout {
                spacing: 8px;
                Button {
                    height: 48px;
                    kind: "primary";
                    text: "Yes, stop and restart";
                    enabled: root.confirmation.valid && !root.confirmation.busy;
                    hint: "Stop the listed processes and switch the " + root.confirmation.product + " account";
                    clicked => { root.action("activation-confirm", ""); }
                }
                Button {
                    height: 48px;
                    text: "Cancel";
                    enabled: !root.confirmation.busy;
                    hint: "Keep every " + root.confirmation.product + " process and account unchanged";
                    clicked => { root.action("activation-cancel", ""); }
                }
            }
            if !(Breakpoints.below-d && dialog.shown-card-w < 400px): HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Button {
                    text: "Cancel";
                    enabled: !root.confirmation.busy;
                    hint: "Keep every " + root.confirmation.product + " process and account unchanged";
                    clicked => { root.action("activation-cancel", ""); }
                }
                Button {
                    kind: "primary";
                    text: "Yes, stop and restart";
                    enabled: root.confirmation.valid && !root.confirmation.busy;
                    hint: "Stop the listed processes and switch the " + root.confirmation.product + " account";
                    clicked => { root.action("activation-confirm", ""); }
                }
            }
        }

        ToastStack {
            // P: full width above the tab bar (or the keyboard); F/T and short: bottom right;
            // D: exactly today's spot, stepping aside for the slide-over.
            card-w: Breakpoints.tier-p && !Breakpoints.short ? min(480px, root.width - 24px - Device.safe-left - Device.safe-right)
                : Breakpoints.below-d ? min(380px, root.width - 2 * Breakpoints.gutter - Device.safe-left - Device.safe-right)
                : 380px;
            x: Breakpoints.tier-p && !Breakpoints.short ? (root.width - self.width) / 2
                : Breakpoints.below-d ? root.width - self.width - Breakpoints.gutter - Device.safe-right
                : root.width - self.width - (root.details-open ? min(580px, max(420px, root.width * 0.3)) + 20px : 24px);
            y: root.height - self.height - (Breakpoints.tier-p && !Breakpoints.short ? max(root.tab-bar-h, Device.keyboard) + 8px
                : Breakpoints.below-d ? Device.safe-bottom + 16px
                : 24px);
            animate x { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            toasts: root.toasts;
            dismissed(id) => { root.toast-dismissed(id); }
        }

        HoverLayer {
            width: root.width;
            height: root.height;
            view-w: root.width;
            view-h: root.height;
        }

        SignInLayer {
            width: root.width;
            height: root.height;
            shown: !root.authenticated;
            auth: root.auth;
            strength: root.strength;
            busy: root.busy;
            username <=> root.username;
            password <=> root.password;
            remember-me <=> root.remember-me;
            login-focus: root.login-focus;
            login-hover: root.login-hover;
            login-overlay(overlay) => { root.login-overlay(overlay); }
            login-focus-request(field) => { root.action("login-field-focus", field); }
            submit(user, pass, remember) => { root.action("login", user + "\n" + pass + "\n" + (remember ? "1" : "0")); }
            create(user, pass, confirm, code) => { root.action("setup", user + "\n" + pass + "\n" + confirm + "\n" + code); }
            typing(pass, confirm) => { root.action("setup-typing", pass + "\n" + confirm); }
            recheck => { root.action("auth-recheck", ""); }
            limit-over => { root.action("login-limit-over", ""); }
        }
    }

    // Decodes every mark and platform image on boot (see MarksPreloader); invisible and inert.
    MarksPreloader {
        x: 0px;
        y: 0px;
    }
}
