// Switch with a spring thumb. A toggle that cannot act yet is drawn off and flat and says why on hover
// (`disabled-reason`); it never shows ON for a state that is off.
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";
import { ProbeMark } from "probe.slint";
import { Hover } from "hover-card.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> on: false;
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> disabled-reason;
    in property <bool> small: false;
    // names the toggle for the end-to-end harness (components/probe.slint)
    in property <string> probe;
    // Touch long-press tip (DESIGN-MOBILE.md 5.2.3): shown after a 450 ms press, which then never toggles.
    in property <string> long-tip: "";
    callback toggled(bool);

    // Below D the switch is 36 x 22 on T and 40 x 24 on F/P (DESIGN-MOBILE.md 2.3).
    property <length> track-w: Breakpoints.tier-d ? (root.small ? 28px : 34px) : Breakpoints.tier-t ? 36px : 40px;
    property <length> track-h: Breakpoints.tier-d ? (root.small ? 16px : 20px) : Breakpoints.tier-t ? 22px : 24px;

    // Long-press: touch only (a desktop press-and-hold still toggles on release).
    property <bool> lp-armed: (Device.coarse || Breakpoints.below-d) && root.long-tip != "";
    property <bool> lp-fired: false;
    property <bool> lp-dead: false;
    lp-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            if root.lp-armed && ta.pressed && !root.lp-dead {
                root.lp-fired = true;
                Hover.tip-now("long-press", ta.absolute-position, ta.width, ta.height, root.long-tip);
            }
        }
    }
    property <length> thumb: root.track-h - 4px;
    property <bool> shown-on: root.on && root.enabled;

    height: max(root.track-h, label-text.preferred-height);
    min-width: root.track-w + (root.label == "" ? 0px : 9px + label-text.preferred-width);
    preferred-width: self.min-width;
    accessible-role: switch;
    accessible-checked: root.shown-on;
    accessible-label: root.label;

    track := Rectangle {
        x: 0px;
        y: (root.height - root.track-h) / 2;
        width: root.track-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: !root.enabled ? Theme.track : root.shown-on ? Theme.accent : Theme.rule-strong;
        animate background { duration: Motion.tint(200ms); easing: cubic-bezier(0.65, 0, 0.35, 1); }
        Rectangle {
            x: root.shown-on ? root.track-w - root.thumb - 2px : 2px;
            y: 2px;
            width: root.thumb;
            height: root.thumb;
            border-radius: root.thumb / 2;
            background: #ffffff;
            opacity: root.enabled ? 1 : 0.85;
            drop-shadow-color: root.enabled ? #00000040 : #00000000;
            drop-shadow-blur: 2px;
            drop-shadow-offset-y: 1px;
            transform-scale: ta.pressed && root.enabled ? 0.92 : 1;
            animate x { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
            animate transform-scale { duration: Motion.fast; }
        }
    }
    label-text := Text {
        x: root.track-w + 9px;
        y: (root.height - self.preferred-height) / 2;
        text: root.label;
        visible: root.label != "";
        color: root.enabled ? Theme.ink : Theme.ink-3;
        font-size: Type.control;
    }
    // Hit-slop below D: the TouchArea grows to at least 44 x 44, centred on the visual.
    property <length> slop-x: Breakpoints.below-d ? max(0px, (44px - root.width) / 2) : 0px;
    property <length> slop-y: Breakpoints.below-d ? max(0px, (44px - root.height) / 2) : 0px;
    ta := TouchArea {
        x: -root.slop-x;
        y: -root.slop-y;
        width: root.width + 2 * root.slop-x;
        height: root.height + 2 * root.slop-y;
        mouse-cursor: root.enabled ? pointer : not-allowed;
        changed pressed => {
            if self.pressed {
                root.lp-dead = false;
                root.lp-fired = false;
                if root.lp-armed { lp-timer.running = true; }
            } else {
                lp-timer.running = false;
                Hover.leave("long-press");
            }
        }
        moved => {
            if self.pressed && (self.mouse-x > self.pressed-x + 8px || self.mouse-x < self.pressed-x - 8px || self.mouse-y > self.pressed-y + 8px || self.mouse-y < self.pressed-y - 8px) {
                root.lp-dead = true;
                lp-timer.running = false;
                if root.lp-fired { root.lp-fired = false; Hover.leave("long-press"); }
            }
        }
        clicked => {
            if root.lp-fired {
                root.lp-fired = false;
                Hover.leave("long-press");
            } else if root.enabled {
                root.on = !root.on;
                root.toggled(root.on);
            }
        }
    }
    ProbeMark { x: 0px; y: 0px; id: root.probe; width: root.track-w; height: root.height; }
}
