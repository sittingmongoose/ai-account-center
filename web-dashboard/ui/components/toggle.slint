// Switch with a spring thumb. A toggle that cannot act yet is drawn off and flat and says why on hover
// (`disabled-reason`); it never shows ON for a state that is off.
import { Theme, Motion, Type } from "../theme.slint";

export component Toggle inherits Rectangle {
    in-out property <bool> on: false;
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> disabled-reason;
    in property <bool> small: false;
    callback toggled(bool);

    property <length> track-w: root.small ? 28px : 34px;
    property <length> track-h: root.small ? 16px : 20px;
    property <length> thumb: root.track-h - 4px;
    property <bool> shown-on: root.on && root.enabled;

    height: max(root.track-h, label-text.preferred-height);
    min-width: root.track-w + (root.label == "" ? 0px : 9px + label-text.preferred-width);
    preferred-width: self.min-width;
    accessible-role: switch;
    accessible-checked: root.shown-on;
    accessible-label: root.label;

    track := Rectangle {
        x: 0px;
        y: (root.height - root.track-h) / 2;
        width: root.track-w;
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: !root.enabled ? Theme.track : root.shown-on ? Theme.accent : Theme.rule-strong;
        animate background { duration: Motion.tint(200ms); easing: cubic-bezier(0.65, 0, 0.35, 1); }
        Rectangle {
            x: root.shown-on ? root.track-w - root.thumb - 2px : 2px;
            y: 2px;
            width: root.thumb;
            height: root.thumb;
            border-radius: root.thumb / 2;
            background: #ffffff;
            opacity: root.enabled ? 1 : 0.85;
            drop-shadow-color: root.enabled ? #00000040 : #00000000;
            drop-shadow-blur: 2px;
            drop-shadow-offset-y: 1px;
            transform-scale: ta.pressed && root.enabled ? 0.92 : 1;
            animate x { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
            animate transform-scale { duration: Motion.fast; }
        }
    }
    label-text := Text {
        x: root.track-w + 9px;
        y: (root.height - self.preferred-height) / 2;
        text: root.label;
        visible: root.label != "";
        color: root.enabled ? Theme.ink : Theme.ink-3;
        font-size: Type.control;
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if root.enabled {
                root.on = !root.on;
                root.toggled(root.on);
            }
        }
    }
}
