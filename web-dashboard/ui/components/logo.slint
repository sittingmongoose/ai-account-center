// Apex Soft (the chosen mark), 24 px pixel grid
export component AacLogoApex24 inherits Rectangle {
    in property <color> ink: Theme.ink;
    in property <bool> template: false;
    width: 24px;
    height: 24px;
    Path {
        x: root.width * 5.104 / 24;
        y: root.height * 14 / 24;
        width: root.width * 7.896 / 24;
        height: root.height * 3 / 24;
        viewbox-x: 5.104;
        viewbox-y: 14;
        viewbox-width: 7.896;
        viewbox-height: 3;
        fill: root.template ? root.ink : @linear-gradient(90deg, #3466FA 0%, #3466FA 30.224%, #2C96FF 100%);
        commands: "M6.577 14L11.5 14A1.5 1.5 0 0 1 11.5 17L5.104 17Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M2.617 22A1.008 1.008 0 0 1 1.713 20.548L10.474 2.701A1.7 1.7 0 0 1 13.526 2.701L22.287 20.548A1.008 1.008 0 0 1 21.383 22L20.074 22A0.6 0.6 0 0 1 19.535 21.664L12 6.314L4.465 21.664A0.6 0.6 0 0 1 3.926 22Z";
    }
}

// Apex Sharp (retired alternate), master (24-unit grid)

// The header and sign-in logo: picks the pixel-tuned variant for the drawn size.
export component AppLogo inherits Rectangle {
    in property <length> size: 26px;
    in property <color> ink: Theme.ink;
    width: root.size;
    height: root.size;
    if root.size <= 16px: AacLogoApex16 { width: root.size; height: root.size; ink: root.ink; }
    if root.size > 16px && root.size <= 18px: AacLogoApex18 { width: root.size; height: root.size; ink: root.ink; }
    if root.size > 18px && root.size <= 20px: AacLogoApex20 { width: root.size; height: root.size; ink: root.ink; }
    if root.size > 20px && root.size <= 24px: AacLogoApex24 { width: root.size; height: root.size; ink: root.ink; }
    if root.size > 24px: AacLogoApex { width: root.size; height: root.size; ink: root.ink; }
}
