// The AI Account Center logo, Apex Soft (the owner's pick, 2026-10-01), as Slint Path elements generated by
// redesign-concepts-20261001/logos/build_logos.py. AacLogoApex is the 24-unit master; the 16/18/20/24 variants
// are tuned to their pixel grids. `ink` is the theme text colour; `template: true` paints everything in `ink`.
import { Theme } from "../theme.slint";

// Apex Soft (the chosen mark), master (24-unit grid)
export component AacLogoApex inherits Rectangle {
    in property <color> ink: Theme.ink;
    in property <bool> template: false;
    width: 24px;
    height: 24px;
    Path {
        x: root.width * 5.362 / 24;
        y: root.height * 14 / 24;
        width: root.width * 7.338 / 24;
        height: root.height * 3.6 / 24;
        viewbox-x: 5.362;
        viewbox-y: 14;
        viewbox-width: 7.338;
        viewbox-height: 3.6;
        fill: root.template ? root.ink : @linear-gradient(90deg, #2D58F4 0%, #2D58F4 37.944%, #2F7DFF 70.213%, #1DB1F0 100%);
        commands: "M7.081 14L10.9 14A1.8 1.8 0 0 1 10.9 17.6L5.362 17.6Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M3.46 21.5A1.222 1.222 0 0 1 2.363 19.74L10.294 3.576A1.9 1.9 0 0 1 13.706 3.576L21.637 19.74A1.222 1.222 0 0 1 20.54 21.5L19.074 21.5A0.9 0.9 0 0 1 18.258 20.979L12.816 9.258A0.9 0.9 0 0 0 11.184 9.258L5.742 20.979A0.9 0.9 0 0 1 4.926 21.5Z";
    }
}

// Apex Soft (the chosen mark), 16 px pixel grid
export component AacLogoApex16 inherits Rectangle {
    in property <color> ink: Theme.ink;
    in property <bool> template: false;
    width: 16px;
    height: 16px;
    Path {
        x: root.width * 3.497 / 16;
        y: root.height * 10 / 16;
        width: root.width * 4.503 / 16;
        height: root.height * 2 / 16;
        viewbox-x: 3.497;
        viewbox-y: 10;
        viewbox-width: 4.503;
        viewbox-height: 2;
        fill: root.template ? root.ink : @linear-gradient(90deg, #3466FA 0%, #3466FA 35.517%, #2C96FF 100%);
        commands: "M4.396 10L7 10A1 1 0 0 1 7 12L3.497 12Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.ink;
        commands: "M2.127 15A0.729 0.729 0 0 1 1.462 13.972L6.997 1.649A1.1 1.1 0 0 1 9.003 1.649L14.538 13.972A0.729 0.729 0 0 1 13.873 15L12.894 15A0.3 0.3 0 0 1 12.62 14.823L8 4.536L3.38 14.823A0.3 0.3 0 0 1 3.106 15Z";
    }
}

