// Modal dialog.
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";

// Centered modal: scrim plus a card that rises 12 px and fades in. Escape and the scrim call
// close-requested only when `dismissable` (a running switch is not). Below D (DESIGN-MOBILE.md
// 3.8) the card is min(440, window - 32 - safe sides) inside the visible band, the scrim is the
// sheet scrim and never dismisses (Back is the cancel button); D keeps today's geometry exactly.
export component Dialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> dismissable: true;
    in property <length> view-w;
    in property <length> view-h;
    in property <length> card-w: 560px;
    // The visible band below D: the chrome's height above, the keyboard or safe-bottom below.
    in property <length> band-top: 0px;
    in property <length> band-inset: 0px;
    callback close-requested();

    property <length> design-w: Breakpoints.below-d ? min(440px, root.view-w - 32px - Device.safe-left - Device.safe-right) : root.card-w;
    property <length> band-h: max(0px, root.view-h - root.band-top - root.band-inset);
    out property <length> shown-card-w: card.width;

    width: root.view-w;
    height: root.view-h;
    visible: scrim.opacity > 0.005;

    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: Breakpoints.below-d ? Theme.sheet-scrim : Theme.scrim.mix(#000000, 0.75);
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        TouchArea {
            enabled: root.open;
            // Below D a tap on the scrim does not dismiss the dialog: it is a decision (3.8).
            clicked => { if root.dismissable && Breakpoints.tier-d { root.close-requested(); } }
        }
    }
    card := Rectangle {
        width: min(root.design-w, root.view-w - 48px);
        height: min(body.preferred-height, Breakpoints.below-d ? root.band-h - 48px : root.view-h - 96px);
        x: (root.view-w - self.width) / 2;
        y: root.band-top + (root.band-h - self.height) / 2 + (root.open ? 0px : 12px);
        opacity: root.open ? 1 : 0;
        animate y { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.rule;
        background: Theme.paper;
        drop-shadow-color: Theme.shadow-pop;
        drop-shadow-blur: 44px;
        drop-shadow-offset-y: 18px;
        clip: true;
        TouchArea { }
        body := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            @children
        }
    }
}
