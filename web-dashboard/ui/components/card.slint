// Surfaces. Plate: a section on a page (radius 14, hairline border, the small shadow). Card: a provider
// card that lifts 2 px on hover with a larger shadow (one drop shadow per rectangle). Both keep their
// layout slot fixed and move an inner surface, so hover never reflows neighbours. Touch (5.1): the lift
// and the hover shadow stay pointer-only, and a press shows the pressed tint fading out over 160 ms.
import { Theme, Motion, Breakpoints, Device } from "../theme.slint";

export component Plate inherits Rectangle {
    in property <bool> flash: false;
    background: root.flash ? Theme.flash : Theme.paper;
    animate background { duration: Motion.tint(600ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    border-radius: Theme.r-plate;
    border-width: 1px;
    border-color: Theme.rule;
    drop-shadow-color: Theme.shadow-1;
    drop-shadow-blur: 3px;
    drop-shadow-offset-y: 1px;
    clip: false;
    // Static content renders into a cached layer (cache-rendering-hint): a frame that leaves the section as it
    // is (scrolling, the slide-over, a page fade, a hover elsewhere) draws one texture instead of re-laying out
    // its text, meters and icons. Anything that changes inside it re-renders the layer for that frame only.
    content := Rectangle {
        cache-rendering-hint: true;
        @children
    }
}

// The hover shadow. Animating a drop shadow's blur, offset or colour makes the renderer blur a new shadow
// texture on every frame (with a GPU sync each time: 0.1-0.3 s a frame on the VM's SwiftShader for a wide card),
// so surfaces keep a static small shadow and this second, static large one fades in behind them instead.
export component HoverShadow inherits Rectangle {
    in property <bool> on;
    in property <length> radius;
    in property <length> blur: 28px;
    in property <length> offset: 12px;
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: root.radius;
        drop-shadow-color: Theme.shadow-2;
        drop-shadow-blur: root.blur;
        drop-shadow-offset-y: root.offset;
        opacity: root.on ? 1 : 0;
        visible: self.opacity > 0.005;
        animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
}

export component Card inherits Rectangle {
    in property <bool> clickable: true;
    in property <bool> selected: false;
    in property <bool> flash: false;
    in property <length> pad: 18px;
    in property <length> pad-top: root.pad;
    in property <length> pad-bottom: root.pad;
    out property <bool> hovered: ta.has-hover;
    // touch: a coarse pointer or any tier below D; the pressed tint replaces the hover lift there
    property <bool> touch: Device.coarse || Breakpoints.below-d;
    callback clicked();

    // body already carries the paddings: adding them again made every card 28 px taller than its content and
    // spread the extra inside it (looser meters and amounts than the concept's .pcard)
    min-height: body.min-height;
    preferred-height: body.preferred-height;
    min-width: body.min-width;

    HoverShadow {
        x: 0px;
        y: surface.y;
        width: root.width;
        height: root.height;
        radius: Theme.r-card;
        on: root.hovered && root.clickable && Device.hover;
    }
    surface := Rectangle {
        x: 0px;
        y: root.hovered && root.clickable && Device.hover ? -2px : 0px;
        width: root.width;
        height: root.height;
        animate y { duration: Motion.on ? 220ms : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        border-radius: Theme.r-card;
        border-width: 1px;
        border-color: root.selected ? Theme.sel-line : root.hovered && root.clickable && Device.hover ? Theme.rule-strong : Theme.rule;
        background: root.flash ? Theme.flash : root.selected ? Theme.sel-fill
            : root.touch && ta.pressed ? Theme.pressed : Theme.paper;
        // a flash lands at once and fades back over 620 ms; a press lands at once and fades out in 160 ms
        animate background { duration: Motion.tint(root.flash ? 0ms : root.touch ? (ta.pressed ? 0ms : 160ms) : 620ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate border-color { duration: Motion.tint(Motion.fast); }
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        // The body is a child of the TouchArea so hovering a nested meter or button keeps the card lifted.
        ta := TouchArea {
            // the card body is a cached layer (see Plate); the surface's own hover lift and shadow stay outside it
            cache-rendering-hint: true;
            enabled: root.clickable;
            mouse-cursor: root.clickable ? pointer : default;
            clicked => { root.clicked(); }
            body := VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: root.pad-top;
                padding-bottom: root.pad-bottom;
                spacing: 0px;
                @children
            }
        }
    }
}
