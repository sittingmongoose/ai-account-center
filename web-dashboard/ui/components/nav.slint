// Primary navigation (appears exactly once): Home, Analytics, Accounts & Settings, Status, Scoreboard. The
// active state is one ink Rectangle that glides between items (spring on x, ease-out on width), never a side bar.
// Desktop keeps today's 34 px tabs in a 44 px track; the touch tiers use 40 px tabs in a 44 px track
// (DESIGN-MOBILE.md 3.2-3.3) and the short header's compact NavBar is a 40 px track with 36 px tabs
// whose hit areas fill the row (3.4). Five items do not fit every header, so the bar steps down to the
// width its row leaves it (`max-w`): "Accounts & Settings" becomes "Accounts", then the icons go, then
// the labels go (icons only, with full accessible names).
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";
import { Icon } from "icon.slint";
import { ProbeMark } from "probe.slint";

// One place for the item metrics, so the NavBar's fit arithmetic matches what NavItem lays out.
global NavMetrics {
    public pure function pad(compact: bool) -> length {
        return compact ? 10px : Breakpoints.tier-d ? (Breakpoints.compact ? 12px : 14px) : 14px;
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    // The accessible name stays full when the drawn label is short.
    in property <string> name: root.text;
    in property <bool> selected;
    in property <bool> show-icon: true;
    in property <bool> show-text: true;
    // compact: the short header's 36 px tabs; on P they are icon-only with accessible names.
    in property <bool> compact: false;
    // the e2e probe id (?e2e only): "nav-<page>"
    in property <string> probe;
    callback clicked();
    height: root.compact ? 36px : Breakpoints.tier-d ? 34px : 40px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: 8px;
    property <color> fg: root.selected ? Theme.nav-active-fg : (ta.has-hover && Device.hover) ? Theme.ink : Theme.ink-2;
    transform-scale: ta.pressed ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: tab;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: NavMetrics.pad(root.compact);
        padding-right: NavMetrics.pad(root.compact);
        spacing: 8px;
        if root.show-icon: VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: root.fg;
                width: 16px;
                height: 16px;
            }
        }
        if root.show-text: Text {
            text: root.text;
            color: root.fg;
            animate color { duration: Motion.tint(Motion.on ? Motion.med : 0ms); easing: cubic-bezier(0.65, 0, 0.35, 1); }
            font-size: root.compact ? Type.small : Type.body;
            font-weight: 560;
            vertical-alignment: center;
        }
    }
    // Hit-slop: at least 44 x 44 centred on the tab; the compact tabs' hit fills the short header's row.
    property <length> hit-h: root.compact ? 48px : max(44px, root.height);
    property <length> slop-x: max(0px, (44px - root.width) / 2);
    property <length> slop-y: (root.hit-h - root.height) / 2;
    ta := TouchArea {
        x: -root.slop-x;
        y: -root.slop-y;
        width: root.width + 2 * root.slop-x;
        height: root.hit-h;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    ProbeMark {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        id: root.probe;
    }
}

export component NavBar inherits Rectangle {
    in property <string> page: "home";
    // The short header's compact track (DESIGN-MOBILE.md 3.4).
    in property <bool> compact: false;
    // The width the row leaves the bar; the bar steps down until it fits (see the top of this file).
    in property <length> max-w: 100000px;
    callback navigate(string);

    property <bool> ready: false;
    init => { ready-timer.running = true; }
    ready-timer := Timer {
        interval: 50ms;
        running: false;
        triggered => { self.running = false; root.ready = true; }
    }

    // The tier's own choice (before fitting): D hides the icons below 1280 px of window, P's short row is
    // icons only.
    property <bool> base-icon: Breakpoints.tier-d ? !Breakpoints.compact : !(root.compact && Breakpoints.tier-p);
    property <bool> base-text: !root.compact || !Breakpoints.tier-p;
    // Hidden measurers (zero-size, transparent): the label widths at the items' font.
    property <length> font: root.compact ? Type.small : Type.body;
    m-home := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: "Home"; font-size: root.font; font-weight: 560; }
    m-analytics := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: "Analytics"; font-size: root.font; font-weight: 560; }
    m-accounts := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: "Accounts & Settings"; font-size: root.font; font-weight: 560; }
    m-accounts-short := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: "Accounts"; font-size: root.font; font-weight: 560; }
    m-status := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: "Status"; font-size: root.font; font-weight: 560; }
    m-scoreboard := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: "Scoreboard"; font-size: root.font; font-weight: 560; }
    property <length> row-pad: root.compact || !Breakpoints.tier-d ? 2px : 4px;
    // track paddings, four 2 px gaps, and a pixel of slack per item for rounding
    property <length> fixed: 2 * root.row-pad + 4 * 2px + 5px + 5 * 2 * NavMetrics.pad(root.compact);
    property <length> texts-short: m-home.preferred-width + m-analytics.preferred-width + m-accounts-short.preferred-width
        + m-status.preferred-width + m-scoreboard.preferred-width;
    property <length> texts-full: root.texts-short - m-accounts-short.preferred-width + m-accounts.preferred-width;
    // 16 px icon plus the 8 px gap to its label
    property <length> w-full: root.fixed + (root.base-icon ? 5 * 24px : 0px) + root.texts-full;
    property <length> w-short: root.fixed + (root.base-icon ? 5 * 24px : 0px) + root.texts-short;
    property <length> w-bare: root.fixed + root.texts-short;
    // 0 full, 1 short Accounts label, 2 short labels without icons, 3 icons only
    property <int> level: !root.base-text ? 3
        : root.w-full <= root.max-w ? 0
        : root.w-short <= root.max-w ? 1
        : root.w-bare <= root.max-w ? 2 : 3;
    property <bool> icons: root.level == 3 || (root.base-icon && root.level < 2);
    property <bool> texts: root.level < 3;
    property <string> accounts-label: root.level == 0 ? "Accounts & Settings" : "Accounts";

    height: root.compact ? 40px : 44px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.rule-2;
    background: Theme.nav-bg;

    property <length> sel-x: root.page == "analytics" ? analytics.x : root.page == "accounts" ? accounts.x
        : root.page == "status" ? status.x : root.page == "scoreboard" ? scoreboard.x : home.x;
    property <length> sel-w: root.page == "analytics" ? analytics.width : root.page == "accounts" ? accounts.width
        : root.page == "status" ? status.width : root.page == "scoreboard" ? scoreboard.width : home.width;
    indicator := Rectangle {
        x: root.sel-x;
        y: 4px;
        width: root.sel-w;
        height: root.height - 8px;
        border-radius: 8px;
        background: Theme.nav-active;
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        animate x { duration: root.ready && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        animate width { duration: root.ready && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    row := HorizontalLayout {
        padding: root.row-pad;
        spacing: 2px;
        home := NavItem { probe: "nav-home"; icon: "home"; text: "Home"; show-icon: root.icons; show-text: root.texts; selected: root.page == "home"; compact: root.compact; clicked => { root.navigate("home"); } }
        analytics := NavItem { probe: "nav-analytics"; icon: "chart"; text: "Analytics"; show-icon: root.icons; show-text: root.texts; selected: root.page == "analytics"; compact: root.compact; clicked => { root.navigate("analytics"); } }
        accounts := NavItem { probe: "nav-accounts"; icon: "users"; text: root.accounts-label; name: "Accounts & Settings"; show-icon: root.icons; show-text: root.texts; selected: root.page == "accounts"; compact: root.compact; clicked => { root.navigate("accounts"); } }
        status := NavItem { probe: "nav-status"; icon: "activity"; text: "Status"; show-icon: root.icons; show-text: root.texts; selected: root.page == "status"; compact: root.compact; clicked => { root.navigate("status"); } }
        scoreboard := NavItem { probe: "nav-scoreboard"; icon: "trophy"; text: "Scoreboard"; show-icon: root.icons; show-text: root.texts; selected: root.page == "scoreboard"; compact: root.compact; clicked => { root.navigate("scoreboard"); } }
    }
}
