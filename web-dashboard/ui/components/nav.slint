// Primary navigation (appears exactly once): Home, Analytics, Accounts & Settings. The active state is
// one ink Rectangle that glides between items (spring on x, ease-out on width), never a side bar.
import { Theme, Motion, Type, Breakpoints } from "../theme.slint";
import { Icon } from "icon.slint";

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: 8px;
    property <color> fg: root.selected ? Theme.nav-active-fg : ta.has-hover ? Theme.ink : Theme.ink-2;
    transform-scale: ta.pressed ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: Breakpoints.compact ? 12px : 14px;
        padding-right: Breakpoints.compact ? 12px : 14px;
        spacing: 8px;
        if !Breakpoints.compact: VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                tint: root.fg;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            animate color { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
            font-size: Type.body;
            font-weight: 560;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavBar inherits Rectangle {
    in property <string> page: "home";
    callback navigate(string);

    property <bool> ready: false;
    init => { ready-timer.running = true; }
    ready-timer := Timer {
        interval: 50ms;
        running: false;
        triggered => { self.running = false; root.ready = true; }
    }

    height: 44px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.rule-2;
    background: Theme.nav-bg;

    indicator := Rectangle {
        x: root.page == "analytics" ? analytics.x : root.page == "accounts" ? accounts.x : home.x;
        y: 4px;
        width: root.page == "analytics" ? analytics.width : root.page == "accounts" ? accounts.width : home.width;
        height: root.height - 8px;
        border-radius: 8px;
        background: Theme.nav-active;
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        animate x { duration: root.ready && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        animate width { duration: root.ready && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        home := NavItem { icon: "home"; text: "Home"; selected: root.page == "home"; clicked => { root.navigate("home"); } }
        analytics := NavItem { icon: "chart"; text: "Analytics"; selected: root.page == "analytics"; clicked => { root.navigate("analytics"); } }
        accounts := NavItem { icon: "users"; text: "Accounts & Settings"; selected: root.page == "accounts"; clicked => { root.navigate("accounts"); } }
    }
}
