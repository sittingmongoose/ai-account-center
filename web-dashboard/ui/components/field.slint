// Text and password fields for the sign-in layer and settings forms.
import { Theme, Motion, Type } from "../theme.slint";
import { Icon } from "icon.slint";

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> aside;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <bool> bad: false;
    in-out property <string> text;
    callback accepted();
    callback edited(string);
    public function focus-input() { input.focus(); }

    property <bool> revealed: false;
    spacing: 6px;
    HorizontalLayout {
        Text { text: root.label; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; horizontal-stretch: 1; }
        if root.aside != "": Text { text: root.aside; font-size: Type.small; color: Theme.ink-3; horizontal-alignment: right; }
    }
    box := Rectangle {
        height: 40px;
        border-radius: 9px;
        border-width: 1px;
        border-color: root.bad ? Theme.crit : input.has-focus ? Theme.accent : hover.has-hover ? Theme.rule-strong : Theme.rule;
        background: root.enabled ? Theme.paper : Theme.paper-2;
        animate border-color { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.65, 0, 0.35, 1); }
        // focus halo: a wider faint ring (no inset shadows, no blur filters)
        Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 12px;
            border-width: 3px;
            border-color: (root.bad ? Theme.crit : Theme.accent).with-alpha(input.has-focus ? 0.18 : 0);
            animate border-color { duration: Motion.tint(Motion.fast); }
        }
        hover := TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: root.password ? 4px : 12px;
            spacing: 6px;
            input := TextInput {
                text <=> root.text;
                enabled: root.enabled;
                input-type: root.password && !root.revealed ? InputType.password : InputType.text;
                font-size: Type.body;
                color: Theme.ink;
                selection-background-color: Theme.accent.with-alpha(0.25);
                selection-foreground-color: Theme.ink;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
                edited => { root.edited(self.text); }
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    visible: input.text == "";
                    color: Theme.ink-4;
                    font-size: Type.body;
                    vertical-alignment: center;
                }
            }
            if root.password: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 7px;
                    background: eye.has-hover ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
                    Icon { name: root.revealed ? "eye-off" : "eye"; tint: eye.has-hover ? Theme.ink : Theme.ink-3; width: 17px; height: 17px; x: 7.5px; y: 7.5px; }
                    eye := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.revealed = !root.revealed; }
                    }
                }
            }
        }
    }
}
