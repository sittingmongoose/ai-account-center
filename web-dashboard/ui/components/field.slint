// Text and password fields for the sign-in layer and settings forms.
import { Theme, Motion, Type } from "../theme.slint";
import { Icon } from "icon.slint";

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> aside;
    // the aside reads as a confirmation ("Matches"): green with a check
    in property <bool> aside-good: false;
    in property <bool> ok: false;
    in property <length> box-height: 40px;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <bool> bad: false;
    in-out property <string> text;
    callback accepted();
    callback edited(string);
    public function focus-input() { input.focus(); }

    // The sign-in page's login fields are real HTML inputs laid over this box (public/login-bridge.mjs), so password
    // managers can see and fill them. `mirror`: the text is typed there, never here; this TextInput only shows a
    // copy of it (bridge.js set_login_fields) and never takes focus, and a click on the part of the box the HTML
    // input leaves free (beside the eye button) asks for that input with `focus-request`. `covered`: the HTML input
    // is on screen now and draws the text, placeholder and caret, so this field draws none of them. `ext-focus` and
    // `ext-hover` are that input's focus and hover, so the border and the focus halo still answer it.
    in property <bool> mirror: false;
    in property <bool> covered: false;
    in property <bool> ext-focus: false;
    in property <bool> ext-hover: false;
    callback focus-request();
    // the box and its text area in window pixels, for the HTML input laid over them
    out property <length> box-x: box.absolute-position.x;
    out property <length> box-y: box.absolute-position.y;
    out property <length> box-width: box.width;
    out property <length> box-h: box.height;
    out property <length> text-x: viewport.absolute-position.x;
    out property <length> text-y: viewport.absolute-position.y;
    out property <length> text-width: viewport.width;
    out property <length> text-height: viewport.height;
    // the eye button shows the password in plain text
    out property <bool> plain: root.revealed;

    property <bool> revealed: false;
    property <bool> focused: input.has-focus || root.ext-focus;
    spacing: 6px;
    HorizontalLayout {
        Text { text: root.label; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; horizontal-stretch: 1; }
        if root.aside != "" && root.aside-good: HorizontalLayout {
            spacing: 5px;
            horizontal-stretch: 0;
            VerticalLayout { alignment: center; Icon { name: "check"; tint: Theme.good-text; width: 14px; height: 14px; } }
            Text { text: root.aside; font-size: Type.small; font-weight: 560; color: Theme.good-text; vertical-alignment: center; }
        }
        if root.aside != "" && !root.aside-good: Text { text: root.aside; font-size: Type.small; color: Theme.ink-3; horizontal-alignment: right; }
    }
    box := Rectangle {
        height: root.box-height;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.bad ? Theme.crit : root.focused ? Theme.accent : root.ok ? Theme.calm.mix(Theme.rule-strong, 0.7) : hover.has-hover || root.ext-hover ? Theme.ink-3.mix(Theme.rule-strong, 0.4) : Theme.rule-strong;
        background: root.enabled ? Theme.paper : Theme.paper-2;
        opacity: root.enabled ? 1 : 0.72;
        animate opacity { duration: Motion.tint(Motion.med); }
        animate border-color { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.65, 0, 0.35, 1); }
        // focus halo: a wider faint ring (no inset shadows, no blur filters)
        Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: 13px;
            border-width: 3px;
            border-color: (root.bad ? Theme.crit : Theme.accent).with-alpha(root.focused ? 0.18 : 0);
            animate border-color { duration: Motion.tint(Motion.fast); }
        }
        hover := TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                if root.mirror {
                    root.focus-request();
                } else {
                    input.focus();
                }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: root.password ? 4px : 12px;
            spacing: 6px;
            // A raw TextInput neither clips nor scrolls: long text would draw past the box and over the
            // eye button. The viewport clips it to the text area (the layout already reserves the eye
            // button's width plus padding), and the input slides sideways so the caret stays visible,
            // the way std-widgets' LineEdit does via cursor-position-changed.
            viewport := Rectangle {
                clip: true;
                horizontal-stretch: 1;
                input := TextInput {
                    property <length> computed-x;
                    x: min(0px, max(parent.width - self.width - 2px, self.computed-x));
                    width: max(parent.width - 2px, self.preferred-width);
                    height: 100%;
                    text <=> root.text;
                    enabled: root.enabled && !root.mirror;
                    visible: !root.covered;
                    input-type: root.password && !root.revealed ? InputType.password : InputType.text;
                    font-size: Type.body;
                    color: Theme.ink;
                    selection-background-color: Theme.accent.with-alpha(0.25);
                    selection-foreground-color: Theme.ink;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => { root.accepted(); }
                    edited => { root.edited(self.text); }
                    // pos is relative to the input's own top-left, so pos.x + computed-x is the
                    // caret's viewport position. Track it in computed-x (never assign x directly:
                    // the assignment does not stick from this callback) and let the x binding clamp
                    // it: flush at the left edge so Home returns the text to its initial position,
                    // 2 px of air at the right edge, and back to 0 whenever the text fits.
                    cursor-position-changed(pos) => {
                        if pos.x + self.computed-x < 0px {
                            self.computed-x = -pos.x;
                        } else if pos.x + self.computed-x > viewport.width - 2px {
                            self.computed-x = viewport.width - pos.x - 2px;
                        }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.placeholder;
                        visible: input.text == "";
                        color: Theme.ink-4;
                        font-size: Type.body;
                        vertical-alignment: center;
                    }
                }
            }
            if root.password: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 7px;
                    background: eye.has-hover ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
                    Icon { name: root.revealed ? "eye-off" : "eye"; tint: eye.has-hover ? Theme.ink : Theme.ink-3; width: 17px; height: 17px; x: 7.5px; y: 7.5px; }
                    eye := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.revealed = !root.revealed; }
                    }
                }
            }
        }
    }
}
