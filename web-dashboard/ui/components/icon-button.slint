// Square icon button.
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";
import { Icon } from "icon.slint";
import { PlatformGlyph } from "mark.slint";
import { ProbeMark } from "probe.slint";
import { Hover } from "hover-card.slint";

// Square icon button (34 px; 28 px small). `bare` drops the border until hover; `pressed-look` is the
// state of a toggle such as an open menu; `chevron` adds a trailing chevron that flips while pressed.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> platform;
    in property <bool> small: false;
    in property <bool> bare: false;
    in property <bool> chevron: false;
    in property <bool> pressed-look: false;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <color> tint: (ta.has-hover || root.pressed-look) && root.enabled ? Theme.ink : Theme.ink-2;
    // While true the icon spins (one-property loop); on release it eases out to the next rest point.
    in property <bool> spinning: false;
    // drawn dimmed but still clickable (a refusal opens its reason); names the button for the e2e harness
    in property <bool> muted: false;
    in property <string> probe;
    // Touch long-press tip (DESIGN-MOBILE.md 5.2.3): shown after a 450 ms press, which then never activates.
    in property <string> long-tip: "";
    callback clicked();

    // Long-press: touch only (a desktop press-and-hold still clicks on release).
    property <bool> lp-armed: (Device.coarse || Breakpoints.below-d) && root.long-tip != "";
    property <bool> lp-fired: false;
    property <bool> lp-dead: false;
    lp-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            if root.lp-armed && ta.pressed && !root.lp-dead {
                root.lp-fired = true;
                Hover.tip-now("long-press", ta.absolute-position, ta.width, ta.height, root.long-tip);
            }
        }
    }

    property <bool> hovered: ta.has-hover && root.enabled;
    // Below D every icon button is 40 visible with a 44 hit area (DESIGN-MOBILE.md 2.3).
    property <length> side: Breakpoints.tier-d ? (root.small ? 28px : 34px) : 40px;
    property <length> glyph: Breakpoints.tier-d ? (root.small ? 16px : 18px) : root.small ? 18px : 20px;
    property <duration> spin-start: 0ms;
    property <duration> settle-start: 0ms;
    property <angle> settle-from: 0deg;
    property <bool> settling: false;
    property <duration> period: 900ms;
    property <angle> live-angle: root.spinning ? mod((animation-tick() - root.spin-start) / root.period, 1) * 360deg : 0deg;
    property <float> settle-t: root.settling ? clamp((animation-tick() - root.settle-start) / 640ms, 0, 1) : 1;
    property <angle> settle-angle: root.settle-from + (540deg - root.settle-from) * (1 - pow(1 - root.settle-t, 3));
    out property <angle> icon-angle: root.spinning ? root.live-angle : root.settling ? root.settle-angle : 0deg;

    changed spinning => {
        if root.spinning {
            root.settling = false;
            root.spin-start = animation-tick();
        } else if Motion.on {
            root.settle-from = mod((animation-tick() - root.spin-start) / root.period, 1) * 360deg;
            root.settle-start = animation-tick();
            root.settling = true;
            settle-timer.running = true;
        }
    }
    settle-timer := Timer {
        interval: 660ms;
        running: false;
        triggered => { root.settling = false; self.running = false; }
    }

    height: root.side;
    width: root.chevron ? content.preferred-width : root.side;
    border-radius: Breakpoints.tier-d ? (root.small ? 7px : 9px) : Theme.r-touch;
    border-width: 1px;
    background: root.pressed-look ? Theme.paper-3
        : root.bare ? (root.hovered ? Theme.paper-3 : Theme.paper.with-alpha(0))
        : (root.hovered ? Theme.paper-2 : Theme.paper);
    border-color: root.bare ? Theme.rule.with-alpha(0)
        : root.pressed-look || root.hovered ? Theme.rule-strong : Theme.rule;
    opacity: root.enabled && !root.muted ? 1 : 0.45;
    animate background, border-color { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.65, 0, 0.35, 1); }
    transform-scale: ta.pressed && root.enabled ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: button;
    accessible-label: root.hint;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    content := HorizontalLayout {
        padding-left: root.chevron ? 9px : 0px;
        padding-right: root.chevron ? 8px : 0px;
        spacing: 4px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            if root.platform == "": Icon {
                name: root.icon;
                tint: root.tint;
                width: root.glyph;
                height: root.glyph;
                transform-rotation: root.icon-angle;
            }
            if root.platform != "": PlatformGlyph {
                platform: root.platform;
                tint: root.tint;
                width: root.glyph - (root.small ? 2px : 3px);
                height: root.glyph - (root.small ? 2px : 3px);
            }
        }
        if root.chevron: VerticalLayout {
            alignment: center;
            Icon {
                name: "chev-down";
                tint: Theme.ink-3;
                width: 14px;
                height: 14px;
                transform-rotation: root.pressed-look ? 180deg : 0deg;
                animate transform-rotation { duration: Motion.med; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
            }
        }
    }
    // Hit-slop below D: the TouchArea grows to at least 44 x 44, centred on the visual.
    property <length> slop-x: Breakpoints.below-d ? max(0px, (44px - root.width) / 2) : 0px;
    property <length> slop-y: Breakpoints.below-d ? max(0px, (44px - root.height) / 2) : 0px;
    ta := TouchArea {
        x: -root.slop-x;
        y: -root.slop-y;
        width: root.width + 2 * root.slop-x;
        height: root.height + 2 * root.slop-y;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        changed pressed => {
            if self.pressed {
                root.lp-dead = false;
                root.lp-fired = false;
                if root.lp-armed { lp-timer.running = true; }
            } else {
                lp-timer.running = false;
                Hover.leave("long-press");
            }
        }
        moved => {
            if self.pressed && (self.mouse-x > self.pressed-x + 8px || self.mouse-x < self.pressed-x - 8px || self.mouse-y > self.pressed-y + 8px || self.mouse-y < self.pressed-y - 8px) {
                root.lp-dead = true;
                lp-timer.running = false;
                if root.lp-fired { root.lp-fired = false; Hover.leave("long-press"); }
            }
        }
        clicked => {
            if root.lp-fired {
                root.lp-fired = false;
                Hover.leave("long-press");
            } else {
                root.clicked();
            }
        }
    }
    ProbeMark { x: 0px; y: 0px; id: root.probe; width: root.width; height: root.height; }
}
