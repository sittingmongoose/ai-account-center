// Buttons: tint on hover, scale to 0.97 on press (a spring only on this non-value property).
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";
import { Icon } from "icon.slint";
import { PlatformGlyph } from "mark.slint";
import { ProbeMark } from "probe.slint";
import { Hover } from "hover-card.slint";

// kind: "default" | "primary" | "ink" | "accent-line" | "danger" | "danger-solid" | "danger-text" | "ghost"
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    // "apple" | "windows" | "ubuntu": a filled platform glyph instead of a Lucide icon.
    in property <string> platform;
    in property <string> kind: "default";
    in property <bool> small: false;
    // Primary and full-width buttons below D (Sign in, Try again, sheet actions): 44 on T, 48 on F/P.
    in property <bool> tall: false;
    in property <bool> enabled: true;
    in property <string> hint;
    // drawn dimmed but still clickable: the click opens the reason it cannot act (a refusal), never the action
    in property <bool> muted: false;
    // a request runs: a small spinner takes the icon's place and clicks are ignored
    in property <bool> busy: false;
    // Touch long-press tip (DESIGN-MOBILE.md 5.2.3): shown after a 450 ms press, which then never activates.
    in property <string> long-tip: "";
    // names the button for the end-to-end harness (components/probe.slint)
    in property <string> probe;
    callback clicked();

    // Long-press: touch only (a desktop press-and-hold still clicks on release).
    property <bool> lp-armed: (Device.coarse || Breakpoints.below-d) && root.long-tip != "";
    property <bool> lp-fired: false;
    property <bool> lp-dead: false;
    lp-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            if root.lp-armed && ta.pressed && !root.lp-dead {
                root.lp-fired = true;
                Hover.tip-now("long-press", ta.absolute-position, ta.width, ta.height, root.long-tip);
            }
        }
    }

    out property <bool> hovered: ta.has-hover && Device.hover && root.enabled;
    out property <length> pad-left: root.kind == "danger-text" ? 6px : root.kind == "ghost" ? 9px : root.small ? 10px : 13px;
    out property <length> icon-size: root.small ? 15px : 16px;
    out property <length> icon-gap: 7px;

    property <color> fg: root.kind == "primary" ? Theme.accent-ink
        : root.kind == "danger-solid" ? #ffffff
        : root.kind == "ink" ? Theme.paper
        : root.kind == "accent-line" ? Theme.accent-text
        : root.kind == "danger" || root.kind == "danger-text" ? Theme.crit-text
        : root.kind == "ghost" ? (root.hovered ? Theme.ink : Theme.ink-2)
        : Theme.ink;
    property <color> bg: root.kind == "primary" ? (root.hovered ? Theme.accent.mix(Theme.ink, 0.88) : Theme.accent)
        : root.kind == "danger-solid" ? (root.hovered ? Theme.crit.mix(Theme.ink, 0.88) : Theme.crit)
        : root.kind == "ink" ? (root.hovered ? Theme.ink.mix(Theme.paper, 0.86) : Theme.ink)
        : root.kind == "accent-line" ? (root.hovered ? Theme.accent-soft : Theme.paper)
        : root.kind == "danger" ? (root.hovered ? Theme.crit.mix(Theme.paper, 0.08) : Theme.paper)
        : root.kind == "danger-text" ? (root.hovered ? Theme.crit.mix(Theme.paper, 0.08) : Theme.paper.with-alpha(0))
        : root.kind == "ghost" ? (root.hovered ? Theme.paper-3 : Theme.paper.with-alpha(0))
        : (root.hovered ? Theme.paper-2 : Theme.paper);
    property <color> line: root.kind == "primary" ? (root.hovered ? Theme.accent.with-alpha(0) : Theme.accent)
        : root.kind == "danger-solid" ? Theme.crit
        : root.kind == "ink" ? Theme.ink
        : root.kind == "accent-line" ? (root.hovered ? Theme.accent : Theme.accent.mix(Theme.rule, 0.45))
        : root.kind == "danger" ? (root.hovered ? Theme.crit : Theme.rule)
        : root.kind == "danger-text" || root.kind == "ghost" ? Theme.rule.with-alpha(0)
        : (root.hovered ? Theme.rule-strong : Theme.rule);

    // Below D every button is a touch target: default 40 on T and 44 on F/P, tall 44/48.
    height: Breakpoints.tier-d ? (root.small ? 28px : 32px)
        : root.tall ? (Breakpoints.tier-t ? 44px : 48px)
        : Breakpoints.tier-t ? 40px : 44px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: Breakpoints.tier-d ? Theme.r-ctl : Theme.r-touch;
    border-width: 1px;
    background: root.bg;
    border-color: root.line;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.65, 0, 0.35, 1); }
    animate opacity { duration: 200ms; }
    transform-scale: ta.pressed && root.enabled ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    accessible-role: button;
    accessible-label: root.hint == "" ? root.text : root.hint;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    row := HorizontalLayout {
        padding-left: root.pad-left;
        padding-right: root.pad-left;
        spacing: root.icon-gap;
        alignment: center;
        if root.icon != "" && !root.busy: VerticalLayout {
            alignment: center;
            Icon { name: root.icon; tint: root.fg; width: root.icon-size; height: root.icon-size; }
        }
        if root.busy: VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.icon-size;
                height: root.icon-size;
                transform-rotation: mod(animation-tick() / 800ms, 1) * 360deg;
                Path {
                    width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
                    commands: "M12 3 A9 9 0 1 1 11.99 3";
                    stroke: root.fg.with-alpha(0.28); stroke-width: 2.2px; fill: transparent;
                }
                Path {
                    width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
                    commands: "M21 12 A9 9 0 0 0 12 3";
                    stroke: root.fg; stroke-width: 2.2px; stroke-line-cap: round; fill: transparent;
                }
            }
        }
        if root.platform != "": VerticalLayout {
            alignment: center;
            PlatformGlyph { platform: root.platform; tint: root.fg; width: root.icon-size - 1px; height: root.icon-size - 1px; }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.small && Breakpoints.tier-d ? 12.5px : Type.control;
            font-weight: 560;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // Hit-slop below D: the TouchArea grows to at least 44 x 44, centred on the visual.
    property <length> slop-x: Breakpoints.below-d ? max(0px, (44px - root.width) / 2) : 0px;
    property <length> slop-y: Breakpoints.below-d ? max(0px, (44px - root.height) / 2) : 0px;
    ta := TouchArea {
        x: -root.slop-x;
        y: -root.slop-y;
        width: root.width + 2 * root.slop-x;
        height: root.height + 2 * root.slop-y;
        enabled: root.enabled;
        mouse-cursor: root.enabled && !root.busy ? pointer : root.busy ? progress : default;
        changed pressed => {
            if self.pressed {
                root.lp-dead = false;
                root.lp-fired = false;
                if root.lp-armed { lp-timer.running = true; }
            } else {
                lp-timer.running = false;
                // Release hides the tip; clicked (either order) swallows the activation.
                Hover.leave("long-press");
            }
        }
        moved => {
            if self.pressed && (self.mouse-x > self.pressed-x + 8px || self.mouse-x < self.pressed-x - 8px || self.mouse-y > self.pressed-y + 8px || self.mouse-y < self.pressed-y - 8px) {
                root.lp-dead = true;
                lp-timer.running = false;
                if root.lp-fired { root.lp-fired = false; Hover.leave("long-press"); }
            }
        }
        clicked => {
            if root.lp-fired {
                root.lp-fired = false;
                Hover.leave("long-press");
            } else if !root.busy {
                root.clicked();
            }
        }
    }
    ProbeMark { x: 0px; y: 0px; id: root.probe; width: root.width; height: root.height; }
}
