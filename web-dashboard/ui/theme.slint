// Daylight Atlas design tokens for the Slint 1.18.1 dashboard.
//
// Every colour is a light/dark pair mixed by `Theme.mix` (0 = light, 1 = dark). The Dashboard window
// owns one animated float and copies it into `Theme.mix` on every frame of the 300 ms cross-fade
// (globals cannot hold `animate` blocks), so the whole UI cross-fades together.
//
// Motion: Slint has no easing-typed properties, so the three curves are written inline where they
// are used. Their names and values are fixed here so every `animate` block reads the same way:
//   ease-out    cubic-bezier(0.2, 0.8, 0.2, 1)     every value-bearing animation (never overshoots)
//   ease-in-out cubic-bezier(0.65, 0, 0.35, 1)    colour and opacity cross-fades
//   ease-spring cubic-bezier(0.34, 1.45, 0.64, 1) hover lifts, nav indicator, buttons, panels only
//   ease-in     cubic-bezier(0.4, 0, 1, 1)        quick exits
//   spring-panel cubic-bezier(0.32, 1.12, 0.52, 1) the slide-over (its 28 px bleed hides the overshoot)

import "fonts/InstrumentSans.ttf";
import "fonts/InstrumentSansTab.ttf";
import "fonts/MartianMono.ttf";

export global Motion {
    out property <duration> fast: 140ms;
    out property <duration> med: 260ms;
    out property <duration> slow: 520ms;
    out property <duration> draw: 900ms;
    out property <duration> stagger: 32ms;
    out property <duration> theme: 300ms;
    // A meter fill sweep; the count-up uses the same duration so number and bar land together.
    out property <duration> meter: 1050ms;
    // Headless screenshots and prefers-reduced-motion set this; every duration that reads `Motion.on` collapses.
    in-out property <bool> reduced: false;
    out property <bool> on: !reduced;
}

export global Type {
    out property <string> sans: "Instrument Sans";
    // Instrument Sans with OpenType tnum frozen into the cmap: every digit has the same advance.
    out property <string> tab: "Instrument Sans Tab";
    out property <string> mono: "Martian Mono";
    out property <length> caption: 11px;
    out property <length> small: 12px;
    out property <length> body: 13.5px;
    out property <length> control: 13px;
    out property <length> title: 18px;
    out property <length> page-title: 28px;
}

// Named desktop widths: compact < 1280 <= regular < 1600 <= wide < 2200 <= ultra.
export global Breakpoints {
    in-out property <length> width: 1440px;
    out property <bool> compact: width < 1280px;
    out property <bool> regular: width >= 1280px && width < 1600px;
    out property <bool> wide: width >= 1600px && width < 2200px;
    out property <bool> ultra: width >= 2200px;
    out property <bool> at-least-regular: width >= 1280px;
    out property <bool> at-least-wide: width >= 1600px;
    out property <length> gutter: ultra ? 40px : compact ? 24px : 32px;
    out property <length> max-content: 2304px;
}

export global Theme {
    // 0 = Auto (follows the browser), 1 = Light, 2 = Dark.
    in-out property <int> mode: 0;
    // Set by bridge.js from matchMedia('(prefers-color-scheme: dark)') and kept live.
    in-out property <bool> system-dark: false;
    out property <bool> dark: mode == 2 || (mode == 0 && system-dark);
    // Animated by the Dashboard window; 0 light, 1 dark.
    in-out property <float> mix: 0;

    public pure function pick(day: color, night: color) -> color {
        return night.mix(day, clamp(mix, 0, 1));
    }

    // ---- surfaces ----
    out property <color> bg: pick(#ECF0F3, #0C1217);
    out property <color> bg-band: pick(#E6EBEF, #0F161D);
    out property <color> paper: pick(#FBFCFD, #131B23);
    out property <color> paper-2: pick(#F4F7F9, #17212A);
    out property <color> paper-3: pick(#EDF1F4, #1C2731);
    // ---- ink ----
    out property <color> ink: pick(#15202B, #E6ECF2);
    out property <color> ink-2: pick(#445363, #B0BCC8);
    out property <color> ink-3: pick(#63717F, #8794A2);
    out property <color> ink-4: pick(#95A2AE, #5B6876);
    // ---- rules and grid ----
    out property <color> rule: pick(#D8DFE5, #24313D);
    out property <color> rule-2: pick(#E5EAEE, #1D2832);
    out property <color> rule-strong: pick(#B6C1CB, #3A4958);
    out property <color> grid: pick(#E3E8EC, #1D2933);
    out property <color> grid-strong: pick(#CDD6DD, #2B3946);
    out property <color> paper-grid-minor: pick(#15202B09, #E6ECF206);
    out property <color> paper-grid-major: pick(#15202B11, #E6ECF20B);
    // ---- meters ----
    out property <color> track: pick(#E4E9ED, #222E39);
    out property <color> track-hover: pick(#DAE1E7, #2A3845);
    out property <color> track-tick: pick(#F8FAFB, #17212A);
    out property <color> fill-wash: pick(#FFFFFF8C, #0C121780);
    // ---- rows ----
    out property <color> row-hover: pick(#F1F5F8, #18232D);
    out property <color> row-sel: pick(#EAF0FB, #182439);
    out property <color> flash: pick(#DDE8FB, #1E2E4A);
    // ---- accent ----
    out property <color> accent: pick(#2552CC, #86ABFF);
    out property <color> accent-ink: pick(#FFFFFF, #0B1424);
    out property <color> accent-text: pick(#2149B8, #9BBAFF);
    out property <color> accent-soft: pick(#E7EDFB, #1A2742);
    // The selected-row highlight: accent mixed 7% into paper with a 1 px accent outline.
    out property <color> sel-fill: accent.mix(paper, 0.07);
    out property <color> sel-line: accent.mix(rule, 0.55);
    // ---- navigation ----
    out property <color> nav-bg: pick(#E9EEF2, #0F171E);
    out property <color> nav-active: pick(#15202B, #E6ECF2);
    out property <color> nav-active-fg: pick(#FFFFFF, #0F161D);
    // ---- severity ramp (fills) ----
    out property <color> calm: pick(#23907F, #46C7B2);
    out property <color> calm-a: pick(#8ED3C6, #1E7468);
    out property <color> warn: pick(#C98410, #F3B743);
    out property <color> warn-a: pick(#F2CD78, #946311);
    out property <color> crit: pick(#CF4127, #FF6D50);
    out property <color> crit-a: pick(#F3A28A, #A1331F);
    out property <color> over: pick(#8C1D48, #FF5C93);
    // ---- severity ramp (text) ----
    out property <color> calm-text: pick(#15202B, #E6ECF2);
    out property <color> warn-text: pick(#9A6100, #F5C35D);
    out property <color> crit-text: pick(#BC3219, #FF8469);
    out property <color> over-text: pick(#8C1D48, #FF7AA6);
    out property <color> good-text: pick(#1C7D6E, #5AD3BF);
    // ---- elevation (one outer shadow per rectangle; no inset, no spread) ----
    out property <color> shadow-1: pick(#15202B12, #00000059);
    out property <color> shadow-2: pick(#15202B21, #00000073);
    out property <color> shadow-pop: pick(#15202B2E, #0000008C);
    out property <color> scrim: pick(#15202B24, #03070B61);
    // ---- marks ----
    // Hairline outline for white-only artwork on light surfaces (none ship today; kept for marks.js parity).
    out property <color> mark-outline: pick(#C3CCD5, #00000000);
    // ---- tooltips ----
    out property <color> tip-bg: pick(#15202B, #E6ECF2);
    out property <color> tip-fg: pick(#F2F5F8, #101820);
    // ---- heatmap ----
    out property <color> heat-0: pick(#EEF2F6, #17212A);
    out property <color> heat-1: pick(#1F4FC2, #8FB2FF);
    // ---- provider identity hues (charts only, never on marks) ----
    out property <color> h-claude: pick(#C25E3B, #E88D69);
    out property <color> h-codex: pick(#2E3B4A, #D3DBE4);
    out property <color> h-codex-2: pick(#6A7A8C, #93A2B2);
    out property <color> h-codex-3: pick(#A3B0BE, #5E6D7D);
    out property <color> h-antigravity: pick(#3A77E0, #7AA6F7);
    out property <color> h-cursor: pick(#6B665C, #BDB7AA);
    out property <color> h-muse: pick(#0B5FD3, #5C9DFF);
    out property <color> h-kimi-code: pick(#2C8DFF, #7DBBFF);
    out property <color> h-qwen: pick(#4B3EEF, #9C94FF);
    out property <color> h-zai: pick(#4C5A6C, #AAB6C4);
    out property <color> h-opencode-go: pick(#7A716A, #C4BBB2);
    // ---- chart palette: one colour per token type, plus cost ----
    out property <color> chart-tokens: pick(#2552CC, #86ABFF);
    out property <color> chart-input: pick(#0E8A8C, #3CC8C0);
    out property <color> chart-output: pick(#7A4CD9, #B18EFF);
    out property <color> chart-cache-write: pick(#D2468A, #FF7DB4);
    out property <color> chart-cache-read: pick(#5C86B8, #7FA3D2);
    out property <color> chart-cost: pick(#15202B, #E6ECF2);

    // Radii
    out property <length> r-plate: 14px;
    out property <length> r-card: 12px;
    out property <length> r-ctl: 8px;

    // Severity from a used percentage: -1 unavailable, 0 calm (< 80), 1 warning (80-95), 2 critical (95-100), 3 over.
    public pure function severity(has-value: bool, used: float) -> int {
        if !has-value { return -1; }
        if used > 100 { return 3; }
        if used >= 95 { return 2; }
        if used >= 80 { return 1; }
        return 0;
    }
    public pure function sev-fill(sev: int) -> color {
        if sev == 3 || sev == 2 { return crit; }
        if sev == 1 { return warn; }
        return calm;
    }
    public pure function sev-text(sev: int) -> color {
        if sev == 3 { return over-text; }
        if sev == 2 { return crit-text; }
        if sev == 1 { return warn-text; }
        if sev == -1 { return ink-3; }
        return calm-text;
    }
    public pure function provider-hue(id: string) -> color {
        if id == "claude" { return h-claude; }
        if id == "codex" { return h-codex; }
        if id == "antigravity" { return h-antigravity; }
        if id == "cursor" { return h-cursor; }
        if id == "muse" { return h-muse; }
        if id == "kimi-code" { return h-kimi-code; }
        if id == "qwen" { return h-qwen; }
        if id == "zai" { return h-zai; }
        if id == "opencode-go" { return h-opencode-go; }
        return ink-3;
    }
}
