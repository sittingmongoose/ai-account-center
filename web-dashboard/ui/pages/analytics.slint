// Analytics (Daylight Atlas): rebuilt around Usage, the original CCS analytics page improved. Order: header,
// KPI row, usage trends, then cost by model, model usage, session stats, token breakdown, cache efficiency,
// the weekday x hour heatmap and daily cost by provider (3 columns from 1600 px, 2 below), then the compact
// quota history and, at the very bottom, upcoming resets and expiries. Every value comes from the version 7
// analytics view model in AxData (pages/analytics/ax-data.slint); see README-ARCHITECTURE.md.
import { Theme, Motion, Type, Breakpoints } from "../theme.slint";
import { AxData, AxLoadHost } from "analytics/ax-data.slint";
import { AxReveal, AxCard, AxCardHead } from "analytics/ax-common.slint";
import { Skeleton } from "../components/skeleton.slint";
import { AxHeader, AxKpiRow } from "analytics/ax-head.slint";
import { AxTrendCard } from "analytics/ax-trend.slint";
import { AxCbmCard, AxDonutCard } from "analytics/ax-models.slint";
import { AxSessionsCard, AxRecentCard, AxTokensCacheCard } from "analytics/ax-stats.slint";
import { AxHeatCard, AxDailyCard } from "analytics/ax-time.slint";
import { AxQuotaCard } from "analytics/ax-quota.slint";
import { AxAgendaCard } from "analytics/ax-agenda.slint";

export { AxData }

export component AnalyticsPage inherits Rectangle {
    // the page scroll offset and the window height: a section plays its first view once it is on screen
    in property <length> scroll;
    in property <length> view-bottom;
    in property <length> win-h: 900px;
    // sections rise in once the first response arrives (or fails: the header then says why)
    property <bool> armed: AxData.ready || AxData.head.error != "";
    // the loading screen's per-host rows; a quiet default until the first answer pushes real progress
    property <[AxLoadHost]> load-hosts: AxData.load-hosts.length > 0 ? AxData.load-hosts : [{ name: "Ubuntu", detail: "queued" }, { name: "Mac", detail: "queued" }, { name: "Windows", detail: "queued" }];
    property <bool> wide3: Breakpoints.width >= 1600px;
    // section gap: 18 on D, 20/16/12 on T/F/P (DESIGN-MOBILE 2.2)
    property <length> gap: Breakpoints.tier-d ? 18px : Breakpoints.tier-t ? 20px : Breakpoints.tier-f ? 16px : 12px;
    // content width below D (every card below D spans it except the T trio/pair)
    property <length> cw: Breakpoints.tier-width - 2 * Breakpoints.gutter;
    // first-view memory for the chart grid (it is laid out again when it changes column count)
    property <bool> s-cbm;
    property <bool> s-donut;
    property <bool> s-sess;
    property <bool> s-tokcache;
    property <bool> s-recent;
    property <bool> s-heat;
    property <bool> s-daily;

    min-height: page.preferred-height;
    preferred-height: page.preferred-height;

    page := VerticalLayout {
        spacing: 0px;
        AxReveal { armed: true; scroll: root.scroll; view-bottom: root.view-bottom; delay: 40ms; AxHeader { } }
        Rectangle { height: 20px; }
        // Before the first useful answer lands (held by the view model until there are numbers to
        // show or a settled failure to explain): skeleton cards with a calm shimmer and one row per
        // computer saying how far its scan is ("2 of 5 tools · scanning now"), so the page never
        // sits blank or looks broken while the logs are still being read. Concept: the .skel sweep
        // in styles.css.
        if !root.armed: VerticalLayout {
            spacing: 18px;
            AxCard {
                hover-lift: false;
                AxCardHead { title: "Reading usage logs"; sub: "Reading usage logs on Ubuntu, Mac and Windows. The page appears as soon as the first numbers land."; }
                VerticalLayout {
                    padding-left: 20px; padding-right: 20px; padding-top: 6px; padding-bottom: 18px; spacing: 12px;
                    for host in root.load-hosts: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: host.name; font-size: 12.5px; font-weight: 600; color: Theme.ink-2; vertical-alignment: center; }
                            Text { text: host.detail; font-family: Type.tab; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                        Skeleton { active: true; height: 12px; }
                    }
                }
            }
            AxCard {
                hover-lift: false;
                VerticalLayout {
                    padding-left: 20px; padding-right: 20px; padding-top: 18px; padding-bottom: 18px; spacing: 10px;
                    Skeleton { active: true; height: 64px; }
                    Skeleton { active: true; height: 12px; }
                }
            }
        }
        kpis := AxReveal {
            armed: root.armed;
            scroll: root.scroll;
            view-bottom: root.view-bottom;
            delay: 80ms;
            AxKpiRow { played: kpis.seen; delay: kpis.play-delay - 40ms; }
        }
        Rectangle { height: 18px; }
        trend := AxReveal {
            armed: root.armed;
            scroll: root.scroll;
            view-bottom: root.view-bottom;
            delay: 120ms;
            AxTrendCard { played: trend.seen; delay: trend.play-delay; win-h: root.win-h; }
        }
        Rectangle { height: 18px; }
        if Breakpoints.tier-d && root.wide3: VerticalLayout {
            spacing: root.gap;
            HorizontalLayout {
                spacing: root.gap;
                cbm3 := AxReveal {
                    horizontal-stretch: 2; preferred-width: root.gap; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 160ms; already: root.s-cbm;
                    changed seen => { if self.seen { root.s-cbm = true; } }
                    AxCbmCard { played: cbm3.seen; delay: cbm3.play-delay; vertical-stretch: 1; }
                }
                donut3 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 192ms; already: root.s-donut;
                    changed seen => { if self.seen { root.s-donut = true; } }
                    AxDonutCard { played: donut3.seen; delay: donut3.play-delay; vertical-stretch: 1; }
                }
            }
            HorizontalLayout {
                spacing: root.gap;
                sess3 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 224ms; already: root.s-sess;
                    changed seen => { if self.seen { root.s-sess = true; } }
                    AxSessionsCard { played: sess3.seen; delay: sess3.play-delay; vertical-stretch: 1; }
                }
                recent3 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 256ms; already: root.s-recent;
                    changed seen => { if self.seen { root.s-recent = true; } }
                    AxRecentCard { played: recent3.seen; delay: recent3.play-delay; vertical-stretch: 1; }
                }
                tokcache3 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 288ms; already: root.s-tokcache;
                    changed seen => { if self.seen { root.s-tokcache = true; } }
                    AxTokensCacheCard { played: tokcache3.seen; delay: tokcache3.play-delay; vertical-stretch: 1; }
                }
            }
            HorizontalLayout {
                spacing: root.gap;
                heat3 := AxReveal {
                    horizontal-stretch: 2; preferred-width: root.gap; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 320ms; already: root.s-heat;
                    changed seen => { if self.seen { root.s-heat = true; } }
                    AxHeatCard { played: heat3.seen; delay: heat3.play-delay; win-h: root.win-h; vertical-stretch: 1; }
                }
                daily3 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 352ms; already: root.s-daily;
                    changed seen => { if self.seen { root.s-daily = true; } }
                    AxDailyCard { played: daily3.seen; delay: daily3.play-delay; win-h: root.win-h; vertical-stretch: 1; }
                }
            }
        }
        if Breakpoints.tier-d && !root.wide3: VerticalLayout {
            spacing: root.gap;
            cbm2 := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 160ms; already: root.s-cbm;
                    changed seen => { if self.seen { root.s-cbm = true; } }
                    AxCbmCard { played: cbm2.seen; delay: cbm2.play-delay; }
                }
            HorizontalLayout {
                spacing: root.gap;
                donut2 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 192ms; already: root.s-donut;
                    changed seen => { if self.seen { root.s-donut = true; } }
                    AxDonutCard { played: donut2.seen; delay: donut2.play-delay; vertical-stretch: 1; }
                }
                sess2 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 224ms; already: root.s-sess;
                    changed seen => { if self.seen { root.s-sess = true; } }
                    AxSessionsCard { played: sess2.seen; delay: sess2.play-delay; vertical-stretch: 1; }
                }
            }
            HorizontalLayout {
                spacing: root.gap;
                recent2 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 256ms; already: root.s-recent;
                    changed seen => { if self.seen { root.s-recent = true; } }
                    AxRecentCard { played: recent2.seen; delay: recent2.play-delay; vertical-stretch: 1; }
                }
                tokcache2 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 288ms; already: root.s-tokcache;
                    changed seen => { if self.seen { root.s-tokcache = true; } }
                    AxTokensCacheCard { played: tokcache2.seen; delay: tokcache2.play-delay; vertical-stretch: 1; }
                }
            }
            heat2 := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 320ms; already: root.s-heat;
                    changed seen => { if self.seen { root.s-heat = true; } }
                    AxHeatCard { played: heat2.seen; delay: heat2.play-delay; win-h: root.win-h; }
                }
            daily2 := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 352ms; already: root.s-daily;
                    changed seen => { if self.seen { root.s-daily = true; } }
                    AxDailyCard { played: daily2.seen; delay: daily2.play-delay; win-h: root.win-h; spans: true; }
                }
        }
        // P/F: everything stacked (DESIGN-MOBILE 4.2.6)
        if Breakpoints.tier-p || Breakpoints.tier-f: VerticalLayout {
            spacing: root.gap;
            cbm-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 160ms; already: root.s-cbm;
                    changed seen => { if self.seen { root.s-cbm = true; } }
                    AxCbmCard { played: cbm-p.seen; delay: cbm-p.play-delay; }
                }
            donut-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 192ms; already: root.s-donut;
                    changed seen => { if self.seen { root.s-donut = true; } }
                    AxDonutCard { played: donut-p.seen; delay: donut-p.play-delay; }
                }
            sess-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 224ms; already: root.s-sess;
                    changed seen => { if self.seen { root.s-sess = true; } }
                    AxSessionsCard { played: sess-p.seen; delay: sess-p.play-delay; cell-w: root.cw; }
                }
            recent-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 256ms; already: root.s-recent;
                    changed seen => { if self.seen { root.s-recent = true; } }
                    AxRecentCard { played: recent-p.seen; delay: recent-p.play-delay; cell-w: root.cw; }
                }
            tokcache-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 288ms; already: root.s-tokcache;
                    changed seen => { if self.seen { root.s-tokcache = true; } }
                    AxTokensCacheCard { played: tokcache-p.seen; delay: tokcache-p.play-delay; cell-w: root.cw; }
                }
            heat-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 320ms; already: root.s-heat;
                    changed seen => { if self.seen { root.s-heat = true; } }
                    AxHeatCard { played: heat-p.seen; delay: heat-p.play-delay; win-h: root.win-h; }
                }
            daily-p := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 352ms; already: root.s-daily;
                    changed seen => { if self.seen { root.s-daily = true; } }
                    AxDailyCard { played: daily-p.seen; delay: daily-p.play-delay; win-h: root.win-h; spans: true; }
                }
        }
        // T: the desktop arrangement with the trio rule (three in a row from a 960 content width,
        // otherwise sessions + recent side by side over a full-width tokens card)
        if Breakpoints.tier-t: VerticalLayout {
            spacing: root.gap;
            property <bool> trio: root.cw >= 960px;
            cbm-t := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 160ms; already: root.s-cbm;
                    changed seen => { if self.seen { root.s-cbm = true; } }
                    AxCbmCard { played: cbm-t.seen; delay: cbm-t.play-delay; }
                }
            donut-t := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 192ms; already: root.s-donut;
                    changed seen => { if self.seen { root.s-donut = true; } }
                    AxDonutCard { played: donut-t.seen; delay: donut-t.play-delay; }
                }
            if self.trio: HorizontalLayout {
                spacing: root.gap;
                sess-t := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 224ms; already: root.s-sess;
                    changed seen => { if self.seen { root.s-sess = true; } }
                    AxSessionsCard { played: sess-t.seen; delay: sess-t.play-delay; vertical-stretch: 1; cell-w: (root.cw - 2 * root.gap) / 3; }
                }
                recent-t := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 256ms; already: root.s-recent;
                    changed seen => { if self.seen { root.s-recent = true; } }
                    AxRecentCard { played: recent-t.seen; delay: recent-t.play-delay; vertical-stretch: 1; cell-w: (root.cw - 2 * root.gap) / 3; }
                }
                tokcache-t := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 288ms; already: root.s-tokcache;
                    changed seen => { if self.seen { root.s-tokcache = true; } }
                    AxTokensCacheCard { played: tokcache-t.seen; delay: tokcache-t.play-delay; vertical-stretch: 1; cell-w: (root.cw - 2 * root.gap) / 3; }
                }
            }
            if !self.trio: HorizontalLayout {
                spacing: root.gap;
                sess-t2 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 224ms; already: root.s-sess;
                    changed seen => { if self.seen { root.s-sess = true; } }
                    AxSessionsCard { played: sess-t2.seen; delay: sess-t2.play-delay; vertical-stretch: 1; cell-w: (root.cw - root.gap) / 2; }
                }
                recent-t2 := AxReveal {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 256ms; already: root.s-recent;
                    changed seen => { if self.seen { root.s-recent = true; } }
                    AxRecentCard { played: recent-t2.seen; delay: recent-t2.play-delay; vertical-stretch: 1; cell-w: (root.cw - root.gap) / 2; }
                }
            }
            if !self.trio: tokcache-t2 := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 288ms; already: root.s-tokcache;
                    changed seen => { if self.seen { root.s-tokcache = true; } }
                    AxTokensCacheCard { played: tokcache-t2.seen; delay: tokcache-t2.play-delay; cell-w: root.cw; }
                }
            heat-t := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 320ms; already: root.s-heat;
                    changed seen => { if self.seen { root.s-heat = true; } }
                    AxHeatCard { played: heat-t.seen; delay: heat-t.play-delay; win-h: root.win-h; }
                }
            daily-t := AxReveal {
                    armed: root.armed; scroll: root.scroll; view-bottom: root.view-bottom; delay: 352ms; already: root.s-daily;
                    changed seen => { if self.seen { root.s-daily = true; } }
                    AxDailyCard { played: daily-t.seen; delay: daily-t.play-delay; win-h: root.win-h; spans: true; }
                }
        }
        Rectangle { height: Breakpoints.tier-d ? 18px : root.gap; }
        quota := AxReveal {
            armed: root.armed;
            scroll: root.scroll;
            view-bottom: root.view-bottom;
            delay: 384ms;
            AxQuotaCard { played: quota.seen; delay: quota.play-delay; cell-w: root.cw; }
        }
        Rectangle { height: Breakpoints.tier-d ? 18px : root.gap; }
        agenda := AxReveal {
            armed: root.armed;
            scroll: root.scroll;
            view-bottom: root.view-bottom;
            delay: 416ms;
            AxAgendaCard { played: agenda.seen; delay: agenda.play-delay; cell-w: root.cw; }
        }
    }
}
