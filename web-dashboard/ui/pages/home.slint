// Home: the Claude section, the switchable Codex and Antigravity sections and the other providers as
// cards, built like the Daylight Atlas concept's Home (c-daylight-atlas/app-home.js, app-active.js and
// styles.css). Every number, label and "unavailable" decision arrives in the view model
// (public/view-model.mjs); this file only lays out and animates it.
//
// Column fitting: in each section the account column is as wide as its widest content (each email in
// its bold active weight, the meta line, the credits line) clamped to 150-320 px, the actions column as
// wide as its widest actions, and the meter columns share the rest equally. Every row reports its
// natural widths and the section keeps the largest.
import { Theme, Motion, Type, Breakpoints } from "../theme.slint";
import { SectionView, AccountRowView, ProviderCardView, MeterView, ColumnView, RunView, AmountView } from "../models.slint";
import { Icon } from "../components/icon.slint";
import { ProviderMark } from "../components/mark.slint";
import { Caps, ValueUnit } from "../components/text.slint";
import { Button } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";
import { Toggle } from "../components/toggle.slint";
import { Meter } from "../components/meter.slint";
import { Plate, Card } from "../components/card.slint";
import { Reveal } from "../components/reveal.slint";
import { Hover } from "../components/hover-card.slint";
import { MenuPanel } from "../components/menu.slint";

// A line that mixes weights ("**4** accounts · desktop profiles"). The "good" tone is the active
// account's name; "warn" is a warning figure.
export component Runs inherits HorizontalLayout {
    in property <[RunView]> runs;
    in property <length> size: 12.5px;
    in property <color> ink: Theme.ink-3;
    in property <color> strong-ink: Theme.ink;
    in property <int> weight: 400;
    in property <int> strong-weight: 600;
    in property <bool> tabular: false;
    spacing: 0px;
    alignment: start;
    for r in root.runs: Text {
        text: r.text;
        font-family: root.tabular ? Type.tab : Type.sans;
        font-size: root.size;
        font-weight: r.strong ? (r.tone == "good" ? 600 : root.strong-weight) : root.weight;
        color: r.tone == "good" ? Theme.good-text : r.tone == "warn" ? Theme.warn-text : r.strong ? root.strong-ink : root.ink;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
}

// The filled check-circle. On a switch the disc grows from 60% and the check is revealed left to right
// by a clip whose width animates (the chart draw-on technique; no animated dashes). Ease-out only.
export component CheckMark inherits Rectangle {
    in property <length> size: 15px;
    in property <bool> drawn: true;
    width: root.size;
    height: root.size;
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: Theme.accent;
        transform-scale: root.drawn ? 1 : 0.6;
        animate transform-scale {
            duration: Motion.on ? (root.drawn ? 300ms : 160ms) : 0ms;
            delay: Motion.on ? (root.drawn ? 180ms : 40ms) : 0ms;
            easing: cubic-bezier(0.2, 0.8, 0.2, 1);
        }
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.drawn ? root.size : 0px;
        height: root.size;
        clip: true;
        animate width {
            duration: Motion.on && root.drawn ? 340ms : 0ms;
            delay: Motion.on ? (root.drawn ? 320ms : 200ms) : 0ms;
            easing: cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        Path {
            x: 0px;
            y: 0px;
            width: root.size;
            height: root.size;
            viewbox-width: 20;
            viewbox-height: 20;
            commands: "M5.7 10.3 L8.6 13.2 L14.4 7.2";
            stroke: Theme.accent-ink;
            stroke-width: root.size * 2.3 / 20;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }
}

// "Active" in the Activate button's slot: a plain check-circle and the word, "on Ubuntu" under the word.
// No border, fill or button shape. It is laid out on the Activate button's own grid: the check is
// inset by the button's left padding and takes the button icon's size, and the word starts after the
// button's icon gap, so the check lands on the button icon's x and "Active" on the label's x.
export component ActiveMark inherits Rectangle {
    in property <string> where;
    in property <bool> on;
    in property <length> inset: 10px;
    in property <length> icon: 15px;
    in property <length> gap: 7px;
    property <length> text-x: root.inset + root.icon + root.gap;
    preferred-width: root.text-x + max(word.preferred-width, sub.preferred-width);
    min-width: self.preferred-width;
    preferred-height: word.preferred-height + 1px + sub.preferred-height;
    min-height: self.preferred-height;
    opacity: root.on ? 1 : 0;
    animate opacity { duration: Motion.on ? 180ms : 0ms; delay: Motion.on && root.on ? 140ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    Rectangle {
        y: root.on ? 0px : 3px;
        animate y { duration: Motion.on ? Motion.med : 0ms; delay: Motion.on && root.on ? 140ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        CheckMark {
            x: root.inset;
            y: (word.preferred-height - root.icon) / 2;
            size: root.icon;
            drawn: root.on;
        }
        word := Text {
            x: root.text-x;
            y: 0px;
            text: "Active";
            font-size: 13px;
            font-weight: 640;
            color: Theme.accent-text;
        }
        sub := Text {
            x: root.text-x;
            y: word.preferred-height + 1px;
            text: root.where;
            font-size: Type.small;
            color: Theme.ink-3;
        }
    }
}

// The fixed action slot of a switchable row: the Activate button and the Active mark stacked in one
// cell on its start edge. They cross-fade (the button fades back in after the mark leaves), so the slot
// never changes width on a switch.
export component SwitchSlot inherits Rectangle {
    in property <AccountRowView> account;
    in property <bool> can-switch;
    in property <bool> busy;
    callback activate();
    callback finish-setup();
    property <bool> show-button: root.can-switch && !root.account.active && !root.account.setup;
    out property <length> natural: max(root.can-switch ? btn.preferred-width : 0px, mark.preferred-width, root.account.setup ? setup-btn.preferred-width : 0px);
    preferred-height: max(28px, mark.preferred-height);
    min-height: self.preferred-height;

    btn-wrap := Rectangle {
        x: 0px;
        y: (parent.height - btn.height) / 2;
        width: btn.preferred-width;
        height: btn.height;
        visible: root.can-switch && !root.account.setup;
        opacity: root.show-button ? 1 : 0;
        transform-scale: root.show-button ? 1 : 0.94;
        animate opacity { duration: Motion.on ? 220ms : 0ms; delay: Motion.on && root.show-button ? 160ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        animate transform-scale { duration: Motion.on ? Motion.fast : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        btn := Button {
            x: 0px;
            y: 0px;
            width: self.preferred-width;
            small: true;
            kind: "accent-line";
            icon: "swap";
            text: "Activate";
            enabled: root.show-button && root.account.can-activate && !root.busy;
            hint: root.account.activate-hint;
            clicked => { root.activate(); }
        }
    }
    mark := ActiveMark {
        x: 0px;
        y: (parent.height - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        inset: btn.pad-left;
        icon: btn.icon-size;
        gap: btn.icon-gap;
        on: root.account.active && !root.account.setup;
        where: root.account.active-label != "" ? root.account.active-label : "on " + root.account.platform;
    }
    setup-btn := Button {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: self.preferred-width;
        visible: root.account.setup;
        small: true;
        kind: "accent-line";
        icon: "terminal";
        text: "Finish setup";
        clicked => { root.finish-setup(); }
    }
}

// The inline question before activating an account that is already past the switch point. It opens
// below its row with an animated height and a content fade.
component ConfirmLine inherits Rectangle {
    in property <[RunView]> runs;
    in property <bool> open;
    in property <bool> busy;
    callback keep();
    callback confirm();
    property <length> natural: line.preferred-height;
    height: root.open ? root.natural : 0px;
    animate height { duration: Motion.on ? (root.open ? Motion.med : 200ms) : 0ms; easing: root.open ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1); }
    clip: true;
    background: Theme.warn.mix(Theme.paper, 0.07);
    line := HorizontalLayout {
        y: 0px;
        height: root.natural;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Motion.on ? (root.open ? Motion.med : 160ms) : 0ms; delay: Motion.on && root.open ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon { name: "alert"; tint: Theme.warn-text; width: 16px; height: 16px; }
        }
        // The figure in bold, then the sentence, which wraps when the section is narrow.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            for r[i] in root.runs: Text {
                text: r.text;
                font-size: 12.5px;
                font-weight: r.strong ? 640 : 400;
                color: r.tone == "warn" ? Theme.warn-text : r.strong ? Theme.ink : Theme.ink-2;
                wrap: r.strong ? no-wrap : word-wrap;
                vertical-alignment: center;
                horizontal-stretch: r.strong ? 0 : 1;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button { kind: "ghost"; small: true; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button { kind: "accent-line"; small: true; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
        }
    }
    Rectangle { y: root.height - 1px; height: 1px; background: Theme.rule-2; }
}

export component AccountRow inherits Rectangle {
    in property <AccountRowView> account;
    in property <SectionView> section;
    in property <length> ident-w;
    in property <length> slot-w;
    in property <length> gap: 20px;
    in property <bool> played;
    // load-in: the delay of this row's first meter (rows one and a half staggers apart)
    in property <duration> delay;
    in property <int> index;
    in property <bool> last;
    in property <bool> round-bottom;
    in property <bool> busy;
    in property <bool> selected;
    in property <bool> confirming;
    in property <float> notch-at: -1;
    callback open-details(string);
    callback launch(string, string);
    callback activate(string, string);
    callback ask-confirm(string);
    callback cancel-confirm();
    callback go-accounts();
    out property <bool> hovered: ta.has-hover;
    out property <length> line-height: line.height;
    // The widths this row needs: the account column (mark, gap, widest text in the active weight, slack)
    // and the actions column.
    out property <length> ident-natural: 22px + 12px + max(email-probe.preferred-width, meta.preferred-width, amounts.preferred-width) + 12px;
    out property <length> slot-natural: root.section.switchable ? sw.natural : 28px + 6px + 28px;

    // a soft highlight for 600 ms when a reading changed on refresh
    out property <bool> flashing: root.flash-phase == 1;
    property <int> flash-phase: 0;
    flash-on := Timer {
        interval: 30ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 2; flash-off.running = true; }
    }
    flash-off := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 0; }
    }
    function flash() {
        if Motion.on {
            root.flash-phase = 1;
            flash-on.running = true;
        }
    }

    min-height: body.min-height;
    preferred-height: body.preferred-height;

    email-probe := Text {
        visible: false;
        text: root.account.email;
        font-size: Type.body;
        font-weight: 640;
    }

    body := VerticalLayout {
        spacing: 0px;
        line := Rectangle {
            min-height: max(72px, row-layout.min-height);
            preferred-height: max(72px, row-layout.preferred-height);
            vertical-stretch: 1;
            border-bottom-left-radius: root.round-bottom ? Theme.r-plate - 1px : 0px;
            border-bottom-right-radius: root.round-bottom ? Theme.r-plate - 1px : 0px;
            background: root.account.active && root.section.switchable ? Theme.row-hover.with-alpha(0)
                : root.flash-phase == 1 ? Theme.flash
                : root.selected ? Theme.row-sel
                : ta.pressed ? Theme.row-hover.mix(Theme.rule, 0.7)
                : ta.has-hover ? Theme.row-hover
                : Theme.row-hover.with-alpha(0);
            animate background {
                duration: Motion.tint(root.flash-phase == 1 ? 0ms : root.flash-phase == 2 ? 620ms : 180ms);
                easing: root.flash-phase == 2 ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1);
            }

            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-details(root.account.id); }
                row-layout := HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: root.gap;
                    HorizontalLayout {
                        width: root.ident-w;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            ProviderMark { provider: root.account.provider; size: 22px; dim: root.account.setup; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                min-height: 19.5px;
                                vertical-alignment: center;
                                text: root.account.email;
                                font-size: Type.body;
                                font-weight: root.account.active && root.section.switchable ? 640 : 520;
                                color: root.section.switchable && !root.account.active ? Theme.ink-2 : Theme.ink;
                                overflow: elide;
                            }
                            Rectangle { height: 1px; }
                            meta := Text {
                                min-height: 17.5px;
                                vertical-alignment: center;
                                text: root.account.meta;
                                font-size: Type.small;
                                color: Theme.ink-3;
                                overflow: elide;
                            }
                            amounts := Runs {
                                padding-top: root.account.amounts-runs.length > 0 ? 2px : 0px;
                                min-height: root.account.amounts-runs.length > 0 ? 19.5px : 0px;
                                runs: root.account.amounts-runs;
                                size: Type.small;
                                ink: Theme.ink-3;
                                strong-ink: Theme.ink-2;
                                strong-weight: 560;
                                tabular: true;
                            }
                        }
                    }
                    for cell[c] in root.account.cells: Rectangle {
                        min-width: 108px;
                        preferred-width: 108px;
                        horizontal-stretch: 1;
                        min-height: cell.key != "" ? m.preferred-height : 0px;
                        preferred-height: self.min-height;
                        m := Meter {
                            y: (parent.height - self.preferred-height) / 2;
                            width: parent.width;
                            height: self.preferred-height;
                            visible: cell.key != "";
                            data: cell;
                            played: root.played;
                            delay: root.delay + c * 16ms;
                            hot: root.hovered;
                            notch-override: root.notch-at;
                            owner-label: root.section.label + " · " + root.account.email;
                            clicked => { root.open-details(root.account.id); }
                            value-changed => { root.flash(); }
                        }
                    }
                    slot := Rectangle {
                        width: root.slot-w;
                        min-height: root.section.switchable ? sw.preferred-height : 28px;
                        if !root.section.switchable: HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    platform: "apple";
                                    small: true;
                                    enabled: root.account.can-mac && !root.busy;
                                    hint: root.account.can-mac ? "Open on Mac" : "Open on Mac is unavailable for this profile";
                                    clicked => { root.launch(root.account.profile, "mac"); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    platform: "windows";
                                    small: true;
                                    enabled: root.account.can-windows && !root.busy;
                                    hint: root.account.can-windows ? "Open on Windows" : "Open on Windows is unavailable for this profile";
                                    clicked => { root.launch(root.account.profile, "windows"); }
                                }
                            }
                        }
                        sw := SwitchSlot {
                            x: 0px;
                            y: (parent.height - self.preferred-height) / 2;
                            width: parent.width;
                            height: self.preferred-height;
                            visible: root.section.switchable;
                            account: root.account;
                            can-switch: root.section.can-switch;
                            busy: root.busy;
                            activate => {
                                if root.account.confirm {
                                    root.ask-confirm(root.account.id);
                                } else {
                                    root.activate(root.account.activate-kind, root.account.profile);
                                }
                            }
                            finish-setup => { root.go-accounts(); }
                        }
                    }
                }
            }
            // the hairline under every row but the last
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.rule-2;
                visible: !root.last;
            }
        }
        if root.account.confirm: ConfirmLine {
            runs: root.account.confirm-runs;
            open: root.confirming;
            busy: root.busy;
            keep => { root.cancel-confirm(); }
            confirm => {
                root.cancel-confirm();
                root.activate(root.account.activate-kind, root.account.profile);
            }
        }
    }
}

// The legend that used to be a permanent strip, behind one "?".
component LegendRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> note;
    in property <int> swatch: 0;
    spacing: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    Rectangle {
        width: 30px;
        if root.swatch >= 0: Rectangle {
            y: (parent.height - 8px) / 2;
            height: 8px;
            border-radius: 4px;
            background: root.swatch == 3 ? Theme.over : Theme.sev-fill(root.swatch);
            Rectangle {
                border-radius: 4px;
                background: @linear-gradient(90deg, Theme.fill-wash 0%, Theme.fill-wash.with-alpha(0) 100%);
            }
        }
        if root.swatch == -1: Rectangle {
            y: (parent.height - 8px) / 2;
            height: 8px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.rule-strong;
        }
        if root.swatch == -2: Rectangle {
            x: 14px;
            y: (parent.height - 14px) / 2;
            width: 2px;
            height: 14px;
            border-radius: 1px;
            background: Theme.ink;
        }
    }
    Text { width: 86px; text: root.name; font-size: 12.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
    Text { text: root.note; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

component Legend inherits VerticalLayout {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 6px;
    spacing: 0px;
    Text { text: "Reading the meters"; font-size: 13.5px; font-weight: 640; color: Theme.ink; }
    Rectangle { height: 10px; }
    LegendRow { swatch: 0; name: "Calm"; note: "under 80% of the window used"; }
    LegendRow { swatch: 1; name: "Warning"; note: "80 to 95%"; }
    LegendRow { swatch: 2; name: "Critical"; note: "95 to 100%"; }
    LegendRow { swatch: 3; name: "Overage"; note: "past 100%, drawn beyond the end of the track"; }
    LegendRow { swatch: -1; name: "Unavailable"; note: "no reading; never shown as zero"; }
    LegendRow { swatch: -2; name: "Notch"; note: "the auto-switch point, in % used"; }
    Rectangle { height: 8px; }
    Rectangle { height: 1px; background: Theme.rule-2; }
    Rectangle { height: 9px; }
    Text {
        text: "Hover a meter for its reset time, sample time and source.";
        font-size: Type.small;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
}

component StepButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <string> hint;
    callback clicked();
    width: 26px;
    height: 26px;
    background: ta.has-hover && root.enabled ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    accessible-role: button;
    accessible-label: root.hint;
    Icon {
        x: 6px;
        y: 6px;
        width: 14px;
        height: 14px;
        name: root.icon;
        tint: ta.has-hover && root.enabled ? Theme.ink : Theme.ink-3;
        opacity: root.enabled ? 1 : 0.4;
        transform-scale: ta.pressed && root.enabled ? 0.85 : 1;
        animate transform-scale { duration: 100ms; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The auto-switch point as a "% used" stepper.
component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> min: 50;
    in property <int> max: 99;
    in property <bool> enabled: true;
    in property <bool> known: true;
    callback step(int);
    width: 26px + 46px + 26px + 2px;
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.paper;
    clip: true;
    HorizontalLayout {
        padding: 1px;
        StepButton { icon: "minus"; hint: "Lower threshold"; enabled: root.enabled && root.known && root.value > root.min; clicked => { root.step(-1); } }
        Rectangle {
            width: 46px;
            if root.known: ValueUnit {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                width: self.preferred-width;
                height: self.preferred-height;
                value: root.value;
                size: 13.5px;
                weight: 640;
                ink: root.enabled ? Theme.ink : Theme.ink-3;
            }
            if !root.known: Text {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                text: "—";
                font-size: 13.5px;
                color: Theme.ink-3;
            }
        }
        StepButton { icon: "plus"; hint: "Raise threshold"; enabled: root.enabled && root.known && root.value < root.max; clicked => { root.step(1); } }
    }
}

export component AccountSection inherits Plate {
    in property <SectionView> section;
    in property <bool> played;
    in property <bool> busy;
    in property <string> selected-id;
    // load-in delay of this section's first row of meters
    in property <duration> meter-delay;
    callback open-details(string);
    callback launch(string, string);
    callback activate(string, string);
    callback auto-toggled(string, bool);
    callback threshold-picked(string, string);
    callback go-analytics();
    callback go-accounts();

    property <length> gap: Breakpoints.ultra ? 26px : 20px;
    // measured column widths (see the file comment); only ever grow while the section lives
    property <length> ident-max: 0px;
    property <length> slot-max: 0px;
    property <length> ident-w: clamp(root.ident-max, 150px, 320px);
    property <length> slot-w: max(root.slot-max, root.section.switchable ? 80px : 62px);

    // the stepper's value before it is saved; -1 when nothing is pending
    property <int> pending: -1;
    property <int> threshold-shown: root.pending >= 0 ? root.pending : root.section.auto.threshold-used;
    send-threshold := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending >= 0 {
                root.threshold-picked(root.section.id, root.pending + "%");
                release-pending.running = true;
            }
        }
    }
    // the saved value arrives with the next view model; if it never does, show the reported one again
    release-pending := Timer {
        interval: 5s;
        running: false;
        triggered => { self.running = false; root.pending = -1; }
    }
    property <int> reported-threshold: root.section.auto.threshold-used;
    changed reported-threshold => {
        if root.pending == root.reported-threshold {
            root.pending = -1;
            release-pending.running = false;
        }
    }

    // the one inline confirmation open in this section
    property <string> confirm-id;

    // Selected row: ONE tinted, outlined highlight per section that glides between rows (translate and
    // height, ease-out, never past its target). Re-layouts place it at once; a switch glides.
    property <length> hl-y: 0px;
    property <length> hl-h: 0px;
    property <bool> hl-glide: false;
    property <bool> hl-placed: false;
    property <bool> hl-hover: false;
    property <bool> hl-flash: false;
    property <bool> hl-on: root.section.switchable && root.section.active-id != "" && root.hl-placed;
    glide-end := Timer {
        interval: 600ms;
        running: false;
        triggered => { self.running = false; root.hl-glide = false; }
    }
    function place(y: length, h: length, glide: bool) {
        root.hl-glide = glide && root.hl-on && Motion.on;
        if root.hl-glide {
            glide-end.running = true;
        }
        root.hl-y = y;
        root.hl-h = h;
        root.hl-placed = true;
    }

    // the header's "codex-2 active" and the footer line crossfade when the active account changes
    property <string> active-id: root.section.active-id;
    property <bool> meta-dip: false;
    changed active-id => {
        if Motion.on {
            root.meta-dip = true;
            meta-back.running = true;
        }
    }
    meta-back := Timer {
        interval: 150ms;
        running: false;
        triggered => { self.running = false; root.meta-dip = false; }
    }

    min-height: body.min-height;
    preferred-height: body.preferred-height;

    body := VerticalLayout {
        spacing: 0px;
        head := HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 13px;
            spacing: 16px;
            min-height: 70px;
            HorizontalLayout {
                spacing: 12px;
                horizontal-stretch: 0;
                VerticalLayout {
                    alignment: center;
                    ProviderMark { provider: root.section.id; size: 28px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        min-height: 26px;
                        vertical-alignment: center;
                        text: root.section.label;
                        font-size: Type.title;
                        font-weight: 630;
                        letter-spacing: -0.2px;
                        color: Theme.ink;
                    }
                    Runs {
                        min-height: 18px;
                        runs: root.section.meta-runs;
                        size: 12.5px;
                        ink: Theme.ink-3;
                        strong-ink: Theme.ink;
                        strong-weight: 600;
                        opacity: root.meta-dip ? 0 : 1;
                        animate opacity { duration: Motion.on ? (root.meta-dip ? 0ms : 150ms) : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Claude: the meter legend and History
            if root.section.kind == "claude": HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 0;
                legend-anchor := Rectangle {
                    width: 28px;
                    legend-btn := IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "help";
                        small: true;
                        bare: true;
                        hint: "How to read the meters";
                        pressed-look: legend-pop.is-open;
                        clicked => { legend-pop.show(); }
                    }
                    legend-pop := PopupWindow {
                        x: parent.width + 4px - 372px;
                        y: (parent.height + legend-btn.height) / 2 + 8px;
                        width: 372px;
                        close-policy: close-on-click-outside;
                        MenuPanel {
                            width: 372px;
                            Legend { }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        kind: "ghost";
                        small: true;
                        icon: "chart";
                        text: "History";
                        hint: "Quota history on Analytics";
                        clicked => { root.go-analytics(); }
                    }
                }
            }
            // Switchable: the section's own auto-switch control, or why it is off
            if root.section.switchable && root.section.count > 0 && root.section.auto.shown: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                auto-ta := TouchArea {
                    changed has-hover => {
                        if self.has-hover {
                            Hover.tip("auto:" + root.section.id, self.absolute-position, self.width, self.height, root.section.auto.message + (root.section.auto.setting != "" ? " · " + root.section.auto.setting : ""));
                        } else {
                            Hover.leave("auto:" + root.section.id);
                        }
                    }
                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.rule;
                        background: Theme.paper-2;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    on: root.section.auto.enabled;
                                    enabled: root.section.auto.available && (root.section.auto.enabled || root.section.auto.can-enable) && !root.busy;
                                    label: "Auto-switch";
                                    toggled(on) => { root.auto-toggled(root.section.id, on); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                Text { text: "at"; font-size: Type.control; color: Theme.ink-2; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    Stepper {
                                        value: root.threshold-shown;
                                        min: root.section.auto.min;
                                        max: root.section.auto.max;
                                        known: root.section.auto.threshold-used >= 0;
                                        enabled: root.section.auto.known && !root.busy;
                                        step(d) => {
                                            root.pending = clamp(root.threshold-shown + d, root.section.auto.min, root.section.auto.max);
                                            release-pending.running = false;
                                            send-threshold.running = false;
                                            send-threshold.running = true;
                                        }
                                    }
                                }
                                Text { text: "used"; font-size: Type.control; color: Theme.ink-2; vertical-alignment: center; }
                            }
                            if root.section.auto.pool != "": Text {
                                text: root.section.auto.pool;
                                font-size: 12.5px;
                                color: Theme.ink-3;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if root.section.switchable && root.section.count > 0 && !root.section.auto.shown: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                TouchArea {
                    changed has-hover => {
                        if self.has-hover {
                            Hover.tip("auto-off:" + root.section.id, self.absolute-position, self.width, self.height, "Switching moves between " + root.section.label + " accounts, so it starts once a second account is signed in.");
                        } else {
                            Hover.leave("auto-off:" + root.section.id);
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        padding-left: 2px;
                        padding-right: 2px;
                        VerticalLayout {
                            alignment: center;
                            Icon { name: "swap"; tint: Theme.ink-3; width: 16px; height: 16px; }
                        }
                        Runs { runs: root.section.auto.off-runs; size: 12.5px; ink: Theme.ink-3; strong-ink: Theme.ink-2; strong-weight: 600; }
                    }
                }
            }
        }
        if root.section.count > 0: Rectangle {
            background: Theme.paper-2;
            min-height: colhead.min-height;
            preferred-height: colhead.preferred-height;
            Rectangle { y: 0px; height: 1px; background: Theme.rule-2; }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.rule-2; }
            colhead := HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: root.gap;
                Caps { width: root.ident-w; text: "ACCOUNT"; vertical-alignment: bottom; }
                for col in root.section.columns: Caps {
                    min-width: 108px;
                    preferred-width: 108px;
                    horizontal-stretch: 1;
                    text: col.label.to-uppercase();
                    wrap: word-wrap;
                    overflow: clip;
                    vertical-alignment: bottom;
                }
                Rectangle { width: root.slot-w; }
            }
        }
        rows-box := Rectangle {
            vertical-stretch: 1;
            min-height: rows.min-height;
            preferred-height: rows.preferred-height;
            if root.section.switchable: Rectangle {
                x: 8px;
                y: root.hl-y + 5px;
                width: parent.width - 16px;
                height: max(0px, root.hl-h - 10px);
                border-radius: 10px;
                background: root.hl-flash ? Theme.flash : Theme.accent.mix(Theme.paper, root.hl-hover ? 0.11 : 0.07);
                border-width: 1px;
                border-color: Theme.accent.mix(Theme.paper, 0.42);
                opacity: root.hl-on ? 1 : 0;
                animate y, height { duration: root.hl-glide ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                animate background { duration: Motion.tint(root.hl-flash ? 0ms : 160ms); easing: cubic-bezier(0.65, 0, 0.35, 1); }
            }
            rows := VerticalLayout {
                spacing: 0px;
                for row[i] in root.section.rows: AccountRow {
                    account: row;
                    section: root.section;
                    index: i;
                    last: i == root.section.count - 1;
                    round-bottom: i == root.section.count - 1 && !root.section.foot.shown;
                    ident-w: root.ident-w;
                    slot-w: root.slot-w;
                    gap: root.gap;
                    played: root.played;
                    delay: root.meter-delay + i * 48ms;
                    busy: root.busy;
                    selected: row.id == root.selected-id;
                    confirming: root.confirm-id == row.id;
                    notch-at: root.pending >= 0 ? root.pending : -1;
                    init => {
                        root.ident-max = max(root.ident-max, self.ident-natural);
                        root.slot-max = max(root.slot-max, self.slot-natural);
                        if row.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), false);
                        }
                    }
                    changed ident-natural => { root.ident-max = max(root.ident-max, self.ident-natural); }
                    changed slot-natural => { root.slot-max = max(root.slot-max, self.slot-natural); }
                    changed y => {
                        if self.account.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), false);
                        }
                    }
                    changed line-height => {
                        if self.account.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), false);
                        }
                    }
                    changed account => {
                        if self.account.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), true);
                        }
                        if !self.account.confirm && root.confirm-id == self.account.id {
                            root.confirm-id = "";
                        }
                    }
                    changed hovered => {
                        if self.account.active {
                            root.hl-hover = self.hovered;
                        }
                    }
                    changed flashing => {
                        if self.account.active {
                            root.hl-flash = self.flashing;
                        }
                    }
                    open-details(id) => { root.open-details(id); }
                    launch(id, target) => { root.launch(id, target); }
                    activate(kind, profile) => { root.activate(kind, profile); }
                    ask-confirm(id) => { root.confirm-id = id; }
                    cancel-confirm => { root.confirm-id = ""; }
                    go-accounts => { root.go-accounts(); }
                }
            }
        }
        if root.section.count == 0: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 18px;
            Text { text: root.section.empty; font-size: 12.5px; color: Theme.ink-3; wrap: word-wrap; }
        }
        if root.section.foot.shown: Rectangle {
            min-height: foot.min-height;
            preferred-height: foot.preferred-height;
            Rectangle { y: 0px; height: 1px; background: Theme.rule-2; }
            foot := HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 9px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Icon {
                        name: root.section.foot.warn ? "alert" : "swap";
                        tint: root.section.foot.warn ? Theme.warn-text : Theme.ink-3;
                        width: 16px;
                        height: 16px;
                    }
                }
                Runs {
                    runs: root.section.foot.runs;
                    size: 12.5px;
                    ink: root.section.foot.warn ? Theme.warn-text : Theme.ink-2;
                    strong-ink: root.section.foot.warn ? Theme.warn-text : Theme.ink;
                    strong-weight: 640;
                    opacity: root.meta-dip ? 0 : 1;
                    animate opacity { duration: Motion.on ? (root.meta-dip ? 0ms : 150ms) : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.section.foot.when;
                    font-family: Type.tab;
                    font-size: 12.5px;
                    color: Theme.ink-3;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
        }
    }
}

// A dashed hairline (Slint draws no dash arrays): 3 px dashes, 3 px apart.
component DashedRule inherits Rectangle {
    height: 1px;
    property <int> dashes: max(1, ceil(root.width / 6px));
    for i in root.dashes: Rectangle {
        x: i * 6px;
        y: 0px;
        width: min(3px, root.width - i * 6px);
        height: 1px;
        background: Theme.rule;
    }
}

component AmountLine inherits VerticalLayout {
    in property <AmountView> amount;
    in property <bool> rule-above;
    spacing: 0px;
    if root.rule-above: DashedRule { }
    HorizontalLayout {
        padding-top: 7px;
        padding-bottom: root.amount.sub != "" ? 2px : 7px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon { name: root.amount.icon; tint: Theme.ink-3; width: 16px; height: 16px; }
        }
        Text {
            text: root.amount.label;
            font-size: 12.5px;
            color: Theme.ink-2;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            Text {
                text: root.amount.value;
                font-family: Type.tab;
                font-size: 12.5px;
                font-weight: 600;
                color: root.amount.spent ? Theme.crit-text : Theme.ink;
                vertical-alignment: center;
            }
            if root.amount.unit != "": Text {
                text: root.amount.unit;
                font-family: Type.tab;
                font-size: Type.small;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }
    }
    if root.amount.sub != "": HorizontalLayout {
        padding-left: 26px;
        padding-bottom: 7px;
        Text { text: root.amount.sub; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
    }
}

component CardNote inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    spacing: 7px;
    if root.icon != "": VerticalLayout {
        alignment: start;
        padding-top: 1px;
        horizontal-stretch: 0;
        Icon { name: root.icon; tint: Theme.ink-3; width: 15px; height: 15px; }
    }
    Text { text: root.text; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; horizontal-stretch: 1; }
}

export component ProviderCard inherits Card {
    in property <ProviderCardView> card;
    in property <bool> played;
    in property <duration> delay;
    in property <string> selected-id;
    selected: root.card.account-id == root.selected-id && root.selected-id != "";
    pad: 18px;
    pad-top: 16px;
    pad-bottom: 12px;
    min-width: 240px;
    // a wide card puts its meters side by side; a wider one its amounts in two columns
    property <bool> wide: root.width >= 560px;
    property <bool> amt2: root.width >= 700px;
    property <int> flash-phase: 0;
    flash: root.flash-phase == 1;
    flash-on := Timer {
        interval: 30ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 2; flash-off.running = true; }
    }
    flash-off := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 0; }
    }

    HorizontalLayout {
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            ProviderMark { provider: root.card.provider; size: 26px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            horizontal-stretch: 1;
            Rectangle {
                min-height: 21.5px;
                name := Text {
                    x: 0px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: min(self.preferred-width, parent.width);
                    text: root.card.label;
                    font-size: 15px;
                    font-weight: 630;
                    letter-spacing: -0.075px;
                    color: Theme.ink;
                    overflow: elide;
                }
                if root.card.plan != "": Text {
                    x: name.width + 6px;
                    y: name.font-metrics.ascent - self.font-metrics.ascent;
                    width: max(0px, parent.width - self.x);
                    text: root.card.plan;
                    font-size: 12.5px;
                    font-weight: 450;
                    color: Theme.ink-3;
                    overflow: elide;
                }
            }
            Text { min-height: 17.5px; vertical-alignment: center; text: root.card.identity; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
        }
    }
    Rectangle { height: 14px; }
    // (Slint 1.18.1: a GridLayout whose repeater starts empty and fills later can panic in layout.rs, so
    // every repeated grid here is created only once its model has rows.)
    if root.card.meters.length > 0: GridLayout {
        spacing-horizontal: 26px;
        spacing-vertical: 14px;
        for m[k] in root.card.meters: Meter {
            row: root.wide ? 0 : k;
            col: root.wide ? k : 0;
            horizontal-stretch: 1;
            min-width: 100px;
            data: m;
            inline: true;
            played: root.played;
            delay: root.delay + k * 16ms;
            hot: root.hovered;
            owner-label: root.card.label + " · " + root.card.identity;
            clicked => { root.clicked(); }
            value-changed => {
                if Motion.on {
                    root.flash-phase = 1;
                    flash-on.running = true;
                }
            }
        }
    }
    if root.card.meters.length == 0 && root.card.note != "": CardNote { text: root.card.note; }
    if root.card.plan-note != "": VerticalLayout {
        padding-top: 10px;
        CardNote { icon: "calendar"; text: root.card.plan-note; }
    }
    if root.card.amounts.length > 0: VerticalLayout {
        padding-top: 12px;
        spacing: 0px;
        Rectangle { height: 1px; background: Theme.rule-2; }
        Rectangle { height: 4px; }
        GridLayout {
            spacing-horizontal: 26px;
            spacing-vertical: 0px;
            for a[j] in root.card.amounts: AmountLine {
                row: root.amt2 ? floor(j / 2) : j;
                col: root.amt2 ? mod(j, 2) : 0;
                amount: a;
                rule-above: root.amt2 ? j >= 2 : j >= 1;
            }
        }
        if root.card.packs-note != "": VerticalLayout {
            DashedRule { }
            HorizontalLayout {
                padding-top: 7px;
                padding-bottom: 2px;
                CardNote { icon: "calendar"; text: root.card.packs-note; }
            }
        }
    }
    if root.card.meters.length > 0 && root.card.note != "": VerticalLayout {
        padding-top: 10px;
        CardNote { text: root.card.note; }
    }
    Rectangle { height: 14px; }
    Rectangle { height: 1px; background: Theme.rule-2; }
    HorizontalLayout {
        padding-top: 11px;
        spacing: 8px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            if root.card.flag != "": Text { text: root.card.flag; font-size: Type.small; font-weight: 600; color: Theme.warn-text; horizontal-stretch: 0; }
            if root.card.flag != "": Text { text: " · "; font-size: Type.small; color: Theme.ink-3; horizontal-stretch: 0; }
            Text { text: root.card.sampled; font-family: Type.tab; font-size: Type.small; color: Theme.ink-3; overflow: elide; horizontal-stretch: 1; }
        }
        Text { text: root.card.platform; font-size: Type.small; color: Theme.ink-3; horizontal-stretch: 0; }
    }
}

export component HomePage inherits Rectangle {
    in property <[SectionView]> sections;
    in property <[ProviderCardView]> cards;
    in property <bool> busy;
    in property <bool> ready;
    in property <string> selected-id;
    // the first page of the session loads in more slowly than a page change
    in property <bool> first: true;
    callback open-details(string);
    callback launch(string, string);
    callback activate(string, string);
    callback auto-toggled(string, bool);
    callback threshold-picked(string, string);
    callback go-analytics();
    callback go-accounts();

    property <length> gap: Breakpoints.ultra ? 24px : 20px;
    // wide and ultra: Claude and Codex side by side (7:5, ultra 4:3) at the same height; the rest full width
    property <bool> pair: Breakpoints.at-least-wide && root.sections.length >= 2 && root.sections[0].id == "claude" && root.sections[1].id == "codex";
    pure function pair-w(s: int) -> length {
        if Breakpoints.ultra {
            return (root.width - root.gap) * (s == 0 ? 4 : 3) / 7;
        }
        return (root.width - root.gap) * (s == 0 ? 7 : 5) / 12;
    }
    property <duration> reveal-base: root.first ? 180ms : 40ms;
    property <duration> meter-base: root.first ? 380ms : 220ms;
    // rows one and a half staggers apart across the whole page, in reading order
    pure function rows-before(s: int) -> int {
        if s <= 0 {
            return 0;
        }
        if s == 1 {
            return root.sections[0].count;
        }
        if s == 2 {
            return root.sections[0].count + root.sections[1].count;
        }
        return root.sections[0].count + root.sections[1].count + root.sections[2].count;
    }
    property <int> all-rows: root.rows-before(root.sections.length);

    // Other providers: rows of equal-width cards in one stable order, heights following content. The
    // column count is what fits at 300 px; the cards are spread over the fewest rows, the longer rows
    // first, and each row's cards share its width (a GridLayout over the rows' least common multiple).
    property <int> n: root.cards.length;
    property <int> cmax: clamp(floor((root.width + 20px) / 320px), 1, 6);
    property <int> per-row: min(root.cmax, max(1, root.n));
    property <int> nrows: max(1, ceil(root.n / root.per-row));
    property <int> base: max(1, floor(root.n / root.nrows));
    property <int> extra: mod(root.n, root.nrows);
    property <int> big: root.extra * (root.base + 1);
    property <int> lcm: root.extra > 0 ? root.base * (root.base + 1) : root.base;

    min-height: page.preferred-height;
    preferred-height: page.preferred-height;

    page := VerticalLayout {
        spacing: root.gap;
        if root.sections.length > 0: GridLayout {
            spacing: root.gap;
            for section[s] in root.sections: Reveal {
                row: root.pair ? max(0, s - 1) : s;
                col: root.pair && s == 1 ? 1 : 0;
                colspan: root.pair && s < 2 ? 1 : 2;
                // the pair's widths are fixed so the split is exactly 7:5 (ultra 4:3) whatever its contents
                min-width: !root.pair || s >= 2 ? 0px : root.pair-w(s);
                max-width: !root.pair || s >= 2 ? 100000px : root.pair-w(s);
                delay: root.reveal-base + s * 40ms;
                armed: root.ready;
                AccountSection {
                    vertical-stretch: 1;
                    section: section;
                    played: root.ready;
                    busy: root.busy;
                    selected-id: root.selected-id;
                    meter-delay: root.meter-base + root.rows-before(s) * 48ms;
                    open-details(id) => { root.open-details(id); }
                    launch(id, target) => { root.launch(id, target); }
                    activate(kind, profile) => { root.activate(kind, profile); }
                    auto-toggled(id, on) => { root.auto-toggled(id, on); }
                    threshold-picked(id, v) => { root.threshold-picked(id, v); }
                    go-analytics => { root.go-analytics(); }
                    go-accounts => { root.go-accounts(); }
                }
            }
        }
        if root.cards.length > 0: Reveal {
            delay: root.reveal-base + root.sections.length * 40ms;
            armed: root.ready;
            HorizontalLayout {
                padding-top: 10px;
                padding-left: 2px;
                padding-right: 2px;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: label.preferred-width + 12px + count.preferred-width;
                    min-height: label.preferred-height;
                    label := Text {
                        x: 0px;
                        y: 0px;
                        text: "Other providers";
                        font-size: Type.title;
                        font-weight: 630;
                        letter-spacing: -0.2px;
                        color: Theme.ink;
                    }
                    count := Text {
                        x: label.preferred-width + 12px;
                        y: label.font-metrics.ascent - self.font-metrics.ascent;
                        text: root.n + (root.n == 1 ? " account" : " accounts");
                        font-family: Type.tab;
                        font-size: 13.5px;
                        color: Theme.ink-3;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle { height: 1px; background: Theme.rule; }
                }
            }
        }
        if root.cards.length > 0: Reveal {
            delay: root.reveal-base + (root.sections.length + 1) * 40ms;
            armed: root.ready;
            GridLayout {
                spacing: 20px;
                for card[i] in root.cards: Rectangle {
                    row: i < root.big ? floor(i / (root.base + 1)) : root.extra + floor((i - root.big) / root.base);
                    col: (i < root.big ? mod(i, root.base + 1) : mod(i - root.big, root.base)) * (root.lcm / (i < root.big ? root.base + 1 : root.base));
                    colspan: root.lcm / (i < root.big ? root.base + 1 : root.base);
                    horizontal-stretch: 1;
                    min-width: 240px;
                    preferred-width: 240px;
                    min-height: pc.preferred-height;
                    preferred-height: pc.preferred-height;
                    pc := ProviderCard {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: self.preferred-height;
                        card: card;
                        played: root.ready;
                        delay: root.meter-base + (root.all-rows + i) * 48ms;
                        selected-id: root.selected-id;
                        clicked => { root.open-details(card.account-id); }
                    }
                }
            }
        }
    }
}
