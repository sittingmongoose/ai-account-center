// Home: the Claude section, the switchable Codex and Antigravity sections and the other providers as
// cards, built like the Daylight Atlas concept's Home (c-daylight-atlas/app-home.js, app-active.js and
// styles.css). Every number, label and "unavailable" decision arrives in the view model
// (public/view-model.mjs); this file only lays out and animates it.
//
// Column fitting: in each section the account column is as wide as its widest content (each email in
// its bold active weight, the meta line, the credits line) clamped to 150-320 px, the actions column as
// wide as its widest actions, and the meter columns share the rest equally. Every row reports its
// natural widths and the section keeps the largest.
//
// Below D (DESIGN-MOBILE.md 4.1): the sections stack full width. Each section picks its row layout from
// its own inner width (1.5): the desktop table with touch sizes from 680 px inner for Claude and 600 px
// for the switchable providers, the stacked layout below that — identity line, then a meter grid of
// equal cells (4.1.2/4.1.3), the auto-switch control wrapping under the title, the inline confirmation
// with two equal 44 px buttons and a footer sentence that wraps without a line limit.
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";
import { SectionView, AccountRowView, ProviderCardView, MeterView, ColumnView, RunView, AmountView } from "../models.slint";
import { Icon } from "../components/icon.slint";
import { ProviderMark } from "../components/mark.slint";
import { Caps, ValueUnit } from "../components/text.slint";
import { Button } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";
import { Toggle } from "../components/toggle.slint";
import { Meter, DashedTrack } from "../components/meter.slint";
import { Plate, Card } from "../components/card.slint";
import { Reveal } from "../components/reveal.slint";
import { Hover } from "../components/hover-card.slint";
import { MenuPanel } from "../components/menu.slint";
import { Sheet } from "../components/sheet.slint";
import { InfoIcon, InlineTip } from "../components/info-tip.slint";
import { ProbeMark } from "../components/probe.slint";

// A line that mixes weights ("**4** accounts · desktop profiles"). The "good" tone is the active
// account's name; "warn" is a warning figure.
export component Runs inherits HorizontalLayout {
    in property <[RunView]> runs;
    in property <length> size: 12.5px;
    in property <color> ink: Theme.ink-3;
    in property <color> strong-ink: Theme.ink;
    in property <int> weight: 400;
    in property <int> strong-weight: 600;
    in property <bool> tabular: false;
    spacing: 0px;
    alignment: start;
    for r in root.runs: Text {
        text: r.text;
        font-family: root.tabular ? Type.tab : Type.sans;
        font-size: root.size;
        font-weight: r.strong ? (r.tone == "good" ? 600 : root.strong-weight) : root.weight;
        color: r.tone == "good" ? Theme.good-text : r.tone == "warn" ? Theme.warn-text : r.strong ? root.strong-ink : root.ink;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
}

// The same runs as one wrapping paragraph, for the places below D where the sentence must wrap with no
// line limit (the section footer, the inline confirmation). Markdown gives the weights and tones; the
// words are the view model's, untouched.
// Mixed-weight sentences that wrap (section meta, footers, confirm questions below D): one real
// Text per word in a wrapping flex row, so rows always measure their true height. (StyledText
// reports a one-line height when created late, and Slint cannot split strings, so the view model
// provides the words.) Each word carries its own trailing space; the layout adds no gaps.
component RunsFlow inherits FlexboxLayout {
    in property <[RunView]> words;
    in property <length> size: 13px;
    in property <color> ink: Theme.ink-3;
    in property <color> strong-ink: Theme.ink;
    in property <color> warn-ink: Theme.warn-text;
    in property <color> good-ink: Theme.good-text;
    in property <int> strong-weight: 640;
    spacing-horizontal: 0px;
    spacing-vertical: 0px;
    alignment: start;
    for w in root.words: Text {
        text: w.text + " ";
        font-size: root.size;
        font-weight: w.strong ? root.strong-weight : 400;
        color: w.tone == "warn" ? root.warn-ink : w.tone == "good" ? root.good-ink : w.strong ? root.strong-ink : root.ink;
    }
}

// The filled check-circle. On a switch the disc grows from 60% and the check is revealed left to right
// by a clip whose width animates (the chart draw-on technique; no animated dashes). Ease-out only.
export component CheckMark inherits Rectangle {
    in property <length> size: 15px;
    in property <bool> drawn: true;
    width: root.size;
    height: root.size;
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: Theme.accent;
        transform-scale: root.drawn ? 1 : 0.6;
        animate transform-scale {
            duration: Motion.on ? (root.drawn ? 300ms : 160ms) : 0ms;
            delay: Motion.on ? (root.drawn ? 180ms : 40ms) : 0ms;
            easing: cubic-bezier(0.2, 0.8, 0.2, 1);
        }
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.drawn ? root.size : 0px;
        height: root.size;
        clip: true;
        animate width {
            duration: Motion.on && root.drawn ? 340ms : 0ms;
            delay: Motion.on ? (root.drawn ? 320ms : 200ms) : 0ms;
            easing: cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        Path {
            x: 0px;
            y: 0px;
            width: root.size;
            height: root.size;
            viewbox-width: 20;
            viewbox-height: 20;
            commands: "M5.7 10.3 L8.6 13.2 L14.4 7.2";
            stroke: Theme.accent-ink;
            stroke-width: root.size * 2.3 / 20;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
    }
}

// "Active" in the Activate button's slot: a plain check-circle and the word, "on Ubuntu" under the word.
// No border, fill or button shape. It is laid out on the Activate button's own grid: the check is
// inset by the button's left padding and takes the button icon's size, and the word starts after the
// button's icon gap, so the check lands on the button icon's x and "Active" on the label's x.
// Touch (below D, 4.1.3): the check is 18 and the word in control size.
export component ActiveMark inherits Rectangle {
    in property <string> where;
    in property <bool> on;
    in property <length> inset: 10px;
    in property <length> icon: 15px;
    in property <length> gap: 7px;
    in property <bool> touch: false;
    property <length> word-size: root.touch ? Type.control : 13px;
    property <length> text-x: root.inset + root.icon + root.gap;
    preferred-width: root.text-x + max(word.preferred-width, sub.preferred-width);
    min-width: self.preferred-width;
    preferred-height: word.preferred-height + 1px + sub.preferred-height;
    min-height: self.preferred-height;
    opacity: root.on ? 1 : 0;
    animate opacity { duration: Motion.on ? 180ms : 0ms; delay: Motion.on && root.on ? 140ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    Rectangle {
        y: root.on ? 0px : 3px;
        animate y { duration: Motion.on ? Motion.med : 0ms; delay: Motion.on && root.on ? 140ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        CheckMark {
            x: root.inset;
            y: (word.preferred-height - root.icon) / 2;
            size: root.icon;
            drawn: root.on;
        }
        word := Text {
            x: root.text-x;
            y: 0px;
            text: "Active";
            font-size: root.word-size;
            font-weight: 640;
            color: Theme.accent-text;
        }
        sub := Text {
            x: root.text-x;
            y: word.preferred-height + 1px;
            text: root.where;
            font-size: Type.small;
            color: Theme.ink-3;
        }
    }
}

// The fixed action slot of a switchable row: the Activate button and the Active mark stacked in one
// cell on its start edge. They cross-fade (the button fades back in after the mark leaves), so the slot
// never changes width on a switch. `full` spans the given width (Details on P, 4.4): a full-width button
// or, for the active account, one full-width selected-style line with the check, "Active" and the platform.
export component SwitchSlot inherits Rectangle {
    in property <AccountRowView> account;
    in property <bool> can-switch;
    in property <bool> busy;
    in property <bool> touch: false;
    in property <bool> full: false;
    callback activate();
    callback finish-setup();
    property <bool> show-button: root.can-switch && !root.account.active && !root.account.setup;
    property <bool> show-mark: root.account.active && !root.account.setup;
    out property <length> natural: max(root.can-switch ? btn.preferred-width : 0px, mark.preferred-width, root.account.setup ? setup-btn.preferred-width : 0px);
    preferred-width: root.natural;
    min-width: root.natural;
    preferred-height: root.full ? 48px : max(28px, mark.preferred-height);
    min-height: self.preferred-height;

    btn-wrap := Rectangle {
        x: 0px;
        y: (parent.height - btn.height) / 2;
        width: root.full && root.show-button ? root.width : btn.preferred-width;
        height: btn.height;
        visible: root.can-switch && !root.account.setup;
        opacity: root.show-button ? 1 : 0;
        transform-scale: root.show-button ? 1 : 0.94;
        animate opacity { duration: Motion.on ? 220ms : 0ms; delay: Motion.on && root.show-button ? 160ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        animate transform-scale { duration: Motion.on ? Motion.fast : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        btn := Button {
            x: 0px;
            y: 0px;
            width: root.full && root.show-button ? parent.width : self.preferred-width;
            // the desktop slot keeps the small button; below D the slot button is the full 44 px control
            small: !root.touch;
            tall: root.full;
            kind: "accent-line";
            icon: "swap";
            text: "Activate";
            enabled: root.show-button && root.account.can-activate && !root.busy;
            hint: root.account.activate-hint;
            clicked => { root.activate(); }
        }
    }
    mark := ActiveMark {
        x: 0px;
        y: (parent.height - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        visible: !root.full;
        inset: btn.pad-left;
        icon: root.touch ? 18px : btn.icon-size;
        gap: btn.icon-gap;
        touch: root.touch;
        on: root.show-mark;
        where: root.account.active-label != "" ? root.account.active-label : "on " + root.account.platform;
    }
    if root.full && root.show-mark: Rectangle {
        width: root.width;
        height: 48px;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: Theme.accent;
        background: Theme.accent.mix(Theme.paper, 0.07);
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                CheckMark { size: 18px; drawn: root.show-mark; }
            }
            Text {
                text: "Active";
                font-size: Type.control;
                font-weight: 600;
                color: Theme.accent-text;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Text {
                text: root.account.active-label != "" ? root.account.active-label : "on " + root.account.platform;
                font-size: Type.small;
                color: Theme.ink-3;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }
    }
    setup-btn := Button {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.full ? root.width : self.preferred-width;
        visible: root.account.setup;
        small: !root.touch;
        tall: root.full;
        kind: "accent-line";
        icon: "terminal";
        text: "Finish setup";
        clicked => { root.finish-setup(); }
    }
}

// The same question in Details: a rounded box under the actions, the buttons on their own line.
// Below D the question wraps and the two buttons become equal 44 px halves (4.1.3).
export component ConfirmBox inherits Rectangle {
    in property <[RunView]> runs;
    in property <[RunView]> words;
    in property <bool> open;
    in property <bool> busy;
    callback keep();
    callback confirm();
    property <bool> touch: Breakpoints.below-d;
    property <length> natural: inner.preferred-height + 10px;
    height: root.open ? root.natural : 0px;
    animate height { duration: Motion.on ? (root.open ? Motion.med : 200ms) : 0ms; easing: root.open ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1); }
    clip: true;
    Rectangle {
        y: 10px;
        height: inner.preferred-height;
        border-radius: root.touch ? Theme.r-touch : 10px;
        border-width: 1px;
        border-color: Theme.rule;
        background: Theme.warn.mix(Theme.paper, 0.07);
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Motion.on ? (root.open ? Motion.med : 160ms) : 0ms; delay: Motion.on && root.open ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        inner := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    horizontal-stretch: 0;
                    Icon { name: "alert"; tint: Theme.warn-text; width: 16px; height: 16px; }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    if !root.touch: HorizontalLayout {
                        spacing: 0px;
                        for r in root.runs: Text {
                            text: r.text;
                            font-size: 12.5px;
                            font-weight: r.strong ? 640 : 400;
                            color: r.tone == "warn" ? Theme.warn-text : r.strong ? Theme.ink : Theme.ink-2;
                            wrap: r.strong ? no-wrap : word-wrap;
                            horizontal-stretch: r.strong ? 0 : 1;
                        }
                    }
                    if root.touch: VerticalLayout {
                        horizontal-stretch: 1;
                        RunsFlow { words: root.words; size: Type.body; ink: Theme.ink-2; strong-ink: Theme.ink; }
                    }
                }
            }
            if !root.touch: HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Button { kind: "ghost"; small: true; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
                Button { kind: "accent-line"; small: true; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
            }
            if root.touch: HorizontalLayout {
                spacing: 8px;
                Button { horizontal-stretch: 1; kind: "ghost"; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
                Button { horizontal-stretch: 1; kind: "accent-line"; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
            }
        }
    }
}

// The inline question before activating an account that is already past the switch point. It opens
// below its row with an animated height and a content fade. On D the question and both buttons share
// one line; below D the question wraps (no line limit) and the buttons are two equal halves on P and
// right-aligned at their natural width otherwise (4.1.3, shared with the Accounts rows).
export component ConfirmLine inherits Rectangle {
    in property <[RunView]> runs;
    in property <[RunView]> words;
    in property <bool> open;
    in property <bool> busy;
    in property <length> pad-x: 16px;
    callback keep();
    callback confirm();
    property <bool> touch: Breakpoints.below-d;
    property <length> natural: line.preferred-height;
    height: root.open ? root.natural : 0px;
    animate height { duration: Motion.on ? (root.open ? Motion.med : 200ms) : 0ms; easing: root.open ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1); }
    clip: true;
    background: Theme.warn.mix(Theme.paper, 0.07);
    line := VerticalLayout {
        y: 0px;
        height: root.natural;
        padding-left: root.touch ? root.pad-x : 20px;
        padding-right: root.touch ? root.pad-x : 20px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: root.touch ? 8px : 0px;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Motion.on ? (root.open ? Motion.med : 160ms) : 0ms; delay: Motion.on && root.open ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        // the icon, the figure in bold and the sentence, which wraps below D when the section is narrow
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: root.touch ? start : center;
                horizontal-stretch: 0;
                padding-top: root.touch ? 2px : 0px;
                Icon { name: "alert"; tint: Theme.warn-text; width: 16px; height: 16px; }
            }
            if !root.touch: HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                for r[i] in root.runs: Text {
                    text: r.text;
                    font-size: 12.5px;
                    font-weight: r.strong ? 640 : 400;
                    color: r.tone == "warn" ? Theme.warn-text : r.strong ? Theme.ink : Theme.ink-2;
                    wrap: r.strong ? no-wrap : word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: r.strong ? 0 : 1;
                }
            }
            // rows without words (other producers) fall back to one line until they adopt wordsOf
            if root.touch && root.words.length > 0: VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 1px;
                RunsFlow { words: root.words; size: Type.small; ink: Theme.ink-2; strong-ink: Theme.ink; }
            }
            if root.touch && root.words.length == 0: VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 1px;
                Runs { runs: root.runs; size: Type.small; ink: Theme.ink-2; strong-ink: Theme.ink; strong-weight: 640; }
            }
            if !root.touch: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { kind: "ghost"; small: true; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
            }
            if !root.touch: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { kind: "accent-line"; small: true; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
            }
        }
        if root.touch && Breakpoints.tier-p: HorizontalLayout {
            spacing: 8px;
            Button { horizontal-stretch: 1; kind: "ghost"; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
            Button { horizontal-stretch: 1; kind: "accent-line"; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
        }
        if root.touch && !Breakpoints.tier-p: HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { kind: "ghost"; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
            Button { kind: "accent-line"; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
        }
    }
    Rectangle { y: root.height - 1px; height: 1px; background: Theme.rule-2; }
}

// The stacked row's inline confirmation (4.1.3): a rounded box inside the row block, inset by the
// card padding with 8 above it, the question in body size wrapping, then two equal-width 44 px
// buttons 8 apart.
component ConfirmStack inherits Rectangle {
    in property <[RunView]> runs;
    in property <[RunView]> words;
    in property <bool> open;
    in property <bool> busy;
    in property <length> pad-x: 16px;
    callback keep();
    callback confirm();
    property <length> natural: box.preferred-height + 8px;
    height: root.open ? root.natural : 0px;
    animate height { duration: Motion.on ? (root.open ? Motion.med : 200ms) : 0ms; easing: root.open ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1); }
    clip: true;
    box := Rectangle {
        x: root.pad-x;
        y: 8px;
        width: parent.width - 2 * root.pad-x;
        height: self.preferred-height;
        border-radius: Theme.r-touch;
        border-width: 1px;
        border-color: Theme.rule;
        background: Theme.paper-2;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Motion.on ? (root.open ? Motion.med : 160ms) : 0ms; delay: Motion.on && root.open ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 2px;
                    horizontal-stretch: 0;
                    Icon { name: "alert"; tint: Theme.warn-text; width: 16px; height: 16px; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    RunsFlow { words: root.words; size: Type.body; ink: Theme.ink-2; strong-ink: Theme.ink; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { horizontal-stretch: 1; kind: "ghost"; text: "Keep current"; enabled: !root.busy; clicked => { root.keep(); } }
                Button { horizontal-stretch: 1; kind: "accent-line"; text: "Activate anyway"; enabled: !root.busy; clicked => { root.confirm(); } }
            }
        }
    }
}

export component AccountRow inherits Rectangle {
    in property <AccountRowView> account;
    in property <SectionView> section;
    in property <bool> table: true;
    in property <length> ident-w;
    in property <length> slot-w;
    in property <length> gap: 20px;
    // stacked layout inputs (4.1.2/4.1.3): the card's side padding and the meter grid's width
    in property <length> pad-x: 20px;
    in property <length> grid-w: 0px;
    in property <bool> played;
    // load-in: the delay of this row's first meter (rows one and a half staggers apart)
    in property <duration> delay;
    in property <int> index;
    in property <bool> last;
    in property <bool> round-bottom;
    in property <bool> busy;
    in property <bool> selected;
    in property <bool> confirming;
    in property <float> notch-at: -1;
    callback open-details(string);
    callback launch(string, string);
    callback activate(string, string);
    callback ask-confirm(string);
    callback cancel-confirm();
    callback go-accounts();
    out property <bool> hovered: ta.has-hover;
    out property <length> line-height: line.height;
    // The widths this row needs: the account column (mark, gap, widest text in the active weight, slack)
    // and the actions column. The probes are unconditional; the row surfaces are mode-conditioned.
    out property <length> ident-natural: 22px + 12px + max(email-probe.preferred-width, meta-probe.preferred-width, amounts-probe.preferred-width) + 12px;
    out property <length> slot-natural: root.section.switchable ? sw-probe.natural : root.touch ? 40px + 4px + 40px : 28px + 6px + 28px;

    // a soft highlight for 600 ms when a reading changed on refresh
    out property <bool> flashing: root.flash-phase == 1;
    property <int> flash-phase: 0;
    flash-on := Timer {
        interval: 30ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 2; flash-off.running = true; }
    }
    flash-off := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 0; }
    }
    function flash() {
        if Motion.on {
            root.flash-phase = 1;
            flash-on.running = true;
        }
    }

    // the row background: flash, selected, pressed tint, hover tint. Touch presses show the pressed
    // token and hover tints stay pointer-only (DESIGN-MOBILE.md 5.1); D is unchanged.
    property <bool> touch: Breakpoints.below-d;
    property <color> row-bg: root.flash-phase == 1 ? Theme.flash
        : root.account.active && root.section.switchable ? Theme.row-hover.with-alpha(0)
        : root.touch && ta.pressed ? Theme.pressed
        : !root.touch && ta.pressed ? Theme.row-hover.mix(Theme.rule, 0.7)
        : Device.hover && ta.has-hover ? Theme.row-hover
        : Theme.row-hover.with-alpha(0);

    // stacked (4.1.3): a row whose account reports no windows shows the identity line only
    property <bool> has-cells: !root.table && root.cell-key(0) + root.cell-key(1) + root.cell-key(2)
        + root.cell-key(3) + root.cell-key(4) + root.cell-key(5) + root.cell-key(6) + root.cell-key(7) != "";
    // stacked meter cells under 100 px wide stack "used" under the number (4.1.2): derived from
    // the tier-fed grid width (not self.width), like the table/stacked switch, to stay out of the
    // layout's width cycle. The 260 px switchable cap never binds here (it is above 100).
    property <bool> narrow-cells: !root.table
        && (root.grid-w - 2 * root.pad-x - 12px * max(0, root.account.cells.length - 1)) / max(1, root.account.cells.length) < 100px;
    public pure function cell-key(at: int) -> string {
        return at < root.account.cells.length ? root.account.cells[at].key : "";
    }

    min-height: body.min-height;
    preferred-height: body.preferred-height;

    email-probe := Text {
        visible: false;
        text: root.account.email;
        font-size: Type.body;
        font-weight: 640;
    }
    meta-probe := Text {
        visible: false;
        text: root.account.meta;
        font-size: Type.small;
    }
    amounts-probe := Runs {
        visible: false;
        runs: root.account.amounts-runs;
        size: Type.small;
        strong-weight: 560;
        tabular: true;
    }
    sw-probe := SwitchSlot {
        visible: false;
        account: root.account;
        can-switch: root.section.can-switch;
        touch: Breakpoints.below-d;
    }

    body := VerticalLayout {
        spacing: 0px;
        // ---- the row surface: the desktop table, or the stacked block below the table thresholds ----
        // Table rows are at least 72 tall on D and 76 tall below D (4.1.2).
        line := Rectangle {
            min-height: root.table ? max(root.touch ? 76px : 72px, innercol.min-height) : innercol.min-height;
            preferred-height: root.table ? max(root.touch ? 76px : 72px, innercol.preferred-height) : innercol.preferred-height;
            vertical-stretch: 1;
            border-bottom-left-radius: root.round-bottom ? Theme.r-plate - 1px : 0px;
            border-bottom-right-radius: root.round-bottom ? Theme.r-plate - 1px : 0px;
            background: root.row-bg;
            animate background {
                duration: Motion.tint(root.flash-phase == 1 ? 0ms : root.flash-phase == 2 ? 620ms : root.touch ? (ta.pressed ? 0ms : 160ms) : 180ms);
                easing: root.flash-phase == 2 ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1);
            }

            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-details(root.account.id); }
                innercol := VerticalLayout {
                    spacing: 0px;
                // ---- the desktop table row (D, and inner >= 680/600 below D) ----
                if root.table: row-layout := HorizontalLayout {
                    padding-left: root.pad-x;
                    padding-right: root.pad-x;
                    padding-top: root.touch ? (Breakpoints.tier-t ? 14px : 12px) : 14px;
                    padding-bottom: root.touch ? (Breakpoints.tier-t ? 14px : 12px) : 14px;
                    spacing: root.gap;
                    HorizontalLayout {
                        width: root.ident-w;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            ProviderMark { provider: root.account.provider; size: 22px; dim: root.account.setup; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                min-height: 19.5px;
                                vertical-alignment: center;
                                text: root.account.email;
                                font-size: Type.body;
                                font-weight: root.account.active && root.section.switchable ? 640 : 520;
                                color: root.section.switchable && !root.account.active ? Theme.ink-2 : Theme.ink;
                                overflow: elide;
                            }
                            Rectangle { height: 1px; }
                            Text {
                                min-height: 17.5px;
                                vertical-alignment: center;
                                text: root.account.meta;
                                font-size: Type.small;
                                color: Theme.ink-3;
                                overflow: elide;
                            }
                            Runs {
                                padding-top: root.account.amounts-runs.length > 0 ? 2px : 0px;
                                min-height: root.account.amounts-runs.length > 0 ? 19.5px : 0px;
                                runs: root.account.amounts-runs;
                                size: Type.small;
                                ink: Theme.ink-3;
                                strong-ink: Theme.ink-2;
                                strong-weight: 560;
                                tabular: true;
                            }
                        }
                    }
                    for cell[c] in root.account.cells: Rectangle {
                        min-width: Breakpoints.below-d ? 120px : 108px;
                        preferred-width: Breakpoints.below-d ? 120px : 108px;
                        horizontal-stretch: 1;
                        min-height: cell.key != "" ? m.preferred-height : 0px;
                        preferred-height: self.min-height;
                        m := Meter {
                            // below D the cells top-align so numbers and bars line up across columns
                            // even when sub-lines wrap to different lengths; D keeps its centring
                            y: Breakpoints.below-d ? 0px : (parent.height - self.preferred-height) / 2;
                            width: parent.width;
                            height: self.preferred-height;
                            visible: cell.key != "";
                            // the meter cell serves the stacked and the table rows below D (4.1.2)
                            cell: Breakpoints.below-d;
                            data: cell;
                            played: root.played;
                            delay: root.delay + c * 16ms;
                            hot: root.hovered && Device.hover;
                            notch-override: root.notch-at;
                            owner-label: root.section.label + " · " + root.account.email;
                            clicked => { root.open-details(root.account.id); }
                            value-changed => { root.flash(); }
                        }
                    }
                    slot := Rectangle {
                        width: root.slot-w;
                        min-height: root.section.switchable ? sw-preferred.preferred-height : 28px;
                        if !root.section.switchable: HorizontalLayout {
                            alignment: end;
                            spacing: Breakpoints.below-d ? 4px : 6px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    platform: "apple";
                                    small: true;
                                    enabled: root.account.can-mac && !root.busy;
                                    hint: root.account.can-mac ? "Open on Mac" : "Open on Mac is unavailable for this profile";
                                    clicked => { root.launch(root.account.profile, "mac"); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    platform: "windows";
                                    small: true;
                                    enabled: root.account.can-windows && !root.busy;
                                    hint: root.account.can-windows ? "Open on Windows" : "Open on Windows is unavailable for this profile";
                                    clicked => { root.launch(root.account.profile, "windows"); }
                                }
                            }
                        }
                        sw-preferred := SwitchSlot {
                            x: 0px;
                            y: (parent.height - self.preferred-height) / 2;
                            width: parent.width;
                            height: self.preferred-height;
                            visible: root.section.switchable;
                            touch: Breakpoints.below-d;
                            account: root.account;
                            can-switch: root.section.can-switch;
                            busy: root.busy;
                            activate => {
                                if root.account.confirm {
                                    root.ask-confirm(root.account.id);
                                } else {
                                    root.activate(root.account.activate-kind, root.account.profile);
                                }
                            }
                            finish-setup => { root.go-accounts(); }
                        }
                    }
                }
                // ---- the stacked row (4.1.2/4.1.3, inner below the table thresholds) ----
                if !root.table: stackcol := VerticalLayout {
                    spacing: 0px;
                    // Line A: mark, identity column, launch buttons or the action slot
                    HorizontalLayout {
                        padding-left: root.pad-x;
                        padding-right: root.pad-x;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        min-height: 44px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            ProviderMark { provider: root.account.provider; size: 20px; dim: root.account.setup; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                min-height: 21px;
                                vertical-alignment: center;
                                text: root.account.email;
                                font-size: Type.control;
                                font-weight: root.account.active && root.section.switchable ? 640 : 600;
                                color: root.section.switchable && !root.account.active ? Theme.ink-2 : Theme.ink;
                                overflow: elide;
                            }
                            Text {
                                height: min(self.preferred-height, 36px);
                                text: root.account.meta;
                                font-size: Type.small;
                                color: Theme.ink-3;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                            if root.account.amounts-runs.length > 0: Runs {
                                runs: root.account.amounts-runs;
                                size: Type.small;
                                ink: Theme.ink-3;
                                strong-ink: Theme.ink-2;
                                strong-weight: 600;
                                tabular: true;
                            }
                        }
                        // the launch buttons (Claude) or the action slot (switchable), centred on Line A
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            if !root.section.switchable: HorizontalLayout {
                                alignment: end;
                                spacing: 4px;
                                IconButton {
                                    platform: "apple";
                                    small: true;
                                    enabled: root.account.can-mac && !root.busy;
                                    hint: root.account.can-mac ? "Open on Mac" : "Open on Mac is unavailable for this profile";
                                    clicked => { root.launch(root.account.profile, "mac"); }
                                }
                                IconButton {
                                    platform: "windows";
                                    small: true;
                                    enabled: root.account.can-windows && !root.busy;
                                    hint: root.account.can-windows ? "Open on Windows" : "Open on Windows is unavailable for this profile";
                                    clicked => { root.launch(root.account.profile, "windows"); }
                                }
                            }
                            // Mode-conditioned, not `visible:`: an invisible slot still stacks its
                            // ~44 px into Line A below D, pushing the identity down (H1, H5).
                            if root.section.switchable: SwitchSlot {
                                touch: true;
                                account: root.account;
                                can-switch: root.section.can-switch;
                                busy: root.busy;
                                activate => {
                                    if root.account.confirm {
                                        root.ask-confirm(root.account.id);
                                    } else {
                                        root.activate(root.account.activate-kind, root.account.profile);
                                    }
                                }
                                finish-setup => { root.go-accounts(); }
                            }
                        }
                    }
                    // the meter grid: N equal columns (Claude) or two capped columns (switchable),
                    // gap 12; an account without a window keeps its empty cell
                    if root.has-cells: Rectangle { height: 10px; }
                    if root.has-cells: HorizontalLayout {
                        padding-left: root.pad-x;
                        padding-right: root.pad-x;
                        spacing: 12px;
                        alignment: root.section.switchable ? start : stretch;
                        for cell[c] in root.account.cells: Rectangle {
                            // an explicit width would pin the column (and 0 collapses it): size through
                            // the preferred width so Claude's columns share the row equally
                            preferred-width: root.section.switchable ? max(0px, min(260px, (root.grid-w - 2 * root.pad-x - 12px * max(0, root.account.cells.length - 1)) / max(1, root.account.cells.length))) : 0px;
                            horizontal-stretch: root.section.switchable ? 0 : 1;
                            min-height: cell.key != "" ? sm.preferred-height : 0px;
                            preferred-height: self.min-height;
                            sm := Meter {
                                y: 0px;
                                width: parent.width;
                                height: self.preferred-height;
                                visible: cell.key != "";
                                cell: true;
                                stack-used: root.narrow-cells;
                                data: cell;
                                played: root.played;
                                delay: root.delay + c * 16ms;
                                hot: root.hovered && Device.hover;
                                notch-override: root.notch-at;
                                owner-label: root.section.label + " · " + root.account.email;
                                clicked => { root.open-details(root.account.id); }
                                value-changed => { root.flash(); }
                            }
                        }
                    }
                    // the inline confirmation, inside the row block before the next divider (4.1.3)
                    if root.account.confirm: ConfirmStack {
                        runs: root.account.confirm-runs;
                        words: root.account.confirm-words;
                        open: root.confirming;
                        busy: root.busy;
                        pad-x: root.pad-x;
                        keep => { root.cancel-confirm(); }
                        confirm => {
                            root.cancel-confirm();
                            root.activate(root.account.activate-kind, root.account.profile);
                        }
                    }
                }
                }
            }
            // the hairline under every row but the last
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.rule-2;
                visible: !root.last;
            }
        }
        if root.table && root.account.confirm: ConfirmLine {
            runs: root.account.confirm-runs;
            words: root.account.confirm-words;
            open: root.confirming;
            busy: root.busy;
            pad-x: root.pad-x;
            keep => { root.cancel-confirm(); }
            confirm => {
                root.cancel-confirm();
                root.activate(root.account.activate-kind, root.account.profile);
            }
        }
    }
}

// The legend that used to be a permanent strip, behind one "?".
component LegendRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> note;
    in property <int> swatch: 0;
    spacing: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    Rectangle {
        width: 30px;
        if root.swatch >= 0: Rectangle {
            y: (parent.height - 8px) / 2;
            height: 8px;
            border-radius: 4px;
            background: root.swatch == 3 ? Theme.over : Theme.sev-fill(root.swatch);
            Rectangle {
                border-radius: 4px;
                background: @linear-gradient(90deg, Theme.fill-wash 0%, Theme.fill-wash.with-alpha(0) 100%);
            }
        }
        if root.swatch == -1: DashedTrack {
            y: (parent.height - 8px) / 2;
            width: parent.width;
            height: 8px;
        }
        if root.swatch == -2: Rectangle {
            x: 14px;
            y: (parent.height - 14px) / 2;
            width: 2px;
            height: 14px;
            border-radius: 1px;
            background: Theme.ink;
        }
    }
    Text { width: 86px; text: root.name; font-size: 12.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
    Text { text: root.note; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

component Legend inherits VerticalLayout {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 6px;
    spacing: 0px;
    Text { text: "Reading the meters"; font-size: 13.5px; font-weight: 640; color: Theme.ink; }
    Rectangle { height: 10px; }
    LegendRow { swatch: 0; name: "Calm"; note: "under 80% of the window used"; }
    LegendRow { swatch: 1; name: "Warning"; note: "80 to 95%"; }
    LegendRow { swatch: 2; name: "Critical"; note: "95 to 100%"; }
    LegendRow { swatch: 3; name: "Overage"; note: "past 100%, drawn beyond the end of the track"; }
    LegendRow { swatch: -1; name: "Unavailable"; note: "no reading; never shown as zero"; }
    LegendRow { swatch: -2; name: "Notch"; note: "the auto-switch point, in % used"; }
    Rectangle { height: 8px; }
    Rectangle { height: 1px; background: Theme.rule-2; }
    Rectangle { height: 9px; }
    Text {
        // Touch has no hover: the row opens Details with the exact times (4.4).
        text: Device.hover ? "Hover a meter for its reset time, sample time and source."
            : "Tap an account for its reset time, sample time and source.";
        font-size: Type.small;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
}

component StepButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <string> hint;
    // Driven by the Stepper's own TouchAreas (they extend past the clipped visuals).
    in property <bool> hov: false;
    in property <bool> press: false;
    // Below D each part is 36 wide and 36 tall with a 44 hit area (DESIGN-MOBILE.md 2.3).
    width: Breakpoints.tier-d ? 26px : 36px;
    height: Breakpoints.tier-d ? 26px : 36px;
    background: root.hov && root.enabled ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    accessible-role: button;
    accessible-label: root.hint;
    Icon {
        x: (parent.width - 14px) / 2;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        name: root.icon;
        tint: root.hov && root.enabled ? Theme.ink : Theme.ink-3;
        opacity: root.enabled ? 1 : 0.4;
        transform-scale: root.press && root.enabled ? 0.85 : 1;
        animate transform-scale { duration: 100ms; }
    }
}

// The auto-switch point as a "% used" stepper.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> min: 50;
    in property <int> max: 99;
    in property <bool> enabled: true;
    in property <bool> known: true;
    callback step(int);
    // Below D the group is 36 + 56 + 36 = 128 wide and 36 tall (DESIGN-MOBILE.md 2.3).
    property <length> part: Breakpoints.tier-d ? 26px : 36px;
    width: Breakpoints.tier-d ? 26px + 46px + 26px + 2px : 36px + 56px + 36px + 2px;
    height: Breakpoints.tier-d ? 28px : 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.paper;
    // No clip on the root: each part's TouchArea extends to 44 x 44 past the border (the value
    // box is not interactive, so the sideways slop collides with nothing). The inner visuals clip.
    visuals := Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 7px;
        clip: true;
        HorizontalLayout {
            minus := StepButton { icon: "minus"; hint: "Lower threshold"; enabled: root.enabled && root.known && root.value > root.min; hov: minus-ta.has-hover; press: minus-ta.pressed; }
            Rectangle {
                width: Breakpoints.tier-d ? 46px : 56px;
                if root.known: ValueUnit {
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                    width: self.preferred-width;
                    height: self.preferred-height;
                    value: root.value;
                    size: Breakpoints.tier-d ? 13.5px : Type.control;
                    weight: 640;
                    ink: root.enabled ? Theme.ink : Theme.ink-3;
                }
                if !root.known: Text {
                    x: (parent.width - self.preferred-width) / 2;
                    y: (parent.height - self.preferred-height) / 2;
                    text: "—";
                    font-size: Breakpoints.tier-d ? 13.5px : Type.control;
                    color: Theme.ink-3;
                }
            }
            plus := StepButton { icon: "plus"; hint: "Raise threshold"; enabled: root.enabled && root.known && root.value < root.max; hov: plus-ta.has-hover; press: plus-ta.pressed; }
        }
    }
    property <length> slop-x: Breakpoints.below-d ? (44px - root.part) / 2 : 0px;
    property <length> slop-y: Breakpoints.below-d ? (44px - root.part) / 2 : 0px;
    minus-ta := TouchArea {
        x: 1px - root.slop-x;
        y: 1px - root.slop-y;
        width: root.part + 2 * root.slop-x;
        height: root.part + 2 * root.slop-y;
        enabled: root.enabled && root.known && root.value > root.min;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.step(-1); }
    }
    plus-ta := TouchArea {
        x: root.width - 1px - root.part - root.slop-x;
        y: 1px - root.slop-y;
        width: root.part + 2 * root.slop-x;
        height: root.part + 2 * root.slop-y;
        enabled: root.enabled && root.known && root.value < root.max;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.step(1); }
    }
}

export component AccountSection inherits Plate {
    in property <SectionView> section;
    in property <bool> played;
    in property <bool> busy;
    in property <string> selected-id;
    // load-in delay of this section's first row of meters
    in property <duration> meter-delay;
    callback open-details(string);
    callback launch(string, string);
    callback activate(string, string);
    callback auto-toggled(string, bool);
    callback threshold-picked(string, string);
    callback go-analytics();
    callback go-accounts();

    property <length> gap: Breakpoints.ultra ? 26px : 20px;
    // Below D (DESIGN-MOBILE.md 4.1): the card's side padding is 16 on P and 20 on F/T, and each
    // section picks its row layout from its own inner width (1.5): the desktop table with touch sizes
    // from 680 px inner for Claude and 600 px for the switchable providers, stacked below that. D is
    // always the table (unchanged).
    property <length> pad-x: Breakpoints.tier-p ? 16px : 20px;
    // The section spans the page width below D, which is the tier width minus the page gutters;
    // deriving it from the tier (not self.width) keeps the table/stacked switch out of the layout's
    // width cycle. Table gaps are 16 below D (4.1.2) and the stacked heads match their 12 grid.
    property <length> inner-w: Breakpoints.tier-width - 2 * Breakpoints.gutter - 2 * root.pad-x;
    property <bool> table: Breakpoints.tier-d || root.inner-w >= (root.section.switchable ? 600px : 680px);
    property <bool> touch: Breakpoints.below-d;
    property <length> col-gap: root.table ? (root.touch ? 16px : root.gap) : 12px;
    // measured column widths (see the file comment); only ever grow while the section lives
    property <length> ident-max: 0px;
    property <length> slot-max: 0px;
    property <length> ident-w: clamp(root.ident-max, root.touch ? 180px : 150px, 320px);
    property <length> slot-w: max(root.slot-max, root.section.switchable ? 80px : root.touch ? 84px : 62px);
    // the stacked switchable meter grid caps each column at 260 px, extra space to the right (4.1.3)
    property <length> cell-w: max(0px, min(260px, (root.inner-w - 12px * max(0, root.section.columns.length - 1)) / max(1, root.section.columns.length)));

    // the stepper's value before it is saved; -1 when nothing is pending
    property <int> pending: -1;
    property <int> threshold-shown: root.pending >= 0 ? root.pending : root.section.auto.threshold-used;
    send-threshold := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending >= 0 {
                root.threshold-picked(root.section.id, root.pending + "%");
                release-pending.running = true;
            }
        }
    }
    // the saved value arrives with the next view model; if it never does, show the reported one again
    release-pending := Timer {
        interval: 5s;
        running: false;
        triggered => { self.running = false; root.pending = -1; }
    }
    property <int> reported-threshold: root.section.auto.threshold-used;
    changed reported-threshold => {
        if root.pending == root.reported-threshold {
            root.pending = -1;
            release-pending.running = false;
        }
    }

    // the one inline confirmation open in this section
    property <string> confirm-id;

    // The full History label needs mark + title + legend + button; at the 320 floor even the bare
    // title leaves no room, so History keeps its icon and accessible name but drops its label there
    // (nothing clips, A3). Everywhere else the label stays.
    property <bool> hist-short: root.touch && root.section.kind == "claude"
        && 28px + 10px + title-probe.preferred-width + 16px + 40px + 8px + hist-probe.preferred-width > root.inner-w;
    title-probe := Text {
        visible: false;
        text: root.section.label;
        font-size: Type.title;
        font-weight: 630;
    }
    hist-probe := Button {
        visible: false;
        kind: "ghost";
        icon: "chart";
        text: "History";
    }

    // Selected row: ONE tinted, outlined highlight per section that glides between rows (translate and
    // height, ease-out, never past its target). Re-layouts place it at once; a switch glides.
    property <length> hl-y: 0px;
    property <length> hl-h: 0px;
    property <bool> hl-glide: false;
    property <bool> hl-placed: false;
    property <bool> hl-hover: false;
    property <bool> hl-flash: false;
    // after a flash the highlight fades back over 620 ms, like a row
    property <bool> hl-fade: false;
    hl-fade-end := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.running = false; root.hl-fade = false; }
    }
    property <bool> hl-on: root.section.switchable && root.section.active-id != "" && root.hl-placed;
    glide-end := Timer {
        interval: 600ms;
        running: false;
        triggered => { self.running = false; root.hl-glide = false; }
    }
    function place(y: length, h: length, glide: bool) {
        root.hl-glide = glide && root.hl-on && Motion.on;
        if root.hl-glide {
            glide-end.running = true;
        }
        root.hl-y = y;
        root.hl-h = h;
        root.hl-placed = true;
    }

    // the header's "codex-2 active" and the footer line crossfade when the active account changes
    property <string> active-id: root.section.active-id;
    property <bool> meta-dip: false;
    changed active-id => {
        if Motion.on {
            root.meta-dip = true;
            meta-back.running = true;
        }
    }
    meta-back := Timer {
        interval: 150ms;
        running: false;
        triggered => { self.running = false; root.meta-dip = false; }
    }

    min-height: body.min-height;
    preferred-height: body.preferred-height;

    body := VerticalLayout {
        spacing: 0px;
        head := HorizontalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            padding-top: 14px;
            padding-bottom: Breakpoints.tier-d ? 13px : root.section.switchable && !root.table ? 8px : 14px;
            spacing: 16px;
            min-height: 70px;
            HorizontalLayout {
                spacing: root.touch ? 10px : 12px;
                horizontal-stretch: root.touch ? 1 : 0;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ProviderMark { provider: root.section.id; size: 28px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        min-height: 26px;
                        vertical-alignment: center;
                        text: root.section.label;
                        font-size: Type.title;
                        font-weight: 630;
                        letter-spacing: -0.2px;
                        color: Theme.ink;
                        overflow: elide;
                    }
                    // below D the meta wraps instead of pushing the header buttons out (4.1.2)
                    if !root.touch: Runs {
                        min-height: 18px;
                        runs: root.section.meta-runs;
                        size: 12.5px;
                        ink: Theme.ink-3;
                        strong-ink: Theme.ink;
                        strong-weight: 600;
                        opacity: root.meta-dip ? 0 : 1;
                        animate opacity { duration: Motion.on ? (root.meta-dip ? 0ms : 150ms) : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                    }
                    if root.touch: RunsFlow {
                        words: root.section.meta-words;
                        size: Type.small;
                        strong-ink: Theme.ink;
                        strong-weight: 600;
                        opacity: root.meta-dip ? 0 : 1;
                        animate opacity { duration: Motion.on ? (root.meta-dip ? 0ms : 150ms) : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Claude: the meter legend and History
            if root.section.kind == "claude": HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 0;
                legend-anchor := Rectangle {
                    width: Breakpoints.tier-d ? 28px : 40px;
                    property <length> pop-w: min(372px, max(240px, Breakpoints.tier-width - 2 * Breakpoints.gutter));
                    // P (not short) opens the sheet below instead of the popover (3.5). The bool,
                    // not the popup's is-open, drives the Sheet: a child binding to its own
                    // popup's builtins trips the compiler.
                    property <bool> sheet-open: false;
                    // e2e: the harness clicks the button's centre through this (?e2e only).
                    ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "home-legend"; }
                    legend-btn := IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "help";
                        small: Breakpoints.tier-d;
                        bare: true;
                        hint: "How to read the meters";
                        pressed-look: legend-pop.is-open || legend-anchor.sheet-open;
                        clicked => {
                            if Breakpoints.tier-p && !Breakpoints.short {
                                if legend-anchor.sheet-open {
                                    legend-anchor.sheet-open = false;
                                    legend-sheet-pop.close();
                                } else {
                                    legend-sheet-pop.show();
                                    legend-anchor.sheet-open = true;
                                }
                            } else {
                                legend-pop.show();
                            }
                        }
                    }
                    // The meter legend popover, width clamped inside the gutters below D (3.5).
                    legend-pop := PopupWindow {
                        width: legend-anchor.pop-w;
                        x: clamp(parent.width + 4px - legend-anchor.pop-w, Breakpoints.gutter + Device.safe-left - legend-btn.absolute-position.x, max(0px, Breakpoints.width - Breakpoints.gutter - Device.safe-right - legend-anchor.pop-w - legend-btn.absolute-position.x));
                        y: (parent.height + legend-btn.height) / 2 + 8px;
                        close-policy: close-on-click-outside;
                        MenuPanel {
                            width: legend-anchor.pop-w;
                            Legend { }
                        }
                    }
                    // P (not short): the legend is a bottom sheet (3.5). The full-window popup
                    // gives the shared Sheet its window geometry, so the scrim covers the tab bar
                    // too; the sheet's own open curve plays on show (closing is instant, as with
                    // the shell's account sheet). Back does not reach page popups: it falls
                    // through to the page, which destroys the open legend with Home itself.
                    legend-sheet-pop := PopupWindow {
                        width: Breakpoints.width;
                        height: Breakpoints.height;
                        // The anchor (not the centred button) is the popup's origin.
                        x: -legend-anchor.absolute-position.x;
                        y: -legend-anchor.absolute-position.y;
                        // Full-window: an outside tap cannot happen; the scrim closes instead.
                        close-policy: close-on-click-outside;
                        Sheet {
                            width: 100%;
                            height: 100%;
                            open: legend-anchor.sheet-open;
                            probe: "legend-sheet";
                            close-requested => {
                                legend-anchor.sheet-open = false;
                                legend-sheet-pop.close();
                            }
                            Legend { }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Button {
                        kind: "ghost";
                        small: Breakpoints.tier-d;
                        icon: "chart";
                        text: root.hist-short ? "" : "History";
                        hint: "Quota history on Analytics";
                        clicked => { root.go-analytics(); }
                    }
                }
            }
            // Switchable, table header: the section's own auto-switch control on the right, touch
            // sizes below D, or why it is off
            if root.section.switchable && root.section.count > 0 && root.section.auto.shown && root.table: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                auto-ta := TouchArea {
                    changed has-hover => {
                        if Device.hover {
                            if self.has-hover {
                                Hover.tip("auto:" + root.section.id, self.absolute-position, self.width, self.height, root.section.auto.message + (root.section.auto.setting != "" ? " · " + root.section.auto.setting : ""));
                            } else {
                                Hover.leave("auto:" + root.section.id);
                            }
                        }
                    }
                    Rectangle {
                        border-radius: Breakpoints.tier-d ? 10px : Theme.r-touch;
                        border-width: 1px;
                        border-color: Theme.rule;
                        background: Theme.paper-2;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    on: root.section.auto.enabled;
                                    enabled: root.section.auto.available && (root.section.auto.enabled || root.section.auto.can-enable) && !root.busy;
                                    label: "Auto-switch";
                                    toggled(on) => { root.auto-toggled(root.section.id, on); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                Text { text: "at"; font-size: Type.control; color: Theme.ink-2; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    Stepper {
                                        value: root.threshold-shown;
                                        min: root.section.auto.min;
                                        max: root.section.auto.max;
                                        known: root.section.auto.threshold-used >= 0;
                                        enabled: root.section.auto.known && !root.busy;
                                        step(d) => {
                                            root.pending = clamp(root.threshold-shown + d, root.section.auto.min, root.section.auto.max);
                                            release-pending.running = false;
                                            send-threshold.running = false;
                                            send-threshold.running = true;
                                        }
                                    }
                                }
                                Text { text: "used"; font-size: Type.control; color: Theme.ink-2; vertical-alignment: center; }
                            }
                            if root.section.auto.pool != "": Text {
                                text: root.section.auto.pool;
                                font-size: 12.5px;
                                color: Theme.ink-3;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if root.section.switchable && root.section.count > 0 && !root.section.auto.shown && root.table: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                TouchArea {
                    changed has-hover => {
                        if Device.hover {
                            if self.has-hover {
                                Hover.tip("auto-off:" + root.section.id, self.absolute-position, self.width, self.height, "Switching moves between " + root.section.label + " accounts, so it starts once a second account is signed in.");
                            } else {
                                Hover.leave("auto-off:" + root.section.id);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        padding-left: 2px;
                        padding-right: 2px;
                        VerticalLayout {
                            alignment: center;
                            Icon { name: "swap"; tint: Theme.ink-3; width: 16px; height: 16px; }
                        }
                        Runs { runs: root.section.auto.off-runs; size: root.touch ? Type.small : 12.5px; ink: Theme.ink-3; strong-ink: Theme.ink-2; strong-weight: 600; }
                    }
                }
            }
        }
        // Switchable, stacked header (4.1.3): the auto-switch groups wrap as whole units under the
        // title; the info icon opens one inline tip with the switch's and the stepper's texts.
        if root.section.switchable && root.section.count > 0 && !root.table: VerticalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            padding-bottom: 12px;
            spacing: 0px;
            if root.section.auto.shown: VerticalLayout {
                spacing: 0px;
                auto-flex := FlexboxLayout {
                    spacing-horizontal: 12px;
                    spacing-vertical: 4px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: root.section.auto.enabled;
                                enabled: root.section.auto.available && (root.section.auto.enabled || root.section.auto.can-enable) && !root.busy;
                                label: "Auto-switch";
                                toggled(on) => { root.auto-toggled(root.section.id, on); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoIcon { tip-id: "auto:" + root.section.id; }
                        }
                    }
                    if root.section.auto.known: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "at"; font-size: Type.control; color: Theme.ink-2; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                value: root.threshold-shown;
                                min: root.section.auto.min;
                                max: root.section.auto.max;
                                known: root.section.auto.threshold-used >= 0;
                                enabled: root.section.auto.known && !root.busy;
                                step(d) => {
                                    root.pending = clamp(root.threshold-shown + d, root.section.auto.min, root.section.auto.max);
                                    release-pending.running = false;
                                    send-threshold.running = false;
                                    send-threshold.running = true;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "used"; font-size: Type.control; color: Theme.ink-2; }
                        }
                    }
                    if root.section.auto.pool != "": VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.section.auto.pool;
                            font-size: Type.small;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                    }
                }
                // one inline tip with both texts, one per line (5.4 #3)
                InlineTip {
                    tip-id: "auto:" + root.section.id;
                    text: root.section.auto.message + (root.section.auto.setting != "" ? "\n" + root.section.auto.setting : "");
                }
            }
            if !root.section.auto.shown: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 0;
                    padding-top: 1px;
                    Icon { name: "swap"; tint: Theme.ink-3; width: 16px; height: 16px; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    RunsFlow {
                        words: root.section.auto.off-words;
                        size: Type.small;
                        ink: Theme.ink-3;
                        strong-ink: Theme.ink-2;
                        strong-weight: 600;
                    }
                }
            }
        }
        if root.section.count > 0: Rectangle {
            background: Theme.paper-2;
            min-height: colhead.min-height;
            preferred-height: colhead.preferred-height;
            Rectangle { y: 0px; height: 1px; background: Theme.rule-2; }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.rule-2; }
            // The strip's opaque background covers the parent box's side borders, so the strip
            // redraws them itself: 1 px Theme.rule exactly on the box's edges, like the box's
            // own border (no inset gap, no double line). Painted after the hairlines so the
            // strip's corners keep the box's edge continuous.
            Rectangle { x: 0px; width: 1px; height: parent.height; background: Theme.rule; }
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.rule; }
            // the concept's .colhead: 8 px padding inside its two hairlines and an 11 px line at line-height 1.35.
            // Table: ACCOUNT over the account column. Stacked (4.1.2): one head per meter grid column.
            colhead := HorizontalLayout {
                padding-left: root.pad-x;
                padding-right: root.pad-x;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: root.col-gap;
                if root.table: Caps { width: root.ident-w; min-height: 15px; text: "ACCOUNT"; vertical-alignment: bottom; }
                for col in root.section.columns: Caps {
                    min-height: 15px;
                    min-width: root.table ? (Breakpoints.below-d ? 120px : 108px) : 0px;
                    preferred-width: !root.table && root.section.switchable ? root.cell-w : (root.table ? (root.touch ? 120px : 108px) : 0px);
                    horizontal-stretch: root.table || !root.section.switchable ? 1 : 0;
                    text: col.label.to-uppercase();
                    wrap: word-wrap;
                    overflow: clip;
                    vertical-alignment: bottom;
                }
                if root.table: Rectangle { width: root.slot-w; }
            }
        }
        rows-box := Rectangle {
            vertical-stretch: 1;
            min-height: rows.min-height;
            preferred-height: rows.preferred-height;
            if root.section.switchable: Rectangle {
                x: root.touch ? 6px : 8px;
                y: root.hl-y + 5px;
                width: parent.width - (root.touch ? 12px : 16px);
                height: max(0px, root.hl-h - 10px);
                border-radius: 10px;
                background: root.hl-flash ? Theme.flash : Theme.accent.mix(Theme.paper, root.hl-hover ? 0.11 : 0.07);
                border-width: root.touch ? 1.5px : 1px;
                border-color: root.touch ? Theme.accent : Theme.accent.mix(Theme.paper, 0.42);
                opacity: root.hl-on ? 1 : 0;
                animate y, height { duration: root.hl-glide ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                animate background {
                    duration: Motion.tint(root.hl-flash ? 0ms : root.hl-fade ? 620ms : 160ms);
                    easing: root.hl-fade ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1);
                }
            }
            rows := VerticalLayout {
                spacing: 0px;
                for row[i] in root.section.rows: AccountRow {
                    account: row;
                    section: root.section;
                    table: root.table;
                    ident-w: root.ident-w;
                    slot-w: root.slot-w;
                    gap: root.col-gap;
                    pad-x: root.pad-x;
                    grid-w: Breakpoints.tier-width - 2 * Breakpoints.gutter;
                    played: root.played;
                    delay: root.meter-delay + i * 48ms;
                    busy: root.busy;
                    selected: row.id == root.selected-id;
                    confirming: root.confirm-id == row.id;
                    notch-at: root.pending >= 0 ? root.pending : -1;
                    init => {
                        root.ident-max = max(root.ident-max, self.ident-natural);
                        root.slot-max = max(root.slot-max, self.slot-natural);
                        if row.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), false);
                        }
                    }
                    changed ident-natural => { root.ident-max = max(root.ident-max, self.ident-natural); }
                    changed slot-natural => { root.slot-max = max(root.slot-max, self.slot-natural); }
                    changed y => {
                        if self.account.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), false);
                        }
                    }
                    changed line-height => {
                        if self.account.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), false);
                        }
                    }
                    changed account => {
                        if self.account.active {
                            root.place(self.y, self.line-height - (self.last ? 0px : 1px), true);
                        }
                        if !self.account.confirm && root.confirm-id == self.account.id {
                            root.confirm-id = "";
                        }
                    }
                    changed hovered => {
                        if self.account.active {
                            root.hl-hover = self.hovered;
                        }
                    }
                    changed flashing => {
                        if self.account.active {
                            if !self.flashing {
                                root.hl-fade = true;
                                hl-fade-end.running = true;
                            }
                            root.hl-flash = self.flashing;
                        }
                    }
                    open-details(id) => { root.open-details(id); }
                    launch(id, target) => { root.launch(id, target); }
                    activate(kind, profile) => { root.activate(kind, profile); }
                    ask-confirm(id) => { root.confirm-id = id; }
                    cancel-confirm => { root.confirm-id = ""; }
                    go-accounts => { root.go-accounts(); }
                }
            }
        }
        if root.section.count == 0: HorizontalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            padding-bottom: 18px;
            Text { text: root.section.empty; font-size: 12.5px; color: Theme.ink-3; wrap: word-wrap; }
        }
        if root.section.foot.shown: Rectangle {
            min-height: foot.min-height;
            preferred-height: foot.preferred-height;
            Rectangle { y: 0px; height: 1px; background: Theme.rule-2; }
            // Measurers for fits-inline (never drawn, never hit-tested): direct children of
            // this box, never of `foot`, so they take no layout space on any tier. `visible:
            // false` only clips in Slint 1.18; inside `foot` they stretched the footer by two
            // text lines plus spacing below D (O2). preferred-* still report natural widths.
            when-probe := Text {
                visible: false;
                text: root.section.foot.when;
                font-family: Type.tab;
                font-size: root.touch ? Type.small : 12.5px;
            }
            runs-fit := Runs {
                visible: false;
                runs: root.section.foot.runs;
                size: root.touch ? Type.small : 12.5px;
                strong-weight: 640;
            }
            // the concept's .plate-foot: 12 px padding under its 1 px rule around a 12.5 px line at 1.45.
            // Below D the sentence wraps with no line limit and the "Checked" line drops to its own line
            // when the sentence does not leave it room (4.1.3).
            foot := VerticalLayout {
                padding-left: root.pad-x;
                padding-right: root.pad-x;
                padding-top: 13px;
                padding-bottom: 12px;
                spacing: Breakpoints.tier-d ? 0px : 6px;
                min-height: 13px + 18px + 12px;
                property <bool> fits-inline: Breakpoints.tier-d
                    || runs-fit.preferred-width + 16px + 8px + when-probe.preferred-width <= Breakpoints.tier-width - 2 * Breakpoints.gutter - 2 * root.pad-x;
                foot-line := HorizontalLayout {
                    spacing: 9px;
                    foot-icon := VerticalLayout {
                        alignment: root.table ? center : start;
                        horizontal-stretch: 0;
                        padding-top: root.table ? 0px : 2px;
                        Icon {
                            name: root.section.foot.warn ? "alert" : "swap";
                            tint: root.section.foot.warn ? Theme.warn-text : Theme.ink-3;
                            width: 16px;
                            height: 16px;
                        }
                    }
                    if Breakpoints.tier-d || foot.fits-inline: HorizontalLayout {
                        spacing: 0px;
                        Runs {
                            runs: root.section.foot.runs;
                            size: root.touch ? Type.small : 12.5px;
                            ink: root.section.foot.warn ? Theme.warn-text : Theme.ink-2;
                            strong-ink: root.section.foot.warn ? Theme.warn-text : Theme.ink;
                            strong-weight: 640;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if Breakpoints.tier-d || foot.fits-inline: Text {
                        text: root.section.foot.when;
                        font-family: Type.tab;
                        font-size: root.touch ? Type.small : 12.5px;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    if Breakpoints.below-d && !foot.fits-inline: VerticalLayout {
                        horizontal-stretch: 1;
                        RunsFlow {
                            words: root.section.foot.words;
                            size: Type.small;
                            ink: root.section.foot.warn ? Theme.warn-text : Theme.ink-2;
                            strong-ink: root.section.foot.warn ? Theme.warn-text : Theme.ink;
                        }
                    }
                }
                if Breakpoints.below-d && !foot.fits-inline: Text {
                    text: root.section.foot.when;
                    font-family: Type.tab;
                    font-size: Type.small;
                    color: Theme.ink-3;
                }
            }
        }
    }
}


// A dashed hairline (Slint draws no dash arrays): 3 px dashes, 3 px apart.
export component DashedRule inherits Rectangle {
    height: 1px;
    property <int> dashes: max(1, ceil(root.width / 6px));
    for i in root.dashes: Rectangle {
        x: i * 6px;
        y: 0px;
        width: min(3px, root.width - i * 6px);
        height: 1px;
        background: Theme.rule;
    }
}

// The concept's .amount: 7 px padding, an 18 px line (12.5 px at 1.45) and the sub line 6 px under it (its
// 8 px row gap less the sub's -2 px margin).
export component AmountLine inherits VerticalLayout {
    in property <AmountView> amount;
    in property <bool> rule-above;
    spacing: 0px;
    if root.rule-above: DashedRule { }
    HorizontalLayout {
        padding-top: 7px;
        padding-bottom: root.amount.sub != "" ? 6px : 7px;
        spacing: 8px;
        min-height: 18px + 7px + (root.amount.sub != "" ? 6px : 7px);
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon { name: root.amount.icon; tint: Theme.ink-3; width: 16px; height: 16px; }
        }
        Text {
            text: root.amount.label;
            font-size: Breakpoints.below-d ? Type.small : 12.5px;
            color: Theme.ink-2;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 4px;
            Text {
                text: root.amount.value;
                font-family: Type.tab;
                font-size: Breakpoints.below-d ? Type.small : 12.5px;
                font-weight: 600;
                color: root.amount.spent ? Theme.crit-text : Theme.ink;
                vertical-alignment: center;
            }
            if root.amount.unit != "": Text {
                text: root.amount.unit;
                font-family: Type.tab;
                font-size: Type.small;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }
    }
    if root.amount.sub != "": HorizontalLayout {
        padding-left: 26px;
        padding-bottom: 7px;
        Text { min-height: 17.5px; vertical-alignment: center; text: root.amount.sub; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
    }
}

component CardNote inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    spacing: 7px;
    if root.icon != "": VerticalLayout {
        alignment: start;
        padding-top: 1px;
        horizontal-stretch: 0;
        Icon { name: root.icon; tint: Theme.ink-3; width: 15px; height: 15px; }
    }
    Text { text: root.text; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; horizontal-stretch: 1; }
}

export component ProviderCard inherits Card {
    in property <ProviderCardView> card;
    in property <bool> played;
    in property <duration> delay;
    in property <string> selected-id;
    selected: root.card.account-id == root.selected-id && root.selected-id != "";
    pad: Breakpoints.tier-p ? 16px : 18px;
    pad-top: 16px;
    pad-bottom: 12px;
    min-width: 240px;
    // a wide card puts its meters side by side; a wider one its amounts in two columns. Below D the
    // meters stack as full-width cells and the amounts stay one per line (4.1.4).
    property <bool> wide: Breakpoints.tier-d && root.width >= 560px;
    property <bool> amt2: Breakpoints.tier-d && root.width >= 700px;
    property <int> flash-phase: 0;
    flash: root.flash-phase == 1;
    flash-on := Timer {
        interval: 30ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 2; flash-off.running = true; }
    }
    flash-off := Timer {
        interval: 650ms;
        running: false;
        triggered => { self.running = false; root.flash-phase = 0; }
    }

    HorizontalLayout {
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            ProviderMark { provider: root.card.provider; size: Breakpoints.below-d ? 24px : 26px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            horizontal-stretch: 1;
            Rectangle {
                min-height: 21.5px;
                name := Text {
                    x: 0px;
                    y: (parent.height - self.preferred-height) / 2;
                    width: min(self.preferred-width, parent.width);
                    text: root.card.label;
                    font-size: Breakpoints.below-d ? Type.control : 15px;
                    font-weight: Breakpoints.below-d ? 600 : 630;
                    letter-spacing: -0.075px;
                    color: Theme.ink;
                    overflow: elide;
                }
                if root.card.plan != "": Text {
                    x: name.width + 6px;
                    y: name.font-metrics.ascent - self.font-metrics.ascent;
                    width: max(0px, parent.width - self.x);
                    text: root.card.plan;
                    font-size: Breakpoints.below-d ? Type.small : 12.5px;
                    font-weight: 450;
                    color: Theme.ink-3;
                    overflow: elide;
                }
            }
            Text { min-height: 17.5px; vertical-alignment: center; text: root.card.identity; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
        }
    }
    Rectangle { height: 14px; }
    // (Slint 1.18.1: a GridLayout whose repeater starts empty and fills later can panic in layout.rs, so
    // every repeated grid here is created only once its model has rows.)
    if root.card.meters.length > 0: GridLayout {
        spacing-horizontal: 26px;
        spacing-vertical: 14px;
        for m[k] in root.card.meters: Meter {
            row: root.wide ? 0 : k;
            col: root.wide ? k : 0;
            horizontal-stretch: 1;
            min-width: 100px;
            data: m;
            cell: Breakpoints.below-d;
            inline: Breakpoints.tier-d;
            played: root.played;
            delay: root.delay + k * 16ms;
            hot: root.hovered && Device.hover;
            owner-label: root.card.label + " · " + root.card.identity;
            clicked => { root.clicked(); }
            value-changed => {
                if Motion.on {
                    root.flash-phase = 1;
                    flash-on.running = true;
                }
            }
        }
    }
    if root.card.meters.length == 0 && root.card.note != "": CardNote { text: root.card.note; }
    if root.card.plan-note != "": VerticalLayout {
        padding-top: 10px;
        CardNote { icon: "calendar"; text: root.card.plan-note; }
    }
    if root.card.amounts.length > 0: VerticalLayout {
        padding-top: 12px;
        spacing: 0px;
        Rectangle { height: 1px; background: Theme.rule-2; }
        Rectangle { height: 4px; }
        GridLayout {
            spacing-horizontal: 26px;
            spacing-vertical: 0px;
            for a[j] in root.card.amounts: AmountLine {
                row: root.amt2 ? floor(j / 2) : j;
                col: root.amt2 ? mod(j, 2) : 0;
                amount: a;
                rule-above: root.amt2 ? j >= 2 : j >= 1;
            }
        }
        if root.card.packs-note != "": VerticalLayout {
            DashedRule { }
            HorizontalLayout {
                padding-top: 7px;
                padding-bottom: 2px;
                CardNote { icon: "calendar"; text: root.card.packs-note; }
            }
        }
    }
    if root.card.meters.length > 0 && root.card.note != "": VerticalLayout {
        padding-top: 10px;
        CardNote { text: root.card.note; }
    }
    Rectangle { height: 14px; }
    Rectangle { height: 1px; background: Theme.rule-2; }
    // the concept's .pcard-foot: 11 px over a 12 px line at 1.45
    HorizontalLayout {
        padding-top: 11px;
        spacing: 8px;
        min-height: 11px + 17.5px;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            if root.card.flag != "": Text { text: root.card.flag; font-size: Type.small; font-weight: 600; color: Theme.warn-text; horizontal-stretch: 0; vertical-alignment: center; }
            if root.card.flag != "": Text { text: " · "; font-size: Type.small; color: Theme.ink-3; horizontal-stretch: 0; vertical-alignment: center; }
            Text { text: root.card.sampled; font-family: Type.tab; font-size: Type.small; color: Theme.ink-3; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        }
        Text { text: root.card.platform; font-size: Type.small; color: Theme.ink-3; horizontal-stretch: 0; vertical-alignment: center; }
    }
}

export component HomePage inherits Rectangle {
    in property <[SectionView]> sections;
    in property <[ProviderCardView]> cards;
    in property <bool> busy;
    in property <bool> ready;
    in property <string> selected-id;
    // the first page of the session loads in more slowly than a page change
    in property <bool> first: true;
    callback open-details(string);
    callback launch(string, string);
    callback activate(string, string);
    callback auto-toggled(string, bool);
    callback threshold-picked(string, string);
    callback go-analytics();
    callback go-accounts();

    property <length> gap: Breakpoints.ultra ? 24px : Breakpoints.tier-d ? 20px : Breakpoints.tier-t ? 20px : Breakpoints.tier-f ? 16px : 12px;
    // wide and ultra: Claude and Codex side by side (7:5, ultra 4:3) at the same height; the rest full width
    property <bool> pair: Breakpoints.tier-d && Breakpoints.at-least-wide && root.sections.length >= 2 && root.sections[0].id == "claude" && root.sections[1].id == "codex";
    pure function pair-w(s: int) -> length {
        if Breakpoints.ultra {
            return (root.width - root.gap) * (s == 0 ? 4 : 3) / 7;
        }
        return (root.width - root.gap) * (s == 0 ? 7 : 5) / 12;
    }
    property <duration> reveal-base: root.first ? 180ms : 40ms;
    property <duration> meter-base: root.first ? 380ms : 220ms;
    // rows one and a half staggers apart across the whole page, in reading order
    pure function rows-before(s: int) -> int {
        if s <= 0 {
            return 0;
        }
        if s == 1 {
            return root.sections[0].count;
        }
        if s == 2 {
            return root.sections[0].count + root.sections[1].count;
        }
        return root.sections[0].count + root.sections[1].count + root.sections[2].count;
    }
    property <int> all-rows: root.rows-before(root.sections.length);

    // Other providers: rows of equal-width cards in one stable order, heights following content. The
    // column count is what fits at 300 px; the cards are spread over the fewest rows, the longer rows
    // first, and each row's cards share its width (a GridLayout over the rows' least common multiple).
    property <int> n: root.cards.length;
    // D keeps today's what-fits-at-320 formula; below D it is clamp(floor((content + 16) / 288), 1, 3)
    // (1.5), so P gets one column, F two and T three.
    property <int> cmax: Breakpoints.tier-d ? clamp(floor((root.width + 20px) / 320px), 1, 6)
        : clamp(floor((root.width + 16px) / 288px), 1, 3);
    property <int> per-row: min(root.cmax, max(1, root.n));
    property <int> nrows: max(1, ceil(root.n / root.per-row));
    property <int> base: max(1, floor(root.n / root.nrows));
    property <int> extra: mod(root.n, root.nrows);
    property <int> big: root.extra * (root.base + 1);
    property <int> lcm: root.extra > 0 ? root.base * (root.base + 1) : root.base;

    min-height: page.preferred-height;
    preferred-height: page.preferred-height;

    page := VerticalLayout {
        spacing: root.gap;
        if root.sections.length > 0: GridLayout {
            spacing: root.gap;
            for section[s] in root.sections: Reveal {
                row: root.pair ? max(0, s - 1) : s;
                col: root.pair && s == 1 ? 1 : 0;
                colspan: root.pair && s < 2 ? 1 : 2;
                // the pair's widths are fixed so the split is exactly 7:5 (ultra 4:3) whatever its contents
                min-width: !root.pair || s >= 2 ? 0px : root.pair-w(s);
                max-width: !root.pair || s >= 2 ? 100000px : root.pair-w(s);
                delay: root.reveal-base + s * 40ms;
                armed: root.ready;
                AccountSection {
                    vertical-stretch: 1;
                    section: section;
                    played: root.ready;
                    busy: root.busy;
                    selected-id: root.selected-id;
                    meter-delay: root.meter-base + root.rows-before(s) * 48ms;
                    open-details(id) => { root.open-details(id); }
                    launch(id, target) => { root.launch(id, target); }
                    activate(kind, profile) => { root.activate(kind, profile); }
                    auto-toggled(id, on) => { root.auto-toggled(id, on); }
                    threshold-picked(id, v) => { root.threshold-picked(id, v); }
                    go-analytics => { root.go-analytics(); }
                    go-accounts => { root.go-accounts(); }
                }
            }
        }
        if root.cards.length > 0: Reveal {
            delay: root.reveal-base + root.sections.length * 40ms;
            armed: root.ready;
            HorizontalLayout {
                padding-top: 10px;
                padding-left: 2px;
                padding-right: 2px;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: label.preferred-width + 12px + count.preferred-width;
                    min-height: label.preferred-height;
                    label := Text {
                        x: 0px;
                        y: 0px;
                        text: "Other providers";
                        font-size: Type.title;
                        font-weight: 630;
                        letter-spacing: -0.2px;
                        color: Theme.ink;
                    }
                    count := Text {
                        x: label.preferred-width + 12px;
                        y: label.font-metrics.ascent - self.font-metrics.ascent;
                        text: root.n + (root.n == 1 ? " account" : " accounts");
                        font-family: Type.tab;
                        font-size: 13.5px;
                        color: Theme.ink-3;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle { height: 1px; background: Theme.rule; }
                }
            }
        }
        if root.cards.length > 0: Reveal {
            delay: root.reveal-base + (root.sections.length + 1) * 40ms;
            armed: root.ready;
            GridLayout {
                spacing: Breakpoints.tier-p ? 12px : Breakpoints.tier-d ? 20px : 16px;
                for card[i] in root.cards: Rectangle {
                    row: i < root.big ? floor(i / (root.base + 1)) : root.extra + floor((i - root.big) / root.base);
                    col: (i < root.big ? mod(i, root.base + 1) : mod(i - root.big, root.base)) * (root.lcm / (i < root.big ? root.base + 1 : root.base));
                    colspan: root.lcm / (i < root.big ? root.base + 1 : root.base);
                    horizontal-stretch: 1;
                    min-width: 240px;
                    preferred-width: 240px;
                    min-height: pc.preferred-height;
                    preferred-height: pc.preferred-height;
                    pc := ProviderCard {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: self.preferred-height;
                        card: card;
                        played: root.ready;
                        delay: root.meter-base + (root.all-rows + i) * 48ms;
                        selected-id: root.selected-id;
                        clicked => { root.open-details(card.account-id); }
                    }
                }
            }
        }
    }
}
