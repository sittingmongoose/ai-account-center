// The settings column of Accounts & Settings (concept: settingsHTML in app-accounts.js and the Dashboard sign-in
// block of app-auth.js): Sign-in & connection, Settings (appearance, usage refresh, auto-switch policies), Update
// apps results and About with Slint's AboutSlint attribution.
import { AboutSlint } from "std-widgets.slint";
import { Theme, Motion, Type, Breakpoints, Device } from "../../theme.slint";
import { RunView, FactView } from "../../models.slint";
import { Icon } from "../../components/icon.slint";
import { ProviderMark, PlatformGlyph } from "../../components/mark.slint";
import { AppLogo } from "../../components/logo.slint";
import { Caps } from "../../components/text.slint";
import { Button } from "../../components/button.slint";
import { Toggle } from "../../components/toggle.slint";
import { Segmented, SegItem } from "../../components/segmented.slint";
import { Select } from "../../components/select.slint";
import { Plate } from "../../components/card.slint";
import { Stepper, Runs, DashedRule } from "../home.slint";
import { AcData, AcPolicy, AcUpdHost, AcUpdItem, AcDevice } from "ac-data.slint";
import { ComingWord, TipArea, IconNote, ActionControl, StretchSegmented, BoundToggle } from "ac-actions.slint";
import { InfoIcon, InlineTip } from "../../components/info-tip.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Field } from "../../components/field.slint";
import { ProbeMark } from "../../components/probe.slint";
import { StrengthMeter } from "../../shell/signin.slint";

// A settings card: the title (and an optional quiet note or "coming" on its right), then its items.
component SetGroup inherits Plate {
    in property <string> title;
    in property <string> note;
    in property <bool> coming: false;
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    col := VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            padding-left: Breakpoints.tier-p ? 16px : Breakpoints.below-d ? 20px : 18px;
            padding-right: Breakpoints.tier-p ? 16px : Breakpoints.below-d ? 20px : 18px;
            padding-top: 15px;
            padding-bottom: 4px;
            spacing: 10px;
            Text { text: root.title; font-size: Breakpoints.below-d ? Type.title : 16px; font-weight: 640; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle { horizontal-stretch: 1; }
            // the note (the Update apps "Runs from ..." copy) wraps under instead of eliding on narrow cards
            if root.note != "": Text { text: root.note; font-size: Breakpoints.tier-d ? 12.5px : Type.small; color: Theme.ink-3; vertical-alignment: center; min-width: 0px; wrap: word-wrap; }
            if root.coming: ComingWord { }
        }
        @children
    }
}

// One block inside a settings card, with the hairline above it (the first one has none).
component SetItem inherits VerticalLayout {
    in property <bool> first: false;
    in property <string> label;
    in property <string> aside;
    in property <bool> aside-strong: false;
    // an inline info icon after the label (5.2.1); its body is a child InlineTip with the same tip-id
    in property <string> info-id: "";
    padding-left: Breakpoints.tier-p ? 16px : Breakpoints.below-d ? 20px : 18px;
    padding-right: Breakpoints.tier-p ? 16px : Breakpoints.below-d ? 20px : 18px;
    padding-top: root.first ? 9px : 13px;
    padding-bottom: 13px;
    spacing: 9px;
    if root.label != "": HorizontalLayout {
        spacing: 10px;
        Text { text: root.label; font-size: 13.5px; font-weight: 600; color: Theme.ink; horizontal-stretch: 0; vertical-alignment: center; }
        // `if`, not `visible`: a hidden icon must take no space, so D measures exactly as before
        if root.info-id != "" && (Device.coarse || Breakpoints.below-d): VerticalLayout { alignment: center; InfoIcon { tip-id: root.info-id; } }
        Rectangle { horizontal-stretch: 1; }
        if root.aside != "": Text {
            text: root.aside;
            font-family: root.aside-strong ? Type.tab : Type.sans;
            font-size: root.aside-strong ? 13.5px : 12.5px;
            font-weight: root.aside-strong ? 640 : 400;
            color: root.aside-strong ? Theme.ink : Theme.ink-3;
            vertical-alignment: center;
            min-width: 0px;
            overflow: elide;
        }
    }
    @children
}
component Hairline inherits Rectangle { height: 1px; background: Theme.rule-2; }

// A five-segment choice that wraps to rows of 3 + 2 when each segment would be under 64 px wide
// (DESIGN-MOBILE.md 1.5); one row uses the equal-width StretchSegmented. `row-1` / `row-2` carry the
// same items split for the wrapped rows (Slint has no model slicing).
component WrapSegmented inherits VerticalLayout {
    in property <[SegItem]> items;
    in property <[SegItem]> row-1;
    in property <[SegItem]> row-2;
    in-out property <string> value;
    in property <bool> enabled: true;
    // the width the control may use (its column's inner width); the segment test needs it ahead of
    // layout, because the wrapped branch changes the control's own height
    in property <length> avail;
    callback changed-value(string);
    property <int> n: root.items.length;
    property <bool> one-row: root.n == 0 || (root.avail - 8px - 4px * max(0, root.n - 1)) / root.n >= 64px;
    spacing: 8px;
    if root.one-row: StretchSegmented {
        items: root.items;
        value: root.value;
        enabled: root.enabled;
        changed-value(v) => { root.changed-value(v); }
    }
    if !root.one-row: StretchSegmented {
        items: root.row-1;
        value: root.value;
        enabled: root.enabled;
        changed-value(v) => { root.changed-value(v); }
    }
    if !root.one-row: StretchSegmented {
        items: root.row-2;
        value: root.value;
        enabled: root.enabled;
        changed-value(v) => { root.changed-value(v); }
    }
}

// A label and its value (the concept's dl.conn / dl.aa-facts): the label in a fixed column, the value wrapping
// beside it. The value sits directly in a VerticalLayout so its wrapped height is measured at its real width.
component FactLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    in property <bool> strong: false;
    in property <length> label-w: 112px;
    min-height: lay.preferred-height;
    preferred-height: lay.preferred-height;
    lay := VerticalLayout {
        padding-left: root.label-w + 12px;
        Text {
            text: root.value;
            font-family: root.mono ? Type.mono : Type.tab;
            font-size: root.mono ? 11.5px : 13px;
            font-weight: root.strong ? 620 : 400;
            color: Theme.ink;
            wrap: word-wrap;
        }
    }
    Text { x: 0px; y: root.mono ? 1px : 0.5px; width: root.label-w; text: root.label; font-size: 12.5px; color: Theme.ink-3; }
}
component Facts inherits VerticalLayout {
    in property <[FactView]> facts;
    in property <length> label-w: 112px;
    spacing: 8px;
    for f in root.facts: FactLine { label: f.label; value: f.value; mono: f.mono; label-w: root.label-w; }
}

// Usage refresh: any whole number of seconds from 30 to 3600 on a log scale, snapping to the marks within 3.5% of
// the track. The value is saved when the pointer is released (PUT /api/accounts/settings).
export component RefreshSlider inherits Rectangle {
    in property <int> seconds;
    in property <bool> enabled: true;
    callback committed(int);
    out property <int> shown: root.dragging || root.pending > 0 ? root.pending : root.seconds;
    property <bool> dragging: false;
    property <int> pending: 0;
    // the saved value arrives with the next settings answer; then the pending one is released
    property <int> reported: root.seconds;
    changed reported => { if !root.dragging { root.pending = 0; } }
    release := Timer { interval: 5s; running: false; triggered => { self.running = false; if !root.dragging { root.pending = 0; } } }

    pure function pos(s: int) -> float {
        return (ln(clamp(s, 30, 3600)) - ln(30)) / (ln(3600) - ln(30));
    }
    pure function from(x: float) -> int {
        if abs(x - root.pos(30)) < 0.035 { return 30; }
        if abs(x - root.pos(60)) < 0.035 { return 60; }
        if abs(x - root.pos(120)) < 0.035 { return 120; }
        if abs(x - root.pos(300)) < 0.035 { return 300; }
        if abs(x - root.pos(600)) < 0.035 { return 600; }
        if abs(x - root.pos(900)) < 0.035 { return 900; }
        if abs(x - root.pos(1800)) < 0.035 { return 1800; }
        if abs(x - root.pos(3600)) < 0.035 { return 3600; }
        return clamp(round(exp(ln(30) + clamp(x, 0, 1) * (ln(3600) - ln(30)))), 30, 3600);
    }
    property <length> px: root.pos(root.shown) * root.width;
    property <bool> settle: !root.dragging;
    height: 44px;
    // the touch thumb (DESIGN-MOBILE.md 2.3): 24 on T, 28 on F and P; the desktop keeps its 18 px thumb
    property <length> thumb-r: Breakpoints.tier-d ? 9px : Breakpoints.tier-t ? 12px : 14px;
    opacity: root.enabled ? 1 : 0.5;

    Rectangle { x: 0px; y: 11px; width: root.width; height: 6px; border-radius: 3px; background: Theme.track; }
    Rectangle {
        x: 0px;
        y: 11px;
        width: root.px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
        animate width { duration: root.settle && Motion.on ? 300ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        Rectangle { border-radius: 3px; background: @linear-gradient(90deg, Theme.fill-wash 0%, Theme.fill-wash.with-alpha(0) 100%); }
    }
    for s in [30, 60, 120, 300, 600, 900, 1800, 3600]: Rectangle {
        x: root.pos(s) * root.width;
        y: 21px;
        width: 1px;
        height: 5px;
        background: Theme.rule-strong;
    }
    for l[i] in [{ s: 30, t: "30 s" }, { s: 120, t: "2 min" }, { s: 600, t: "10 min" }, { s: 3600, t: "60 min" }]: Text {
        x: i == 0 ? 0px : i == 3 ? root.width - self.preferred-width : root.pos(l.s) * root.width - self.preferred-width / 2;
        y: 28px;
        text: l.t;
        font-family: Type.mono;
        font-size: Type.caption;
        color: Theme.ink-3;
    }
    thumb := Rectangle {
        x: root.px - root.thumb-r;
        y: 14px - root.thumb-r;
        width: root.thumb-r * 2;
        height: root.thumb-r * 2;
        border-radius: root.thumb-r;
        background: Theme.paper;
        border-width: 2px;
        border-color: Theme.accent;
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        transform-scale: root.dragging ? 1.22 : ta.has-hover && root.enabled ? 1.12 : 1;
        animate transform-scale { duration: Motion.on ? 200ms : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        animate x { duration: root.settle && Motion.on ? 300ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.dragging = true;
                root.pending = root.from(self.mouse-x / max(1px, root.width));
            }
            if e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                if root.pending != root.seconds {
                    release.running = false;
                    release.running = true;
                    root.committed(root.pending);
                } else {
                    root.pending = 0;
                }
            }
        }
        moved => {
            if root.dragging { root.pending = root.from(self.mouse-x / max(1px, root.width)); }
        }
    }
}
global AcFormat {
    // "30 s", "1 min", "7 min 17 s" (public/view-model.mjs intervalLabel).
    public pure function interval(s: int) -> string {
        if s < 60 { return s + " s"; }
        if mod(s, 60) == 0 { return floor(s / 60) + " min"; }
        return floor(s / 60) + " min " + mod(s, 60) + " s";
    }
}

// The "at N% used" half of a policy row (4.3.7): beside the [mark name switch] group when the row's
// width fits both, stacked under it otherwise (the wrap is decided from measured widths, PolicyRow).
component PolicyAtRow inherits HorizontalLayout {
    in property <int> shown;
    in property <int> min: 50;
    in property <int> max: 99;
    in property <bool> known: true;
    in property <bool> enabled: true;
    in property <bool> wait: false;
    callback step(int);
    spacing: 8px;
    alignment: start;
    opacity: root.wait ? 0.5 : 1;
    Text { text: "at"; font-size: 13px; color: Theme.ink-3; vertical-alignment: center; }
    VerticalLayout {
        alignment: center;
        Stepper {
            value: root.shown;
            min: root.min;
            max: root.max;
            known: root.known;
            enabled: root.enabled;
            step(d) => { root.step(d); }
        }
    }
    Text { text: "used"; font-size: 13px; color: Theme.ink-3; vertical-alignment: center; }
}

component PolicyRow inherits VerticalLayout {
    in property <AcPolicy> policy;
    in property <bool> busy;
    // the row's inner width (the settings card's width less the item's padding), passed down from the
    // settings column: the wrap below must be decided ahead of layout
    in property <length> avail: 0px;
    callback act(string, string);
    property <int> pending: -1;
    property <int> shown: root.pending >= 0 ? root.pending : root.policy.threshold;
    property <int> reported: root.policy.threshold;
    changed reported => { if root.pending == root.reported { root.pending = -1; } }
    // below D a tap on the dimmed row's toggle opens its reason under the row (5.2.2)
    property <bool> show-reason: false;
    function queue-step(d: int) {
        root.pending = clamp(root.shown + d, root.policy.min, root.policy.max);
        release.running = false;
        send.running = false;
        send.running = true;
    }
    send := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending >= 0 {
                root.act(root.policy.provider == "antigravity" ? "antigravity-threshold" : "threshold", root.pending + "%");
                release.running = true;
            }
        }
    }
    release := Timer { interval: 5s; running: false; triggered => { self.running = false; root.pending = -1; } }
    spacing: 2px;
    opacity: root.policy.toggle-enabled ? 1 : 0.55;
    animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    // below D the control wraps as two whole groups: [mark name switch] and [at stepper used] (4.3.7).
    // Not a FlexboxLayout: a wrapping FlexboxLayout reports a one-line preferred height, so the card
    // measured too short and its last row ran past the card's bottom edge (task 9 O9). Plain rows
    // measure exactly, so the wrap is a measured choice between one row and two: the groups' natural
    // width (mark 20, switch and stepper are fixed; the texts report their preferred-width) against
    // the row's inner width.
    if Breakpoints.below-d: pol := VerticalLayout {
        spacing: 8px;
        property <bool> one-line: root.avail > 0px
            && 20px + 8px + max(76px, pname.preferred-width) + 8px + pt.preferred-width
                + 8px + at-m.preferred-width + 8px + 130px + 8px + used-m.preferred-width <= root.avail;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            VerticalLayout { alignment: center; ProviderMark { provider: root.policy.provider; size: 20px; } }
            pname := Text { min-width: 76px; text: root.policy.name; font-size: 13px; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; overflow: elide; }
            TipArea {
                owner: "policy:" + root.policy.provider;
                tip: root.policy.tip;
                width: pt.preferred-width;
                height: 44px;
                horizontal-stretch: 0;
                clicked => { if !root.policy.toggle-enabled { root.show-reason = !root.show-reason; } }
                pt := BoundToggle {
                    y: (parent.height - self.height) / 2;
                    model-on: root.policy.enabled;
                    enabled: root.policy.toggle-enabled && !root.busy;
                    toggled(on) => { root.act(root.policy.provider == "antigravity" ? "antigravity-automatic" : "automatic", on ? "true" : "false"); }
                }
                // measurers for the wrap decision (never drawn, never hit-tested): visible:false still
                // takes layout space in Slint 1.18, so they are zero-sized (88e3b13a) and only their
                // preferred-width is read. They live in this TouchArea, not in a layout, whose spacing
                // would count a zero-sized child.
                at-m := Text { x: 0px; y: 0px; visible: false; width: 0px; height: 0px; text: "at"; font-size: 13px; }
                used-m := Text { x: 0px; y: 0px; visible: false; width: 0px; height: 0px; text: "used"; font-size: 13px; }
            }
            if pol.one-line: PolicyAtRow {
                shown: root.shown;
                min: root.policy.min;
                max: root.policy.max;
                known: root.policy.threshold >= 0;
                enabled: root.policy.step-enabled && !root.busy;
                wait: root.policy.wait;
                step(d) => { root.queue-step(d); }
            }
        }
        if !pol.one-line: PolicyAtRow {
            shown: root.shown;
            min: root.policy.min;
            max: root.policy.max;
            known: root.policy.threshold >= 0;
            enabled: root.policy.step-enabled && !root.busy;
            wait: root.policy.wait;
            step(d) => { root.queue-step(d); }
        }
    }
    if !Breakpoints.below-d: HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center; ProviderMark { provider: root.policy.provider; size: 20px; } }
        Text { min-width: 76px; text: root.policy.name; font-size: 13px; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; overflow: elide; }
        TipArea {
            owner: "policy:" + root.policy.provider;
            tip: root.policy.tip;
            width: pt-d.preferred-width;
            horizontal-stretch: 0;
            pt-d := BoundToggle {
                y: (parent.height - self.height) / 2;
                model-on: root.policy.enabled;
                enabled: root.policy.toggle-enabled && !root.busy;
                toggled(on) => { root.act(root.policy.provider == "antigravity" ? "antigravity-automatic" : "automatic", on ? "true" : "false"); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            horizontal-stretch: 0;
            alignment: start;
            opacity: root.policy.wait ? 0.5 : 1;
            Text { text: "at"; font-size: 13px; color: Theme.ink-3; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Stepper {
                    value: root.shown;
                    min: root.policy.min;
                    max: root.policy.max;
                    known: root.policy.threshold >= 0;
                    enabled: root.policy.step-enabled && !root.busy;
                    step(d) => {
                        root.pending = clamp(root.shown + d, root.policy.min, root.policy.max);
                        release.running = false;
                        send.running = false;
                        send.running = true;
                    }
                }
            }
            Text { text: "used"; font-size: 13px; color: Theme.ink-3; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // the reason a tap on the dimmed row opened (5.2.2), then the status sentence (no line limit)
    if root.show-reason && !root.policy.toggle-enabled && root.policy.tip != "": Text {
        text: root.policy.tip;
        font-size: Type.small;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
    // under the name, after the mark and its gap
    if root.policy.sub != "": VerticalLayout {
        padding-left: 28px;
        Text {
            text: root.policy.sub;
            font-size: Type.small;
            color: root.policy.warn ? Theme.warn-text : Theme.ink-3;
            wrap: word-wrap;
        }
    }
}

// One Update apps result line: the app and what happened, on a dashed rule; a quiet bar runs while it is busy.
component UpdLine inherits VerticalLayout {
    in property <AcUpdItem> item;
    in property <bool> first;
    spacing: 0px;
    if !root.first: DashedRule { }
    TipArea {
        owner: "upd:" + root.item.key;
        tip: root.item.tip;
        min-height: 30px;
        // below D the app name and its result sit on their own lines, so a long result wraps
        if Breakpoints.below-d: VerticalLayout {
            spacing: 1px;
            Text { text: root.item.app; font-size: Type.small; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if root.item.result != "": Text {
                text: root.item.result;
                font-size: Type.small;
                font-weight: root.item.tone == "good" ? 600 : 400;
                color: root.item.tone == "good" ? Theme.good-text : root.item.tone == "crit" ? Theme.crit-text : root.item.tone == "run" ? Theme.accent-text : root.item.tone == "warn" ? Theme.warn-text : Theme.ink-3;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if !Breakpoints.below-d: HorizontalLayout {
            spacing: 10px;
            Text { text: root.item.app; font-size: 12.5px; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text {
                text: root.item.result;
                font-size: 12.5px;
                font-weight: root.item.tone == "good" ? 600 : 400;
                color: root.item.tone == "good" ? Theme.good-text : root.item.tone == "crit" ? Theme.crit-text : root.item.tone == "run" ? Theme.accent-text : root.item.tone == "warn" ? Theme.warn-text : Theme.ink-3;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }
        if root.item.running: Rectangle {
            y: parent.height - 3px;
            height: 3px;
            border-radius: 2px;
            background: Theme.track;
            clip: true;
            Rectangle {
                // one segment travelling while the host is busy (stops when it is not)
                x: (mod(animation-tick() / 1400ms, 1) * 1.3 - 0.3) * parent.width;
                width: parent.width * 0.3;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
}

// A check box with its label (the concept's `.aa-check`): a 16 px box that fills with the accent and a check.
component CheckLine inherits Rectangle {
    in-out property <bool> checked: true;
    in property <string> text;
    in property <string> sub;
    in property <bool> enabled: true;
    in property <string> probe;
    callback toggled(bool);
    // the touch box (DESIGN-MOBILE.md 2.3): 20 on T, 22 on F and P; desktop keeps 16
    property <length> box: Breakpoints.tier-d ? 16px : Breakpoints.tier-t ? 20px : 22px;
    min-height: Breakpoints.below-d ? 44px : 22px;
    preferred-width: row.preferred-width;
    // the note sits under the label (never beside it): side by side they are wider than the settings
    // column, and the column would grow past the page to fit them
    row := HorizontalLayout {
        spacing: 9px;
        alignment: start;
        opacity: root.enabled ? 1 : 0.5;
        VerticalLayout {
            alignment: start;
            padding-top: Breakpoints.tier-d ? (root.sub == "" ? 3px : 1px) : root.sub == "" ? (44px - root.box) / 2 : (40px - root.box) / 2;
            Rectangle {
                width: root.box;
                height: root.box;
                border-radius: root.box / 4;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : Theme.rule-strong;
                background: root.checked ? Theme.accent : Theme.paper;
                animate background, border-color { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.65, 0, 0.35, 1); }
                Icon { x: (parent.width - 13px) / 2; y: (parent.height - 13px) / 2; width: 13px; height: 13px; name: "check"; tint: Theme.accent-ink; opacity: root.checked ? 1 : 0; animate opacity { duration: Motion.on ? Motion.fast : 0ms; } }
            }
        }
        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text { text: root.text; font-size: 12.5px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
            if root.sub != "": Text { text: root.sub; font-family: Type.tab; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; overflow: elide; }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
    ProbeMark { x: 0px; y: 0px; width: root.box; height: root.height; id: root.probe; }
}

// A block that opens and closes by its height (ease-out in, in-out out); its content fades in a little after.
component Collapse inherits Rectangle {
    in property <bool> open;
    property <length> natural: lay.preferred-height;
    height: root.open ? root.natural : 0px;
    animate height { duration: Motion.on ? (root.open ? Motion.med : 220ms) : 0ms; easing: root.open ? cubic-bezier(0.2, 0.8, 0.2, 1) : cubic-bezier(0.65, 0, 0.35, 1); }
    clip: true;
    lay := VerticalLayout {
        y: 0px;
        height: root.natural;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Motion.on ? (root.open ? Motion.med : 160ms) : 0ms; delay: Motion.on && root.open ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        @children
    }
}

// An inline confirmation (the concept's `.aa-confirm`): the alert icon, the question in bold and what follows,
// then the confirm and cancel buttons.
component ConfirmBlock inherits Rectangle {
    in property <string> lead;
    in property <string> text;
    in property <string> confirm-label;
    in property <string> probe;
    in property <bool> busy;
    callback confirmed();
    callback cancelled();
    min-height: lay.preferred-height;
    preferred-height: lay.preferred-height;
    border-radius: 10px;
    background: Theme.paper-2;
    border-width: 1px;
    border-color: Theme.rule;
    lay := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 10px;
        Rectangle {
            min-height: q.preferred-height;
            preferred-height: q.preferred-height;
            q := VerticalLayout {
                padding-left: 25px;
                StyledText {
                    text: @markdown("**\{root.lead}** \{root.text}");
                    default-color: Theme.ink-2;
                    default-font-size: 12.5px;
                }
            }
            Icon { x: 0px; y: 1px; width: 16px; height: 16px; name: "alert"; tint: Theme.warn-text; }
        }
        HorizontalLayout {
            padding-left: 25px;
            spacing: 8px;
            alignment: start;
            Button { small: true; kind: "danger-solid"; text: root.confirm-label; busy: root.busy; probe: root.probe; clicked => { root.confirmed(); } }
            Button { small: true; kind: "ghost"; text: "Cancel"; enabled: !root.busy; probe: root.probe + ":cancel"; clicked => { root.cancelled(); } }
        }
    }
}

// One paired tray: its platform glyph, name, where and when it was last seen, and Revoke with its confirmation.
component DeviceRow inherits VerticalLayout {
    in property <AcDevice> device;
    in property <bool> confirming;
    in property <bool> busy;
    in property <bool> revoking;
    callback ask();
    callback cancel();
    callback revoke();
    spacing: 0px;
    TipArea {
        owner: "device:" + root.device.id;
        tip: root.device.tip;
        min-height: 44px;
        HorizontalLayout {
            spacing: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            // the platform glyph alone, in ink (the concept's .aa-plat: no box behind it)
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Rectangle {
                    width: 22px;
                    height: 18px;
                    if root.device.platform != "": PlatformGlyph { x: 0px; y: 0.5px; width: 17px; height: 17px; platform: root.device.platform; tint: Theme.ink; }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: root.device.name; font-size: 13.5px; font-weight: 600; color: Theme.ink; overflow: elide; min-height: 19px; vertical-alignment: center; }
                Text { text: root.device.sub; font-family: Type.tab; font-size: 12.5px; color: Theme.ink-3; overflow: elide; min-height: 18px; vertical-alignment: center; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { small: true; text: "Revoke"; enabled: !root.busy && !root.confirming; probe: "revoke:" + root.device.id; clicked => { root.ask(); } }
            }
        }
    }
    Collapse {
        open: root.confirming;
        HorizontalLayout {
            padding-bottom: 8px;
            ConfirmBlock {
                lead: "Sign out the " + root.device.name + "?";
                text: "It shows its pairing screen until someone signs in on it again.";
                confirm-label: "Revoke";
                probe: "revoke-do:" + root.device.id;
                busy: root.revoking;
                confirmed => { root.revoke(); }
                cancelled => { root.cancel(); }
            }
        }
    }
}

// The Sign-in & connection block (app-auth.js renderSettingsSection), bound to the server: who is signed in,
// this connection and the trusted local network, the session lifetime, this session and the other browsers,
// the read-only connection facts, the password change, the paired trays with Revoke and Sign out all devices,
// and Sign out.
component SigninGroup inherits SetGroup {
    in property <bool> busy;
    callback act(string, string);
    title: "Sign-in & connection";
    // the facts list's label column: 104 on P, 120 on F and T, 112 as on desktop (4.3.7)
    property <length> fact-w: Breakpoints.tier-p ? 104px : Breakpoints.below-d ? 120px : 112px;
    // the inner width of the column this group sits in (for the wrapping segmented control)
    in property <length> col-w: 360px;

    // the change-password form's fields stay here until they are submitted
    property <string> pw-cur;
    property <string> pw-new;
    property <string> pw-conf;
    property <bool> pw-others: true;
    property <bool> pw-open: AcData.signin.password-open;
    changed pw-open => {
        if !self.pw-open {
            root.pw-cur = "";
            root.pw-new = "";
            root.pw-conf = "";
            root.pw-others = true;
        }
    }
    // a refused change shakes the fields, as on the sign-in page
    property <int> pw-nonce: AcData.signin.password-nonce;
    property <duration> shake-start: 0ms;
    property <bool> shaking: false;
    changed pw-nonce => {
        if Motion.on {
            root.shake-start = animation-tick();
            root.shaking = true;
            shake-end.running = true;
        }
    }
    shake-end := Timer { interval: 460ms; running: false; triggered => { self.running = false; root.shaking = false; } }
    property <float> shake-p: root.shaking ? clamp((animation-tick() - root.shake-start) / 440ms, 0, 1) : 1;
    property <length> shake-x: root.shaking ? 7px * pow(1 - root.shake-p, 2) * sin(root.shake-p * 4 * 360deg) : 0px;
    function submit-password() {
        root.act("pw-submit", root.pw-cur + "\n" + root.pw-new + "\n" + root.pw-conf + "\n" + (root.pw-others ? "1" : "0"));
    }
    property <string> revoke-id;
    property <bool> all-open: false;
    property <int> device-count: AcData.devices.length;
    changed device-count => { root.revoke-id = ""; }

    SetItem {
        first: true;
        FactLine { label: "Signed in as"; value: AcData.signin.username; strong: true; label-w: root.fact-w; }
        FactLine { label: "Connection"; value: AcData.signin.connection; label-w: root.fact-w; }
        TipArea {
            owner: "session";
            tip: AcData.signin.session-tip;
            min-height: session-line.preferred-height;
            session-line := FactLine {
                label: "This session";
                value: AcData.signin.session + (AcData.signin.session-sub != "" ? " · " + AcData.signin.session-sub : "");
                label-w: root.fact-w;
            }
        }
        // the concept's .aa-row wraps (flex-wrap): beside the providers the button sits under the status,
        // since the three do not fit the settings column on one line. On a narrow column (small P) the
        // value would elide to nothing, so there the button moves under the fact instead.
        if Breakpoints.compact && root.col-w >= 380px: HorizontalLayout {
            spacing: 12px;
            Text { width: root.fact-w; text: "Other browsers"; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                horizontal-stretch: 1;
                min-width: 0px;
                Text { text: AcData.signin.others-text; font-family: Type.tab; font-size: 13px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                TipArea {
                    owner: "others";
                    tip: AcData.signin.others-tip;
                    width: others-btn.preferred-width;
                    height: 28px;
                    others-btn := Button {
                        small: true;
                        text: AcData.signin.others-busy ? "Signing out" : "Sign out other browsers";
                        enabled: AcData.signin.others-enabled && !root.busy;
                        busy: AcData.signin.others-busy;
                        probe: "others-out";
                        clicked => { root.act("others-out", ""); }
                    }
                }
            }
        }
        if !Breakpoints.compact || root.col-w < 380px: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Text { width: root.fact-w; text: "Other browsers"; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; }
                Text { text: AcData.signin.others-text; font-family: Type.tab; font-size: 13px; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; wrap: word-wrap; }
            }
            HorizontalLayout {
                spacing: 12px;
                Rectangle { width: root.fact-w; }
                TipArea {
                    owner: "others";
                    tip: AcData.signin.others-tip;
                    width: others-btn-narrow.preferred-width;
                    height: 28px;
                    others-btn-narrow := Button {
                        small: true;
                        text: AcData.signin.others-busy ? "Signing out" : "Sign out other browsers";
                        enabled: AcData.signin.others-enabled && !root.busy;
                        busy: AcData.signin.others-busy;
                        probe: "others-out";
                        clicked => { root.act("others-out", ""); }
                    }
                }
            }
        }
    }
    Hairline { }
    SetItem {
        label: "Session lifetime";
        aside: AcData.signin.lifetime-busy ? "Saving" : "";
        info-id: "lifetime-tip";
        // `if`, not just closed: a zero-height child still takes the item's 9 px spacing on D
        if Device.coarse || Breakpoints.below-d: InlineTip { tip-id: "lifetime-tip"; text: AcData.signin.lifetime-tip; }
        // below D the five segments wrap 3 + 2 when narrow (4.3.7); D keeps the desktop Segmented untouched
        if Breakpoints.below-d: TipArea {
            owner: "lifetime";
            tip: AcData.signin.lifetime-tip;
            min-height: lifetime-seg-w.preferred-height;
            lifetime-seg-w := WrapSegmented {
                avail: root.col-w - 36px;
                items: [{ value: "1", label: "1 day" }, { value: "7", label: "7 days" }, { value: "30", label: "30 days" }, { value: "90", label: "90 days" }, { value: "365", label: "1 year" }];
                row-1: [{ value: "1", label: "1 day" }, { value: "7", label: "7 days" }, { value: "30", label: "30 days" }];
                row-2: [{ value: "90", label: "90 days" }, { value: "365", label: "1 year" }];
                value: AcData.signin.lifetime-value;
                enabled: AcData.signin.lifetime-enabled && !root.busy;
                changed-value(v) => { root.act("session-lifetime", v); }
            }
        }
        if !Breakpoints.below-d: TipArea {
            owner: "lifetime";
            tip: AcData.signin.lifetime-tip;
            min-height: lifetime-seg-d.preferred-height;
            lifetime-seg-d := Segmented {
                pad: 7px;
                items: [{ value: "1", label: "1 day" }, { value: "7", label: "7 days" }, { value: "30", label: "30 days" }, { value: "90", label: "90 days" }, { value: "365", label: "1 year" }];
                value: AcData.signin.lifetime-value;
                enabled: AcData.signin.lifetime-enabled && !root.busy;
                changed-value(v) => { root.act("session-lifetime", v); }
            }
        }
    }
    Hairline { }
    // this connection and the trusted local network (dashboard_network.trust_local_network)
    SetItem {
        info-id: "network-tip";
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Local network"; font-size: 13.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
            // the inline-tip icon (5.4 #16), touch tiers only: D shows the note statically below (`if`, so D
            // measures exactly as before)
            if Breakpoints.below-d: VerticalLayout { alignment: center; InfoIcon { tip-id: "network-tip"; } }
            Rectangle { horizontal-stretch: 1; }
            if AcData.signin.network.act != "": TipArea {
                owner: "network";
                tip: AcData.signin.network.tip;
                width: net-btn.preferred-width;
                height: Breakpoints.below-d ? 44px : 28px;
                net-btn := Button {
                    y: (parent.height - self.height) / 2;
                    small: true;
                    kind: AcData.signin.network.on ? "default" : "accent-line";
                    text: AcData.signin.network.act-label;
                    enabled: AcData.signin.network.act-enabled && !root.busy;
                    busy: AcData.signin.network.busy;
                    probe: "network";
                    long-tip: AcData.signin.network.tip;
                    clicked => { root.act(AcData.signin.network.act, ""); }
                }
            }
        }
        Text { text: AcData.signin.network.line; font-family: Type.tab; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
        if !Breakpoints.below-d: IconNote { icon: AcData.signin.network.on ? "lock-open" : "lock"; text: AcData.signin.network.note; }
        if Breakpoints.below-d: InlineTip { tip-id: "network-tip"; text: AcData.signin.network.note; }
    }
    Hairline { }
    // the read-only connection facts (the former Connection section, merged here)
    SetItem {
        label: "Connection";
        Facts { facts: AcData.connection; label-w: Breakpoints.tier-p ? 104px : Breakpoints.below-d ? 120px : 104px; }
    }
    Hairline { }
    SetItem {
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Password"; font-size: 13.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle { horizontal-stretch: 1; }
            if AcData.signin.password-when != "": Text { text: AcData.signin.password-when; font-family: Type.tab; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; min-width: 0px; overflow: elide; }
            TipArea {
                owner: "password";
                tip: AcData.signin.password-can ? "" : AcData.signin.password-note;
                width: pw-btn.preferred-width;
                height: Breakpoints.below-d ? 44px : 28px;
                pw-btn := Button {
                    y: (parent.height - self.height) / 2;
                    small: true;
                    kind: AcData.signin.password-open ? "ghost" : "default";
                    text: AcData.signin.password-open ? "Close" : "Change password";
                    enabled: AcData.signin.password-can && !AcData.signin.password-busy;
                    probe: "pw-toggle";
                    clicked => { root.act("pw-toggle", ""); }
                }
            }
        }
        if !AcData.signin.password-can && AcData.signin.password-note != "": IconNote { icon: "lock"; text: AcData.signin.password-note; }
        Collapse {
            open: AcData.signin.password-open;
            Rectangle {
                min-height: pw-form.preferred-height;
                preferred-height: pw-form.preferred-height;
                pw-form := VerticalLayout {
                    x: root.shake-x;
                    width: parent.width;
                    spacing: 10px;
                    padding-top: 2px;
                    padding-bottom: 4px;
                    Rectangle {
                        min-height: f-cur.preferred-height;
                        f-cur := Field {
                            width: parent.width;
                            label: "Current password";
                            password: true;
                            box-height: Breakpoints.below-d ? 48px : 36px;
                            text <=> root.pw-cur;
                            enabled: !AcData.signin.password-busy;
                            bad: AcData.signin.password-field == "cur";
                            accepted => { f-new.focus-input(); }
                        }
                        ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "pw-cur"; }
                    }
                    if AcData.signin.password-field == "cur": Text { text: AcData.signin.password-error; font-size: Type.small; color: Theme.crit-text; wrap: word-wrap; }
                    Rectangle {
                        min-height: f-new.preferred-height;
                        f-new := Field {
                            width: parent.width;
                            label: "New password";
                            password: true;
                            box-height: Breakpoints.below-d ? 48px : 36px;
                            text <=> root.pw-new;
                            enabled: !AcData.signin.password-busy;
                            bad: AcData.signin.password-field == "new";
                            edited(v) => { root.act("pw-typing", v + "\n" + root.pw-conf); }
                            accepted => { f-conf.focus-input(); }
                        }
                        ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "pw-new"; }
                    }
                    StrengthMeter { data: AcData.pw-strength; }
                    if AcData.signin.password-field == "new": Text { text: AcData.signin.password-error; font-size: Type.small; color: Theme.crit-text; wrap: word-wrap; }
                    Rectangle {
                        min-height: f-conf.preferred-height;
                        f-conf := Field {
                            width: parent.width;
                            label: "Confirm new password";
                            password: true;
                            box-height: Breakpoints.below-d ? 48px : 36px;
                            aside: AcData.pw-strength.matches ? "Matches" : "";
                            aside-good: AcData.pw-strength.matches;
                            ok: AcData.pw-strength.matches;
                            text <=> root.pw-conf;
                            enabled: !AcData.signin.password-busy;
                            bad: AcData.signin.password-field == "conf";
                            edited(v) => { root.act("pw-typing", root.pw-new + "\n" + v); }
                            accepted => { root.submit-password(); }
                        }
                        ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "pw-conf"; }
                    }
                    if AcData.signin.password-field == "conf" || AcData.signin.password-field == "form": Text { text: AcData.signin.password-error; font-size: Type.small; color: Theme.crit-text; wrap: word-wrap; }
                    CheckLine {
                        checked <=> root.pw-others;
                        text: "Also sign out other browsers";
                        sub: AcData.signin.password-others;
                        enabled: !AcData.signin.password-busy;
                        probe: "pw-others";
                    }
                    // the buttons (4.3.5): two equal halves on P, one right-aligned row on F and T,
                    // the desktop's left-aligned row on D
                    if Breakpoints.tier-p: HorizontalLayout {
                        spacing: 8px;
                        height: 48px;
                        padding-top: 2px;
                        Button {
                            horizontal-stretch: 1;
                            tall: true;
                            kind: AcData.signin.password-done ? "default" : "primary";
                            icon: AcData.signin.password-done ? "check" : "";
                            text: AcData.signin.password-done ? "Password changed" : AcData.signin.password-busy ? "Changing" : "Change password";
                            busy: AcData.signin.password-busy;
                            enabled: !AcData.signin.password-done;
                            probe: "pw-submit";
                            clicked => { root.submit-password(); }
                        }
                        Button {
                            horizontal-stretch: 1;
                            tall: true;
                            kind: "ghost";
                            text: "Cancel";
                            enabled: !AcData.signin.password-busy;
                            probe: "pw-cancel";
                            clicked => { root.act("pw-toggle", ""); }
                        }
                    }
                    if Breakpoints.below-d && !Breakpoints.tier-p: HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        min-height: 44px;
                        padding-top: 2px;
                        Button {
                            small: true;
                            kind: AcData.signin.password-done ? "default" : "primary";
                            icon: AcData.signin.password-done ? "check" : "";
                            text: AcData.signin.password-done ? "Password changed" : AcData.signin.password-busy ? "Changing" : "Change password";
                            busy: AcData.signin.password-busy;
                            enabled: !AcData.signin.password-done;
                            probe: "pw-submit";
                            clicked => { root.submit-password(); }
                        }
                        Button { small: true; kind: "ghost"; text: "Cancel"; enabled: !AcData.signin.password-busy; probe: "pw-cancel"; clicked => { root.act("pw-toggle", ""); } }
                    }
                    if !Breakpoints.below-d: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        padding-top: 2px;
                        // idle, busy and done in one button: the label, a spinner, then a check
                        Button {
                            kind: AcData.signin.password-done ? "default" : "primary";
                            icon: AcData.signin.password-done ? "check" : "";
                            text: AcData.signin.password-done ? "Password changed" : AcData.signin.password-busy ? "Changing" : "Change password";
                            busy: AcData.signin.password-busy;
                            enabled: !AcData.signin.password-done;
                            probe: "pw-submit";
                            clicked => { root.submit-password(); }
                        }
                        Button { kind: "ghost"; text: "Cancel"; enabled: !AcData.signin.password-busy; probe: "pw-cancel"; clicked => { root.act("pw-toggle", ""); } }
                    }
                }
            }
        }
    }
    Hairline { }
    SetItem {
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Paired tray apps"; font-size: 13.5px; font-weight: 600; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle { horizontal-stretch: 1; }
            if AcData.devices.length > 0: Text { text: AcData.devices.length == 1 ? "1 paired" : AcData.devices.length + " paired"; font-family: Type.tab; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; }
        }
        VerticalLayout {
            spacing: 0px;
            for d[i] in AcData.devices: VerticalLayout {
                if i > 0: Hairline { }
                DeviceRow {
                    device: d;
                    busy: root.busy;
                    confirming: root.revoke-id == d.id;
                    revoking: AcData.signin.revoke-busy == d.id;
                    ask => { root.revoke-id = d.id; root.all-open = false; }
                    cancel => { root.revoke-id = ""; }
                    revoke => { root.act("device-revoke", d.id); }
                }
            }
        }
        if AcData.devices.length == 0: IconNote { icon: "link"; text: AcData.signin.devices-note; }
        HorizontalLayout {
            alignment: start;
            Button {
                small: true;
                kind: "danger-text";
                icon: "logout";
                text: "Sign out all devices";
                enabled: AcData.signin.revoke-all-enabled && !root.all-open && !root.busy;
                probe: "all-ask";
                clicked => { root.all-open = true; root.revoke-id = ""; }
            }
        }
        Collapse {
            open: root.all-open;
            ConfirmBlock {
                lead: "Sign out every tray and every other browser?";
                text: "Each tray shows its pairing screen. This browser stays signed in.";
                confirm-label: "Sign out all devices";
                probe: "all-do";
                busy: AcData.signin.revoke-all-busy;
                confirmed => { root.act("devices-revoke-all", ""); root.all-open = false; }
                cancelled => { root.all-open = false; }
            }
        }
    }
    Hairline { }
    SetItem {
        Rectangle {
            min-height: pairing.preferred-height;
            preferred-height: pairing.preferred-height;
            pairing := VerticalLayout {
                padding-left: 25px;
                StyledText {
                    text: AcData.pairing-note.length >= 2
                        ? @markdown("<font color='\{Theme.ink}'>**\{AcData.pairing-note[0].text}**</font>\{AcData.pairing-note[1].text}")
                        : @markdown("");
                    default-color: Theme.ink-2;
                    default-font-size: 12.5px;
                }
            }
            Icon { x: 0px; y: 2px; width: 15px; height: 15px; name: "info"; tint: Theme.ink-3; }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                small: true;
                icon: "logout";
                text: AcData.signin.sign-out-busy ? "Signing out" : "Sign out";
                busy: AcData.signin.sign-out-busy;
                enabled: !root.busy;
                probe: "logout";
                clicked => { root.act("logout", ""); }
            }
        }
    }
}

component SettingsGroup inherits SetGroup {
    in property <string> theme-value;
    in property <bool> busy;
    // the width of the column this group sits in (like SigninGroup's): the policy rows must decide
    // their wrap ahead of layout
    in property <length> col-w: 360px;
    callback theme-picked(string);
    callback act(string, string);
    title: "Settings";
    SetItem {
        first: true;
        label: "Appearance";
        aside: "Auto follows the system";
        // the segmented fills the item's width on P/F/T (4.3.7)
        if Breakpoints.below-d: StretchSegmented {
            items: [{ value: "light", label: "Light", icon: "sun" }, { value: "dark", label: "Dark", icon: "moon" }, { value: "auto", label: "Auto", icon: "monitor" }];
            value: root.theme-value;
            changed-value(v) => { root.theme-picked(v); }
        }
        if !Breakpoints.below-d: HorizontalLayout {
            alignment: start;
            Segmented {
                items: [{ value: "light", label: "Light", icon: "sun" }, { value: "dark", label: "Dark", icon: "moon" }, { value: "auto", label: "Auto", icon: "monitor" }];
                value: root.theme-value;
                changed-value(v) => { root.theme-picked(v); }
            }
        }
    }
    Hairline { }
    // the Home screen app row (DESIGN-MOBILE.md 6.6): the Chromium install button (the "install-app"
    // action kind; phase 6 calls the captured install prompt), or the iOS Safari Share-menu words;
    // hidden when already standalone or without an install path
    if AcData.install == "chromium": SetItem {
        label: "Home screen app";
        Text { text: "Install AI Account Center as an app on this device."; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start;
            min-height: 44px;
            Button {
                small: true;
                text: "Install app";
                probe: "install-app";
                clicked => { root.act("install-app", ""); }
            }
        }
    }
    if AcData.install == "ios": SetItem {
        label: "Home screen app";
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            Text { text: "In Safari, open the Share menu"; font-size: Type.small; color: Theme.ink-3; }
            VerticalLayout {
                alignment: center;
                Icon { name: "share"; tint: Theme.ink-3; width: 14px; height: 14px; }
            }
            Text { text: ", then choose Add to Home Screen."; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; horizontal-stretch: 1; min-width: 0px; }
        }
    }
    // only with the install row above: otherwise the two hairlines stack into one 2 px line
    if AcData.install == "chromium" || AcData.install == "ios": Hairline { }
    SetItem {
        label: "Usage refresh";
        aside: AcData.refresh-known ? "Every " + AcFormat.interval(slider.shown) : "Not reported";
        aside-strong: AcData.refresh-known;
        slider := RefreshSlider {
            seconds: AcData.refresh-seconds;
            enabled: AcData.refresh-known && !root.busy;
            committed(s) => { root.act("refresh-interval", s + "s"); }
        }
        if !AcData.refresh-known: Text {
            text: "The saved interval could not be read, so it cannot be changed here.";
            font-size: Type.small;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
    SetItem {
        label: "Time zone";
        aside: AcData.timezone-busy ? "Saving" : "";
        TipArea {
            owner: "timezone";
            tip: AcData.timezone-tip;
            min-height: timezone-sel.preferred-height;
            timezone-sel := Select {
                options: ["America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles", "America/Anchorage", "Pacific/Honolulu", "Europe/London", "Europe/Paris", "Asia/Tokyo", "Australia/Sydney", "UTC"];
                value: AcData.timezone-value;
                enabled: AcData.timezone-enabled && !root.busy;
                selected(v) => { root.act("time-zone", v); }
            }
        }
    }
    Hairline { }
    SetItem {
        label: "Auto-switch policies";
        VerticalLayout {
            spacing: 10px;
            for p in AcData.policies: PolicyRow {
                policy: p;
                busy: root.busy;
                // the row's inner width: the card's width less this item's 16 px (P) / 20 px (F and T) padding
                avail: root.col-w - (Breakpoints.tier-p ? 32px : 40px);
                act(kind, value) => { root.act(kind, value); }
            }
        }
    }
}

component LogSourceRow inherits HorizontalLayout {
    in property <string> id;
    in property <string> tool-label;
    in property <string> host;
    in property <string> location;
    in property <string> mapping;
    in property <bool> enabled;
    callback act(string, string);
    spacing: 8px;
    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        spacing: 1px;
        Text { text: tool-label + " · " + host; font-size: 12.5px; font-weight: 600; color: Theme.ink-2; }
        Text { text: location; font-size: Breakpoints.below-d ? 13px : Type.small; font-family: Breakpoints.below-d ? Type.mono : Type.sans; color: Theme.ink-3; wrap: Breakpoints.below-d ? char-wrap : word-wrap; }
        if mapping != "": Text { text: mapping; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        // below D the remove control is the trash icon (40 visible, 44 hit)
        if Breakpoints.below-d: TipArea {
            owner: "logsource:" + root.id;
            tip: "Stop scanning this extra location.";
            width: 44px;
            height: 44px;
            ls-trash := IconButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                bare: true;
                icon: "trash";
                hint: "Remove";
                enabled: root.enabled;
                long-tip: "Stop scanning this extra location.";
                clicked => { root.act("logsource-remove", root.id); }
            }
        }
        if !Breakpoints.below-d: Button {
            small: true;
            text: "Remove";
            enabled: root.enabled;
            clicked => { root.act("logsource-remove", root.id); }
        }
    }
}

component LogSourcesGroup inherits SetGroup {
    in property <bool> busy;
    callback act(string, string);
    title: "Usage log sources";
    // the tool and host selects sit side by side while the group's inner width allows 300 px (4.3.7)
    property <bool> narrow: Breakpoints.below-d && (Breakpoints.tier-width - 2 * Breakpoints.gutter - 32px) < 300px;
    // the tool and host behind the selects (Select shows strings only); hoisted so both the side-by-side
    // and the stacked layouts (and the submit) read one source
    property <string> tool-choice: "OMP";
    property <string> host-choice: "ubuntu";
    property <string> tool-id: root.tool-choice == "Muse Code" ? "muse" : root.tool-choice == "zcode" ? "zcode" : root.tool-choice == "Claude Code" ? "claude-code" : root.tool-choice == "Codex" ? "codex" : root.tool-choice == "Generic JSONL" ? "jsonl" : "omp";
    property <[string]> host-options: root.tool-id == "omp" || root.tool-id == "claude-code" || root.tool-id == "codex" ? ["ubuntu", "mac", "windows"] : root.tool-id == "muse" || root.tool-id == "zcode" ? ["ubuntu", "mac"] : ["ubuntu"];
    // the mapping fields live under an `if`: their text is hoisted here so the
    // submitted JSON never reads an uninstantiated element
    property <string> map-ts-text;
    property <string> map-model-text;
    property <string> map-in-text;
    property <string> map-out-text;
    property <string> map-cost-text;
    property <string> mapping-json: "{\"timestamp\":\"" + map-ts-text + "\",\"model\":\"" + map-model-text + "\"" + (map-in-text != "" ? ",\"inputTokens\":\"" + map-in-text + "\"" : "") + (map-out-text != "" ? ",\"outputTokens\":\"" + map-out-text + "\"" : "") + (map-cost-text != "" ? ",\"cost\":\"" + map-cost-text + "\"" : "") + "}";
    property <bool> form-enabled: AcData.log-sources-enabled && !root.busy && !AcData.log-sources-busy;
    SetItem {
        first: true;
        label: "Extra locations";
        aside: AcData.log-sources-busy ? "Saving" : "";
        TipArea {
            owner: "logsources";
            tip: AcData.log-sources-tip;
            VerticalLayout {
                spacing: 10px;
                if AcData.log-sources.length == 0: Text {
                    text: "No extras yet. Built-in locations are always scanned.";
                    font-size: Type.small;
                    color: Theme.ink-3;
                    wrap: word-wrap;
                }
                for src in AcData.log-sources: LogSourceRow {
                    id: src.id;
                    tool-label: src.tool-label;
                    host: src.host;
                    location: src.path;
                    mapping: src.mapping;
                    enabled: form-enabled;
                    act(k, v) => { root.act(k, v); }
                }
            }
        }
    }
    Hairline { }
    SetItem {
        label: "Add a location";
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Text { text: "Tool"; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; }
                    tool-sel := Select {
                        options: ["OMP", "Muse Code", "zcode", "Claude Code", "Codex", "Generic JSONL"];
                        value <=> root.tool-choice;
                        enabled: form-enabled;
                        selected(v) => { root.host-choice = "ubuntu"; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Text { text: "Host"; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; }
                    host-sel := Select {
                        options: host-options;
                        value <=> root.host-choice;
                        enabled: form-enabled;
                    }
                }
            }
            path-field := Field {
                label: "Path";
                placeholder: "/absolute/path or C:\\absolute\\path";
                enabled: form-enabled;
            }
            if tool-id == "jsonl": VerticalLayout {
                spacing: 8px;
                Text { text: "Row field mapping: dot paths into each JSON record"; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; }
                map-ts := Field {
                    label: "Timestamp";
                    placeholder: "ts";
                    enabled: form-enabled;
                    edited(t) => { map-ts-text = t; }
                }
                map-model := Field {
                    label: "Model";
                    placeholder: "model";
                    enabled: form-enabled;
                    edited(t) => { map-model-text = t; }
                }
                map-in := Field {
                    label: "Input tokens (optional)";
                    placeholder: "usage.input_tokens";
                    enabled: form-enabled;
                    edited(t) => { map-in-text = t; }
                }
                map-out := Field {
                    label: "Output tokens (optional)";
                    placeholder: "usage.output_tokens";
                    enabled: form-enabled;
                    edited(t) => { map-out-text = t; }
                }
                map-cost := Field {
                    label: "Cost in USD (optional)";
                    placeholder: "cost";
                    enabled: form-enabled;
                    edited(t) => { map-cost-text = t; }
                }
            }
            if AcData.log-sources-error != "": Text {
                text: AcData.log-sources-error;
                font-size: Type.small;
                color: Theme.crit;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    small: true;
                    text: AcData.log-sources-busy ? "Adding" : "Add location";
                    enabled: form-enabled;
                    busy: AcData.log-sources-busy;
                    probe: "logsource-add";
                    clicked => { root.act("logsource-add", root.tool-id + "\n" + root.host-choice + "\n" + path-field.text + "\n" + (root.tool-id == "jsonl" ? mapping-json : "")); }
                }
            }
        }
    }
}

component CleanupGroup inherits SetGroup {
    in property <bool> busy;
    callback act(string, string);
    title: "History snapshots";
    SetItem {
        first: true;
        label: "Automatic cleanup";
        TipArea {
            owner: "cleanup";
            tip: AcData.cleanup-tip;
            min-height: 20px;
            CheckLine {
                text: "Clean up after each copy";
                sub: "keeps the newest 3 snapshot folders per profile";
                checked: AcData.cleanup-auto;
                enabled: AcData.cleanup-enabled && !root.busy;
                toggled(checked) => { root.act("cleanup-auto", ""); }
            }
        }
    }
    SetItem {
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                small: true;
                text: AcData.cleanup-busy ? "Cleaning" : "Clean up now";
                enabled: AcData.cleanup-enabled && !root.busy;
                busy: AcData.cleanup-busy;
                probe: "cleanup-now";
                clicked => { root.act("cleanup-now", ""); }
            }
        }
        if AcData.cleanup-note != "": Text {
            text: AcData.cleanup-note;
            font-size: Type.small;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
}

component UpdateGroup inherits SetGroup {
    title: "Update apps";
    // P has no "header" label (its chrome is the top bar), so the note names it (4.3.7 group 5)
    note: Breakpoints.tier-p ? "Runs from Update apps in the top bar" : "Runs from Update apps in the header";
    callback act(string, string);
    SetItem {
        first: true;
        Runs {
            runs: AcData.update-head;
            size: 12.5px;
            ink: Theme.ink-3;
            strong-ink: Theme.ink-2;
            strong-weight: 600;
            tabular: true;
        }
        if AcData.update-shown && AcData.update-running: HorizontalLayout {
            alignment: start;
            padding-top: 6px;
            TipArea {
                owner: "update-cancel";
                tip: "Finishes the update running now, then skips the queued apps. Finished updates stay as they are.";
                width: cancel-btn.preferred-width;
                height: 28px;
                cancel-btn := Button {
                    small: true;
                    text: AcData.update-cancelling ? "Cancelling…" : "Cancel";
                    enabled: !AcData.update-cancelling;
                    probe: "update-cancel";
                    clicked => { root.act("update-cancel", ""); }
                }
            }
        }
        for h in AcData.update-hosts: VerticalLayout {
            spacing: 0px;
            padding-top: 4px;
            HorizontalLayout {
                spacing: 7px;
                padding-top: 4px;
                padding-bottom: 2px;
                VerticalLayout { alignment: center; PlatformGlyph { platform: h.platform; tint: Theme.ink-3; width: 13px; height: 13px; } }
                Caps { text: h.label.to-uppercase(); }
            }
            for item[i] in h.items: UpdLine { item: item; first: i == 0; }
        }
    }
}

component AboutGroup inherits SetGroup {
    title: "About";
    SetItem {
        first: true;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout { alignment: center; AppLogo { size: 34px; } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "AI Account Center"; font-size: 13.5px; font-weight: 640; color: Theme.ink; }
                Text { text: AcData.about-version + " · built with Slint 1.18.1"; font-size: 12.5px; color: Theme.ink-3; }
            }
        }
        // Slint's required attribution (exactly 220 x 92, centred on P)
        if Breakpoints.tier-p: HorizontalLayout {
            alignment: center;
            AboutSlint { width: 220px; height: 92px; }
        }
        if !Breakpoints.tier-p: HorizontalLayout {
            alignment: start;
            AboutSlint { width: 220px; height: 92px; }
        }
    }
}

// The settings groups (DESIGN-MOBILE.md 4.3.7): every group is shown at every width. Two columns (left:
// Sign-in & connection, Update apps and About; right: Settings, History snapshots and Usage log sources,
// each flowing independently) when the page hints F >= 760 or T and the settings area's own content width
// reaches 760 (1.5); one column (P, F below that) stacks everything; the desktop settings column beside
// the providers is unchanged.
export component SettingsColumn inherits VerticalLayout {
    in property <bool> two-col: false;
    in property <string> theme-value;
    in property <bool> busy;
    callback theme-picked(string);
    callback act(string, string);
    spacing: 16px;
    alignment: start;
    // the settings area's own content width decides the split (DESIGN-MOBILE.md 1.5), not the tier
    // alone: the page's F >= 760 hint alone would still split the F band whose content (the window
    // less the two gutters) is under 760
    property <bool> content-fits: Breakpoints.tier-width - 2 * Breakpoints.gutter >= 760px;
    property <bool> col-split: root.two-col && root.content-fits;
    // one settings column's inner width, for the controls that must decide their layout ahead of it
    // (the group cards inset their content by 16 px on P and 20 px on F/T)
    property <length> col-half: (Breakpoints.tier-width - 2 * Breakpoints.gutter - 16px) / 2;
    property <length> col-inner: root.col-split ? root.col-half - 80px
        : Breakpoints.at-least-regular ? (Breakpoints.wide ? 420px : Breakpoints.ultra ? 440px : 380px)
        : Breakpoints.tier-width - 2 * Breakpoints.gutter - (Breakpoints.tier-p ? 32px : 40px);
    if !root.col-split: VerticalLayout {
        spacing: 16px;
        alignment: start;
        SigninGroup { busy: root.busy; col-w: root.col-inner; act(k, v) => { root.act(k, v); } }
        SettingsGroup {
            theme-value: root.theme-value;
            busy: root.busy;
            col-w: root.col-inner;
            theme-picked(v) => { root.theme-picked(v); }
            act(k, v) => { root.act(k, v); }
        }
        CleanupGroup {
            busy: root.busy;
            act(k, v) => { root.act(k, v); }
        }
        LogSourcesGroup {
            busy: root.busy;
            act(k, v) => { root.act(k, v); }
        }
        UpdateGroup {
            act(k, v) => { root.act(k, v); }
        }
        AboutGroup { }
    }
    if root.col-split: HorizontalLayout {
        spacing: 16px;
        alignment: stretch;
        VerticalLayout {
            // equal halves of the content width (4.3.7), whatever each column's content prefers
            width: root.col-half;
            spacing: 16px;
            alignment: start;
            SigninGroup { busy: root.busy; col-w: root.col-inner; act(k, v) => { root.act(k, v); } }
            UpdateGroup {
                act(k, v) => { root.act(k, v); }
            }
            AboutGroup { }
        }
        VerticalLayout {
            width: root.col-half;
            spacing: 16px;
            alignment: start;
            SettingsGroup {
                theme-value: root.theme-value;
                busy: root.busy;
                col-w: root.col-half;
                theme-picked(v) => { root.theme-picked(v); }
                act(k, v) => { root.act(k, v); }
            }
            CleanupGroup {
                busy: root.busy;
                act(k, v) => { root.act(k, v); }
            }
            LogSourcesGroup {
                busy: root.busy;
                act(k, v) => { root.act(k, v); }
            }
        }
    }
}
