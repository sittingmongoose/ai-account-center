// One provider section on Accounts & Settings, built like the concept (c-daylight-atlas/app-accounts.js and the
// .prov / .acc-row rules in styles.css): the head with the mark, the kind line and "Show on dashboard"; one row per
// account with its identity, status, source and fixed, aligned action slots; the Antigravity policy box; and
// the footer with how the provider signs in and its add or check actions.
//
// Slots: every row of a section has the same slots in the same columns, each as wide as its widest content
// across the rows (rows report their natural widths, the section keeps the largest), so a wider status
// ("Active on Ubuntu") never pushes the buttons beside it. A switchable provider's first slot is the Home
// SwitchSlot (Activate with the plain Active mark on the button's own grid) and starts at the slot's left edge.
//
// Below D the rows reflow by the section's own inner width (DESIGN-MOBILE.md 4.3.3, 1.5): a table row (the
// desktop row with touch sizes) when it is >= 920, stacked-wide (520 to 919, the Dashboard / Tray pair in a
// 168 px column on the right) and stacked (< 520: name with trash, plan, status and sample, source, the
// pair, then the action slots wrapping). The desktop (>= 1280) row is unchanged.
import { Theme, Motion, Type, Breakpoints } from "../../theme.slint";
import { RunView } from "../../models.slint";
import { Icon } from "../../components/icon.slint";
import { ProviderMark } from "../../components/mark.slint";
import { Caps } from "../../components/text.slint";
import { Button } from "../../components/button.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Toggle } from "../../components/toggle.slint";
import { Segmented } from "../../components/segmented.slint";
import { Plate } from "../../components/card.slint";
import { Hover } from "../../components/hover-card.slint";
import { SwitchSlot, ConfirmLine, Stepper, Runs } from "../home.slint";
import { ProbeMark } from "../../components/probe.slint";
import { AcData, AcAction, AcRow, AcProvider, AcAgPolicy, AcTrashRow } from "ac-data.slint";
import { ComingWord, TipArea, IconNote, ActionControl, SwitchPair, StretchSegmented, BoundToggle } from "ac-actions.slint";
import { FlowPanel, RowLine } from "ac-flow.slint";
export { ComingWord, TipArea, IconNote, ActionControl }

// One account row. mode: 2 table (desktop), 1 stacked-wide, 0 stacked; see the file head.
export component AcRowItem inherits Rectangle {
    in property <AcRow> item;
    in property <AcProvider> provider;
    in property <int> mode: 2;
    in property <length> w0;
    in property <length> w1;
    in property <length> w2;
    in property <length> acts-w;
    in property <bool> show-src: true;
    in property <bool> selected;
    in property <bool> busy;
    in property <bool> confirming;
    callback open-details(string);
    callback act(string, string);
    callback measured(int, length);
    callback ask-confirm(string);
    callback cancel-confirm();
    out property <bool> hovered: ta.has-hover;
    out property <length> line-height: line.height;
    property <bool> is-active: root.item.active && root.provider.switchable;
    // the remove control is always the row's last action; the stacked layouts lift it to the top line
    property <bool> has-trash: root.item.actions.length > 0 && root.item.actions[root.item.actions.length - 1].icon == "trash";
    // the reason line a tap on a dimmed control opens under this row (5.2.2); the next tap anywhere clears it
    property <string> tap-reason;

    min-height: body.min-height;
    preferred-height: body.preferred-height;

    body := VerticalLayout {
        spacing: 0px;
        // removing: the row fades while it keeps its place, then the list settles
        opacity: root.item.gone ? 0.35 : 1;
        animate opacity { duration: Motion.on ? 260ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        line := Rectangle {
            min-height: root.mode == 2 ? max(56px, rowbox.min-height) : rowbox.preferred-height;
            preferred-height: self.min-height;
            background: root.is-active ? Theme.row-hover.with-alpha(0)
                : root.selected ? Theme.row-sel
                : Breakpoints.below-d ? (ta.pressed ? Theme.pressed : Theme.row-hover.with-alpha(0))
                : ta.pressed ? Theme.row-hover.mix(Theme.rule, 0.7)
                : ta.has-hover ? Theme.row-hover
                : Theme.row-hover.with-alpha(0);
            animate background { duration: Motion.tint(160ms); easing: cubic-bezier(0.65, 0, 0.35, 1); }
            // the hairline above every row (the first one separates the rows from the head)
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.rule-2; }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.tap-reason = "";
                    root.open-details(root.item.id);
                }
                // the desktop row (and the T table below D): the concept's .acc-row, 11 px padding under its
                // 1 px rule, 13.5 px and 12 px lines at line-height 1.45 with 1 px between them (61 px pitch);
                // T raises the vertical padding to the touch token (14 px)
                rowbox := VerticalLayout {
                spacing: 0px;
                if root.mode == 2: tbl := HorizontalLayout {
                    padding-left: Breakpoints.below-d ? 20px : 18px;
                    padding-right: Breakpoints.below-d ? 20px : 18px;
                    padding-top: Breakpoints.below-d ? 14px : 12px;
                    padding-bottom: Breakpoints.below-d ? 13px : 11px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1.3;
                        min-width: 180px;
                        spacing: 1px;
                        // hidden from the dashboard: the identity dims like a hidden provider's rows
                        opacity: root.item.shown-dash ? 1 : 0.55;
                        animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                        Text {
                            min-height: 19.5px;
                            vertical-alignment: center;
                            text: root.item.email;
                            font-size: Type.body;
                            font-weight: root.is-active ? 640 : 520;
                            color: Theme.ink;
                            overflow: elide;
                        }
                        Text {
                            min-height: 17.5px;
                            vertical-alignment: center;
                            text: root.item.meta + (root.show-src ? "" : (root.item.meta != "" ? " · " : "") + root.item.src-inline);
                            font-size: Type.small;
                            color: Theme.ink-3;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0.7;
                        min-width: 110px;
                        spacing: 0px;
                        if root.item.status != "": Text {
                            min-height: 18px;
                            vertical-alignment: center;
                            text: root.item.status;
                            font-size: 12.5px;
                            font-weight: 620;
                            color: Theme.warn-text;
                            overflow: elide;
                        }
                        Text {
                            min-height: 17.5px;
                            vertical-alignment: center;
                            text: root.item.sampled;
                            font-family: Type.tab;
                            font-size: Type.small;
                            color: Theme.ink-3;
                            overflow: elide;
                        }
                    }
                    if root.show-src: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 140px;
                        spacing: 0px;
                        Text { min-height: 18px; vertical-alignment: center; text: root.item.src; font-size: 12.5px; color: Theme.ink-2; overflow: elide; }
                        Text { min-height: 17.5px; vertical-alignment: center; text: root.item.src-sub; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
                    }
                    // Show on dashboard and Show in tray for this account, side by side in one column: two
                    // independent switches (each saves only its own list)
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        spacing: 3px;
                        TipArea {
                            owner: "acct-show:" + root.item.id;
                            tip: root.item.dash-tip;
                            height: 18px;
                            width: max(t-dash.preferred-width, t-tray.preferred-width);
                            t-dash := BoundToggle {
                                y: (parent.height - self.height) / 2;
                                small: true;
                                model-on: root.item.shown-dash;
                                enabled: root.item.dash-enabled;
                                label: "Dashboard";
                                long-tip: root.item.dash-tip;
                                probe: "acct-show:" + root.item.id;
                                toggled(on) => { root.act("account-show", root.item.id + "|" + (on ? "show" : "hide")); }
                            }
                        }
                        TipArea {
                            owner: "acct-tray:" + root.item.id;
                            tip: root.item.tray-acct-tip;
                            height: 18px;
                            width: max(t-dash.preferred-width, t-tray.preferred-width);
                            t-tray := BoundToggle {
                                y: (parent.height - self.height) / 2;
                                small: true;
                                model-on: root.item.shown-tray;
                                enabled: root.item.tray-acct-enabled;
                                label: "Tray";
                                long-tip: root.item.tray-acct-tip;
                                probe: "acct-tray:" + root.item.id;
                                toggled(on) => { root.act("account-tray", root.item.id + "|" + (on ? "show" : "hide")); }
                            }
                        }
                    }
                    acts := HorizontalLayout {
                        width: root.acts-w;
                        spacing: 6px;
                        alignment: end;
                        for a[i] in root.item.actions: Rectangle {
                            width: i == 0 ? root.w0 : i == 1 ? root.w1 : root.w2;
                            property <length> natural: a.kind == "switch" ? tsw.natural : tctl.natural;
                            init => { root.measured(i, self.natural); }
                            changed natural => { root.measured(i, self.natural); }
                            tsw := SwitchSlot {
                                x: 0px;
                                y: (parent.height - self.preferred-height) / 2;
                                width: parent.width;
                                height: self.preferred-height;
                                visible: a.kind == "switch";
                                account: {
                                    id: root.item.id,
                                    active: root.item.active,
                                    active-label: root.item.active-label,
                                    can-activate: a.enabled,
                                    activate-hint: root.item.activate-hint,
                                    platform: "Ubuntu",
                                };
                                can-switch: root.provider.can-switch;
                                busy: root.busy;
                                activate => {
                                    if root.item.confirm {
                                        root.ask-confirm(root.item.id);
                                    } else {
                                        root.act(a.act, a.value);
                                    }
                                }
                            }
                            if a.kind == "switch" && a.probe != "": ProbeMark { x: 0px; y: tsw.y; width: min(parent.width, tsw.natural); height: tsw.height; id: a.probe; }
                            tctl := ActionControl {
                                width: parent.width;
                                height: parent.height;
                                visible: a.kind != "switch" && a.kind != "empty";
                                data: a;
                                owner: "acc:" + root.item.id + ":" + i;
                                busy: root.busy;
                                act(kind, value) => { root.tap-reason = ""; root.act(kind, value); }
                                reason(r) => { root.tap-reason = r; }
                            }
                        }
                    }
                }
                if root.mode != 2: st := VerticalLayout {
                    height: self.preferred-height;
                    // card side padding 16 on P, 20 on F and T (DESIGN-MOBILE.md 2.2); 12 px row padding
                    padding-left: Breakpoints.tier-p ? 16px : 20px;
                    padding-right: Breakpoints.tier-p ? 16px : 20px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    if root.mode == 0: stacked-col := VerticalLayout {
                        spacing: 1px;
                        // Line A: the name with the remove control at its right (40 visible, 44 hit)
                        HorizontalLayout {
                            min-height: 44px;
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                opacity: root.item.shown-dash ? 1 : 0.55;
                                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                                Text {
                                    min-height: 21px;
                                    vertical-alignment: center;
                                    text: root.item.email;
                                    font-size: Type.control;
                                    font-weight: root.is-active ? 640 : 600;
                                    color: Theme.ink;
                                    overflow: elide;
                                }
                            }
                            if root.has-trash: VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                trash-a := ActionControl {
                                    height: 44px;
                                    width: self.natural;
                                    align-end: false;
                                    data: root.item.actions[root.item.actions.length - 1];
                                    owner: "acc:" + root.item.id + ":" + (root.item.actions.length - 1);
                                    busy: root.busy;
                                    act(kind, value) => { root.tap-reason = ""; root.act(kind, value); }
                                    reason(r) => { root.tap-reason = r; }
                                }
                            }
                        }
                        // Line B: plan · label
                        if root.item.meta != "": Text {
                            min-height: 18px;
                            vertical-alignment: center;
                            text: root.item.meta;
                            font-size: Type.small;
                            color: Theme.ink-3;
                            overflow: elide;
                        }
                        // Line C: the status word only when exceptional, then the sample age
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            min-height: 18px;
                            if root.item.status != "": Text {
                                text: root.item.status;
                                font-size: Type.small;
                                font-weight: 600;
                                color: Theme.warn-text;
                                vertical-alignment: center;
                            }
                            if root.item.status != "": Text {
                                text: "·";
                                font-size: Type.small;
                                color: Theme.ink-3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.item.sampled;
                                font-family: Type.tab;
                                font-size: Type.small;
                                color: Theme.ink-3;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }
                        }
                        // Line D: where the account was read from, wrapping
                        Text {
                            min-height: 18px;
                            vertical-alignment: center;
                            text: root.item.src + (root.item.src-sub != "" ? " · " + root.item.src-sub : "");
                            font-size: Type.small;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 8px; }
                        // Line E: this account's Dashboard / Tray pair, each a 44 px hit area
                        HorizontalLayout {
                            spacing: 24px;
                            alignment: start;
                            min-height: 44px;
                            dash-pair := SwitchPair {
                                label: "Dashboard";
                                on: root.item.shown-dash;
                                enabled: root.item.dash-enabled;
                                long-tip: root.item.dash-tip;
                                probe: "acct-show:" + root.item.id;
                                toggled(on) => { root.act("account-show", root.item.id + "|" + (on ? "show" : "hide")); }
                                reason-tap => { root.tap-reason = root.item.dash-tip; }
                            }
                            tray-pair := SwitchPair {
                                label: "Tray";
                                on: root.item.shown-tray;
                                enabled: root.item.tray-acct-enabled;
                                long-tip: root.item.tray-acct-tip;
                                probe: "acct-tray:" + root.item.id;
                                toggled(on) => { root.act("account-tray", root.item.id + "|" + (on ? "show" : "hide")); }
                                reason-tap => { root.tap-reason = root.item.tray-acct-tip; }
                            }
                        }
                        Rectangle { height: 8px; }
                        // Line F: the action slots wrap (the remove control lives on Line A)
                        FlexboxLayout {
                            spacing-horizontal: 8px;
                            spacing-vertical: 8px;
                            alignment: start;
                            for a[i] in root.item.actions: Rectangle {
                                // the Flexbox sizes each item by its content's natural width
                                preferred-width: fl.preferred-width;
                                fl := VerticalLayout {
                                    if i != root.item.actions.length - 1 || !root.has-trash: VerticalLayout {
                                        alignment: start;
                                        if a.kind == "switch": Rectangle {
                                            width: ssw.natural;
                                            height: ssw.preferred-height;
                                            ssw := SwitchSlot {
                                                width: parent.width;
                                                height: parent.height;
                                                account: {
                                                    id: root.item.id,
                                                    active: root.item.active,
                                                    active-label: root.item.active-label,
                                                    can-activate: a.enabled,
                                                    activate-hint: root.item.activate-hint,
                                                    platform: "Ubuntu",
                                                };
                                                can-switch: root.provider.can-switch;
                                                busy: root.busy;
                                                activate => {
                                                    if root.item.confirm {
                                                        root.ask-confirm(root.item.id);
                                                    } else {
                                                        root.act(a.act, a.value);
                                                    }
                                                }
                                            }
                                            if a.kind == "switch" && a.probe != "": ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: a.probe; }
                                        }
                                        if a.kind != "switch" && a.kind != "empty": sctl := ActionControl {
                                            height: 44px;
                                            width: self.natural;
                                            align-end: false;
                                            data: a;
                                            owner: "acc:" + root.item.id + ":" + i;
                                            busy: root.busy;
                                            act(kind, value) => { root.tap-reason = ""; root.act(kind, value); }
                                            reason(r) => { root.tap-reason = r; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.mode == 1: wide-row := HorizontalLayout {
                        spacing: 12px;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 1px;
                            // Line A: the name (the remove control sits at the top of the right column)
                            HorizontalLayout {
                                min-height: 44px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    opacity: root.item.shown-dash ? 1 : 0.55;
                                    animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                                    Text {
                                        min-height: 21px;
                                        vertical-alignment: center;
                                        text: root.item.email;
                                        font-size: Type.control;
                                        font-weight: root.is-active ? 640 : 600;
                                        color: Theme.ink;
                                        overflow: elide;
                                    }
                                }
                            }
                            if root.item.meta != "": Text {
                                min-height: 18px;
                                vertical-alignment: center;
                                text: root.item.meta;
                                font-size: Type.small;
                                color: Theme.ink-3;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                min-height: 18px;
                                if root.item.status != "": Text {
                                    text: root.item.status;
                                    font-size: Type.small;
                                    font-weight: 600;
                                    color: Theme.warn-text;
                                    vertical-alignment: center;
                                }
                                if root.item.status != "": Text {
                                    text: "·";
                                    font-size: Type.small;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.item.sampled;
                                    font-family: Type.tab;
                                    font-size: Type.small;
                                    color: Theme.ink-3;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                }
                            }
                            Text {
                                min-height: 18px;
                                vertical-alignment: center;
                                text: root.item.src + (root.item.src-sub != "" ? " · " + root.item.src-sub : "");
                                font-size: Type.small;
                                color: Theme.ink-3;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 8px; }
                            FlexboxLayout {
                                spacing-horizontal: 8px;
                                spacing-vertical: 8px;
                                alignment: start;
                                for a[i] in root.item.actions: Rectangle {
                                    // the Flexbox sizes each item by its content's natural width
                                    preferred-width: fw.preferred-width;
                                    fw := VerticalLayout {
                                        if i != root.item.actions.length - 1 || !root.has-trash: VerticalLayout {
                                            alignment: start;
                                            if a.kind == "switch": Rectangle {
                                                width: wsw.natural;
                                                height: wsw.preferred-height;
                                                wsw := SwitchSlot {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    account: {
                                                        id: root.item.id,
                                                        active: root.item.active,
                                                        active-label: root.item.active-label,
                                                        can-activate: a.enabled,
                                                        activate-hint: root.item.activate-hint,
                                                        platform: "Ubuntu",
                                                    };
                                                    can-switch: root.provider.can-switch;
                                                    busy: root.busy;
                                                    activate => {
                                                        if root.item.confirm {
                                                            root.ask-confirm(root.item.id);
                                                        } else {
                                                            root.act(a.act, a.value);
                                                        }
                                                    }
                                                }
                                                if a.kind == "switch" && a.probe != "": ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: a.probe; }
                                            }
                                            if a.kind != "switch" && a.kind != "empty": wctl := ActionControl {
                                                height: 44px;
                                                width: self.natural;
                                                align-end: false;
                                                data: a;
                                                owner: "acc:" + root.item.id + ":" + i;
                                                busy: root.busy;
                                                act(kind, value) => { root.tap-reason = ""; root.act(kind, value); }
                                                reason(r) => { root.tap-reason = r; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // the right column: the remove control on top, then the two toggles (4.3.3 stacked-wide)
                        VerticalLayout {
                            width: 168px;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            if root.has-trash: Rectangle {
                                min-height: 44px;
                                trash-w := ActionControl {
                                    x: parent.width - self.width;
                                    y: (parent.height - self.height) / 2;
                                    height: 44px;
                                    width: self.natural;
                                    align-end: false;
                                    data: root.item.actions[root.item.actions.length - 1];
                                    owner: "acc:" + root.item.id + ":" + (root.item.actions.length - 1);
                                    busy: root.busy;
                                    act(kind, value) => { root.tap-reason = ""; root.act(kind, value); }
                                    reason(r) => { root.tap-reason = r; }
                                }
                            }
                            dash-pair-wide := SwitchPair {
                                spread: true;
                                label: "Dashboard";
                                on: root.item.shown-dash;
                                enabled: root.item.dash-enabled;
                                long-tip: root.item.dash-tip;
                                probe: "acct-show:" + root.item.id;
                                toggled(on) => { root.act("account-show", root.item.id + "|" + (on ? "show" : "hide")); }
                                reason-tap => { root.tap-reason = root.item.dash-tip; }
                            }
                            tray-pair-wide := SwitchPair {
                                spread: true;
                                label: "Tray";
                                on: root.item.shown-tray;
                                enabled: root.item.tray-acct-enabled;
                                long-tip: root.item.tray-acct-tip;
                                probe: "acct-tray:" + root.item.id;
                                toggled(on) => { root.act("account-tray", root.item.id + "|" + (on ? "show" : "hide")); }
                                reason-tap => { root.tap-reason = root.item.tray-acct-tip; }
                            }
                        }
                    }
                }
                }
            }
        }
        if root.item.confirm: ConfirmLine {
            runs: root.item.confirm-runs;
            open: root.confirming;
            busy: root.busy;
            keep => { root.cancel-confirm(); }
            confirm => {
                root.cancel-confirm();
                root.act(root.item.activate-kind, root.item.profile);
            }
        }
        RowLine {
            line: root.item.line;
            owner: "line:" + root.item.id;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
        // the reason a tap on a dimmed control opened (5.2.2), in the refusal-line style
        if root.tap-reason != "": RowLine {
            line: { shown: true, kind: "refuse", icon: "info", lead: "", text: root.tap-reason, actions: [] };
            owner: "reason:" + root.item.id;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
    }
    ProbeMark { x: 0px; y: 0px; width: root.width; height: line.height; id: "row:" + root.item.id; }
}

// A Claude profile in the 30-day trash: its label, when it is deleted for good, Restore and Delete now
// (typed DELETE in the Claude flow), and its confirmation line.
component TrashRowItem inherits Rectangle {
    in property <AcTrashRow> item;
    in property <bool> busy;
    callback act(string, string);
    min-height: body.min-height;
    preferred-height: body.preferred-height;
    body := VerticalLayout {
        spacing: 0px;
        Rectangle {
            min-height: max(52px, lay.preferred-height);
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.rule-2; }
            lay := HorizontalLayout {
                padding-left: Breakpoints.tier-p ? 16px : 18px;
                padding-right: Breakpoints.tier-p ? 16px : 18px;
                padding-top: Breakpoints.below-d ? 12px : 10px;
                padding-bottom: Breakpoints.below-d ? 12px : 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text { min-height: 19.5px; vertical-alignment: center; text: root.item.label; font-size: Type.body; font-weight: 520; color: Theme.ink-2; overflow: elide; }
                    Text { min-height: 17.5px; vertical-alignment: center; text: root.item.sub; font-family: Type.tab; font-size: Type.small; color: Theme.ink-3; overflow: elide; }
                }
                for a[i] in root.item.actions: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ActionControl {
                        height: Breakpoints.below-d ? 44px : 28px;
                        width: self.natural;
                        align-end: false;
                        data: a;
                        owner: "trash:" + root.item.id + ":" + i;
                        busy: root.busy;
                        act(kind, value) => { root.act(kind, value); }
                    }
                }
                if root.item.actions.length > 0 && root.item.actions[root.item.actions.length - 1].coming: VerticalLayout { alignment: center; ComingWord { } }
            }
        }
        RowLine {
            line: root.item.line;
            owner: "trash-line:" + root.item.id;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
    }
}

// The Antigravity policy's controls: each a caption over its control, bottoms aligned in their row (or
// start-aligned full-width rows in the stacked list below D).
component AgParam inherits VerticalLayout {
    in property <string> caption;
    in property <bool> live;
    in property <bool> list: false;
    alignment: root.list ? start : end;
    spacing: 6px;
    opacity: root.live ? 1 : 0.5;
    animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    Caps { text: root.caption; min-width: self.preferred-width; }
    @children
}
component AgToggle inherits VerticalLayout {
    in property <AcAgPolicy> ag;
    in property <bool> busy;
    in property <bool> list;
    callback act(string, string);
    alignment: root.list ? start : end;
    // the list row (4.3.6): "Auto-switch" with its state word before the switch, the whole row 44 tall
    if root.list: HorizontalLayout {
        min-height: 44px;
        spacing: 8px;
        Text { text: "Auto-switch"; font-size: Type.body; color: Theme.ink; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if !root.ag.enabled: Text { text: "Off"; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; }
        if root.ag.enabled: Text { text: "On"; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            ag-t-m := BoundToggle {
                model-on: root.ag.enabled;
                enabled: root.ag.toggle-enabled && !root.busy;
                long-tip: root.ag.toggle-tip;
                toggled(on) => { root.act("antigravity-automatic", on ? "true" : "false"); }
            }
        }
    }
    if !root.list: TipArea {
        owner: "ag-auto";
        tip: root.ag.toggle-tip;
        height: 32px;
        width: tg-row.preferred-width;
        tg-row := HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                ag-t := BoundToggle {
                    model-on: root.ag.enabled;
                    enabled: root.ag.toggle-enabled && !root.busy;
                    label: "Auto-switch";
                    long-tip: root.ag.toggle-tip;
                    toggled(on) => { root.act("antigravity-automatic", on ? "true" : "false"); }
                }
            }
            if !root.ag.enabled: Text {
                text: "Off";
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }
    }
}
component AgStep inherits AgParam {
    in property <AcAgPolicy> ag;
    in property <bool> busy;
    in property <int> shown;
    callback step(int);
    caption: "SWITCH AT % USED";
    live: root.ag.live;
    HorizontalLayout {
        alignment: start;
        padding-bottom: root.list ? 0px : 4px;
        Stepper {
            value: root.shown;
            min: root.ag.min;
            max: root.ag.max;
            known: root.ag.threshold >= 0;
            enabled: root.ag.step-enabled && !root.busy;
            step(d) => { root.step(d); }
        }
    }
}
component AgPool inherits AgParam {
    in property <AcAgPolicy> ag;
    in property <bool> busy;
    callback act(string, string);
    caption: "WATCH POOL";
    live: root.ag.live;
    if root.ag.pools.length > 0 && !root.list: Segmented {
        items: root.ag.pools;
        value: root.ag.pool;
        enabled: root.ag.pool-enabled && !root.busy;
        changed-value(v) => { root.act("antigravity-pool", v); }
    }
    if root.ag.pools.length > 0 && root.list: StretchSegmented {
        items: root.ag.pools;
        value: root.ag.pool;
        enabled: root.ag.pool-enabled && !root.busy;
        changed-value(v) => { root.act("antigravity-pool", v); }
    }
    if root.ag.pools.length == 0 && !root.list: Text { height: 36px; text: "No quota pool reported yet"; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; }
    if root.ag.pools.length == 0 && root.list: Text { text: "No quota pool reported yet"; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; vertical-alignment: center; }
}
component AgCool inherits AgParam {
    in property <AcAgPolicy> ag;
    in property <bool> busy;
    callback act(string, string);
    caption: "COOLDOWN";
    live: root.ag.live;
    if root.list: StretchSegmented {
        items: root.ag.cooldowns;
        value: root.ag.cooldown;
        enabled: root.ag.cooldown-enabled && !root.busy;
        changed-value(v) => { root.act("antigravity-cooldown", v); }
    }
    if !root.list: Segmented {
        items: root.ag.cooldowns;
        value: root.ag.cooldown;
        enabled: root.ag.cooldown-enabled && !root.busy;
        changed-value(v) => { root.act("antigravity-cooldown", v); }
    }
}

// The Antigravity policy under its rows: the toggle, the switch point, the watched pool and the cooldown. Before
// a second account is signed in the toggle is drawn off and inert and the values are greyed, as in the concept.
// Below D it reflows by its own inner width (DESIGN-MOBILE.md 4.3.6, 1.5): a 2 x 2 grid from 520 and a
// full-width list under that; one row (as on desktop) from 860.
component AgPolicyBox inherits Rectangle {
    in property <AcAgPolicy> ag;
    in property <bool> busy;
    callback act(string, string);
    // the stepper's value before it is saved; -1 when nothing is pending
    property <int> pending: -1;
    property <int> shown: root.pending >= 0 ? root.pending : root.ag.threshold;
    property <int> reported: root.ag.threshold;
    changed reported => { if root.pending == root.reported { root.pending = -1; } }
    send := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            if root.pending >= 0 { root.act("antigravity-threshold", root.pending + "%"); release.running = true; }
        }
    }
    release := Timer { interval: 5s; running: false; triggered => { self.running = false; root.pending = -1; } }
    function step(d: int) {
        root.pending = clamp(root.shown + d, root.ag.min, root.ag.max);
        release.running = false;
        send.running = false;
        send.running = true;
    }
    // the box is wide enough for one row of controls; derived from the window (the box's own width in
    // its layout would loop). The section fills the page, the box sits in the section's 18 px gutters.
    // The one-row gate is the row's real natural width (toggle + stepper + both segmented controls,
    // ~930 px with the longest labels), not the concept's 860: between the two the row overflowed the
    // box and the card (measured at 1000 px), so those widths get the 2 x 2 grid, which compresses.
    property <length> inner-w: Breakpoints.tier-width - 2 * Breakpoints.gutter - 38px;
    property <bool> one-row: Breakpoints.tier-d ? Breakpoints.width >= 1360px : root.inner-w >= 940px;
    property <bool> grid: !root.one-row && root.inner-w >= 520px;

    min-height: inner.preferred-height;
    preferred-height: inner.preferred-height;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.paper-2;
    inner := VerticalLayout {
        padding-left: Breakpoints.tier-p ? 12px : 14px;
        padding-right: Breakpoints.tier-p ? 12px : 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        IconNote {
            gap: 8px;
            size: Breakpoints.below-d ? Type.small : 12.5px;
            ink: Theme.ink-2;
            text: root.ag.note-strong != "" ? root.ag.note-strong + " " + root.ag.note : root.ag.note;
        }
        // one row when the box is wide enough, otherwise the desktop's second row holds the cooldown.
        // The two segmented controls may shrink (min-width 0), but the toggle and stepper keep their
        // natural width: their labels clip hard, while the segmented cells elide. Without this the box's
        // natural row exceeded the box at F/T widths just over the gates, which stretched the whole
        // section card past the page edge and clipped the head's captions (card grew to 710 px on a
        // 669 px page).
        if root.one-row: HorizontalLayout {
            spacing: 22px;
            alignment: start;
            AgToggle { min-width: self.preferred-width; ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
            AgStep { min-width: self.preferred-width; ag: root.ag; busy: root.busy; shown: root.shown; step(d) => { root.step(d); } }
            AgPool { min-width: 0px; ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
            AgCool { min-width: 0px; ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
        }
        if !root.one-row && Breakpoints.tier-d: VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 22px;
                alignment: start;
                AgToggle { ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
                AgStep { ag: root.ag; busy: root.busy; shown: root.shown; step(d) => { root.step(d); } }
                AgPool { ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
            }
            HorizontalLayout {
                alignment: start;
                AgCool { ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
            }
        }
        // the 2 x 2 grid (520 to 859 below D): Auto-switch | Switch at, then Watch pool | Cooldown.
        // Shrinkable segmented cells (min-width 0), so the controls compress instead of stretching the
        // section card past the page edge at F widths just over the 520 gate.
        if !root.one-row && !Breakpoints.tier-d && root.grid: GridLayout {
            spacing: 12px;
            Row {
                AgToggle { min-width: self.preferred-width; ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
                AgStep { min-width: self.preferred-width; ag: root.ag; busy: root.busy; shown: root.shown; step(d) => { root.step(d); } }
            }
            Row {
                AgPool { min-width: 0px; ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
                AgCool { min-width: 0px; ag: root.ag; busy: root.busy; act(k, v) => { root.act(k, v); } }
            }
        }
        // the full-width list (under 520 below D)
        if !root.one-row && !Breakpoints.tier-d && !root.grid: VerticalLayout {
            spacing: 10px;
            AgToggle { ag: root.ag; busy: root.busy; list: true; act(k, v) => { root.act(k, v); } }
            AgStep { ag: root.ag; busy: root.busy; list: true; shown: root.shown; step(d) => { root.step(d); } }
            AgPool { ag: root.ag; busy: root.busy; list: true; act(k, v) => { root.act(k, v); } }
            AgCool { ag: root.ag; busy: root.busy; list: true; act(k, v) => { root.act(k, v); } }
        }
    }
}

// The section footer: how the provider signs in, then its add or check actions (and "coming" when they wait
// on the server). Desktop: the concept's .prov-foot with the hint left and the buttons right. Below D
// (4.3.4) the hint wraps above the buttons and the buttons follow the P rules: one button full width, two
// as equal halves, a dimmed one at its natural width with the caption; F and T keep them right-aligned at
// natural widths, as on desktop. Two components, so no layout branch ever reaches across.
component SectionFootDesk inherits Rectangle {
    in property <AcProvider> provider;
    in property <bool> busy;
    callback act(string, string);
    property <bool> any-coming: root.provider.foot-coming;
    property <length> text-w: max(160px, root.width - 36px - 15px - 8px - 14px - btns.preferred-width);
    // the concept's .prov-foot: its 1 px rule, 11 px above and 13 px below the 28 px controls
    min-height: max(how.preferred-height, 28px) + 25px;
    preferred-height: self.min-height;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.rule-2; }
    Icon {
        x: 18px;
        y: (root.height - max(how.preferred-height, 17px)) / 2 + 1px;
        name: root.provider.needs ? "alert" : "info";
        tint: root.provider.needs ? Theme.warn-text : Theme.ink-3;
        width: 15px;
        height: 15px;
    }
    how := Text {
        x: 18px + 15px + 8px;
        y: (root.height - self.preferred-height) / 2;
        width: root.text-w;
        text: root.provider.how;
        font-size: 12.5px;
        color: root.provider.needs ? Theme.ink-2 : Theme.ink-3;
        wrap: word-wrap;
    }
    btns := HorizontalLayout {
        x: root.width - 18px - self.preferred-width;
        y: (root.height - 28px) / 2;
        height: 28px;
        spacing: 8px;
        for f[i] in root.provider.foot: ActionControl {
            width: self.natural;
            align-end: false;
            data: f;
            owner: "foot:" + root.provider.id + ":" + i;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
        if root.any-coming: VerticalLayout { alignment: center; ComingWord { } }
    }
}

component SectionFootMob inherits Rectangle {
    in property <AcProvider> provider;
    in property <bool> busy;
    callback act(string, string);
    property <bool> any-coming: root.provider.foot-coming;
    property <length> pad-x: Breakpoints.tier-p ? 16px : 20px;
    min-height: mob.preferred-height + 1px;
    preferred-height: self.min-height;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.rule-2; }
    mob := VerticalLayout {
        y: 1px;
        height: self.preferred-height;
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: 12px;
        // 16 to the card's bottom edge below every action (DESIGN-MOBILE.md 4.3.4, ISSUES-9 C3)
        padding-bottom: 16px;
        spacing: 0px;
        IconNote {
            icon: root.provider.needs ? "alert" : "info";
            icon-ink: root.provider.needs ? Theme.warn-text : Theme.ink-3;
            ink: root.provider.needs ? Theme.ink-2 : Theme.ink-3;
            size: Type.small;
            text: root.provider.how;
        }
        Rectangle { height: 12px; }
        // a dimmed (coming) button keeps its natural width and gains the caption; F/T right-align the row
        if root.any-coming: HorizontalLayout {
            spacing: 8px;
            alignment: Breakpoints.tier-p ? start : end;
            min-height: 44px;
            for f[i] in root.provider.foot: VerticalLayout {
                alignment: center;
                ActionControl {
                    height: 44px;
                    width: self.natural;
                    align-end: false;
                    data: f;
                    owner: "foot:" + root.provider.id + ":" + i;
                    busy: root.busy;
                    act(kind, value) => { root.act(kind, value); }
                }
            }
            VerticalLayout { alignment: center; ComingWord { } }
        }
        // one live button: full width, 48 tall. The slot keeps an explicit height: a plain Rectangle
        // reserves none in a layout (its 48 px child does not grow it), so the card sized its bottom
        // without the button and the button rendered over the card's rounded edge (ISSUES-9 C2).
        if !root.any-coming && Breakpoints.tier-p && root.provider.foot.length == 1: Rectangle {
            height: 48px;
            for f[i] in root.provider.foot: ActionControl {
                stretch: true;
                tall: true;
                height: 48px;
                data: f;
                owner: "foot:" + root.provider.id + ":" + i;
                busy: root.busy;
                act(kind, value) => { root.act(kind, value); }
            }
        }
        // two live buttons: equal halves, 48 tall
        if !root.any-coming && Breakpoints.tier-p && root.provider.foot.length == 2: HorizontalLayout {
            spacing: 8px;
            height: 48px;
            for f[i] in root.provider.foot: Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                ActionControl {
                    width: parent.width;
                    stretch: true;
                    tall: true;
                    height: 48px;
                    data: f;
                    owner: "foot:" + root.provider.id + ":" + i;
                    busy: root.busy;
                    act(kind, value) => { root.act(kind, value); }
                }
            }
        }
        // F and T (or an unexpected count): right-aligned at natural widths, as on desktop
        if !root.any-coming && !(Breakpoints.tier-p && root.provider.foot.length >= 1): HorizontalLayout {
            spacing: 8px;
            alignment: end;
            min-height: 44px;
            for f[i] in root.provider.foot: VerticalLayout {
                alignment: center;
                ActionControl {
                    height: 44px;
                    width: self.natural;
                    align-end: false;
                    data: f;
                    owner: "foot:" + root.provider.id + ":" + i;
                    busy: root.busy;
                    act(kind, value) => { root.act(kind, value); }
                }
            }
        }
    }
}

export component ProviderSection inherits Plate {
    in property <AcProvider> provider;
    in property <bool> busy;
    in property <string> selected-id;
    in property <bool> show-src: true;
    callback open-details(string);
    callback act(string, string);

    // measured slot widths (only ever grow while the section lives); the actions column is their sum, at least
    // the concept's width for this kind of provider
    property <length> w0: 0px;
    property <length> w1: 0px;
    property <length> w2: 0px;
    property <length> acts-w: max(root.provider.acts-min, root.w0 + root.w1 + root.w2 + 6px * max(0, root.provider.slots - 1));
    property <string> confirm-id;
    // the row layout, from the page content width the section fills (DESIGN-MOBILE.md 1.5, 1.2); D keeps
    // its table row. Derived from the window, not the section's own width: that binding loops.
    property <length> sec-w: Breakpoints.tier-width - 2 * Breakpoints.gutter;
    property <int> row-mode: Breakpoints.tier-d ? 2 : root.sec-w >= 920px ? 2 : root.sec-w >= 520px ? 1 : 0;
    property <length> pad-x: Breakpoints.tier-p ? 16px : Breakpoints.below-d ? 20px : 18px;
    // task 9 accounts: the slot for the fixed "coming" caption beside the tray toggle. A hidden measurer
    // Text reads preferred-width 0 in Slint 1.18, so the slot is a constant; the caption elides inside it.
    property <length> coming-w: 48px;

    // Selected row: ONE tinted, outlined highlight per switchable section that glides between rows (translate
    // and height, ease-out, never past its target), inset 4 px top and bottom and 8 px from the sides.
    property <length> hl-y: 0px;
    property <length> hl-h: 0px;
    property <bool> hl-glide: false;
    property <bool> hl-placed: false;
    property <bool> hl-hover: false;
    property <bool> hl-on: root.provider.switchable && root.hl-placed && root.active-count > 0;
    property <int> active-count: 0;
    glide-end := Timer { interval: 600ms; running: false; triggered => { self.running = false; root.hl-glide = false; } }
    function place(y: length, h: length, glide: bool) {
        root.hl-glide = glide && root.hl-placed && Motion.on;
        if root.hl-glide { glide-end.running = true; }
        root.hl-y = y;
        root.hl-h = h;
        root.hl-placed = true;
    }

    min-height: body.min-height;
    preferred-height: body.preferred-height;

    body := VerticalLayout {
        spacing: 0px;
        // the P head (4.3.2, under 520): the mark, the name and kind line, then the two toggles as 44 px
        // list rows whose whole row is the hit area
        if root.row-mode == 0: VerticalLayout {
            padding-top: 16px;
            HorizontalLayout {
                padding-left: root.pad-x;
                padding-right: root.pad-x;
                padding-bottom: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ProviderMark { provider: root.provider.id; size: 28px; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "pmark:" + root.provider.id; } }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 0px;
                    opacity: root.provider.visible ? 1 : 0.55;
                    animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                    Text {
                        min-height: 23px;
                        vertical-alignment: center;
                        text: root.provider.label;
                        font-size: Type.title;
                        font-weight: 640;
                        color: Theme.ink;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        min-height: 18px;
                        VerticalLayout { alignment: center; Icon { name: root.provider.kind-icon; tint: Theme.ink-3; width: 14px; height: 14px; } }
                        Text {
                            text: root.provider.kind-label + " · " + root.provider.count-text;
                            font-size: Type.small;
                            color: Theme.ink-3;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.provider.hidden-note != "": Text {
                        text: root.provider.hidden-note;
                        font-size: Type.small;
                        color: Theme.ink-3;
                        horizontal-alignment: left;
                    }
                }
            }
            VerticalLayout {
                padding-left: root.pad-x;
                padding-right: root.pad-x;
                padding-bottom: 8px;
                opacity: root.provider.visible ? 1 : 0.55;
                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                head-show-pair := SwitchPair {
                    spread: true;
                    label: "Show on dashboard";
                    on: root.provider.visible;
                    enabled: root.provider.toggle-enabled;
                    long-tip: root.provider.toggle-tip;
                    probe: "show:" + root.provider.id;
                    toggled(on) => { root.act("accounts-show", root.provider.id + ":" + (on ? "show" : "hide")); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    head-tray-pair := SwitchPair {
                        horizontal-stretch: 1;
                        spread: true;
                        label: "Show in tray";
                        on: root.provider.tray-visible;
                        enabled: root.provider.tray-enabled;
                        long-tip: root.provider.tray-tip;
                        probe: "tray:" + root.provider.id;
                        toggled(on) => { root.act("accounts-tray", root.provider.id + ":" + (on ? "show" : "hide")); }
                    }
                    if root.provider.tray-coming: VerticalLayout { alignment: center; ComingWord { } }
                }
            }
        }
        // the F / T / D head, as on desktop
        if root.row-mode != 0: HorizontalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            padding-top: 16px;
            padding-bottom: 13px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                ProviderMark { provider: root.provider.id; size: 28px; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "pmark:" + root.provider.id; } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 0px;
                opacity: root.provider.visible ? 1 : 0.55;
                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                Text {
                    min-height: 23px;
                    vertical-alignment: center;
                    text: root.provider.label;
                    font-size: 16px;
                    font-weight: 640;
                    color: Theme.ink;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    min-height: 18px;
                    VerticalLayout { alignment: center; Icon { name: root.provider.kind-icon; tint: Theme.ink-3; width: 15px; height: 15px; } }
                    Text {
                        text: root.provider.kind-label + " · " + root.provider.count-text;
                        font-family: Type.tab;
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                spacing: 2px;
                // below D the column keeps its widest row's width: layouts shrink stretch-0 children too
                // when space is short, which squeezed this column and pushed the tray row's "coming"
                // caption past the card edge at 669 px. D keeps its natural sizing.
                // "Show on dashboard" is always the wider label, so the column's width is h-show's
                min-width: Breakpoints.below-d ? h-show.preferred-width
                    + (root.provider.tray-coming ? 6px + root.coming-w : 0px) : 0px;
                TipArea {
                    owner: "show:" + root.provider.id;
                    tip: root.provider.toggle-tip;
                    height: 22px;
                    // "Show on dashboard" is always the wider label, so this is the column's widest row
                    width: h-show.preferred-width;
                    h-show := BoundToggle {
                        y: (parent.height - self.height) / 2;
                        model-on: root.provider.visible;
                        enabled: root.provider.toggle-enabled;
                        label: "Show on dashboard";
                        long-tip: root.provider.toggle-tip;
                        probe: "show:" + root.provider.id;
                        toggled(on) => { root.act("accounts-show", root.provider.id + ":" + (on ? "show" : "hide")); }
                    }
                }
                // Below D the tray row is a fixed-width Rectangle: just over the layout gates the column
                // was squeezed below its content and the caption drew past the card's edge (669 px). On D
                // the row keeps the desktop's own HorizontalLayout, so D renders exactly as main.
                if Breakpoints.below-d: Rectangle {
                    height: 22px;
                    width: max(h-show.preferred-width, h-tray.preferred-width)
                        + (root.provider.tray-coming ? 6px + root.coming-w : 0px);
                    TipArea {
                        x: 0px;
                        y: 0px;
                        owner: "tray:" + root.provider.id;
                        tip: root.provider.tray-tip;
                        height: 22px;
                        width: max(h-show.preferred-width, h-tray.preferred-width);
                        h-tray := BoundToggle {
                            y: (parent.height - self.height) / 2;
                            model-on: root.provider.tray-visible;
                            enabled: root.provider.tray-enabled;
                            label: "Show in tray";
                            long-tip: root.provider.tray-tip;
                            probe: "tray:" + root.provider.id;
                            toggled(on) => { root.act("accounts-tray", root.provider.id + ":" + (on ? "show" : "hide")); }
                        }
                    }
                    if root.provider.tray-coming: ComingWord {
                        x: max(h-show.preferred-width, h-tray.preferred-width) + 6px;
                        y: 0px;
                        width: root.coming-w;
                        height: 22px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if !Breakpoints.below-d: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    TipArea {
                        owner: "tray:" + root.provider.id;
                        tip: root.provider.tray-tip;
                        height: 22px;
                        width: max(h-show.preferred-width, h-tray-d.preferred-width);
                        h-tray-d := BoundToggle {
                            y: (parent.height - self.height) / 2;
                            model-on: root.provider.tray-visible;
                            enabled: root.provider.tray-enabled;
                            label: "Show in tray";
                            long-tip: root.provider.tray-tip;
                            probe: "tray:" + root.provider.id;
                            toggled(on) => { root.act("accounts-tray", root.provider.id + ":" + (on ? "show" : "hide")); }
                        }
                    }
                    if root.provider.tray-coming: ComingWord { }
                }
                if root.provider.hidden-note != "": Text {
                    text: root.provider.hidden-note;
                    font-size: Type.small;
                    color: Theme.ink-3;
                    horizontal-alignment: left;
                }
            }
        }
        rows-box := Rectangle {
            min-height: rows.min-height;
            preferred-height: rows.preferred-height;
            opacity: root.provider.visible ? 1 : 0.55;
            animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
            if root.provider.switchable: Rectangle {
                x: 8px;
                y: root.hl-y + 4px;
                width: parent.width - 16px;
                height: max(0px, root.hl-h - 8px);
                border-radius: 10px;
                background: Theme.accent.mix(Theme.paper, root.hl-hover ? 0.11 : 0.07);
                border-width: 1px;
                border-color: Theme.accent.mix(Theme.paper, 0.42);
                opacity: root.hl-on ? 1 : 0;
                animate y, height { duration: root.hl-glide ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                animate background { duration: Motion.tint(160ms); easing: cubic-bezier(0.65, 0, 0.35, 1); }
            }
            rows := VerticalLayout {
                spacing: 0px;
                for row[i] in root.provider.rows: AcRowItem {
                    item: row;
                    provider: root.provider;
                    mode: root.row-mode;
                    w0: root.w0;
                    w1: root.w1;
                    w2: root.w2;
                    acts-w: root.acts-w;
                    show-src: root.show-src;
                    busy: root.busy;
                    selected: row.id == root.selected-id;
                    confirming: root.confirm-id == row.id;
                    init => {
                        if row.active {
                            root.active-count = 1;
                            root.place(self.y, self.line-height, false);
                        }
                    }
                    changed y => { if self.item.active { root.place(self.y, self.line-height, false); } }
                    changed line-height => { if self.item.active { root.place(self.y, self.line-height, false); } }
                    changed item => {
                        if self.item.active {
                            root.active-count = 1;
                            root.place(self.y, self.line-height, true);
                        }
                        if !self.item.confirm && root.confirm-id == self.item.id { root.confirm-id = ""; }
                    }
                    changed hovered => { if self.item.active { root.hl-hover = self.hovered; } }
                    measured(index, width) => {
                        if index == 0 { root.w0 = max(root.w0, width); }
                        if index == 1 { root.w1 = max(root.w1, width); }
                        if index == 2 { root.w2 = max(root.w2, width); }
                    }
                    open-details(id) => { root.open-details(id); }
                    act(kind, value) => { root.act(kind, value); }
                    ask-confirm(id) => { root.confirm-id = id; }
                    cancel-confirm => { root.confirm-id = ""; }
                }
            }
        }
        if root.provider.count == 0: Rectangle {
            min-height: 46px;
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.rule-2; }
            Text {
                x: root.pad-x;
                y: (parent.height - self.preferred-height) / 2;
                text: root.provider.empty;
                font-size: Type.small;
                color: Theme.ink-3;
            }
        }
        if root.provider.trash.length > 0: VerticalLayout {
            spacing: 0px;
            Rectangle {
                min-height: 34px;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.rule-2; }
                HorizontalLayout {
                    padding-left: root.pad-x;
                    padding-right: root.pad-x;
                    padding-top: 12px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    Caps { text: "IN THE TRASH"; horizontal-stretch: 0; }
                    Text { text: "Restored within 30 days, then deleted for good"; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                }
            }
            for t in root.provider.trash: TrashRowItem {
                item: t;
                busy: root.busy;
                act(kind, value) => { root.act(kind, value); }
            }
        }
        if root.provider.ag: HorizontalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            padding-top: 4px;
            padding-bottom: 14px;
            AgPolicyBox {
                ag: AcData.ag;
                busy: root.busy;
                act(kind, value) => { root.act(kind, value); }
            }
        }
        FlowPanel {
            flow: root.provider.flow;
            provider: root.provider.id;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
        if Breakpoints.below-d: SectionFootMob {
            provider: root.provider;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
        if !Breakpoints.below-d: SectionFootDesk {
            provider: root.provider;
            busy: root.busy;
            act(kind, value) => { root.act(kind, value); }
        }
    }
}
