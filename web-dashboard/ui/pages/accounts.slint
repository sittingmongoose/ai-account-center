// Accounts & Settings, built like the concept (c-daylight-atlas/app-accounts.js, the Dashboard sign-in block of
// app-auth.js, styles.css and auth.css). One section per provider from the registry with its accounts and fixed,
// aligned action slots; then the settings column: Sign-in & connection, Settings, History snapshots, Usage log
// sources, Update apps and About with AboutSlint.
//
// Widths: below 1280 px the providers fill the page and the settings sit below them — one column on P and F
// under 760, two columns (Sign-in & connection, Update apps, About | Settings, History snapshots, Usage log
// sources) on F from 760 and T (DESIGN-MOBILE.md 4.3.7); from 1280 the settings column stands beside the
// providers (380 px, 420 from 1600, 440 from 2200) and from 1280 to 1439 the source column folds into the
// identity line; from 2200 the providers split into two columns, the ones with their own sign-in flows first.
// P and F get the page title with the Settings jump button (4.3.1); T and D keep the desktop arrangement.
// Every value comes from the AcData global (public/accounts-view.mjs); intent goes out through action(kind, value).
import { Theme, Motion, Type, Breakpoints } from "../theme.slint";
import { Button } from "../components/button.slint";
import { Reveal } from "../components/reveal.slint";
import { AcData, AcProvider, AcUi } from "accounts/ac-data.slint";
import { ProviderSection } from "accounts/ac-provider.slint";
import { SettingsColumn } from "accounts/ac-settings.slint";

component ProviderList inherits VerticalLayout {
    in property <[AcProvider]> list;
    in property <int> offset: 0;
    in property <bool> busy;
    in property <string> selected-id;
    in property <bool> show-src;
    in property <duration> base;
    callback open-details(string);
    callback act(string, string);
    spacing: 16px;
    alignment: start;
    for p[i] in root.list: Reveal {
        delay: root.base + (root.offset + i) * 40ms;
        ProviderSection {
            provider: p;
            busy: root.busy;
            selected-id: root.selected-id;
            show-src: root.show-src;
            open-details(id) => { root.open-details(id); }
            act(kind, value) => { root.act(kind, value); }
        }
    }
}

export component AccountsPage inherits Rectangle {
    in property <bool> busy: false;
    in property <string> selected-id;
    in property <string> theme-value: "auto";
    in property <bool> first: false;
    callback theme-picked(string);
    callback open-details(string);
    callback act(string, string);

    property <duration> base: root.first ? 180ms : 40ms;
    property <bool> show-src: Breakpoints.width < 1280px || Breakpoints.width >= 1440px;
    property <length> settings-w: Breakpoints.ultra ? 440px : Breakpoints.wide ? 420px : 380px;
    // the P/F page header (4.3.1); T and D keep the desktop arrangement without a title
    property <bool> page-head: Breakpoints.tier-p || Breakpoints.tier-f;
    // the settings' two columns on F from 760 and T (4.3.7)
    property <bool> settings-two-col: Breakpoints.tier-t || (Breakpoints.tier-f && Breakpoints.tier-width >= 760px);

    min-height: page.preferred-height;
    preferred-height: page.preferred-height;

    page := VerticalLayout {
        alignment: start;
        spacing: root.page-head ? 12px : 0px;
        if AcData.ready && root.page-head: HorizontalLayout {
            padding-left: Breakpoints.gutter;
            padding-right: Breakpoints.gutter;
            padding-top: Breakpoints.tier-p ? 2px : 4px;
            spacing: 12px;
            Text {
                text: "Accounts & Settings";
                font-size: Type.page-title;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
            // the Settings jump (Q2: kept): scrolls the page to the top of the Settings area; the page
            // scroller in the shell watches AcUi.settings-jump
            Button {
                y: (parent.height - self.height) / 2;
                kind: "ghost";
                icon: "arrow-down";
                text: "Settings";
                clicked => { AcUi.settings-jump += 1; }
            }
        }
        if AcData.ready && Breakpoints.compact: VerticalLayout {
            spacing: 24px;
            VerticalLayout {
                spacing: 16px;
                ProviderList {
                    list: AcData.col-a;
                    busy: root.busy;
                    selected-id: root.selected-id;
                    show-src: root.show-src;
                    base: root.base;
                    open-details(id) => { root.open-details(id); }
                    act(kind, value) => { root.act(kind, value); }
                }
                ProviderList {
                    list: AcData.col-b;
                    offset: AcData.col-a.length;
                    busy: root.busy;
                    selected-id: root.selected-id;
                    show-src: root.show-src;
                    base: root.base;
                    open-details(id) => { root.open-details(id); }
                    act(kind, value) => { root.act(kind, value); }
                }
            }
            Reveal {
                delay: root.base + 80ms;
                SettingsColumn {
                    two-col: root.settings-two-col;
                    theme-value: root.theme-value;
                    busy: root.busy;
                    theme-picked(v) => { root.theme-picked(v); }
                    act(kind, value) => { root.act(kind, value); }
                }
            }
        }
        if AcData.ready && !Breakpoints.compact: HorizontalLayout {
            spacing: 24px;
            alignment: stretch;
            // the providers: one column, or two on ultra-wide screens
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 20px;
                alignment: stretch;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 16px;
                    ProviderList {
                        list: AcData.col-a;
                        busy: root.busy;
                        selected-id: root.selected-id;
                        show-src: root.show-src;
                        base: root.base;
                        open-details(id) => { root.open-details(id); }
                        act(kind, value) => { root.act(kind, value); }
                    }
                    if !Breakpoints.ultra: ProviderList {
                        list: AcData.col-b;
                        offset: AcData.col-a.length;
                        busy: root.busy;
                        selected-id: root.selected-id;
                        show-src: root.show-src;
                        base: root.base;
                        open-details(id) => { root.open-details(id); }
                        act(kind, value) => { root.act(kind, value); }
                    }
                }
                if Breakpoints.ultra: ProviderList {
                    horizontal-stretch: 1;
                    list: AcData.col-b;
                    offset: 1;
                    busy: root.busy;
                    selected-id: root.selected-id;
                    show-src: root.show-src;
                    base: root.base;
                    open-details(id) => { root.open-details(id); }
                    act(kind, value) => { root.act(kind, value); }
                }
            }
            VerticalLayout {
                width: root.settings-w;
                alignment: start;
                Reveal {
                    delay: root.base + 40ms;
                    SettingsColumn {
                        theme-value: root.theme-value;
                        busy: root.busy;
                        theme-picked(v) => { root.theme-picked(v); }
                        act(kind, value) => { root.act(kind, value); }
                    }
                }
            }
        }
    }
}
