// Cost by model (4-segment cost bars that grow in sequence, a model detail popover with the I/O ratio) and the
// model usage donut (tokens or cost, an animated sweep, labels above 5%, a hover readout and the centre total):
// the donut large at the top of its box, the model list full-width below it, so full model names fit.
import { Theme, Motion, Type, Breakpoints, Device } from "../../theme.slint";
import { Icon } from "../../components/icon.slint";
import { Hover } from "../../components/hover-card.slint";
import { IconButton } from "../../components/icon-button.slint";
import { ProviderMark } from "../../components/mark.slint";
import { Caps, ValueUnit } from "../../components/text.slint";
import { AxData, AxModelRow, AxDonutSeg } from "ax-data.slint";
import { AxColor, AxCard, AxCardHead, AxSeg, AxSegItem, AxTip, AxPress, AxScrub, AxSwatch, AxLegendEntry } from "ax-common.slint";
import { AxPopBody } from "ax-head.slint";

// ---------------------------------------------------------------- the model detail popover
component StatBox inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <bool> pct;
    in property <string> tip;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.rule-2;
    background: Theme.paper-2;
    min-height: col.preferred-height;
    col := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 1px;
        HorizontalLayout {
            if root.pct: ValueUnit { value: root.value; size: 17px; weight: 650; unit-scale: 0.96; height: 23px; }
            if !root.pct: Text { text: root.value; font-family: Type.tab; font-size: 17px; font-weight: 650; color: Theme.ink; min-height: 23px; vertical-alignment: center; AxTip { tip: root.tip; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.label; font-size: 11.5px; color: Theme.ink-3; wrap: word-wrap; }
    }
}

export component ModelDetail inherits VerticalLayout {
    in property <AxModelRow> m;
    // narrow popovers (phones) shrink the token-type columns so the rows fit
    in property <bool> narrow: false;
    callback close();
    property <bool> grown: !Motion.on;
    grow := Timer { interval: 32ms; running: !root.grown; triggered => { self.running = false; root.grown = true; } }
    spacing: 0px;
    HorizontalLayout {
        spacing: 10px;
        // a model that is not one provider's alone has no mark
        if root.m.provider != "": VerticalLayout { alignment: start; padding-top: 2px; ProviderMark { provider: root.m.provider; size: 22px; } }
        VerticalLayout {
            horizontal-stretch: 1;
            Text { text: root.m.name; font-size: 14.5px; font-weight: 660; color: Theme.ink; overflow: elide; }
            Text { text: root.m.sub; font-size: 12px; color: Theme.ink-3; overflow: elide; }
        }
        VerticalLayout { alignment: start; IconButton { icon: "close"; small: true; bare: true; hint: "Close"; clicked => { root.close(); } } }
    }
    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 4px;
        spacing: 8px;
        StatBox { value: root.m.usage; label: "of all tokens"; pct: true; horizontal-stretch: 1; }
        StatBox { value: root.m.cost; label: root.m.partial ? "estimated cost, partial" : "estimated cost"; horizontal-stretch: 1; }
        StatBox { value: root.m.tok; label: "tokens, all types"; tip: root.m.tok-tip; horizontal-stretch: 1; }
    }
    Caps { text: "TOKEN TYPES"; min-height: 32px; vertical-alignment: bottom; }
    Rectangle { height: 6px; }
    for t[i] in root.m.types: HorizontalLayout {
        spacing: root.narrow ? 8px : 9px;
        min-height: 22px;
        VerticalLayout { alignment: center; AxSwatch { c: AxColor.of(t.key); } }
        Text { text: t.label; width: root.narrow ? 84px : 112px; font-size: 12.5px; color: t.none ? Theme.ink-3 : Theme.ink; vertical-alignment: center; overflow: elide; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: root.narrow ? 24px : 40px;
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.paper-3;
                clip: true;
                Rectangle {
                    x: 0px;
                    width: parent.width * (root.grown ? t.w : 0) / 100;
                    animate width { duration: Motion.on ? 640ms : 0ms; delay: Motion.on ? 80ms + i * 60ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    height: 6px;
                    border-radius: 3px;
                    background: AxColor.of(t.key);
                }
            }
        }
        Text {
            text: t.tok;
            width: root.narrow ? 48px : 54px;
            font-family: Type.tab;
            font-size: 12.5px;
            font-weight: t.none ? 500 : 600;
            color: t.none ? Theme.ink-3 : Theme.ink;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            AxPress { tip: t.tip; long-tip: t.tip; }
        }
        Text { text: t.cost; width: root.narrow ? 72px : 84px; font-family: Type.tab; font-size: 12.5px; font-weight: t.none ? 500 : 600; color: t.none ? Theme.ink-3 : Theme.ink; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
    Caps { text: "INPUT TO OUTPUT RATIO"; min-height: 32px; vertical-alignment: bottom; }
    Rectangle { height: 6px; }
    Rectangle {
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.rule-2;
        min-height: io.preferred-height;
        io := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;
            Text { text: root.m.io; font-family: Type.tab; font-size: 18px; font-weight: 650; color: Theme.ink; }
            Text { text: root.m.io-note; font-size: 12.5px; color: Theme.ink-2; wrap: word-wrap; }
            if root.m.io-quiet != "": Text { text: root.m.io-quiet; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
        }
    }
    Rectangle { height: 10px; }
    Text { text: root.m.rate; font-size: 11.5px; color: Theme.ink-3; wrap: word-wrap; }
}

// ---------------------------------------------------------------- cost by model
component CbmRow inherits Rectangle {
    in property <AxModelRow> m;
    in property <bool> played;
    in property <duration> delay;
    in property <length> name-w;
    in property <length> gap;
    in property <length> tok-w;
    in property <length> cost-w;
    in property <length> share-w;
    // Desktop only (used under `if Breakpoints.tier-d`): the single-line row, verbatim main.
    // A tier-conditional layout inside the TouchArea reserves box space even when its branch
    // is off, which grew every desktop row by 20 px; the below-D stacked row lives in
    // CbmRowStacked instead, so this TouchArea holds one unconditional layout.
    min-height: 40px;
    border-radius: 9px;
    background: ta.pressed && Breakpoints.below-d ? Theme.pressed : (Device.hover && ta.has-hover) || pop.is-open ? Theme.row-hover : Theme.row-hover.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // the fill grows from zero on first view and to the new width when the data changes
    property <bool> mounted: !Motion.on;
    mount := Timer { interval: 16ms; running: !root.mounted; triggered => { self.running = false; root.mounted = true; } }
    property <bool> landed: !Motion.on;
    land := Timer { interval: root.delay + root.m.idx * 70ms + 820ms; running: root.played && root.mounted && !root.landed; triggered => { self.running = false; root.landed = true; } }
    property <float> fill: root.played && root.mounted ? root.m.w : 0;
    animate fill { duration: Motion.on ? 760ms : 0ms; delay: Motion.on && !root.landed ? root.delay + root.m.idx * 70ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <length> pop-w: Breakpoints.tier-d ? 440px : min(440px, Breakpoints.tier-width - 2 * Breakpoints.gutter);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: root.gap;
            HorizontalLayout {
                width: root.name-w;
                spacing: 9px;
                VerticalLayout { alignment: center; ProviderMark { provider: root.m.provider; size: 18px; } }
                Text { text: root.m.name; font-size: 13px; font-weight: 560; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 100px;
                track := Rectangle {
                    height: 14px;
                    border-radius: 4px;
                    background: Theme.paper-3;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: track.width * root.fill / 100;
                        height: 14px;
                        border-radius: 4px;
                        clip: true;
                        HorizontalLayout {
                            width: track.width * root.m.w / 100;
                            spacing: 1px;
                            if root.m.fin > 0: Rectangle { horizontal-stretch: root.m.fin; min-width: 0px; background: AxColor.of("in"); AxPress { tip: root.m.tip-in; long-tip: root.m.tip-in; tapped => { pop.show(); } } }
                            if root.m.fout > 0: Rectangle { horizontal-stretch: root.m.fout; min-width: 0px; background: AxColor.of("out"); AxPress { tip: root.m.tip-out; long-tip: root.m.tip-out; tapped => { pop.show(); } } }
                            if root.m.fcw > 0: Rectangle { horizontal-stretch: root.m.fcw; min-width: 0px; background: AxColor.of("cw"); AxPress { tip: root.m.tip-cw; long-tip: root.m.tip-cw; tapped => { pop.show(); } } }
                            if root.m.fcr > 0: Rectangle { horizontal-stretch: root.m.fcr; min-width: 0px; background: AxColor.of("cr"); AxPress { tip: root.m.tip-cr; long-tip: root.m.tip-cr; tapped => { pop.show(); } } }
                        }
                    }
                }
            }
            if root.tok-w > 0: Text { text: root.m.tok; width: root.tok-w; font-family: Type.tab; font-size: 13px; color: Theme.ink-2; horizontal-alignment: right; vertical-alignment: center; AxPress { tip: root.m.tok-tip; long-tip: root.m.tok-tip; tapped => { pop.show(); } } }
            VerticalLayout {
                width: root.cost-w;
                alignment: center;
                spacing: 0px;
                Text { text: root.m.cost; font-family: Type.tab; font-size: root.m.cost-na ? 12px : 13px; font-weight: root.m.cost-na ? 500 : 620; color: root.m.cost-na ? Theme.ink-3 : Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                if root.m.partial: Text { text: "partial"; font-size: 11px; color: Theme.ink-3; horizontal-alignment: right; }
            }
            HorizontalLayout {
                width: root.share-w;
                alignment: end;
                if root.m.share == "Unavailable": Text { text: root.m.share; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; }
                if root.m.share != "Unavailable" && root.m.share != "": VerticalLayout { alignment: center; ValueUnit { value: root.m.share; size: 13px; weight: 400; ink: Theme.ink-2; unit-scale: 0.96; height: 18px; } }
            }
        }
    }
    pop := PopupWindow {
        x: Breakpoints.tier-d ? max(-root.absolute-position.x + 10px, (root.width - 440px) / 2) : max(-8px, root.width - root.pop-w);
        y: root.height + 8px;
        width: root.pop-w;
        height: cbm-body.preferred-height;
        close-policy: close-on-click-outside;
        cbm-body := AxPopBody { width: root.pop-w; height: self.preferred-height; pad-y: 14px; ModelDetail { m: root.m; narrow: root.pop-w < 380px; close => { pop.close(); } } }
    }
}

// ---------------------------------------------------------------- cost by model, below D
// The stacked row (DESIGN-MOBILE 4.2.4): below-D only (used under `if Breakpoints.below-d`).
// Its TouchArea keeps both tier branches exactly as before, so every below-D layout is
// unchanged; desktop uses CbmRow above, whose TouchArea holds no conditional layout.
component CbmRowStacked inherits Rectangle {
    in property <AxModelRow> m;
    in property <bool> played;
    in property <duration> delay;
    in property <length> name-w;
    in property <length> gap;
    in property <length> tok-w;
    in property <length> cost-w;
    in property <length> share-w;
    // stacked below a 520 px card inner width (DESIGN-MOBILE 1.5, 4.2.4)
    in property <bool> stacked: false;
    // stacked content is fixed-height (10 + 22 + 6 + 8 + 6 + 19 + 10): the row fits it exactly,
    // so the tokens/share line never overflows onto the next row (task 9 A1)
    min-height: root.stacked ? 81px : 40px;
    border-radius: 9px;
    background: ta.pressed && Breakpoints.below-d ? Theme.pressed : (Device.hover && ta.has-hover) || pop.is-open ? Theme.row-hover : Theme.row-hover.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    // the fill grows from zero on first view and to the new width when the data changes
    property <bool> mounted: !Motion.on;
    mount := Timer { interval: 16ms; running: !root.mounted; triggered => { self.running = false; root.mounted = true; } }
    property <bool> landed: !Motion.on;
    land := Timer { interval: root.delay + root.m.idx * 70ms + 820ms; running: root.played && root.mounted && !root.landed; triggered => { self.running = false; root.landed = true; } }
    property <float> fill: root.played && root.mounted ? root.m.w : 0;
    animate fill { duration: Motion.on ? 760ms : 0ms; delay: Motion.on && !root.landed ? root.delay + root.m.idx * 70ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <length> pop-w: Breakpoints.tier-d ? 440px : min(440px, Breakpoints.tier-width - 2 * Breakpoints.gutter);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
        if !root.stacked: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: root.gap;
            HorizontalLayout {
                width: root.name-w;
                spacing: 9px;
                VerticalLayout { alignment: center; ProviderMark { provider: root.m.provider; size: 18px; } }
                Text { text: root.m.name; font-size: 13px; font-weight: 560; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 100px;
                track := Rectangle {
                    height: 14px;
                    border-radius: 4px;
                    background: Theme.paper-3;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: track.width * root.fill / 100;
                        height: 14px;
                        border-radius: 4px;
                        clip: true;
                        HorizontalLayout {
                            width: track.width * root.m.w / 100;
                            spacing: 1px;
                            if root.m.fin > 0: Rectangle { horizontal-stretch: root.m.fin; min-width: 0px; background: AxColor.of("in"); AxPress { tip: root.m.tip-in; long-tip: root.m.tip-in; tapped => { pop.show(); } } }
                            if root.m.fout > 0: Rectangle { horizontal-stretch: root.m.fout; min-width: 0px; background: AxColor.of("out"); AxPress { tip: root.m.tip-out; long-tip: root.m.tip-out; tapped => { pop.show(); } } }
                            if root.m.fcw > 0: Rectangle { horizontal-stretch: root.m.fcw; min-width: 0px; background: AxColor.of("cw"); AxPress { tip: root.m.tip-cw; long-tip: root.m.tip-cw; tapped => { pop.show(); } } }
                            if root.m.fcr > 0: Rectangle { horizontal-stretch: root.m.fcr; min-width: 0px; background: AxColor.of("cr"); AxPress { tip: root.m.tip-cr; long-tip: root.m.tip-cr; tapped => { pop.show(); } } }
                        }
                    }
                }
            }
            if root.tok-w > 0: Text { text: root.m.tok; width: root.tok-w; font-family: Type.tab; font-size: 13px; color: Theme.ink-2; horizontal-alignment: right; vertical-alignment: center; AxPress { tip: root.m.tok-tip; long-tip: root.m.tok-tip; tapped => { pop.show(); } } }
            VerticalLayout {
                width: root.cost-w;
                alignment: center;
                spacing: 0px;
                Text { text: root.m.cost; font-family: Type.tab; font-size: root.m.cost-na ? 12px : 13px; font-weight: root.m.cost-na ? 500 : 620; color: root.m.cost-na ? Theme.ink-3 : Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                if root.m.partial: Text { text: "partial"; font-size: 11px; color: Theme.ink-3; horizontal-alignment: right; }
            }
            HorizontalLayout {
                width: root.share-w;
                alignment: end;
                if root.m.share == "Unavailable": Text { text: root.m.share; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; }
                if root.m.share != "Unavailable" && root.m.share != "": VerticalLayout { alignment: center; ValueUnit { value: root.m.share; size: 13px; weight: 400; ink: Theme.ink-2; unit-scale: 0.96; height: 18px; } }
            }
        }
        // stacked: mark + name + cost, the 8 px bar, then tokens and share (DESIGN-MOBILE 4.2.4)
        if root.stacked: VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 9px;
                min-height: 22px;
                VerticalLayout { alignment: center; ProviderMark { provider: root.m.provider; size: 16px; } }
                Text { text: root.m.name; font-size: Type.body; font-weight: 560; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.m.cost; font-family: Type.tab; font-size: Type.body; font-weight: root.m.cost-na ? 500 : 620; color: root.m.cost-na ? Theme.ink-3 : Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
            }
            strack := Rectangle {
                height: 8px;
                border-radius: 4px;
                background: Theme.paper-3;
                clip: true;
                Rectangle {
                    x: 0px;
                    width: strack.width * root.fill / 100;
                    height: 8px;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        width: strack.width * root.m.w / 100;
                        spacing: 1px;
                        if root.m.fin > 0: Rectangle { horizontal-stretch: root.m.fin; min-width: 0px; background: AxColor.of("in"); }
                        if root.m.fout > 0: Rectangle { horizontal-stretch: root.m.fout; min-width: 0px; background: AxColor.of("out"); }
                        if root.m.fcw > 0: Rectangle { horizontal-stretch: root.m.fcw; min-width: 0px; background: AxColor.of("cw"); }
                        if root.m.fcr > 0: Rectangle { horizontal-stretch: root.m.fcr; min-width: 0px; background: AxColor.of("cr"); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 5px;
                min-height: 19px;
                Text { text: root.m.tok; font-family: Type.tab; font-size: Type.small; color: Theme.ink-2; vertical-alignment: center; }
                if root.m.share != "" && root.m.share != "Unavailable": Text { text: "·"; font-size: Type.small; color: Theme.ink-4; vertical-alignment: center; }
                if root.m.share != "" && root.m.share != "Unavailable": VerticalLayout { alignment: center; horizontal-stretch: 0; ValueUnit { value: root.m.share; size: Type.small; weight: 400; ink: Theme.ink-2; unit-scale: 0.96; } }
                if root.m.partial: Text { text: "· partial"; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; }
                // spare width goes here, never between the runs (task 9 A1, same as O6)
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    pop := PopupWindow {
        x: Breakpoints.tier-d ? max(-root.absolute-position.x + 10px, (root.width - 440px) / 2) : max(-8px, root.width - root.pop-w);
        y: root.height + 8px;
        width: root.pop-w;
        height: cbm-body.preferred-height;
        close-policy: close-on-click-outside;
        cbm-body := AxPopBody { width: root.pop-w; height: self.preferred-height; pad-y: 14px; ModelDetail { m: root.m; narrow: root.pop-w < 380px; close => { pop.close(); } } }
    }
}

export component AxCbmCard inherits AxCard {
    in property <bool> played;
    in property <duration> delay;
    property <bool> tight: Breakpoints.width <= 1360px;
    property <length> gap: root.tight ? 12px : 14px;
    // the name column: minmax(150px, 220px) in the concept, from the page width so the layout has no loop
    property <length> name-w: Breakpoints.width < 1180px ? 180px : root.tight ? 200px : 220px;
    property <length> tok-w: root.tight ? 60px : 64px;
    property <length> cost-w: root.tight ? 88px : 92px;
    property <length> share-w: root.tight ? 52px : 56px;
    property <length> pad-x: Breakpoints.tier-d ? 20px : Breakpoints.tier-p ? 16px : 20px;
    // the card spans the full content width below D, so the inner width is a window function
    // (a card's own width must never drive its layout: binding loop)
    property <bool> stacked: Breakpoints.below-d
        && Breakpoints.tier-width - 2 * Breakpoints.gutter - 2 * root.pad-x < 520px;
    if Breakpoints.tier-d: AxCardHead {
        title: "Cost by model";
        sub: AxData.cbm.sub;
        note: AxData.cbm.note;
        HorizontalLayout {
            spacing: 14px;
            alignment: end;
            horizontal-stretch: 0;
            for k in ["in", "out", "cw", "cr"]: VerticalLayout {
                alignment: center;
                AxLegendEntry { c: AxColor.of(k); label: k == "in" ? "Input" : k == "out" ? "Output" : k == "cw" ? "Cache write" : "Cache read"; }
            }
            // the order of the rows: by cost (the default), or by tokens so a model whose cost is not logged
            // ranks by its usage
            HorizontalLayout {
                spacing: 8px;
                padding-left: 6px;
                Caps { text: "SORT"; }
                VerticalLayout {
                    alignment: start;
                    AxSeg {
                        small: true;
                        items: [{ value: "cost", label: "Cost" }, { value: "tokens", label: "Tokens" }];
                        value: AxData.cbm-sort;
                        picked(v) => { AxData.action("analytics-cbm-sort", v); }
                    }
                }
            }
        }
    }
    // below D the legend stacks on P/F and the sort pair sits at its right (DESIGN-MOBILE 4.2.4)
    if Breakpoints.below-d: AxCardHead { title: "Cost by model"; sub: AxData.cbm.sub; note: AxData.cbm.note; }
    if Breakpoints.below-d: HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-bottom: 4px;
        spacing: 12px;
        if Breakpoints.tier-t: HorizontalLayout {
            spacing: 14px;
            horizontal-stretch: 1;
            alignment: start;
            for k in ["in", "out", "cw", "cr"]: VerticalLayout {
                alignment: center;
                AxLegendEntry { c: AxColor.of(k); label: k == "in" ? "Input" : k == "out" ? "Output" : k == "cw" ? "Cache write" : "Cache read"; }
            }
        }
        if !Breakpoints.tier-t: VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: start;
            for k in ["in", "out", "cw", "cr"]: AxLegendEntry { c: AxColor.of(k); label: k == "in" ? "Input" : k == "out" ? "Output" : k == "cw" ? "Cache write" : "Cache read"; }
        }
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Caps { text: "SORT"; }
                AxSeg {
                    small: true;
                    items: [{ value: "cost", label: "Cost" }, { value: "tokens", label: "Tokens" }];
                    value: AxData.cbm-sort;
                    picked(v) => { AxData.action("analytics-cbm-sort", v); }
                }
            }
        }
    }
    if !root.stacked: HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 2px;
        padding-bottom: 6px;
        spacing: root.gap;
        Rectangle { width: root.name-w; }
        Caps { text: "ESTIMATED COST BY TOKEN TYPE"; horizontal-stretch: 1; min-width: 100px; }
        Caps { text: "TOKENS"; width: root.tok-w; horizontal-alignment: right; }
        Caps { text: "COST"; width: root.cost-w; horizontal-alignment: right; }
        Caps { text: "SHARE"; width: root.share-w; horizontal-alignment: right; }
    }
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 10px;
        if Breakpoints.tier-d: VerticalLayout {
            spacing: 0px;
            for m in AxData.models: CbmRow {
                m: m;
                played: root.played;
                delay: root.delay;
                name-w: root.name-w;
                gap: root.gap;
                tok-w: root.tok-w;
                cost-w: root.cost-w;
                share-w: root.share-w;
            }
        }
        if Breakpoints.below-d: VerticalLayout {
            spacing: 0px;
            for m in AxData.models: CbmRowStacked {
                m: m;
                played: root.played;
                delay: root.delay;
                name-w: root.name-w;
                gap: root.gap;
                tok-w: root.tok-w;
                cost-w: root.cost-w;
                share-w: root.share-w;
                stacked: root.stacked;
            }
        }
        if AxData.models.length == 0: Text {
            text: AxData.ready ? AxData.cbm.empty : AxData.head.error != "" ? "Model activity unavailable" : "Loading model activity";
            font-size: 13px;
            color: Theme.ink-3;
            horizontal-alignment: center;
            min-height: 72px;
            vertical-alignment: center;
        }
    }
    if AxData.cbm.foot != "" && Breakpoints.tier-d: HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-bottom: 14px;
        Text { text: AxData.cbm.foot; font-size: Breakpoints.tier-d ? 12px : Type.small; color: Theme.ink-3; wrap: word-wrap; }
    }
    // below D the note sits directly in a column, so the card measures its wrapped height (task 9 A2):
    // a wrapping Text in a HorizontalLayout is measured single-line and overflows the card
    if AxData.cbm.foot != "" && Breakpoints.below-d: VerticalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-bottom: 14px;
        Text { text: AxData.cbm.foot; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; }
    }
    // A taller neighbour (the Model usage box beside it) stretches this card to the row's height.
    // Nothing else in the card body stretches, and when no child of a Slint layout has a stretch
    // factor they ALL grow evenly, so the spare height used to spread between the head, the column
    // labels and the rows - about 100 px of empty space above the table at 16:9. This stretchy tail
    // collects the spare height at the bottom instead: any spare height goes below the table, never
    // above it, exactly as in the Session stats card.
    Rectangle { vertical-stretch: 1; min-height: 0px; }
}

// ---------------------------------------------------------------- the donut
component DonutArc inherits Rectangle {
    in property <AxDonutSeg> seg;
    in property <float> sweep;
    in property <length> size;
    in property <float> r0;
    in property <float> r1;
    in property <bool> dim;
    in property <bool> pin-dim: false;
    in property <bool> morph;
    property <float> c: root.size / 1px / 2;
    property <bool> mounted: !Motion.on;
    mount := Timer { interval: 16ms; running: !root.mounted; triggered => { self.running = false; root.mounted = true; } }
    property <float> s0: root.seg.a0;
    property <float> s1: root.mounted ? root.seg.a1 : root.seg.a0;
    animate s0, s1 { duration: root.morph && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    property <float> g0: min(root.s0, root.sweep) + 0.01;
    property <float> g1: min(root.s1, root.sweep) - 0.01;
    property <int> large: root.g1 - root.g0 > 3.14159265 ? 1 : 0;
    property <float> x0: root.c + root.r1 * sin(root.g0 * 1rad);
    property <float> y0: root.c - root.r1 * cos(root.g0 * 1rad);
    property <float> x1: root.c + root.r1 * sin(root.g1 * 1rad);
    property <float> y1: root.c - root.r1 * cos(root.g1 * 1rad);
    property <float> x2: root.c + root.r0 * sin(root.g1 * 1rad);
    property <float> y2: root.c - root.r0 * cos(root.g1 * 1rad);
    property <float> x3: root.c + root.r0 * sin(root.g0 * 1rad);
    property <float> y3: root.c - root.r0 * cos(root.g0 * 1rad);
    width: root.size;
    height: root.size;
    opacity: root.pin-dim ? 0.35 : root.dim ? 0.3 : 1;
    animate opacity { duration: Motion.on ? Motion.fast : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: root.size / 1px;
        viewbox-height: root.size / 1px;
        commands: root.g1 - root.g0 > 0.002
            ? "M\{root.x0} \{root.y0}A\{root.r1} \{root.r1} 0 \{root.large} 1 \{root.x1} \{root.y1}L\{root.x2} \{root.y2}A\{root.r0} \{root.r0} 0 \{root.large} 0 \{root.x3} \{root.y3}Z"
            : "";
        fill: AxColor.model(root.seg.provider, root.seg.mix, root.seg.other);
    }
}

// A legend row. kind "seg": one arc, its model's detail on click; "group": "N smaller models" (or, by cost, the
// models with no arc), which opens and closes the list of its models; "child": one model inside an open group,
// indented, with no swatch of its own (it is drawn in its group's arc, or not drawn).
component DonutLegendRow inherits Rectangle {
    in property <AxDonutSeg> seg;
    in property <string> kind: "seg";
    in property <bool> open;
    in property <bool> hot;
    // below D a tap highlights the arc instead of opening the detail (DESIGN-MOBILE 4.2.5, 5.3)
    in property <bool> pinned: false;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    callback toggle();
    callback pick();
    height: Breakpoints.tier-d ? 29px : 44px;
    border-radius: 7px;
    background: root.pinned ? Theme.paper-2 : ta.pressed && Breakpoints.below-d ? Theme.pressed : root.hot || (Device.hover && ta.has-hover) || pop.is-open ? Theme.row-hover : Theme.row-hover.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    ta := AxPress {
        tip: root.kind == "group" && root.open ? "" : root.seg.tip;
        long-tip: root.kind == "group" && root.open ? "" : root.seg.tip;
        mouse-cursor: root.kind == "group" || root.seg.model != "" ? pointer : default;
        tapped => {
            if root.kind == "group" {
                Hover.clear();
                root.toggle();
            } else if Breakpoints.tier-d {
                if root.seg.model != "" {
                    pop.show();
                }
            } else {
                root.pick();
            }
        }
        HorizontalLayout {
            padding-left: root.kind == "child" ? 27px : 8px;
            padding-right: 8px;
            spacing: 9px;
            if root.kind != "child": VerticalLayout { alignment: center; AxSwatch { c: AxColor.model(root.seg.provider, root.seg.mix, root.seg.other); } }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: root.seg.name; font-size: Breakpoints.tier-d ? 12.5px : Type.small; color: root.kind == "child" ? Theme.ink-2 : Theme.ink; overflow: elide; vertical-alignment: center; horizontal-stretch: 0; }
                if root.kind == "group": VerticalLayout {
                    alignment: center;
                    Icon {
                        name: "chev-down";
                        width: 13px;
                        height: 13px;
                        tint: Theme.ink-3;
                        transform-rotation: root.open ? 180deg : 0deg;
                        animate transform-rotation { duration: Motion.med; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.seg.value;
                font-family: Type.tab;
                font-size: Breakpoints.tier-d ? 12.5px : Type.small;
                font-weight: root.seg.value == "Not logged" ? 500 : 600;
                color: root.seg.value == "Not logged" ? Theme.ink-3 : root.kind == "child" ? Theme.ink-2 : Theme.ink;
                horizontal-alignment: right;
                vertical-alignment: center;
                AxPress {
                    tip: root.seg.value-tip;
                    long-tip: root.seg.value-tip;
                    tapped => {
                        if root.kind == "group" {
                            Hover.clear();
                            root.toggle();
                        } else if Breakpoints.tier-d {
                            if root.seg.model != "" {
                                pop.show();
                            }
                        } else {
                            root.pick();
                        }
                    }
                }
            }
            HorizontalLayout { width: 52px; alignment: end; if root.seg.share != "": VerticalLayout { alignment: center; ValueUnit { value: root.seg.share; size: Breakpoints.tier-d ? 12.5px : Type.small; weight: 400; ink: Theme.ink-3; unit-scale: 0.96; height: 18px; } } }
        }
    }
    pop := PopupWindow {
        x: max(-root.absolute-position.x + 10px, (root.width - 440px) / 2);
        y: root.height + 6px;
        width: 440px;
        height: lg-body.preferred-height;
        close-policy: close-on-click-outside;
        lg-body := AxPopBody { width: 440px; height: self.preferred-height; visible: root.seg.model != ""; ModelDetail { m: AxData.models[max(0, root.seg-idx)]; close => { pop.close(); } } }
    }
    in property <int> seg-idx: -1;
}

export component AxDonutCard inherits AxCard {
    in property <bool> played;
    in property <duration> delay;
    // FW3 T4: the donut on top of the box and larger, the model list full-width below it. pad-x follows the
    // card head's padding so the list lines up with the title.
    property <length> pad-x: Breakpoints.tier-d ? (Breakpoints.width < 1180px ? 16px : 20px) : Breakpoints.tier-p ? 16px : 20px;
    // below D the card spans the full content width: a window function, never the card's own width
    property <length> wrap-w: Breakpoints.tier-d ? root.width - 2 * root.pad-x
        : Breakpoints.tier-width - 2 * Breakpoints.gutter - 2 * root.pad-x;
    // P: 180 centred above the list; F/T: 200 beside the list from a 480 inner width (DESIGN-MOBILE 4.2.5)
    property <bool> side: Breakpoints.below-d && !Breakpoints.tier-p && root.wrap-w >= 480px;
    // below D the donut fills the room it has (task 9 A5b): on P nearly the card's content width (a
    // 220-260 px ring at 402), beside the list 200 to 240 growing with the card. D is unchanged.
    property <length> size: Breakpoints.tier-d ? clamp(round(root.wrap-w * 0.68 / 1px) * 1px, 260px, 380px)
        : Breakpoints.tier-p ? min(root.wrap-w - 24px, 322px) : root.side ? clamp(root.wrap-w - 360px, 200px, 240px) : 180px;
    property <float> r1: root.size / 1px / 2 - 42;
    property <float> r0: root.r1 - max(22, round(root.size / 1px * 0.11));
    // first view: the arcs sweep in (ease-in-out, never past their share); then toggles morph
    property <bool> swept: !Motion.on;
    property <float> sweep: root.played ? 6.2831853 : 0;
    animate sweep { duration: Motion.on ? Motion.draw + 200ms : 0ms; delay: Motion.on ? root.delay : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
    swept-timer := Timer { interval: root.delay + Motion.draw + 260ms; running: root.played && !root.swept; triggered => { self.running = false; root.swept = true; } }
    property <int> hot: -1;
    property <int> hot-row: -1;
    property <int> pop-idx: 0;
    // below D a tap pins an arc (a second tap clears it); the centre shows the pinned arc (5.3)
    property <int> pin: -1;
    property <int> show: Breakpoints.tier-d ? root.hot : root.pin >= 0 ? root.pin : root.hot;
    property <string> range: AxData.range;
    property <string> prov: AxData.prov;
    property <string> donut-mode: AxData.donut-mode;
    changed range => { root.pin = -1; }
    changed prov => { root.pin = -1; }
    changed donut-mode => { root.pin = -1; }
    property <bool> labels-on: root.swept && root.calm;
    property <bool> calm: true;
    property <string> mode: AxData.donut.mode;
    changed mode => { root.calm = false; calm-timer.running = true; }
    calm-timer := Timer { interval: Motion.slow + 40ms; running: false; triggered => { self.running = false; root.calm = true; } }
    property <AxDonutSeg> hot-seg: root.hot >= 0 && root.hot < AxData.donut-segs.length ? AxData.donut-segs[root.hot] : { };
    property <AxDonutSeg> show-seg: root.show >= 0 && root.show < AxData.donut-segs.length ? AxData.donut-segs[root.show] : { };
    // the unpinned centre label below D: the full label when the hole fits it, else the short one (task 9 A5)
    property <string> centre-below-d: AxData.donut.mode == "cost"
        ? (root.r0 * 2 >= 165 ? AxData.donut.centre-label : AxData.donut.centre-short)
        : (root.r0 * 2 >= 115 ? AxData.donut.centre-label : AxData.donut.centre-short);

    if Breakpoints.tier-d: AxCardHead {
        title: "Model usage";
        sub: AxData.donut.sub;
        note: AxData.donut.note;
        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            AxSeg {
                small: true;
                items: [{ value: "tokens", label: "Tokens" }, { value: "cost", label: "Cost" }];
                value: AxData.donut-mode;
                picked(v) => { AxData.action("analytics-donut", v); }
            }
        }
    }
    if Breakpoints.below-d && !Breakpoints.tier-p: AxCardHead {
        title: "Model usage";
        sub: AxData.donut.sub;
        note: AxData.donut.note;
        VerticalLayout {
            alignment: start;
            horizontal-stretch: 0;
            AxSeg {
                small: true;
                items: [{ value: "tokens", label: "Tokens" }, { value: "cost", label: "Cost" }];
                value: AxData.donut-mode;
                picked(v) => { AxData.action("analytics-donut", v); }
            }
        }
    }
    if Breakpoints.tier-p: AxCardHead { title: "Model usage"; sub: AxData.donut.sub; note: AxData.donut.note; }
    if Breakpoints.tier-p: HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-bottom: 4px;
        alignment: start;
        AxSeg {
            small: true;
            items: [{ value: "tokens", label: "Tokens" }, { value: "cost", label: "Cost" }];
            value: AxData.donut-mode;
            picked(v) => { AxData.action("analytics-donut", v); }
        }
    }
    body := Rectangle {
        // donut, a 12px gap, then the list; the whole stack centres when the row is taller than the content.
        // side: the donut sits left of the list instead.
        property <length> stack-h: root.side ? max(root.size, legend.preferred-height) : root.size + 12px + legend.preferred-height;
        property <length> content-y: max(4px, (self.height - self.stack-h - 16px) / 2);
        min-height: self.stack-h + 20px;
        vertical-stretch: 1;
        donut := Rectangle {
            x: root.side ? root.pad-x : (parent.width - root.size) / 2;
            y: parent.content-y;
            width: root.size;
            height: root.size;
            // the track
            Path {
                width: root.size;
                height: root.size;
                viewbox-width: root.size / 1px;
                viewbox-height: root.size / 1px;
                commands: "M\{root.size / 1px / 2} \{root.size / 1px / 2 - (root.r0 + root.r1) / 2}A\{(root.r0 + root.r1) / 2} \{(root.r0 + root.r1) / 2} 0 1 1 \{root.size / 1px / 2 - 0.01} \{root.size / 1px / 2 - (root.r0 + root.r1) / 2}Z";
                stroke: Theme.track;
                stroke-width: (root.r1 - root.r0) * 1px;
            }
            for s[i] in AxData.donut-segs: DonutArc {
                seg: s;
                sweep: root.sweep;
                size: root.size;
                r0: root.r0;
                r1: root.r1;
                morph: root.swept;
                dim: root.hot >= 0 && root.hot != i && (Breakpoints.tier-d || root.pin < 0);
                pin-dim: Breakpoints.below-d && root.pin >= 0 && root.pin != i;
            }
            for s in AxData.donut-segs: Text {
                property <float> m: (s.a0 + s.a1) / 2;
                property <float> sn: sin(self.m * 1rad);
                property <length> lx: root.size / 2 + (root.r1 + 12) * self.sn * 1px;
                property <length> ly: root.size / 2 - (root.r1 + 12) * cos(self.m * 1rad) * 1px;
                visible: s.label;
                opacity: root.labels-on ? 1 : 0;
                animate opacity { duration: Motion.on ? Motion.med : 0ms; }
                x: abs(self.sn) < 0.3 ? self.lx - self.preferred-width / 2 : self.sn > 0 ? self.lx : self.lx - self.preferred-width;
                y: self.ly + 4px - self.font-metrics.ascent;
                width: self.preferred-width;
                text: s.share + "%";
                font-family: Type.mono;
                font-size: 11px;
                color: Theme.ink-2;
            }
            centre := VerticalLayout {
                // the readout stays inside the hole also when a big donut's ring is thick
                width: Breakpoints.tier-d ? min(root.size - 156px, (root.r0 * 2 - 12) * 1px) : root.r0 * 2 * 1px;
                x: (root.size - self.width) / 2;
                alignment: center;
                spacing: 3px;
                if root.show < 0: Text { text: AxData.donut.centre; font-family: Type.tab; font-size: Breakpoints.tier-d ? 22px : root.r0 * 2 >= 130 ? 18px : 16px; font-weight: 640; color: Theme.ink; horizontal-alignment: center; overflow: elide; }
                if root.show >= 0 && Breakpoints.tier-d: HorizontalLayout { alignment: center; ValueUnit { value: root.show-seg.share; size: 22px; weight: 640; unit-scale: 0.96; } }
                // below D the pinned arc shows its share and its value (the legend row names it)
                if root.show >= 0 && Breakpoints.below-d: HorizontalLayout { alignment: center; ValueUnit { value: root.show-seg.share; size: 20px; weight: 640; unit-scale: 0.96; } }
                if Breakpoints.tier-d: Text {
                    text: root.show < 0 ? AxData.donut.centre-label : root.show-seg.name + " · " + root.show-seg.value + AxData.donut.unit;
                    font-size: 12px;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if Breakpoints.below-d: Text {
                    text: root.show < 0 ? root.centre-below-d : root.show-seg.value + AxData.donut.unit;
                    font-family: Type.tab;
                    font-size: 11px;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            hit := AxScrub {
                mouse-cursor: root.hot >= 0 && root.hot-seg.model != "" ? pointer : default;
                function track-at(mx: length, my: length) -> int {
                    let dx = (mx - root.size / 2) / 1px;
                    let dy = (my - root.size / 2) / 1px;
                    let rr = sqrt(dx * dx + dy * dy);
                    if rr < root.r0 - 2 || rr > root.r1 + 2 || AxData.donut-lut.length == 0 {
                        return -1;
                    }
                    let deg = mod(atan2(dx, -dy) / 1deg + 360, 360);
                    return AxData.donut-lut[clamp(floor(deg), 0, AxData.donut-lut.length - 1)];
                }
                tap => {
                    if Breakpoints.tier-d {
                        return;
                    }
                    let i = self.track-at(self.mouse-x, self.mouse-y);
                    if i < 0 || root.pin == i {
                        root.pin = -1;
                    } else {
                        root.pin = i;
                    }
                }
                scrub(mx, my) => {
                    if Breakpoints.tier-d {
                        return;
                    }
                    let i = self.track-at(mx, my);
                    if i >= 0 {
                        root.pin = i;
                    }
                }
                changed mouse-x => {
                    if Breakpoints.tier-d {
                        if self.has-hover {
                            root.hot = self.track-at(self.mouse-x, self.mouse-y);
                        }
                    } else if self.has-hover && !self.pressed && root.pin < 0 {
                        root.hot = self.track-at(self.mouse-x, self.mouse-y);
                    }
                }
                changed mouse-y => {
                    if Breakpoints.tier-d {
                        if self.has-hover {
                            root.hot = self.track-at(self.mouse-x, self.mouse-y);
                        }
                    } else if self.has-hover && !self.pressed && root.pin < 0 {
                        root.hot = self.track-at(self.mouse-x, self.mouse-y);
                    }
                }
                changed has-hover => { if !self.has-hover { root.hot = -1; } }
                clicked => {
                    if Breakpoints.tier-d && root.hot >= 0 && root.hot-seg.model != "" {
                        root.pop-idx = root.hot-seg.idx;
                        seg-pop.show();
                    }
                }
            }
            seg-pop := PopupWindow {
                x: (root.size - 440px) / 2;
                y: root.size / 2 + 12px;
                width: 440px;
                height: seg-body.preferred-height;
                close-policy: close-on-click-outside;
                seg-body := AxPopBody { width: 440px; height: self.preferred-height; ModelDetail { m: AxData.models[max(0, root.pop-idx)]; close => { seg-pop.close(); } } }
            }
        }
        legend := VerticalLayout {
            x: root.side ? root.pad-x + root.size + 16px : root.pad-x;
            y: root.side ? parent.content-y : parent.content-y + root.size + 12px;
            width: root.side ? parent.width - 2 * root.pad-x - root.size - 16px : parent.width - 2 * root.pad-x;
            spacing: 2px;
            if AxData.donut-segs.length == 0: Text { text: AxData.ready ? AxData.donut.empty-text : ""; font-size: 13px; color: Theme.ink-3; wrap: word-wrap; }
            // one row per arc; a group opens into its models, so no model is only inside a group
            for l[j] in AxData.donut-legend: DonutLegendRow {
                seg: l.seg;
                kind: l.kind;
                open: l.open;
                seg-idx: l.seg.idx;
                hot: l.kind != "child" && l.arc >= 0 && root.hot == l.arc;
                pinned: Breakpoints.below-d && l.arc >= 0 && root.pin == l.arc;
                // the hovered row lights its arc; rows of one group share an arc, so only the row that set it clears it
                changed hovered => {
                    if self.hovered && (Breakpoints.tier-d || root.pin < 0) { root.hot-row = j; root.hot = l.arc; }
                    else if root.hot-row == j { root.hot-row = -1; root.hot = -1; }
                }
                toggle => { AxData.action("analytics-donut-open", l.seg.key); }
                pick => {
                    if l.arc >= 0 {
                        if root.pin == l.arc {
                            root.pin = -1;
                        } else {
                            root.pin = l.arc;
                        }
                    }
                }
            }
        }
    }
}
