// Analytics header (title, scope line and its disclosure, range presets, the custom range picker, the provider
// filter, refresh) and the KPI row.
import { Theme, Motion, Type, Breakpoints, Device } from "../../theme.slint";
import { RunView } from "../../models.slint";
import { Icon } from "../../components/icon.slint";
import { ProviderMark } from "../../components/mark.slint";
import { Hover } from "../../components/hover-card.slint";
import { IconButton } from "../../components/icon-button.slint";
import { Button } from "../../components/button.slint";
import { Caps } from "../../components/text.slint";
import { HoverShadow } from "../../components/card.slint";
import { ProbeMark } from "../../components/probe.slint";
import { AxData, AxKpi, AxDay, AxSrcCell, AxProvItem, AxPickItem } from "ax-data.slint";
import { AxColor, AxNum, AxTip, AxPress, AxSwatch, AxSeg, AxSegItem, AxInfo } from "ax-common.slint";

// A popover body that rises 4 px and fades in when it opens.
export component AxPopBody inherits Rectangle {
    in property <length> pad-x: 16px;
    in property <length> pad-y: 14px;
    property <bool> shown: !Motion.on;
    t := Timer { interval: 16ms; running: !root.shown; triggered => { self.running = false; root.shown = true; } }
    background: Theme.paper;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.rule;
    drop-shadow-color: Theme.shadow-pop;
    drop-shadow-blur: 40px;
    drop-shadow-offset-y: 16px;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Motion.on ? Motion.fast : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := VerticalLayout {
        height: root.height;
        y: root.shown ? 0px : 4px;
        animate y { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 0px;
        @children
    }
}

// "What this page covers": the scope rules behind one info button, not paragraphs on the page.
component ScopeLines inherits VerticalLayout {
    spacing: 0px;
    Text { text: "What this page covers"; font-size: 14px; font-weight: 640; color: Theme.ink; min-height: 20px; }
    for line in AxData.scope: HorizontalLayout {
        padding-top: 8px;
        spacing: 10px;
        VerticalLayout { alignment: start; padding-top: 2px; Icon { name: line.icon; width: 16px; height: 16px; tint: Theme.ink-3; } }
        // an explicit width, so the wrapped height is measured at the popover's width
        Text { text: line.text; width: 380px - 32px - 26px; font-size: 13px; color: Theme.ink-2; wrap: word-wrap; }
    }
}

// "Included usage": which tools' logs on which computers are in these numbers, and each source's state and
// last scan (activity.sources). It names where the numbers come from; it never divides them.
component SrcCell inherits Text {
    in property <AxSrcCell> c;
    text: root.c.text;
    font-family: Type.tab;
    font-size: 12px;
    color: root.c.tone == "ok" ? Theme.ink-2 : root.c.tone == "cached" ? Theme.warn-text : root.c.tone == "unavailable" ? Theme.crit-text : root.c.tone == "scanning" ? Theme.accent-text : Theme.ink-4;
    vertical-alignment: center;
    overflow: elide;
    horizontal-stretch: 1;
    min-width: 0px;
    AxTip { tip: root.c.tip; }
}
component IncludedLines inherits VerticalLayout {
    in property <length> body-w;
    // On P the grid becomes a list grouped by tool (DESIGN-MOBILE 4.2.1).
    in property <bool> narrow: false;
    spacing: 0px;
    Text { text: "Included usage"; font-size: 14px; font-weight: 640; color: Theme.ink; min-height: 20px; }
    Rectangle { height: 6px; }
    Text { text: AxData.included.line; width: root.body-w; font-size: 13px; color: Theme.ink-2; wrap: word-wrap; }
    Rectangle { height: 12px; }
    if !root.narrow: HorizontalLayout {
        spacing: 10px;
        min-height: 22px;
        Rectangle { width: 96px; }
        for h in AxData.included-hosts: Caps { text: h; horizontal-stretch: 1; min-width: 0px; }
    }
    for r in AxData.included-rows: VerticalLayout {
        visible: !root.narrow;
        Rectangle { height: 1px; background: Theme.rule-2; }
        HorizontalLayout {
            spacing: 10px;
            min-height: 28px;
            Text { text: r.tool; width: 96px; font-size: 12.5px; font-weight: 560; color: Theme.ink; vertical-alignment: center; overflow: elide; }
            for c in r.cells: SrcCell { c: c; }
        }
    }
    for r in AxData.included-rows: VerticalLayout {
        visible: root.narrow;
        Rectangle { height: 1px; background: Theme.rule-2; }
        Text { text: r.tool; font-size: Type.body; font-weight: 600; color: Theme.ink; min-height: 32px; vertical-alignment: bottom; }
        for c[i] in r.cells: HorizontalLayout {
            spacing: 10px;
            min-height: 44px;
            Text { text: AxData.included-hosts.length > i ? AxData.included-hosts[i] : c.id; font-size: Type.small; color: Theme.ink-2; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: c.text; font-family: Type.tab; font-size: Type.small; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; AxPress { tip: c.tip; long-tip: c.tip; } }
        }
    }
    Rectangle { height: 1px; background: Theme.rule-2; }
    Rectangle { height: 10px; }
    Text { text: AxData.included.foot; width: root.body-w; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
}

// The quiet text button that opens it, collapsed by default like the scope disclosure beside it.
// Below D it is a 44 tall text button (DESIGN-MOBILE 4.2.1).
component IncludedButton inherits Rectangle {
    in property <bool> open;
    callback clicked();
    height: Breakpoints.tier-d ? 24px : 44px;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    border-radius: 7px;
    background: ta.has-hover || root.open ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 5px;
        spacing: 4px;
        Text { text: AxData.included.label; font-size: Breakpoints.tier-d ? 13px : Type.control; color: ta.has-hover || root.open ? Theme.ink : Theme.ink-2; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "chev-down";
                width: 13px;
                height: 13px;
                tint: Theme.ink-3;
                transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: Motion.med; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            }
        }
    }
    ta := AxPress { tip: Breakpoints.tier-d ? "" : AxData.included.line; long-tip: AxData.included.line; mouse-cursor: pointer; tapped => { Hover.clear(); root.clicked(); } }
    ProbeMark { x: 0px; y: 0px; width: root.width; height: root.height; id: "included-usage"; }
}

// One day of the custom range picker.
component DayCell inherits Rectangle {
    in property <AxDay> day;
    in property <bool> inside;
    in property <bool> lo;
    in property <bool> hi;
    callback picked(int);
    callback hovered(int);
    height: Breakpoints.tier-d ? 38px : 44px;
    property <bool> end: root.lo || root.hi;
    background: root.end ? Theme.accent : root.inside ? Theme.accent-soft : ta.has-hover && !root.day.off ? Theme.paper-3 : Theme.paper.with-alpha(0);
    border-top-left-radius: root.lo || (!root.inside && !root.end) ? 8px : 0px;
    border-bottom-left-radius: self.border-top-left-radius;
    border-top-right-radius: root.hi || (!root.inside && !root.end) ? 8px : 0px;
    border-bottom-right-radius: self.border-top-right-radius;
    animate background { duration: Motion.tint(Motion.fast); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        if root.day.month != "": Text {
            text: root.day.month;
            font-size: 11px;
            font-weight: 500;
            color: root.end ? Theme.accent-ink.with-alpha(0.8) : root.day.off ? Theme.ink-4 : Theme.ink-3;
            horizontal-alignment: center;
        }
        Text {
            text: root.day.label;
            font-family: Type.tab;
            font-size: 13px;
            font-weight: root.end || (root.day.today && !root.end) ? 640 : 400;
            color: root.end ? Theme.accent-ink : root.day.off ? Theme.ink-4 : root.day.today ? Theme.accent-text : Theme.ink;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: !root.day.off;
        mouse-cursor: root.day.off ? default : pointer;
        clicked => { root.picked(root.day.n); }
        changed has-hover => { if self.has-hover { root.hovered(root.day.n); } }
    }
}

// Custom range: whole local days within the logs that can be read.
component DatesBody inherits VerticalLayout {
    in-out property <int> lo;
    in-out property <int> hi: -1;
    in-out property <int> hover: -1;
    callback apply(int, int);
    callback cancel();
    property <int> a: root.hi < 0 && root.hover >= 0 ? min(root.lo, root.hover) : root.lo;
    property <int> b: root.hi >= 0 ? root.hi : root.hover >= 0 ? max(root.lo, root.hover) : root.lo;
    property <string> lo-long: root.lo >= 0 && root.lo < AxData.days.length ? AxData.days[root.lo].long : "";
    property <string> hi-long: root.hi >= 0 && root.hi < AxData.days.length ? AxData.days[root.hi].long : "";
    spacing: 0px;
    Text { text: "Custom range"; font-size: 14px; font-weight: 640; color: Theme.ink; min-height: 20px; }
    Rectangle { height: 6px; }
    Text { text: AxData.calendar.note; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 8px;
        spacing: 6px;
        alignment: start;
        for q[i] in ["Today", "Last 2 days", "Last 3 days"]: Button {
            text: q;
            small: true;
            clicked => {
                root.hi = AxData.calendar.last-n;
                root.lo = max(AxData.calendar.first-n, AxData.calendar.last-n - i);
                root.hover = -1;
            }
        }
    }
    grid := Rectangle {
        property <length> cw: self.width / 7;
        property <int> weeks: ceil(AxData.days.length / 7);
        property <length> pitch: Breakpoints.tier-d ? 40px : 46px;
        height: 22px + self.weeks * self.pitch;
        for w[i] in ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]: Caps {
            x: i * grid.cw;
            y: 0px;
            width: grid.cw;
            height: 22px;
            text: w;
            horizontal-alignment: center;
        }
        for d[i] in AxData.days: DayCell {
            x: mod(i, 7) * grid.cw;
            y: 22px + floor(i / 7) * grid.pitch;
            width: grid.cw;
            day: d;
            inside: !d.off && root.lo >= 0 && i >= root.a && i <= root.b;
            lo: !d.off && root.lo >= 0 && i == root.a;
            hi: !d.off && root.lo >= 0 && i == root.b;
            hovered(n) => { if root.hi < 0 { root.hover = n; } }
            picked(n) => {
                if root.hi >= 0 || root.lo < 0 { root.lo = n; root.hi = -1; }
                else if n < root.lo { root.hi = root.lo; root.lo = n; }
                else { root.hi = n; }
                root.hover = -1;
            }
        }
    }
    Rectangle { height: 12px; }
    Rectangle { height: 1px; background: Theme.rule-2; }
    if Breakpoints.tier-d: HorizontalLayout {
        padding-top: 10px;
        spacing: 6px;
        Text {
            text: root.lo < 0 ? "Pick a first day"
                : root.hi < 0 ? root.lo-long + " · pick a last day, or apply one day"
                : root.lo-long + " to " + root.hi-long + " · \{root.hi - root.lo + 1} day" + (root.hi == root.lo ? "" : "s");
            font-family: Type.tab;
            font-size: 12px;
            color: Theme.ink-2;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button { text: "Cancel"; small: true; kind: "ghost"; clicked => { root.cancel(); } }
        Button { text: "Apply"; small: true; kind: "primary"; enabled: root.lo >= 0; clicked => { root.apply(root.lo, root.hi >= 0 ? root.hi : root.lo); } }
    }
    // below D the range sentence sits above two equal buttons (DESIGN-MOBILE 3.5: pinned halves, 48 tall)
    if Breakpoints.below-d: VerticalLayout {
        padding-top: 10px;
        spacing: 10px;
        Text {
            text: root.lo < 0 ? "Pick a first day"
                : root.hi < 0 ? root.lo-long + " · pick a last day, or apply one day"
                : root.lo-long + " to " + root.hi-long + " · \{root.hi - root.lo + 1} day" + (root.hi == root.lo ? "" : "s");
            font-family: Type.tab;
            font-size: Type.small;
            color: Theme.ink-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Cancel"; kind: "ghost"; tall: true; horizontal-stretch: 1; clicked => { root.cancel(); } }
            Button { text: "Apply"; kind: "primary"; tall: true; horizontal-stretch: 1; enabled: root.lo >= 0; clicked => { root.apply(root.lo, root.hi >= 0 ? root.hi : root.lo); } }
        }
    }
}

component DateButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> open;
    callback clicked();
    height: Breakpoints.tier-d ? 36px : 44px;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.open || ta.has-hover ? Theme.rule-strong : root.on ? Theme.ink-3 : Theme.rule;
    background: ta.pressed && Breakpoints.below-d ? Theme.pressed : ta.has-hover || root.open ? Theme.paper-2 : Theme.paper;
    animate background, border-color { duration: Motion.tint(Motion.fast); }
    transform-scale: ta.pressed ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    row := HorizontalLayout {
        padding-left: 11px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout { alignment: center; Icon { name: "calendar"; width: Breakpoints.tier-d ? 15px : 16px; height: Breakpoints.tier-d ? 15px : 16px; tint: root.on ? Theme.accent-text : Theme.ink-3; } }
        Text { text: root.label; font-family: Type.tab; font-size: Breakpoints.tier-d ? 13px : Type.control; font-weight: 560; color: root.on || ta.has-hover ? Theme.ink : Theme.ink-2; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "chev-down";
                width: 13px;
                height: 13px;
                tint: Theme.ink-3;
                transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: Motion.med; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            }
        }
    }
    ta := AxPress { tip: root.open ? "" : "Pick days within the logs that were read"; long-tip: "Pick days within the logs that were read"; mouse-cursor: pointer; tapped => { Hover.clear(); root.clicked(); } }
}

// The provider picker: a quiet button with the picked provider (its mark) that opens the list of providers with
// usage in the range, each with its tokens. Picking one shows that provider's usage, divided by model.
component PickerRow inherits Rectangle {
    in property <AxPickItem> item;
    in property <bool> selected;
    callback picked(string);
    height: Breakpoints.tier-d ? 32px : 52px;
    border-radius: 7px;
    background: ta.pressed && Breakpoints.below-d ? Theme.pressed : ta.has-hover || root.selected ? Theme.row-hover : Theme.row-hover.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(root.item.value); }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 9px;
            HorizontalLayout { width: Breakpoints.tier-d ? 16px : 20px; if root.item.mark != "": VerticalLayout { alignment: center; ProviderMark { provider: root.item.mark; size: Breakpoints.tier-d ? 16px : 20px; } } }
            Text {
                text: root.item.label;
                font-size: Breakpoints.tier-d ? 13px : Type.body;
                font-weight: root.selected ? 620 : 500;
                color: root.item.off ? Theme.ink-3 : Theme.ink;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text { text: root.item.tokens; font-family: Type.tab; font-size: Breakpoints.tier-d ? 12.5px : Type.small; color: Theme.ink-3; horizontal-alignment: right; vertical-alignment: center; }
            HorizontalLayout { width: Breakpoints.tier-d ? 14px : 20px; if root.selected: VerticalLayout { alignment: center; Icon { name: "check"; width: Breakpoints.tier-d ? 14px : 20px; height: Breakpoints.tier-d ? 14px : 20px; tint: Theme.accent-text; } } }
        }
    }
}
component PickerBody inherits VerticalLayout {
    callback picked(string);
    spacing: 0px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 6px;
        Caps { text: "PROVIDER"; horizontal-stretch: 1; }
        Caps { text: "TOKENS"; horizontal-alignment: right; }
        Rectangle { width: 31px; }
    }
    for it in AxData.picker-items: PickerRow { item: it; selected: it.value == AxData.prov; picked(v) => { root.picked(v); } }
}
component PickerButton inherits Rectangle {
    in property <bool> open;
    callback clicked();
    height: Breakpoints.tier-d ? 36px : 44px;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.open || ta.has-hover ? Theme.rule-strong : Theme.rule;
    background: ta.pressed && Breakpoints.below-d ? Theme.pressed : ta.has-hover || root.open ? Theme.paper-2 : Theme.paper;
    animate background, border-color { duration: Motion.tint(Motion.fast); }
    transform-scale: ta.pressed ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    row := HorizontalLayout {
        padding-left: 11px;
        padding-right: 10px;
        spacing: 8px;
        if AxData.picker-mark != "": VerticalLayout { alignment: center; ProviderMark { provider: AxData.picker-mark; size: 16px; } }
        Text { text: AxData.picker-label; font-size: Breakpoints.tier-d ? 13px : Type.control; font-weight: 560; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        VerticalLayout {
            alignment: center;
            Icon {
                name: "chev-down";
                width: 13px;
                height: 13px;
                tint: Theme.ink-3;
                transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: Motion.med; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            }
        }
    }
    ta := AxPress { tip: root.open ? "" : "Show one provider's usage, by model"; long-tip: "Show one provider's usage, by model"; mouse-cursor: pointer; tapped => { Hover.clear(); root.clicked(); } }
    ProbeMark { x: 0px; y: 0px; width: root.width; height: root.height; id: "analytics-provider"; }
}

export component AxHeader inherits Rectangle {
    property <bool> wide: Breakpoints.width >= 1360px;
    property <[AxSegItem]> ranges: [{ value: "24h", label: "24H" }, { value: "7d", label: "7D" }, { value: "30d", label: "30D" }, { value: "month", label: "Month" }, { value: "all", label: "All" }];
    // the 3 + 2 wrap of the range control when a segment would be under 64 px (DESIGN-MOBILE 1.5)
    property <[AxSegItem]> ranges-a: [root.ranges[0], root.ranges[1], root.ranges[2]];
    property <[AxSegItem]> ranges-b: [root.ranges[3], root.ranges[4]];
    min-height: body.min-height;
    preferred-height: body.preferred-height;

    // exactly one branch exists; the body always does, so the root can measure it
    body := VerticalLayout {
        spacing: 0px;
        if Breakpoints.tier-d: lay := VerticalLayout {
            spacing: 16px;
        HorizontalLayout {
            spacing: 28px;
            title := VerticalLayout {
                alignment: end;
                spacing: 7px;
                horizontal-stretch: 0;
                Text { text: "Analytics"; font-size: 30px; font-weight: 620; color: Theme.ink; letter-spacing: -0.6px; }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: AxData.head.scope; font-size: 13px; color: Theme.ink-3; vertical-alignment: center; }
                    Text {
                        text: AxData.head.read;
                        font-family: Type.tab;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.ink-2;
                        vertical-alignment: center;
                        AxTip { tip: AxData.head.read-tip; }
                    }
                    // One calm pill for every background update: a scan runs now, or source cells are still converging.
                    if AxData.head.updating: upd := Rectangle {
                        height: 22px;
                        min-width: upd-row.preferred-width;
                        preferred-width: upd-row.preferred-width;
                        border-radius: 11px;
                        background: Theme.paper-3;
                        upd-row := HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            Text { text: AxData.head.update-note == "" ? "Updating…" : AxData.head.update-note; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; }
                        }
                    }
                    info := AxInfo {
                        open: scope-pop.is-open;
                        clicked => { scope-pop.show(); }
                        scope-pop := PopupWindow {
                            x: 0px;
                            y: info.height + 8px;
                            width: 380px;
                            height: scope-body.preferred-height;
                            close-policy: close-on-click-outside;
                            scope-body := AxPopBody { width: 380px; height: self.preferred-height; ScopeLines { } }
                        }
                    }
                    if AxData.included.shown: VerticalLayout {
                        alignment: center;
                        inc := IncludedButton {
                            open: inc-pop.is-open;
                            clicked => { inc-pop.show(); }
                            inc-pop := PopupWindow {
                                x: 0px;
                                y: inc.height + 8px;
                                width: 500px;
                                height: inc-body.preferred-height;
                                close-policy: close-on-click-outside;
                                inc-body := AxPopBody { width: 500px; height: self.preferred-height; IncludedLines { body-w: 500px - 32px; } }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.wide: Rectangle { horizontal-stretch: 1; }
            if root.wide: tools-wide := HorizontalLayout {
                alignment: end;
                spacing: 14px;
                horizontal-stretch: 0;
                VerticalLayout { alignment: end; HorizontalLayout { spacing: 8px; range-seg-w := AxSeg { mono: true; items: root.ranges; value: AxData.range; picked(v) => { AxData.action("analytics-range", v); } } date-w := DateButton { label: AxData.head.date; on: AxData.head.custom; open: dates-w.is-open; clicked => { dates-w.show(); } dates-w := PopupWindow { x: 0px; y: date-w.height + 8px; width: 336px; height: dw-body.preferred-height; close-policy: close-on-click-outside; dw-body := AxPopBody { width: 336px; height: self.preferred-height; DatesBody { lo: AxData.calendar.lo; hi: AxData.calendar.hi; apply(a, b) => { dates-w.close(); AxData.action("analytics-custom", AxData.days[a].day + "," + AxData.days[b].day); } cancel => { dates-w.close(); } } } } } } }
                VerticalLayout {
                    alignment: end;
                    pick-w := PickerButton {
                        open: picks-w.is-open;
                        clicked => { picks-w.show(); }
                        picks-w := PopupWindow {
                            x: pick-w.width - 320px;
                            y: pick-w.height + 8px;
                            width: 320px;
                            height: pw-body.preferred-height;
                            close-policy: close-on-click-outside;
                            pw-body := AxPopBody { width: 320px; height: self.preferred-height; pad-x: 8px; pad-y: 10px; PickerBody { picked(v) => { picks-w.close(); AxData.action("analytics-provider", v); } } }
                        }
                    }
                }
                VerticalLayout { alignment: end; IconButton { icon: "refresh"; hint: "Refresh now"; spinning: AxData.head.loading; clicked => { AxData.action("analytics-refresh", ""); } } }
            }
        }
        if !root.wide: HorizontalLayout {
            spacing: 14px;
            HorizontalLayout { spacing: 8px; horizontal-stretch: 0; AxSeg { mono: true; items: root.ranges; value: AxData.range; picked(v) => { AxData.action("analytics-range", v); } } date-n := DateButton { label: AxData.head.date; on: AxData.head.custom; open: dates-n.is-open; clicked => { dates-n.show(); } dates-n := PopupWindow { x: 0px; y: date-n.height + 8px; width: 336px; height: dn-body.preferred-height; close-policy: close-on-click-outside; dn-body := AxPopBody { width: 336px; height: self.preferred-height; DatesBody { lo: AxData.calendar.lo; hi: AxData.calendar.hi; apply(a, b) => { dates-n.close(); AxData.action("analytics-custom", AxData.days[a].day + "," + AxData.days[b].day); } cancel => { dates-n.close(); } } } } } }
            pick-n := PickerButton {
                horizontal-stretch: 0;
                open: picks-n.is-open;
                clicked => { picks-n.show(); }
                picks-n := PopupWindow {
                    x: 0px;
                    y: pick-n.height + 8px;
                    width: 320px;
                    height: pn-body.preferred-height;
                    close-policy: close-on-click-outside;
                    pn-body := AxPopBody { width: 320px; height: self.preferred-height; pad-x: 8px; pad-y: 10px; PickerBody { picked(v) => { picks-n.close(); AxData.action("analytics-provider", v); } } }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton { icon: "refresh"; hint: "Refresh now"; spinning: AxData.head.loading; clicked => { AxData.action("analytics-refresh", ""); } }
        }
        if AxData.head.error != "": Text { text: AxData.head.error; font-size: 12.5px; color: Theme.crit-text; wrap: word-wrap; }
    }

    // Below D: title, a wrapping scope line with the read-time info toggle, the Included usage
    // button and the tools in one or two rows (DESIGN-MOBILE 4.2.1).
    if Breakpoints.below-d: mlay := VerticalLayout {
        spacing: 6px;
        property <length> cw: Breakpoints.tier-width - 2 * Breakpoints.gutter;
        property <bool> two-row: Breakpoints.tier-p || (Breakpoints.tier-f && Breakpoints.tier-width < 760px);
        property <bool> seg-wrap: self.cw / 5 < 64px;
        property <bool> read-tip: false;
        property <length> inc-w: min(500px, self.cw);
        property <length> date-w: min(336px, self.cw);
        property <length> pick-w: min(320px, self.cw);
        Text { text: "Analytics"; font-size: Type.page-title; font-weight: 620; color: Theme.ink; }
        subrow := HorizontalLayout {
            spacing: 6px;
            // Capped at the subline's natural single-line width (same size, measured in the
            // spacer below), so the info icon sits right after the read time and only wraps with
            // the text when the line truly runs out (DESIGN-MOBILE 4.2.1).
            sub := StyledText {
                width: min(m-sub.preferred-width + 6px, max(48px, mlay.cw - 50px - (AxData.head.updating ? m-upd.preferred-width + 6px : 0px)));
                text: @markdown("<font color='\{Theme.ink-3}'>\{AxData.head.scope}</font><font color='\{Theme.ink-2}'>**\{AxData.head.read}**</font>");
                default-color: Theme.ink-3;
                default-font-size: Type.small;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                AxInfo { open: mlay.read-tip; tip: AxData.head.read-tip; clicked => { mlay.read-tip = !mlay.read-tip; } }
            }
            if AxData.head.updating: Text { text: AxData.head.update-note == "" ? "Updating…" : AxData.head.update-note; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; }
            // The slack goes here, never between the text and the icon. The zero-size measurers
            // hide in the spacer so the rows above and below keep their 6 px rhythm.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                m-sub := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: AxData.head.scope + AxData.head.read; font-size: Type.small; }
                m-upd := Text { x: 0px; y: 0px; width: 0px; height: 0px; opacity: 0; text: AxData.head.update-note == "" ? "Updating…" : AxData.head.update-note; font-size: Type.small; }
            }
        }
        if mlay.read-tip: VerticalLayout {
            padding-top: 2px;
            padding-bottom: 8px;
            Text { text: AxData.head.read-tip; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; }
        }
        if AxData.included.shown: VerticalLayout {
            inc-m := IncludedButton {
                open: inc-m-pop.is-open;
                clicked => { inc-m-pop.show(); }
                inc-m-pop := PopupWindow {
                    x: 0px;
                    y: inc-m.height + 8px;
                    width: mlay.inc-w;
                    height: inc-m-body.preferred-height;
                    close-policy: close-on-click-outside;
                    inc-m-body := AxPopBody {
                        width: mlay.inc-w;
                        height: self.preferred-height;
                        inc-scroll := Flickable {
                            height: min(inc-lines.preferred-height, Breakpoints.height - 160px);
                            content-height: inc-lines.preferred-height;
                            inc-lines := IncludedLines { width: mlay.inc-w - 32px; body-w: mlay.inc-w - 32px; narrow: Breakpoints.tier-p; }
                        }
                    }
                }
            }
        }
        Rectangle { height: 6px; }
        if mlay.two-row: VerticalLayout {
            spacing: 8px;
            if !mlay.seg-wrap: AxSeg { mono: true; fill: true; items: root.ranges; value: AxData.range; picked(v) => { AxData.action("analytics-range", v); } }
            if mlay.seg-wrap: VerticalLayout {
                spacing: 8px;
                AxSeg { mono: true; fill: true; items: root.ranges-a; value: AxData.range; picked(v) => { AxData.action("analytics-range", v); } }
                AxSeg { mono: true; fill: true; items: root.ranges-b; value: AxData.range; picked(v) => { AxData.action("analytics-range", v); } }
            }
            tools2 := HorizontalLayout {
                spacing: 8px;
                date-m := DateButton {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    label: AxData.head.date;
                    on: AxData.head.custom;
                    open: dates-m.is-open;
                    clicked => { dates-m.show(); }
                    dates-m := PopupWindow {
                        x: 0px;
                        y: date-m.height + 8px;
                        width: mlay.date-w;
                        height: dates-m-body.preferred-height;
                        close-policy: close-on-click-outside;
                        dates-m-body := AxPopBody { width: mlay.date-w; height: self.preferred-height; DatesBody { lo: AxData.calendar.lo; hi: AxData.calendar.hi; apply(a, b) => { dates-m.close(); AxData.action("analytics-custom", AxData.days[a].day + "," + AxData.days[b].day); } cancel => { dates-m.close(); } } }
                    }
                }
                pick-m := PickerButton {
                    min-width: 0px;
                    max-width: (mlay.cw - 56px) * 0.45;
                    open: picks-m.is-open;
                    clicked => { picks-m.show(); }
                    picks-m := PopupWindow {
                        x: min(0px, tools2.absolute-position.x + tools2.width - pick-m.absolute-position.x - mlay.pick-w);
                        y: pick-m.height + 8px;
                        width: mlay.pick-w;
                        height: picks-m-body.preferred-height;
                        close-policy: close-on-click-outside;
                        picks-m-body := AxPopBody {
                            width: mlay.pick-w;
                            height: self.preferred-height;
                            pad-x: 8px;
                            pad-y: 10px;
                            pick-scroll := Flickable {
                                height: min(pick-list.preferred-height, Breakpoints.height - 160px);
                                content-height: pick-list.preferred-height;
                                pick-list := PickerBody { width: mlay.pick-w - 16px; picked(v) => { picks-m.close(); AxData.action("analytics-provider", v); } }
                            }
                        }
                    }
                }
                IconButton { icon: "refresh"; hint: "Refresh now"; spinning: AxData.head.loading; clicked => { AxData.action("analytics-refresh", ""); } }
            }
        }
        if !mlay.two-row: tools1 := HorizontalLayout {
            spacing: 8px;
            AxSeg { mono: true; items: root.ranges; value: AxData.range; picked(v) => { AxData.action("analytics-range", v); } }
            date-t := DateButton {
                min-width: 0px;
                label: AxData.head.date;
                on: AxData.head.custom;
                open: dates-t.is-open;
                clicked => { dates-t.show(); }
                dates-t := PopupWindow {
                    x: 0px;
                    y: date-t.height + 8px;
                    width: mlay.date-w;
                    height: dates-t-body.preferred-height;
                    close-policy: close-on-click-outside;
                    dates-t-body := AxPopBody { width: mlay.date-w; height: self.preferred-height; DatesBody { lo: AxData.calendar.lo; hi: AxData.calendar.hi; apply(a, b) => { dates-t.close(); AxData.action("analytics-custom", AxData.days[a].day + "," + AxData.days[b].day); } cancel => { dates-t.close(); } } }
                }
            }
            pick-t := PickerButton {
                min-width: 0px;
                open: picks-t.is-open;
                clicked => { picks-t.show(); }
                picks-t := PopupWindow {
                    x: min(0px, tools1.absolute-position.x + tools1.width - pick-t.absolute-position.x - mlay.pick-w);
                    y: pick-t.height + 8px;
                    width: mlay.pick-w;
                    height: picks-t-body.preferred-height;
                    close-policy: close-on-click-outside;
                    picks-t-body := AxPopBody {
                        width: mlay.pick-w;
                        height: self.preferred-height;
                        pad-x: 8px;
                        pad-y: 10px;
                        pick-scroll-t := Flickable {
                            height: min(pick-list-t.preferred-height, Breakpoints.height - 160px);
                            content-height: pick-list-t.preferred-height;
                            pick-list-t := PickerBody { width: mlay.pick-w - 16px; picked(v) => { picks-t.close(); AxData.action("analytics-provider", v); } }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton { icon: "refresh"; hint: "Refresh now"; spinning: AxData.head.loading; clicked => { AxData.action("analytics-refresh", ""); } }
        }
        if AxData.head.error != "": Text { text: AxData.head.error; font-size: Type.small; color: Theme.crit-text; wrap: word-wrap; }
        }
    }
}

// ---------------------------------------------------------------- KPI row
component KpiCard inherits Rectangle {
    in property <AxKpi> kpi;
    in property <bool> played;
    in property <duration> delay;
    in property <bool> loading;
    // hover lift only with a real hover pointer (DESIGN-MOBILE 5.1); touch shows no lift
    property <bool> hovered: Device.hover && ta.has-hover;
    // a value wider than the card drops to 18 px (DESIGN-MOBILE 4.2.2)
    property <length> inner-w: root.width - (Breakpoints.tier-d ? 36px : 28px);
    property <length> val-size: Breakpoints.tier-d ? (Breakpoints.width < 1600px ? 27px : 30px)
        : Breakpoints.tier-p ? 22px : Breakpoints.tier-f ? 24px : 26px;
    // Measurer (never drawn, never hit-tested): `visible: false` only clips in Slint 1.18, so the
    // item stays in the flow at its natural size. On D it is zero-sized (the card widths match main);
    // below D it keeps its natural size (the approved P/F/T layouts). preferred-width always reports
    // the natural width for `tight` below D.
    measure := Text { x: 0px; y: 0px; visible: false; width: Breakpoints.tier-d ? 0px : self.preferred-width; height: Breakpoints.tier-d ? 0px : self.preferred-height; text: root.kpi.text; font-family: Type.tab; font-size: root.val-size; font-weight: 620; }
    property <bool> tight: measure.preferred-width > root.inner-w;
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    min-width: 0px;
    HoverShadow {
        x: 0px;
        y: surface.y;
        width: root.width;
        height: root.height;
        radius: Theme.r-plate;
        on: root.hovered;
        blur: 24px;
        offset: 8px;
    }
    surface := Rectangle {
        x: 0px;
        y: root.hovered ? -2px : 0px;
        width: root.width;
        height: root.height;
        animate y { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        background: Theme.paper;
        border-radius: Theme.r-plate;
        border-width: 1px;
        border-color: root.hovered ? Theme.rule-strong : Theme.rule;
        animate border-color { duration: Motion.tint(Motion.med); }
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        ta := TouchArea {
            cache-rendering-hint: true;
            mouse-cursor: default;
            col := VerticalLayout {
                padding-left: Breakpoints.tier-d ? 18px : 14px;
                padding-right: Breakpoints.tier-d ? 18px : 14px;
                padding-top: 15px;
                padding-bottom: 16px;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 8px;
                    min-height: 19px;
                    if root.kpi.swatch == "cost": VerticalLayout { alignment: center; AxSwatch { shape: "line"; c: AxColor.of("cost"); } }
                    if root.kpi.swatch == "cache": VerticalLayout { alignment: center; AxSwatch { shape: "half"; c: AxColor.of("cw"); c2: AxColor.of("cr"); } }
                    if root.kpi.swatch == "in" || root.kpi.swatch == "out": VerticalLayout { alignment: center; AxSwatch { c: AxColor.of(root.kpi.swatch); } }
                    Text { text: root.kpi.label; font-size: Breakpoints.tier-d ? 13px : Type.small; font-weight: Breakpoints.tier-d ? 560 : 600; color: Theme.ink-2; vertical-alignment: center; overflow: elide; }
                    if Breakpoints.tier-d && root.kpi.apport: VerticalLayout { alignment: center; AxInfo { side: 18px; glyph: 14px; tip: AxData.apport-tip; } }
                    if Breakpoints.below-d && root.kpi.apport: Rectangle { width: 36px; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 8px; }
                if root.loading: Rectangle { height: 33px; Rectangle { y: 4px; width: 120px; height: 26px; border-radius: 6px; background: Theme.paper-3; } }
                if !root.loading: value := HorizontalLayout {
                    AxNum {
                        num: root.kpi.num;
                        has: root.kpi.has;
                        fmt: root.kpi.fmt;
                        text: root.kpi.text;
                        played: root.played;
                        delay: root.delay;
                        size: root.tight && Breakpoints.below-d ? 18px : root.val-size;
                        weight: 620;
                        na-size: 20px;
                        height: 33px;
                        AxTip { tip: root.kpi.tip; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 6px; }
                // D renders the sub-line exactly like main (natural height). Below D it wraps to at most
                // two lines (DESIGN-MOBILE 4.2.2). Split elements (not a height ternary): a height-queried
                // wrapper shifts the card content on D, so the D branch stays verbatim main again.
                if Breakpoints.tier-d: StyledText {
                    text: root.kpi.sub.length == 0 ? @markdown("")
                        : root.kpi.sub.length == 1 ? @markdown("\{root.kpi.sub[0].text}")
                        : root.kpi.sub.length == 2 && root.kpi.sub[0].strong ? @markdown("<font color='\{Theme.ink-2}'>**\{root.kpi.sub[0].text}**</font>\{root.kpi.sub[1].text}")
                        : root.kpi.sub[0].strong ? @markdown("<font color='\{Theme.ink-2}'>**\{root.kpi.sub[0].text}**</font>\{root.kpi.sub[1].text}\{root.kpi.sub[2].text}")
                        : @markdown("\{root.kpi.sub[0].text}\{root.kpi.sub[1].text}\{root.kpi.sub[2].text}");
                    default-color: Theme.ink-3;
                    default-font-size: 12.5px;
                    default-font-family: Type.tab;
                }
                if Breakpoints.below-d: Rectangle {
                    height: min(sub-m.preferred-height, 36px);
                    clip: true;
                    sub-m := StyledText {
                        width: parent.width;
                        height: self.preferred-height;
                        text: root.kpi.sub.length == 0 ? @markdown("")
                            : root.kpi.sub.length == 1 ? @markdown("\{root.kpi.sub[0].text}")
                            : root.kpi.sub.length == 2 && root.kpi.sub[0].strong ? @markdown("<font color='\{Theme.ink-2}'>**\{root.kpi.sub[0].text}**</font>\{root.kpi.sub[1].text}")
                            : root.kpi.sub[0].strong ? @markdown("<font color='\{Theme.ink-2}'>**\{root.kpi.sub[0].text}**</font>\{root.kpi.sub[1].text}\{root.kpi.sub[2].text}")
                            : @markdown("\{root.kpi.sub[0].text}\{root.kpi.sub[1].text}\{root.kpi.sub[2].text}");
                        default-color: Theme.ink-3;
                        default-font-size: Type.small;
                        default-font-family: Type.tab;
                    }
                }
            }
        }
    }
    // below D the apportioning note sits over the label row's corner, out of the flow,
    // so the 44 px info target never staggers the values across the row
    if Breakpoints.below-d && root.kpi.apport: AxInfo { x: root.width - 44px; y: 3px; tip: AxData.apport-tip; }
}

// "Tokens by provider": how many tokens each provider served in the range, under the KPI cards. The view model
// packs the items into lines that fit the page; each item's tip has its share, token types, estimated cost and the
// logs it came from. It is a summary, never a filter, a legend or a section (the charts stay divided by model).
component ProvItem inherits Rectangle {
    in property <AxProvItem> t;
    // natural width only: the line's spare room goes to its end, never between items or within one
    horizontal-stretch: 0;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    max-width: row.preferred-width;
    min-height: 22px;
    AxTip {
        tip: root.t.tip;
        row := HorizontalLayout {
            spacing: 5px;
            if root.t.mark != "": VerticalLayout { alignment: center; ProviderMark { provider: root.t.mark; size: 16px; } }
            Text { text: root.t.label; font-size: Breakpoints.tier-d ? 13px : Type.small; color: Theme.ink-2; vertical-alignment: center; }
            Text {
                text: root.t.value;
                font-family: Type.tab;
                font-size: Breakpoints.tier-d ? 13px : Type.small;
                font-weight: root.t.quiet ? 500 : 620;
                color: root.t.quiet ? Theme.ink-3 : Theme.ink;
                vertical-alignment: center;
            }
        }
    }
}
export component AxProvLines inherits VerticalLayout {
    spacing: 2px;
    // below D the caption sits above the lines, which use the full width (DESIGN-MOBILE 4.2.2)
    if Breakpoints.below-d: HorizontalLayout {
        spacing: 8px;
        padding-left: 2px;
        Caps { text: AxData.prov-summary.label; min-height: 22px; }
    }
    for line in AxData.prov-lines: HorizontalLayout {
        spacing: 10px;
        padding-left: 2px;
        // the caption opens the first line; the lines after it start under the first item
        if Breakpoints.tier-d && line.first: Caps { text: AxData.prov-summary.label; width: 150px; min-height: 22px; }
        if Breakpoints.tier-d && !line.first: Rectangle { width: 150px; }
        for t[i] in line.items: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 10px;
            if i > 0: Text { text: "·"; font-size: Breakpoints.tier-d ? 13px : Type.small; color: Theme.ink-4; vertical-alignment: center; horizontal-stretch: 0; }
            ProvItem { t: t; }
        }
        if line.last && Breakpoints.tier-d: Text { text: AxData.prov-summary.note; font-size: 13px; color: Theme.ink-3; vertical-alignment: center; horizontal-stretch: 0; }
        if line.last && Breakpoints.below-d: Text { text: AxData.prov-summary.note; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; horizontal-stretch: 0; }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component AxKpiRow inherits Rectangle {
    in property <bool> played;
    in property <duration> delay;
    property <bool> narrow: Breakpoints.width < 1180px;
    property <bool> loading: AxData.kpis.length < 5;
    property <AxKpi> k0: AxData.kpis.length > 0 ? AxData.kpis[0] : { label: "Total tokens" };
    property <AxKpi> k1: AxData.kpis.length > 1 ? AxData.kpis[1] : { label: "Total cost" };
    property <AxKpi> k2: AxData.kpis.length > 2 ? AxData.kpis[2] : { label: "Cache tokens" };
    property <AxKpi> k3: AxData.kpis.length > 3 ? AxData.kpis[3] : { label: "Input cost" };
    property <AxKpi> k4: AxData.kpis.length > 4 ? AxData.kpis[4] : { label: "Output cost" };
    // P: 2 columns with the 5th spanning; F: 3 + 2; T: one row from 1000 px, else 3 + 2 (4.2.2)
    property <length> cw: Breakpoints.tier-width - 2 * Breakpoints.gutter;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := VerticalLayout {
        spacing: 12px;
        if Breakpoints.tier-d && !root.narrow: HorizontalLayout {
            spacing: 16px;
            KpiCard { kpi: root.k0; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k1; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k2; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k3; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k4; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-d && root.narrow: HorizontalLayout {
            spacing: 12px;
            KpiCard { kpi: root.k0; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k1; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-d && root.narrow: HorizontalLayout {
            spacing: 12px;
            KpiCard { kpi: root.k2; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k3; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k4; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-p: HorizontalLayout {
            spacing: 12px;
            KpiCard { kpi: root.k0; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k1; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-p: HorizontalLayout {
            spacing: 12px;
            KpiCard { kpi: root.k2; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k3; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-p: HorizontalLayout {
            spacing: 12px;
            KpiCard { kpi: root.k4; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-f || (Breakpoints.tier-t && root.cw < 1000px): HorizontalLayout {
            spacing: 16px;
            KpiCard { kpi: root.k0; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k1; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k2; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-f || (Breakpoints.tier-t && root.cw < 1000px): HorizontalLayout {
            spacing: 16px;
            KpiCard { kpi: root.k3; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k4; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if Breakpoints.tier-t && root.cw >= 1000px: HorizontalLayout {
            spacing: 16px;
            KpiCard { kpi: root.k0; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k1; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k2; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k3; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
            KpiCard { kpi: root.k4; played: root.played; delay: root.delay + 120ms; loading: root.loading; horizontal-stretch: 1; }
        }
        if !root.loading && AxData.prov-summary.shown: AxProvLines { }
    }
}
