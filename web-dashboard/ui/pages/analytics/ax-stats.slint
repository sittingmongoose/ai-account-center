// Session stats, recent sessions, and the combined tokens-and-cache box.
import { Theme, Motion, Type, Breakpoints } from "../../theme.slint";
import { ProviderMark } from "../../components/mark.slint";
import { Caps, ValueUnit } from "../../components/text.slint";
import { ProbeMark } from "../../components/probe.slint";
import { AxData, AxSessRecent } from "ax-data.slint";
import { AxColor, AxCard, AxCardHead, AxNum, AxTip, AxSwatch, AxLegendEntry } from "ax-common.slint";

// ---------------------------------------------------------------- the session table
// One continued table across two boxes: Session stats shows the summary numbers, the per-provider rows
// and the five most recent sessions, Recent sessions continues with the next twenty. Both boxes render
// these same components, so the columns and styling line up exactly and the list reads as one. The fixed
// columns are one shared grid, identical in the header and every row, so each value sits exactly under
// its header whatever the labels measure; each width fits its Martian Mono 11 px header (0.65 em a glyph
// plus 0.66 px letter spacing: PROVIDER needs 62, LAST ACTIVE 86) and the widest value it carries at
// 12.5 px ("Unavailable", 89), and absurd magnitudes elide inside the column instead of shifting the
// grid. The models column flexes and elides, with the full list in the row's tip. The first column names
// the provider that served the session, never the CLI whose logs held it.
global SessCols {
    out property <length> gap: 10px;
    out property <length> prov: 64px;
    out property <length> tok: 92px;
    out property <length> cost: 92px;
    out property <length> when: 92px;
}

component SessRow inherits HorizontalLayout {
    in property <AxSessRecent> r;
    // "" reports nothing; the first row of each box names its cells for the e2e harness (see SessList)
    in property <string> probe: "";
    min-height: 31px;
    spacing: SessCols.gap;
    VerticalLayout { alignment: center; width: SessCols.prov; horizontal-stretch: 0; HorizontalLayout { alignment: start; ProviderMark { provider: root.r.tool; size: 16px; } } }
    Text { text: root.r.models; font-size: 12.5px; font-weight: 560; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; AxTip { tip: root.r.tip; } ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + ":models"; } }
    Text { text: root.r.tokens; width: SessCols.tok; horizontal-stretch: 0; overflow: elide; font-family: Type.tab; font-size: 12.5px; color: Theme.ink-2; horizontal-alignment: right; vertical-alignment: center; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + ":tokens"; } }
    Text { text: root.r.cost; width: SessCols.cost; horizontal-stretch: 0; overflow: elide; font-family: Type.tab; font-size: 12.5px; font-weight: 600; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + ":cost"; } }
    Text { text: root.r.when; width: SessCols.when; horizontal-stretch: 0; overflow: elide; font-family: Type.tab; font-size: 12px; color: Theme.ink-3; horizontal-alignment: right; vertical-alignment: center; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + ":when"; } }
}

component SessList inherits VerticalLayout {
    in property <[AxSessRecent]> rows;
    in property <string> empty-text;
    // names this box's header and first-row cells for the e2e harness (components/probe.slint); "" reports
    // nothing. Both boxes share the grid, so a harness can check one list by comparing their rectangles.
    in property <string> probe: "";
    spacing: 0px;
    HorizontalLayout {
        padding-bottom: 6px;
        spacing: SessCols.gap;
        Caps { text: "PROVIDER"; width: SessCols.prov; horizontal-stretch: 0; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + "-h:prov"; } }
        Caps { text: "MODELS"; horizontal-stretch: 1; min-width: 0px; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + "-h:models"; } }
        Caps { text: "TOKENS"; width: SessCols.tok; horizontal-stretch: 0; horizontal-alignment: right; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + "-h:tokens"; } }
        Caps { text: "COST"; width: SessCols.cost; horizontal-stretch: 0; horizontal-alignment: right; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + "-h:cost"; } }
        Caps { text: "LAST ACTIVE"; width: SessCols.when; horizontal-stretch: 0; horizontal-alignment: right; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.probe == "" ? "" : root.probe + "-h:when"; } }
    }
    for r[i] in root.rows: VerticalLayout {
        spacing: 0px;
        Rectangle { height: 1px; background: Theme.rule-2; }
        SessRow { r: r; probe: root.probe == "" || i > 0 ? "" : root.probe + "-c"; }
    }
    if root.rows.length == 0: Text {
        text: root.empty-text;
        font-size: 12.5px;
        color: Theme.ink-3;
        wrap: word-wrap;
        min-height: 32px;
        vertical-alignment: center;
    }
}

// ---------------------------------------------------------------- session stats
// The summary numbers, then one row per provider with sessions, then the five most recent sessions as a
// compact table at the bottom; the Recent sessions box continues the same list. Numbers sit in three
// equal columns, each number above its label.
component SessCell inherits Text {
    font-family: Type.tab;
    font-size: 12.5px;
    color: Theme.ink;
    horizontal-alignment: right;
    vertical-alignment: center;
    horizontal-stretch: 1;
    // absurd magnitudes elide inside the fixed column instead of shifting the grid
    overflow: elide;
}

export component AxSessionsCard inherits AxCard {
    in property <bool> played;
    in property <duration> delay;
    property <bool> pad16: Breakpoints.width < 1180px;
    // ONE shared grid for the provider header and every provider row: the provider column takes the
    // remainder and the three numeric columns are fixed and right-aligned, identical in the header and
    // every row, so each value sits exactly under its header whatever the labels measure. Each width fits
    // its Martian Mono 11 px header (0.65 em a glyph plus 0.66 px letter spacing: SESSIONS needs 63, PER
    // SESSION 86, EVENTS PER SESSION 141) and the widest value it carries ("Unavailable", 89).
    property <length> col-sessions: 92px;
    property <length> col-per: 92px;
    property <length> col-events: 146px;
    AxCardHead { title: "Session stats"; sub: AxData.sessions.sub; note: AxData.sessions.note; probe: "sess-head"; }
    VerticalLayout {
        // a card stretched by a taller neighbour (an open donut legend) keeps its content at the top
        alignment: start;
        padding-left: root.pad16 ? 16px : 20px;
        padding-right: self.padding-left;
        padding-top: 2px;
        padding-bottom: 16px;
        spacing: 14px;
        vertical-stretch: 1;
        // the stats spread across the card at the top under the subtitle, as the concept draws them; the
        // table below keeps its own shared grid
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 0;
            for s[i] in AxData.sess-stats: VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 3px;
                AxNum {
                    num: s.num;
                    has: s.has;
                    fmt: s.fmt;
                    text: s.text;
                    played: root.played;
                    delay: root.delay + i * 60ms;
                    size: 22px;
                    weight: 640;
                    na-size: 15px;
                    height: 26px;
                    ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-stat:" + s.key; }
                }
                Text { text: s.label; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
            }
        }
        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 0;
            HorizontalLayout {
                padding-bottom: 6px;
                Caps { text: "PROVIDER"; horizontal-stretch: 1; min-width: 0px; }
                Caps { text: "SESSIONS"; horizontal-alignment: right; horizontal-stretch: 0; width: root.col-sessions; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-h:sessions"; } }
                Caps { text: "PER SESSION"; horizontal-alignment: right; horizontal-stretch: 0; width: root.col-per; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-h:per"; } }
                Caps { text: "EVENTS PER SESSION"; horizontal-alignment: right; horizontal-stretch: 0; width: root.col-events; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-h:events"; } }
            }
            for r in AxData.sess-rows: VerticalLayout {
                Rectangle { height: 1px; background: Theme.rule-2; }
                HorizontalLayout {
                    min-height: 32px;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; ProviderMark { provider: r.provider; size: 16px; } }
                        Text { text: r.label; font-size: 12.5px; font-weight: 560; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    SessCell { text: r.sessions; horizontal-stretch: 0; width: root.col-sessions; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-c:" + r.provider + ":sessions"; } }
                    SessCell { text: r.per; horizontal-stretch: 0; width: root.col-per; ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-c:" + r.provider + ":per"; } }
                    SessCell { text: r.events; horizontal-stretch: 0; width: root.col-events; AxTip { tip: r.events-tip; } ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "sess-c:" + r.provider + ":events"; } }
                }
            }
        }
        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 0;
            Rectangle { height: 1px; background: Theme.rule-2; }
            Text { text: "Most recent sessions"; font-size: 12.5px; font-weight: 600; color: Theme.ink-2; min-height: 30px; vertical-alignment: bottom; }
            Rectangle { height: 9px; }
            SessList { rows: AxData.sess-recent; empty-text: "No sessions in this range."; probe: "sess"; }
        }
        // any spare height goes below the table, never above the stats
        Rectangle { vertical-stretch: 1; min-height: 0px; }
    }
}
// ---------------------------------------------------------------- recent sessions
// The session table continued: the next twenty sessions (6 to 25), most recent first, without paths. It
// renders the same SessList as the Session stats box, so the two read as one continued list.
export component AxRecentCard inherits AxCard {
    in property <bool> played;
    in property <duration> delay;
    property <bool> narrow: Breakpoints.width < 1180px;
    AxCardHead { title: "Recent sessions"; sub: AxData.sess-more-sub; probe: "more-head"; }
    VerticalLayout {
        alignment: start;
        padding-left: root.narrow ? 16px : 20px;
        padding-right: self.padding-left;
        padding-top: 2px;
        padding-bottom: 14px;
        spacing: 10px;
        vertical-stretch: 1;
        SessList {
            rows: AxData.sess-recent-more;
            empty-text: AxData.sess-recent.length == 0 ? "No sessions in this range." : "No more sessions in this range.";
            vertical-stretch: 0;
            probe: "more";
        }
        if AxData.sessions.foot != "": Text { text: AxData.sessions.foot; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
    }
}

// ---------------------------------------------------------------- token breakdown
component TokBar inherits Rectangle {
    in property <float> w;
    in property <color> c;
    in property <bool> played;
    in property <duration> delay;
    height: 7px;
    border-radius: 4px;
    background: Theme.paper-3;
    clip: true;
    property <bool> mounted: !Motion.on;
    mount := Timer { interval: 16ms; running: !root.mounted; triggered => { self.running = false; root.mounted = true; } }
    property <bool> landed: !Motion.on;
    land := Timer { interval: root.delay + 860ms; running: root.played && root.mounted && !root.landed; triggered => { self.running = false; root.landed = true; } }
    property <float> fill: root.played && root.mounted ? root.w : 0;
    animate fill { duration: Motion.on ? 820ms : 0ms; delay: Motion.on && !root.landed ? root.delay : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Rectangle { x: 0px; width: parent.width * root.fill / 100; height: 7px; border-radius: 4px; background: root.c; }
}

// ---------------------------------------------------------------- cache efficiency
// The hit-rate gauge: a 240-degree track, quarter ticks, a gradient arc that sweeps with the count-up on one
// non-overshooting ease-out (so the arc never passes the value), 0% and 100% at its ends.
component Gauge inherits Rectangle {
    in property <float> frac;
    in property <bool> played;
    in property <duration> delay;
    property <float> cx: 80;
    property <float> cy: 74;
    property <float> r: 58;
    property <bool> mounted: !Motion.on;
    mount := Timer { interval: 16ms; running: !root.mounted; triggered => { self.running = false; root.mounted = true; } }
    property <bool> landed: !Motion.on;
    land := Timer { interval: root.delay + 1060ms; running: root.played && root.mounted && !root.landed; triggered => { self.running = false; root.landed = true; } }
    property <float> f: root.played && root.mounted ? clamp(root.frac, 0, 1) : 0;
    animate f { duration: Motion.on ? (root.landed ? 700ms : 1000ms) : 0ms; delay: Motion.on && !root.landed ? root.delay : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> deg: -120 + 240 * root.f;
    property <float> x0: root.cx + root.r * sin(-120deg);
    property <float> y0: root.cy - root.r * cos(-120deg);
    property <float> x1: root.cx + root.r * sin(root.deg * 1deg);
    property <float> y1: root.cy - root.r * cos(root.deg * 1deg);
    property <float> xe: root.cx + root.r * sin(120deg);
    property <float> ye: root.cy - root.r * cos(120deg);
    property <float> sx: root.width / 160px;
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 160;
        viewbox-height: 132;
        commands: "M\{root.x0} \{root.y0}A58 58 0 1 1 \{root.xe} \{root.ye}";
        stroke: Theme.track;
        stroke-width: 10px * root.sx;
        stroke-line-cap: round;
    }
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 160;
        viewbox-height: 132;
        commands: "M\{root.cx + 67 * sin(-120deg)} \{root.cy - 67 * cos(-120deg)}L\{root.cx + 71 * sin(-120deg)} \{root.cy - 71 * cos(-120deg)}"
            + "M\{root.cx + 67 * sin(-60deg)} \{root.cy - 67 * cos(-60deg)}L\{root.cx + 71 * sin(-60deg)} \{root.cy - 71 * cos(-60deg)}"
            + "M\{root.cx} \{root.cy - 67}L\{root.cx} \{root.cy - 71}"
            + "M\{root.cx + 67 * sin(60deg)} \{root.cy - 67 * cos(60deg)}L\{root.cx + 71 * sin(60deg)} \{root.cy - 71 * cos(60deg)}"
            + "M\{root.cx + 67 * sin(120deg)} \{root.cy - 67 * cos(120deg)}L\{root.cx + 71 * sin(120deg)} \{root.cy - 71 * cos(120deg)}";
        stroke: Theme.rule-strong;
        stroke-width: 1.25px;
        stroke-line-cap: round;
    }
    if root.f > 0.0005: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 160;
        viewbox-height: 132;
        commands: "M\{root.x0} \{root.y0}A58 58 0 \{root.deg + 120 > 180 ? 1 : 0} 1 \{root.x1} \{root.y1}";
        stroke: @linear-gradient(90deg, AxColor.of("cr").mix(Theme.paper, 0.55) 0%, AxColor.of("cr") 100%);
        stroke-width: 10px * root.sx;
        stroke-line-cap: round;
    }
    Text { x: root.x0 * 1px * root.sx - self.preferred-width / 2; y: (root.y0 + 22) * 1px * root.sx - self.font-metrics.ascent; text: "0%"; font-family: Type.mono; font-size: 11px; color: Theme.ink-3; }
    Text { x: root.xe * 1px * root.sx - self.preferred-width / 2; y: (root.ye + 22) * 1px * root.sx - self.font-metrics.ascent; text: "100%"; font-family: Type.mono; font-size: 11px; color: Theme.ink-3; }
}

component RwRow inherits HorizontalLayout {
    in property <string> kind;
    in property <string> name;
    in property <string> note;
    in property <string> tok;
    in property <string> tip;
    in property <string> share;
    in property <string> cost;
    in property <bool> narrow;
    spacing: root.narrow ? 10px : 12px;
    min-height: 23px;
    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 8px;
        VerticalLayout { alignment: center; AxSwatch { c: AxColor.of(root.kind); } }
        Text { text: root.name; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; vertical-alignment: center; }
        if root.note != "": Text { text: root.note; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }
    Text { text: root.tok; width: root.narrow ? 64px : 76px; font-family: Type.tab; font-size: 12.5px; font-weight: 620; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; AxTip { tip: root.tip; } }
    HorizontalLayout { width: root.narrow ? 60px : 70px; alignment: end; if root.share != "Unavailable": VerticalLayout { alignment: center; ValueUnit { value: root.share; size: 12.5px; weight: 400; ink: Theme.ink-3; unit-scale: 0.96; height: 18px; } } }
    Text { text: root.cost; width: root.narrow ? 86px : 96px; font-family: Type.tab; font-size: 12.5px; font-weight: 620; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
}

// ---------------------------------------------------------------- tokens and cache
// One box for both: the token breakdown rows on top, the cache efficiency gauge and reads-vs-writes
// below. Nothing is dropped; the two sections share one head because they cover the same range.
export component AxTokensCacheCard inherits AxCard {
    in property <bool> played;
    in property <duration> delay;
    property <bool> narrow: Breakpoints.width < 1180px;
    property <length> gw: root.narrow ? 140px : 160px;
    AxCardHead {
        title: "Tokens and cache";
        sub: AxData.tokens-sub;
        HorizontalLayout {
            spacing: 14px;
            alignment: end;
            horizontal-stretch: 0;
            VerticalLayout { alignment: start; padding-top: 1px; AxLegendEntry { shape: "bar-t"; label: "Share of tokens"; } }
            VerticalLayout { alignment: start; padding-top: 1px; AxLegendEntry { shape: "bar-c"; label: "Share of cost"; } }
        }
    }
    VerticalLayout {
        padding-left: root.narrow ? 16px : 20px;
        padding-right: self.padding-left;
        padding-top: 4px;
        padding-bottom: 18px;
        spacing: 12px;
        alignment: start;
        for t[i] in AxData.tokens: HorizontalLayout {
            spacing: root.narrow ? 10px : 14px;
            HorizontalLayout {
                width: root.narrow ? 92px : 104px;
                spacing: 8px;
                VerticalLayout { alignment: center; AxSwatch { c: AxColor.of(t.key); } }
                Text { text: t.label; font-size: 13px; font-weight: 560; color: Theme.ink; vertical-alignment: center; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                min-width: 60px;
                TokBar { w: t.wt; c: AxColor.of(t.key).with-alpha(0.42); played: root.played; delay: root.delay + i * 90ms; }
                TokBar { w: t.wc; c: AxColor.of(t.key); played: root.played; delay: root.delay + i * 90ms + 40ms; }
            }
            VerticalLayout {
                width: root.narrow ? 138px : 150px;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: t.tok; font-family: Type.tab; font-size: 12.5px; font-weight: 600; color: Theme.ink; horizontal-alignment: right; horizontal-stretch: 1; min-height: 17px; AxTip { tip: t.tok-tip; } }
                    HorizontalLayout { width: 50px; alignment: end; ValueUnit { value: t.tok-share; size: 12px; weight: 400; ink: Theme.ink-3; unit-scale: 0.96; height: 17px; } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: t.cost; font-family: Type.tab; font-size: 12.5px; font-weight: 600; color: Theme.ink; horizontal-alignment: right; horizontal-stretch: 1; min-height: 17px; }
                    HorizontalLayout { width: 50px; alignment: end; if t.cost-share != "": ValueUnit { value: t.cost-share; size: 12px; weight: 400; ink: Theme.ink-3; unit-scale: 0.96; height: 17px; } }
                }
            }
        }
        Rectangle { height: 6px; }
        Rectangle { height: 1px; background: Theme.rule-2; }
        Text { text: "Cache efficiency"; font-size: 12.5px; font-weight: 600; color: Theme.ink-2; min-height: 30px; vertical-alignment: bottom; }
        Rectangle { height: 4px; }
        HorizontalLayout {
            padding-right: self.padding-left;
            spacing: root.narrow ? 20px : 28px;
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: root.gw;
                    height: root.gw * 132 / 160;
                    Gauge { width: parent.width; height: parent.height; frac: AxData.cache.has-hit ? AxData.cache.hit / 100 : 0; played: root.played; delay: root.delay; }
                    VerticalLayout {
                        y: root.narrow ? 42px : 50px;
                        width: parent.width;
                        height: self.preferred-height;
                        spacing: 3px;
                        HorizontalLayout {
                            alignment: center;
                            AxNum {
                                num: AxData.cache.hit;
                                has: AxData.cache.has-hit;
                                fmt: "pct2";
                                text: AxData.cache.hit-text;
                                pct: true;
                                played: root.played;
                                delay: root.delay;
                                size: root.narrow ? 23px : 26px;
                                weight: 640;
                                na-size: 14px;
                            }
                        }
                        Text { text: "hit rate"; font-size: 12px; color: Theme.ink-3; horizontal-alignment: center; }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 0px;
                Text { text: "Estimated savings"; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; }
                Rectangle { height: 3px; }
                HorizontalLayout {
                    AxNum {
                        num: AxData.cache.save;
                        has: AxData.cache.has-save;
                        fmt: "money";
                        text: AxData.cache.save-text;
                        played: root.played;
                        delay: root.delay;
                        size: root.narrow ? 23px : 26px;
                        weight: 640;
                        ink: Theme.good-text;
                        na-size: 15px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 3px; }
                Text { text: "Cache reads priced at each model's cache-read rate instead of its input rate"; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
                Rectangle { height: 14px; }
                Rectangle { height: 1px; background: Theme.rule-2; }
                Rectangle { height: 14px; }
                Text { text: "Estimated cache cost"; font-size: 12.5px; font-weight: 560; color: Theme.ink-2; }
                Rectangle { height: 3px; }
                HorizontalLayout {
                    AxNum {
                        num: AxData.cache.ccost;
                        has: AxData.cache.has-ccost;
                        fmt: "money";
                        text: AxData.cache.ccost-text;
                        played: root.played;
                        delay: root.delay;
                        size: 21px;
                        weight: 640;
                        na-size: 15px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 3px; }
                if AxData.cache.ccost-share != "": HorizontalLayout {
                    spacing: 0px;
                    alignment: start;
                    ValueUnit { value: AxData.cache.ccost-share; size: 12px; weight: 400; ink: Theme.ink-3; unit-scale: 0.96; horizontal-stretch: 0; }
                    Text { text: " of the estimated cost for this range"; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
                }
            }
        }
        VerticalLayout {
            padding-right: self.padding-left;
            spacing: 0px;
            Rectangle { height: 1px; background: Theme.rule-2; }
            Text { text: "Cache reads vs writes"; font-size: 12.5px; font-weight: 600; color: Theme.ink-2; min-height: 32px; vertical-alignment: bottom; }
            Rectangle { height: 9px; }
            rw := Rectangle {
                height: 10px;
                border-radius: 5px;
                background: Theme.track;
                clip: true;
                property <float> total: AxData.cache.reads + AxData.cache.writes;
                property <length> ww: self.total > 0 && AxData.cache.writes > 0 ? max(3px, (self.width - 2px) * AxData.cache.writes / self.total) : 0px;
                property <length> rw-w: self.total > 0 && AxData.cache.reads > 0 ? self.width - self.ww - (self.ww > 0 ? 2px : 0px) : 0px;
                animate ww, rw-w { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                Rectangle {
                    x: 0px;
                    width: rw.rw-w;
                    background: @linear-gradient(90deg, AxColor.of("cr").mix(Theme.paper, 0.55) 0%, AxColor.of("cr") 100%);
                    AxTip { tip: "Cache reads: " + AxData.cache.r-tip; }
                }
                Rectangle {
                    x: rw.width - rw.ww;
                    width: rw.ww;
                    background: AxColor.of("cw");
                    AxTip { tip: "Cache writes: " + AxData.cache.w-tip; }
                }
            }
            Rectangle { height: 10px; }
            HorizontalLayout {
                spacing: root.narrow ? 10px : 12px;
                padding-bottom: 2px;
                Rectangle { horizontal-stretch: 1; }
                Caps { text: "TOKENS"; width: root.narrow ? 64px : 76px; horizontal-alignment: right; }
                Caps { text: "SHARE"; width: root.narrow ? 60px : 70px; horizontal-alignment: right; }
                Caps { text: "EST. COST"; width: root.narrow ? 86px : 96px; horizontal-alignment: right; }
            }
            RwRow { kind: "cr"; name: "Reads"; tok: AxData.cache.r-tok; tip: AxData.cache.r-tip; share: AxData.cache.r-share; cost: AxData.cache.r-cost; narrow: root.narrow; }
            RwRow { kind: "cw"; name: "Writes"; note: AxData.cache.w-note; tok: AxData.cache.w-tok; tip: AxData.cache.w-tip; share: AxData.cache.w-share; cost: AxData.cache.w-cost; narrow: root.narrow; }
        }
        HorizontalLayout {
            padding-right: self.padding-left;
            Text {
                text: "Hit rate is cache reads divided by cache reads plus cache writes. Savings and costs are API-equivalent estimates, not a bill.";
                font-size: 12px;
                color: Theme.ink-3;
                wrap: word-wrap;
            }
        }
    }
}

