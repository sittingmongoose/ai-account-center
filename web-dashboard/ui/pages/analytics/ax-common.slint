// Analytics building blocks: chart colours, count-up numbers, the card shell and head, swatches, the
// switch, the segmented control with marks, readout rows, tips and the first-view reveal.
import { Theme, Motion, Type, Breakpoints } from "../../theme.slint";
import { HoverShadow } from "../../components/card.slint";
import { Icon } from "../../components/icon.slint";
import { ProviderMark } from "../../components/mark.slint";
import { Hover } from "../../components/hover-card.slint";
import { ValueUnit } from "../../components/text.slint";
import { AxData } from "ax-data.slint";

// ---------------------------------------------------------------- colours
export global AxColor {
    // one colour per token type and per provider (charts only, never on marks)
    public pure function of(k: string) -> color {
        if k == "in" { return Theme.chart-input; }
        if k == "out" { return Theme.chart-output; }
        if k == "cw" { return Theme.chart-cache-write; }
        if k == "cr" { return Theme.chart-cache-read; }
        if k == "tok" { return Theme.chart-tokens; }
        if k == "cost" { return Theme.chart-cost; }
        if k == "claude" { return Theme.h-claude; }
        if k == "codex" { return Theme.h-codex; }
        return Theme.ink-3;
    }
    // a focus-chart series: the provider hue, then lighter steps (Codex has its own second and third tones)
    public pure function series(p: string, shade: int) -> color {
        if shade <= 0 { return Theme.provider-hue(p); }
        if p == "codex" { return shade == 1 ? Theme.h-codex-2 : Theme.h-codex-3; }
        return Theme.provider-hue(p).mix(Theme.paper, shade == 1 ? 0.62 : 0.38);
    }
    // stroke and fill keys of the focus-chart drawing lists
    public pure function key(k: string, p: string, shade: int) -> color {
        if k == "grid" { return Theme.grid; }
        if k == "grid-strong" { return Theme.grid-strong; }
        if k == "rule-strong" { return Theme.rule-strong; }
        if k == "warn" { return Theme.warn; }
        if k == "crit" { return Theme.crit; }
        if k == "accent" { return Theme.accent; }
        if k == "ink" { return Theme.ink; }
        if k == "ink-2" { return Theme.ink-2; }
        if k == "ink-3" { return Theme.ink-3; }
        if k == "paper" { return Theme.paper; }
        if k == "paper-2" { return Theme.paper-2; }
        if k == "crit-text" { return Theme.crit-text; }
        if k == "accent-text" { return Theme.accent-text; }
        if k == "series" { return series(p, shade); }
        if k == "series-ink" { return series(p, shade).mix(Theme.ink, 0.62); }
        return Theme.ink-3;
    }
    // one colour per model in its family (the donut and its legend): Claude Code, Codex, or the neutral family
    // of models whose usage is not one provider's alone ("" provider)
    public pure function model(p: string, mix: float, other: bool) -> color {
        if other { return Theme.ink-4; }
        if mix >= 0.999 { return p == "" ? Theme.h-model : Theme.provider-hue(p); }
        return (p == "" ? Theme.h-model : Theme.provider-hue(p)).mix(Theme.paper, mix);
    }
    // heatmap: an empty hour, the low end of the ramp, and a cell at sqrt-scaled intensity k
    out property <color> heat-zero: Theme.pick(Theme.heat-0, #1F2A35);
    out property <color> heat-lo: Theme.pick(Theme.heat-1.mix(Theme.heat-0, 0.12), Theme.heat-1.mix(Theme.heat-0, 0.30));
    public pure function heat(k: float) -> color { return Theme.heat-1.mix(heat-lo, clamp(k, 0, 1)); }
    public pure function sev-line(s: int) -> color {
        if s >= 2 { return Theme.crit; }
        if s == 1 { return Theme.warn; }
        return Theme.calm;
    }
}

// ---------------------------------------------------------------- number formats for count-ups
// While a number rolls it is formatted here; once it lands it shows the exact text from bridge.js.
export global AxFmt {
    public pure function pad3(n: int) -> string {
        if n < 10 { return "00\{n}"; }
        if n < 100 { return "0\{n}"; }
        return "\{n}";
    }
    public pure function group(v: float) -> string {
        if v < 1000 { return "\{floor(v)}"; }
        if v < 1000000 { return "\{floor(v / 1000)},\{pad3(mod(floor(v), 1000))}"; }
        return "\{floor(v / 1000000)},\{pad3(mod(floor(v / 1000), 1000))},\{pad3(mod(floor(v), 1000))}";
    }
    public pure function money(v: float) -> string {
        let cents = round(max(0, v) * 100);
        let whole = floor(cents / 100);
        let rest = mod(cents, 100);
        return "$\{group(whole)}.\{rest < 10 ? "0" : ""}\{rest}";
    }
    public pure function sig(s: float, suffix: string) -> string {
        if s >= 100 { return "\{round(s)}\{suffix}"; }
        if s >= 10 { return "\{s.to-fixed(1)}\{suffix}"; }
        return "\{s.to-fixed(2)}\{suffix}";
    }
    public pure function tok(v: float) -> string {
        if v >= 1000000000000 { return sig(v / 1000000000000, "T"); }
        if v >= 1000000000 { return sig(v / 1000000000, "B"); }
        if v >= 1000000 { return sig(v / 1000000, "M"); }
        if v >= 1000 { return sig(v / 1000, "K"); }
        return "\{round(v)}";
    }
    public pure function format(fmt: string, v: float) -> string {
        if fmt == "money" { return money(v); }
        if fmt == "tok" { return tok(v); }
        if fmt == "pct2" { return v.to-fixed(2); }
        if fmt == "pct1" { return v.to-fixed(1); }
        return group(round(v));
    }
}

// A number that counts up (ease-out, never past its value) from the value on screen to the new one; on its
// first view it rolls from zero after `delay`. `text` is the exact final text; "%" is drawn as a unit.
export component AxNum inherits Rectangle {
    in property <float> num;
    in property <bool> has: true;
    in property <string> fmt: "int";
    in property <string> text;
    in property <bool> played: true;
    in property <duration> delay: 0ms;
    in property <duration> dur: 1000ms;
    in property <length> size: 22px;
    in property <int> weight: 640;
    in property <color> ink: Theme.ink;
    in property <bool> pct: false;
    in property <float> unit-scale: 0.96;
    in property <bool> right: false;
    // the text shown without a value: the view model's own ("Unavailable" or "Not logged")
    in property <string> na: root.text == "" ? "Unavailable" : root.text;
    in property <length> na-size: root.size;

    property <bool> mounted: !Motion.on;
    mount := Timer {
        interval: 16ms;
        running: !root.mounted;
        triggered => { self.running = false; root.mounted = true; }
    }
    property <bool> landed: !Motion.on;
    land := Timer {
        interval: root.delay + root.dur + 60ms;
        running: root.played && root.mounted && !root.landed;
        triggered => { self.running = false; root.landed = true; }
    }
    property <float> target: root.has ? root.num : 0;
    property <float> anim: root.played && root.mounted ? root.target : 0;
    animate anim {
        duration: Motion.on ? (root.landed ? 700ms : root.dur) : 0ms;
        delay: root.landed || !Motion.on ? 0ms : root.delay;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    property <bool> settled: !Motion.on || abs(root.anim - root.target) <= abs(root.target) * 0.000001 + 0.0000001;
    out property <string> shown: root.settled ? root.text : AxFmt.format(root.fmt, root.anim);

    min-width: lay.min-width;
    preferred-width: lay.preferred-width;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := HorizontalLayout {
        alignment: root.right ? end : start;
        if root.has && !root.pct: Text {
            vertical-alignment: center;
            text: root.shown;
            font-family: Type.tab;
            font-size: root.size;
            font-weight: root.weight;
            color: root.ink;
            letter-spacing: -0.01 * root.size;
        }
        if root.has && root.pct: VerticalLayout {
            alignment: center;
            ValueUnit {
                value: root.shown;
                unit: "%";
                size: root.size;
                weight: root.weight;
                ink: root.ink;
                unit-scale: root.unit-scale;
            }
        }
        if !root.has: Text {
            vertical-alignment: center;
            text: root.na;
            font-size: root.na-size;
            font-weight: 520;
            color: Theme.ink-3;
        }
    }
}

// ---------------------------------------------------------------- tips
// Hover target for a plain tooltip (exact values, the rule behind a number).
export component AxTip inherits TouchArea {
    in property <string> tip;
    in property <string> owner: root.tip;
    changed has-hover => {
        if self.has-hover && root.tip != "" {
            Hover.tip(root.owner, self.absolute-position, self.width, self.height, root.tip);
        } else {
            Hover.leave(root.owner);
        }
    }
}

// ---------------------------------------------------------------- swatches (legend keys, not decoration)
// shape: box (10 x 10), line (14 x 3), half (two 6 px halves), bar-t / bar-c (14 x 6 share bars)
export component AxSwatch inherits Rectangle {
    in property <color> c: Theme.ink-3;
    in property <color> c2: root.c;
    in property <string> shape: "box";
    width: root.shape == "line" || root.shape == "bar-t" || root.shape == "bar-c" ? 14px : root.shape == "half" ? 8px : 10px;
    height: 10px;
    if root.shape == "box": Rectangle { width: 10px; height: 10px; border-radius: 3px; background: root.c; }
    if root.shape == "line": Rectangle { y: 3.5px; width: 14px; height: 3px; border-radius: 2px; background: root.c; }
    if root.shape == "half": Rectangle { x: 0px; width: 6px; height: 10px; border-radius: 2px; background: root.c; }
    if root.shape == "half": Rectangle { x: 4px; width: 6px; height: 10px; border-radius: 2px; background: root.c2; }
    if root.shape == "bar-t": Rectangle { y: 2px; width: 14px; height: 6px; border-radius: 3px; background: Theme.ink-3.with-alpha(0.45); }
    if root.shape == "bar-c": Rectangle { y: 2px; width: 14px; height: 6px; border-radius: 3px; background: Theme.ink-3; }
}

export component AxLegendEntry inherits HorizontalLayout {
    in property <color> c;
    in property <color> c2: root.c;
    in property <string> shape: "box";
    in property <string> label;
    in property <string> note;
    spacing: 7px;
    horizontal-stretch: 0;
    VerticalLayout { alignment: center; AxSwatch { c: root.c; c2: root.c2; shape: root.shape; } }
    Text { text: root.label; font-size: 12.5px; color: Theme.ink-2; vertical-alignment: center; min-height: 18px; }
    if root.note != "": Text { text: root.note; font-size: 12px; color: Theme.ink-3; vertical-alignment: center; }
}

// ---------------------------------------------------------------- the card
// A chart card: paper, hairline border, the small shadow; on hover the shadow grows and the border darkens.
export component AxCard inherits Rectangle {
    in property <bool> hover-lift: true;
    // Off for cards whose hover readout moves with the pointer: the readout's shadow changes the layer's bounds,
    // and a resized layer costs a new texture and a GPU sync every frame (the trend card caches its plot itself).
    in property <bool> cached: true;
    out property <bool> hovered: hover-ta.has-hover;
    min-height: body.min-height;
    preferred-height: body.preferred-height;
    min-width: body.min-width;
    // a static large shadow fades in on hover (HoverShadow) instead of re-blurring this one every frame
    HoverShadow {
        width: root.width;
        height: root.height;
        radius: Theme.r-plate;
        on: root.hovered && root.hover-lift;
        blur: 24px;
        offset: 8px;
    }
    surface := Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.paper;
        border-radius: Theme.r-plate;
        border-width: 1px;
        border-color: root.hovered && root.hover-lift ? Theme.rule-strong : Theme.rule;
        animate border-color { duration: Motion.tint(Motion.med); }
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        // The content sits inside the hover area so nested rows and buttons keep the card's hover.
        hover-ta := TouchArea {
            // the card's content is a cached layer: it re-renders only while something inside it changes (a
            // reveal, a morph, a hover tint), so scrolling and the slide-over do not redraw every chart
            cache-rendering-hint: root.cached;
            mouse-cursor: default;
            body := VerticalLayout {
                spacing: 0px;
                @children
            }
        }
    }
}

// Card head: title and sub, an optional quiet scope note (with the info glyph), tools at the right.
export component AxCardHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    in property <string> note;
    in property <length> pad: Breakpoints.width < 1180px ? 16px : 20px;
    padding-left: root.pad;
    padding-right: root.pad;
    padding-top: Breakpoints.width < 1180px ? 14px : 16px;
    padding-bottom: Breakpoints.width < 1180px ? 8px : 10px;
    spacing: 16px;
    VerticalLayout {
        spacing: 3px;
        horizontal-stretch: 1;
        alignment: start;
        Text { text: root.title; font-size: 16px; font-weight: 640; color: Theme.ink; letter-spacing: -0.16px; min-height: 21px; vertical-alignment: center; }
        if root.sub != "": Text { text: root.sub; font-family: Type.tab; font-size: 12.5px; color: Theme.ink-3; wrap: word-wrap; min-height: 17.5px; vertical-alignment: center; }
        // the wrapped note sits directly in the column so its height is measured at the column's width
        if root.note != "": VerticalLayout {
            padding-top: 3px;
            Rectangle {
                min-height: nt.preferred-height;
                Icon { x: 0px; y: 2px; name: "info"; width: 13px; height: 13px; tint: Theme.ink-3; }
                nt := Text { x: 19px; y: 0px; width: parent.width - 19px; text: root.note; font-size: 12px; color: Theme.ink-3; wrap: word-wrap; }
            }
        }
    }
    @children
}

// ---------------------------------------------------------------- controls
// The concept's own switch: a 30 x 18 track, a spring thumb and its label; the whole thing is the target.
export component AxSwitch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    in property <string> tip;
    callback toggled(bool);
    height: 26px;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    border-radius: 8px;
    background: ta.has-hover ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    row := HorizontalLayout {
        padding-left: 4px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 18px;
                border-radius: 9px;
                background: root.on ? Theme.accent : Theme.rule-strong;
                animate background { duration: Motion.tint(Motion.med); easing: cubic-bezier(0.65, 0, 0.35, 1); }
                transform-scale: ta.pressed ? 0.95 : 1;
                animate transform-scale { duration: Motion.fast; }
                Rectangle {
                    x: root.on ? 14px : 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Theme.paper;
                    drop-shadow-color: #00000040;
                    drop-shadow-blur: 2px;
                    drop-shadow-offset-y: 1px;
                    animate x { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                }
            }
        }
        Text { text: root.label; font-size: 12.5px; font-weight: 540; color: ta.has-hover ? Theme.ink : Theme.ink-2; vertical-alignment: center; }
    }
    ta := AxTip {
        tip: root.tip;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

export struct AxSegItem { value: string, label: string, mark: string }

component AxSegButton inherits Rectangle {
    in property <AxSegItem> item;
    in property <bool> selected;
    in property <bool> mono;
    in property <bool> small;
    callback clicked();
    height: root.small ? 24px : 28px;
    min-width: row.preferred-width;
    preferred-width: row.preferred-width;
    border-radius: 7px;
    property <color> fg: root.selected || ta.has-hover ? Theme.ink : Theme.ink-3;
    transform-scale: ta.pressed ? 0.97 : 1;
    animate transform-scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    row := HorizontalLayout {
        padding-left: root.small ? 10px : root.mono ? 11px : 12px;
        padding-right: self.padding-left;
        spacing: 7px;
        alignment: center;
        if root.item.mark != "": VerticalLayout { alignment: center; ProviderMark { provider: root.item.mark; size: 16px; } }
        Text {
            text: root.item.label;
            color: root.fg;
            animate color { duration: Motion.tint(Motion.med); }
            font-family: root.mono ? Type.mono : Type.sans;
            font-size: root.mono ? 11.5px : root.small ? 12px : 12.5px;
            font-weight: 560;
            letter-spacing: root.mono ? 0.46px : 0px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Segmented control with one sliding indicator (spring); items may carry a provider mark.
export component AxSeg inherits Rectangle {
    in property <[AxSegItem]> items;
    in property <string> value;
    in property <bool> mono: false;
    in property <bool> small: false;
    callback picked(string);
    property <length> ind-x: 0px;
    property <length> ind-w: 0px;
    property <bool> placed: false;
    height: root.small ? 32px : 36px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.rule-2;
    background: Theme.paper-3;
    indicator := Rectangle {
        x: root.ind-x;
        y: 4px;
        width: root.ind-w;
        height: root.height - 8px;
        visible: root.ind-w > 0;
        border-radius: 7px;
        background: Theme.paper;
        border-width: 1px;
        border-color: Theme.rule;
        drop-shadow-color: Theme.shadow-1;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        animate x { duration: root.placed && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        animate width { duration: root.placed && Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    }
    row := HorizontalLayout {
        padding: 4px;
        spacing: 0px;
        for item in root.items: AxSegButton {
            item: item;
            mono: root.mono;
            small: root.small;
            selected: item.value == root.value;
            init => { if self.selected { root.ind-x = self.x; root.ind-w = self.width; } }
            changed selected => { if self.selected { root.ind-x = self.x; root.ind-w = self.width; root.placed = true; } }
            changed x => { if self.selected { root.ind-x = self.x; } }
            changed width => { if self.selected { root.ind-w = self.width; } }
            clicked => {
                if root.value != item.value {
                    root.placed = true;
                    root.picked(item.value);
                }
            }
        }
    }
}

// A small square info button (24 px) that opens a popover or shows a tip.
export component AxInfo inherits Rectangle {
    in property <bool> open;
    in property <string> tip;
    in property <length> side: 24px;
    in property <length> glyph: 16px;
    callback clicked();
    width: root.side;
    height: root.side;
    border-radius: 6px;
    background: ta.has-hover || root.open ? Theme.paper-3 : Theme.paper-3.with-alpha(0);
    animate background { duration: Motion.tint(Motion.fast); }
    transform-scale: ta.pressed ? 0.94 : 1;
    animate transform-scale { duration: Motion.fast; }
    Icon { x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; name: "info"; width: root.glyph; height: root.glyph; tint: ta.has-hover || root.open ? Theme.ink : Theme.ink-3; }
    ta := AxTip { tip: root.tip; mouse-cursor: pointer; clicked => { Hover.clear(); root.clicked(); } }
}

// ---------------------------------------------------------------- readout card rows
export component AxRoRow inherits HorizontalLayout {
    in property <color> c;
    in property <string> shape: "box";
    in property <string> label;
    in property <string> value;
    in property <bool> dim;
    in property <bool> strong;
    in property <bool> no-swatch;
    spacing: 8px;
    min-height: 19px;
    Rectangle {
        width: 14px;
        if !root.no-swatch: AxSwatch { x: 0px; y: (parent.height - 10px) / 2; c: root.c; shape: root.shape; }
    }
    Text { text: root.label; font-size: 12.5px; color: root.dim ? Theme.ink-3 : Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
    Text {
        text: root.value;
        font-family: Type.tab;
        font-size: 12.5px;
        font-weight: root.strong ? 680 : root.dim ? 500 : 600;
        color: root.dim ? Theme.ink-3 : Theme.ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component AxRoTime inherits Text {
    font-family: Type.mono;
    font-size: 11px;
    color: Theme.ink-3;
    letter-spacing: 0.44px;
    min-height: 17px;
}

// The readout card shell (crosshair readouts): a paper card with the popover shadow.
export component AxRoCard inherits Rectangle {
    background: Theme.paper;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.rule;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    @children
}

// ---------------------------------------------------------------- first view
// A section rises 12 px and fades in once it is first on screen (sections on screen at load follow the
// stagger); `seen` then starts its charts' draw-on, sweeps and count-ups. `scroll` is passed only so the
// on-screen test re-runs while the page scrolls.
export component AxReveal inherits Rectangle {
    in property <bool> armed;
    in property <length> scroll;
    in property <length> view-bottom;
    in property <duration> delay: 0ms;
    // the section was already seen by an earlier instance (the chart grid changed its column count)
    in property <bool> already: false;
    out property <bool> seen: !Motion.on || root.already;
    out property <duration> play-delay: root.already ? 0ms : 160ms;
    property <bool> on-screen: root.armed && root.scroll >= -100000px && self.absolute-position.y < root.view-bottom - 30px;
    property <bool> early: true;
    early-timer := Timer {
        interval: 600ms;
        running: root.armed && root.early;
        triggered => { self.running = false; root.early = false; }
    }
    init => { if root.on-screen { root.start(); } }
    changed on-screen => { if root.on-screen { root.start(); } }
    function start() {
        if root.seen || go.running { return; }
        root.play-delay = root.early ? 160ms : 60ms;
        go.interval = root.early ? max(1ms, root.delay) : 1ms;
        go.running = true;
    }
    go := Timer {
        interval: 1ms;
        running: false;
        triggered => { self.running = false; root.seen = true; }
    }
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    min-width: inner.min-width;
    preferred-width: inner.preferred-width;
    surface := Rectangle {
        x: 0px;
        y: root.seen ? 0px : 12px;
        width: root.width;
        height: root.height;
        opacity: root.seen ? 1 : 0;
        animate y { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: Motion.on ? 460ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        inner := VerticalLayout {
            @children
        }
    }
}
