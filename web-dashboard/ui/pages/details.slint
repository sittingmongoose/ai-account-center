// Details: the content of the right-hand slide-over for one account. Every visible window as a meter,
// balances as amounts, and where the reading came from. Sections stagger in when it opens.
import { Theme, Motion, Type } from "../theme.slint";
import { DetailsView, MeterView, AmountView, FactView, AccountRowView } from "../models.slint";
import { Icon } from "../components/icon.slint";
import { ProviderMark } from "../components/mark.slint";
import { Caps } from "../components/text.slint";
import { Button } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";
import { Meter } from "../components/meter.slint";
import { SwitchSlot, CheckMark, ConfirmBox, AmountLine } from "home.slint";

component Stagger inherits Rectangle {
    in property <int> index;
    in property <bool> run;
    property <bool> shown: !Motion.on;
    min-height: inner.preferred-height;
    preferred-height: inner.preferred-height;
    t := Timer {
        interval: max(1ms, (160 + root.index * 45) * 1ms);
        running: root.run && !root.shown && Motion.on;
        triggered => { self.running = false; root.shown = true; }
    }
    changed run => { if !root.run && Motion.on { root.shown = false; } }
    Rectangle {
        x: root.shown ? 0px : 18px;
        width: root.width;
        height: root.height;
        opacity: root.shown ? 1 : 0;
        animate x { duration: Motion.on ? 460ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate opacity { duration: Motion.on ? 340ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        inner := VerticalLayout { @children }
    }
}

export component DetailsPanel inherits Rectangle {
    in property <DetailsView> data;
    in property <bool> open;
    in property <bool> busy;
    callback close();
    callback launch(string, string);
    callback activate(string, string);
    callback go-accounts();

    // the inline confirmation before activating an account past its switch point
    property <bool> confirming: false;
    property <string> shown-id: root.data.id;
    changed shown-id => { root.confirming = false; }
    changed open => { if !root.open { root.confirming = false; } }

    head := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: head-row.preferred-height;
        head-row := HorizontalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 14px;
            VerticalLayout {
                alignment: start;
                padding-top: 2px;
                ProviderMark { provider: root.data.provider; size: 32px; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                Text { text: root.data.title; font-size: 18px; font-weight: 640; letter-spacing: -0.18px; color: Theme.ink; overflow: elide; }
                // "Codex · Pro · Active on Ubuntu", the active state with the same check-circle the rows use
                HorizontalLayout {
                    spacing: 0px;
                    alignment: start;
                    Text {
                        text: root.data.sub-lead != "" ? root.data.sub-lead + " · " : "";
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        vertical-alignment: center;
                    }
                    if root.data.switchable && root.data.active: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            CheckMark { size: 14px; drawn: root.data.active; }
                        }
                        Text {
                            text: "Active " + root.data.active-label;
                            font-size: 12.5px;
                            font-weight: 640;
                            color: Theme.accent-text;
                            vertical-alignment: center;
                        }
                    }
                    if !(root.data.switchable && root.data.active): Text {
                        text: root.data.state;
                        font-size: 12.5px;
                        color: Theme.ink-3;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton { icon: "close"; hint: "Close"; clicked => { root.close(); } }
            }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.rule-2; }
    }
    scroll := Flickable {
        x: 0px;
        y: head.height;
        width: root.width;
        height: root.height - head.height;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: scroll.width;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 8px;
            padding-bottom: 30px;
            spacing: 0px;
            Stagger {
                index: 0;
                run: root.open;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    Caps { text: "USAGE WINDOWS · " + root.data.meter-count; }
                    for m[i] in root.data.meters: Meter {
                        data: m;
                        show-label: true;
                        played: root.open;
                        delay: (240 + i * 40) * 1ms;
                        owner-label: root.data.title;
                    }
                    if root.data.meter-count == 0: Text {
                        text: "No usage windows reported yet.";
                        font-size: 12.5px;
                        color: Theme.ink-3;
                    }
                    if root.data.note != "": HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout { alignment: start; padding-top: 2px; Icon { name: "clock"; tint: Theme.ink-3; width: 15px; height: 15px; } }
                        Text { text: root.data.note; font-size: 12.5px; color: Theme.ink-3; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }
            }
            if root.data.amount-count > 0: Rectangle { height: 1px; background: Theme.rule-2; }
            if root.data.amount-count > 0: Stagger {
                index: 1;
                run: root.open;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 0px;
                    Caps { text: "BALANCES, PACKS AND CREDITS · " + root.data.amount-count; }
                    Rectangle { height: 8px; }
                    for a[k] in root.data.amounts: AmountLine { amount: a; rule-above: k > 0; }
                }
            }
            Rectangle { height: 1px; background: Theme.rule-2; }
            Stagger {
                index: 2;
                run: root.open;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 8px;
                    Caps { text: "READING"; }
                    for f in root.data.facts: HorizontalLayout {
                        spacing: 12px;
                        Text { text: f.label; width: 110px; min-height: 19px; font-size: 13px; color: Theme.ink-3; }
                        Text {
                            min-height: 19px;
                            text: f.value;
                            font-family: f.mono ? Type.mono : Type.tab;
                            font-size: f.mono ? 12px : 13px;
                            color: Theme.ink;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.rule-2; }
            Stagger {
                index: 3;
                run: root.open;
                // the actions wrap onto a second line instead of eliding their labels
                FlexboxLayout {
                    padding-top: 16px;
                    spacing-horizontal: 8px;
                    spacing-vertical: 8px;
                    alignment: start;
                    if root.data.provider == "claude": Button {
                        small: true;
                        platform: "apple";
                        text: "Open on Mac";
                        enabled: root.data.can-mac && !root.busy;
                        clicked => { root.launch(root.data.profile, "mac"); }
                    }
                    if root.data.provider == "claude": Button {
                        small: true;
                        platform: "windows";
                        text: "Open on Windows";
                        enabled: root.data.can-windows && !root.busy;
                        clicked => { root.launch(root.data.profile, "windows"); }
                    }
                    // the row's action slot: Activate with the plain "Active" mark stacked on it, so a switch
                    // while Details is open crossfades in place and the check draws in
                    if root.data.switchable && (root.data.can-switch || root.data.active): SwitchSlot {
                        account: {
                            id: root.data.id,
                            active: root.data.active,
                            active-label: root.data.active-label,
                            platform: root.data.platform,
                            can-activate: root.data.can-activate,
                            activate-hint: root.data.activate-hint,
                        };
                        can-switch: root.data.can-switch;
                        busy: root.busy;
                        activate => {
                            if root.data.confirm {
                                root.confirming = true;
                            } else {
                                root.activate(root.data.activate-kind, root.data.profile);
                            }
                        }
                    }
                    Button { small: true; kind: "ghost"; text: "Manage in Accounts & Settings"; clicked => { root.go-accounts(); } }
                }
            }
            if root.data.confirm: ConfirmBox {
                runs: root.data.confirm-runs;
                open: root.confirming;
                busy: root.busy;
                keep => { root.confirming = false; }
                confirm => {
                    root.confirming = false;
                    root.activate(root.data.activate-kind, root.data.profile);
                }
            }
        }
    }
}
