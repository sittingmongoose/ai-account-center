// The sign-in page: the real login screen, a full-window gate above the dashboard, built like the concept
// (c-daylight-atlas/app-auth.js and auth.css). States: loading, default, connecting, wrong (inline, no layout
// jump: the message slot keeps its height), limited (rate limited, with a countdown and a draining bar),
// expired (the session ended), setup (first run: the form when the server can create the sign-in, otherwise
// the command that does it on the server), success (the button turns into a check and the page cross-fades
// into the dashboard load-in), offline (DESIGN-MOBILE.md 4.6: /api was unreachable at launch). Every word
// comes from bridge.js (public/auth-view.mjs).
//
// Tiers (DESIGN-MOBILE.md 4.5.1): on T and D the card sits beside the atlas motif as before (T with 48 px
// inputs). On P and F the page is one scrolled column: brand row, the card (max 440, centred, with a 4 px
// scale bar that carries the connecting, rate-limited and success states), then the footer lines; the motif
// is hidden. Short (landscape phones, Duo outer landscape): two columns, brand/title/host/note on the left
// and a 360 px card on the right, scrolling when they do not fit. A strip of the page background is painted
// over the safe-top inset on every tier, so scrolled content never runs under the status bar text.
//
// Keyboard (4.5.2, 2.5): while a field has the keyboard, the page scrolls so the Sign in button's bottom
// sits 12 px above the keyboard, never pushing the focused field's top above safe-top + 8; it never scrolls
// back on blur. The HTML inputs follow their Slint boxes on every frame (login-bridge.mjs), and a box
// scrolled under the strip or off screen reports its input hidden (visibility, not removal).
//
// The atlas motif: contour lines of one summit with the Apex mark at the top and a map scale bar; the rings
// grow from the summit on entry, the scale bar sweeps while connecting and fills on success, and the rings dim
// while sign-in is paused. Only opacity, scale and one clip width move; nothing loops while idle.
import { Theme, Motion, Type, Breakpoints, Device } from "../theme.slint";
import { AuthView, StrengthView, LoginBox, LoginOverlay } from "../models.slint";
import { Icon } from "../components/icon.slint";
import { AppLogo } from "../components/logo.slint";
import { Field } from "../components/field.slint";
import { Reveal } from "../components/reveal.slint";
import { ProbeMark } from "../components/probe.slint";

// The first-run form's confirmation and setup code (public/login-bridge.mjs place): the HTML inputs hold
// them while they are on screen, lib.rs set_login_setup copies them here, and the Slint fields mirror them
// whenever the inputs are hidden.
export global LoginExtra {
    in-out property <string> confirm;
    in-out property <string> code;
}

// File-internal seam between the sign-in layer and its scrolled hosts: the last overlay report (window
// geometry), the live scroll offset of the page's Flickable, its scrollable range, and whether the card's
// load-in has settled. The layer computes the keyboard scroll (4.5.2) from these.
global SigninScroll {
    in-out property <LoginOverlay> report;
    in-out property <length> current: 0px;
    in-out property <length> max-scroll: 0px;
    in-out property <bool> ready: false;
}

struct Ring { d: string, idx: bool, label: string, lx: float, ly: float }

component Motif inherits Rectangle {
    in property <bool> run;
    in property <bool> success;
    in property <bool> connecting;
    in property <bool> paused;
    property <[Ring]> rings: [
        { d: "M365 97.4C389.5 111.9 412.9 155.2 435.2 185.3C457.5 215.4 478.6 248.5 498.8 278.1C519 307.8 550.1 337.4 556.3 363.1C562.5 388.8 562.9 421.5 535.8 432.2C508.8 442.9 439.9 429.9 394.1 427.6C348.3 425.2 303.5 421.2 261.1 418.3C218.7 415.5 171.3 417.2 139.5 410.4C107.7 403.6 67.9 399.6 70.2 377.5C72.4 355.5 127.8 309.9 153 278.2C178.2 246.6 199 217.6 221.6 187.6C244.1 157.7 264.3 113.6 288.2 98.6C312.1 83.5 340.5 83 365 97.4Z", idx: true, label: "", lx: 0, ly: 0 },
        { d: "M363.8 109.9C386.1 123 408.3 162.2 428 189.3C447.7 216.5 463.3 245.6 481.9 272.8C500.6 300 534.1 329.6 539.8 352.5C545.5 375.5 541 401.6 516 410.6C490.9 419.5 430.1 408.5 389.5 406.1C348.8 403.7 310.9 397.6 271.9 396.2C232.9 394.7 184.4 402.7 155.2 397.3C126 391.9 93.8 384.4 96.8 363.8C99.8 343.2 150.2 302.1 173.2 273.5C196.3 244.9 215 219.3 235.1 192.2C255.3 165.1 272.7 124.6 294.1 110.9C315.6 97.2 341.4 96.8 363.8 109.9Z", idx: false, label: "", lx: 0, ly: 0 },
        { d: "M362.6 122C382.6 133.7 402.9 169.6 420 193.9C437.1 218.1 448.3 243.1 465.2 267.6C482.1 292.1 516.3 320.5 521.4 340.7C526.5 360.9 518.5 381 495.8 388.6C473.1 396.1 420.8 387.8 385.1 385.8C349.4 383.8 317.2 376.9 281.5 376.6C245.7 376.3 196.7 388.8 170.8 384.2C144.9 379.5 122.1 368 126 348.7C129.8 329.5 173.4 294 193.9 268.7C214.5 243.4 231.7 221.3 249.3 197.1C267 172.8 281.1 135.8 300 123.2C318.9 110.7 342.6 110.2 362.6 122Z", idx: true, label: "25", lx: 276.7, ly: 390.2 },
        { d: "M361.4 134.5C378.9 145.1 396.4 177.5 411 198.9C425.6 220.2 434.1 241 449.2 262.5C464.3 284.1 497.3 310.6 501.8 328.2C506.4 345.7 496.8 361.3 476.6 367.7C456.5 374.1 412 368.1 381 366.6C349.9 365.1 322.3 358.2 290.2 358.7C258.2 359.1 210.8 373.5 188.7 369.2C166.5 364.8 152.9 350.1 157.3 332.6C161.6 315 197.3 285.6 214.9 263.8C232.6 242 248.1 223.2 263.2 201.8C278.4 180.4 289.4 146.5 305.8 135.3C322.1 124.1 343.8 123.9 361.4 134.5Z", idx: false, label: "", lx: 0, ly: 0 },
        { d: "M360.1 147.9C375.1 157.3 389.2 185.8 401.6 204.2C414 222.5 421.1 239.4 434.4 257.9C447.8 276.4 477.9 300.3 481.9 315.4C485.9 330.4 476.2 342.8 458.7 348.2C441.2 353.5 403.5 348.7 376.9 347.5C350.2 346.4 326.6 340.5 298.7 341.2C270.9 341.9 227.9 355.7 209.6 351.6C191.3 347.4 184.6 331.7 188.9 316.2C193.2 300.8 220.9 277.4 235.5 259.1C250 240.7 263.4 224.8 276.1 206.2C288.8 187.6 297.6 157.1 311.6 147.4C325.6 137.7 345.1 138.4 360.1 147.9Z", idx: true, label: "50", lx: 294.5, ly: 353.7 },
        { d: "M358.7 161.9C371.2 170.1 381.9 194.1 392.3 209.4C402.7 224.7 409.4 238.2 421 253.7C432.5 269.2 458.2 289.8 461.6 302.3C465 314.9 456.1 325 441.3 329.2C426.4 333.5 395 328.9 372.6 327.9C350.3 327 330.6 322.9 307.3 323.6C284 324.2 247.6 335.8 232.9 332C218.2 328.2 215.4 313.6 219.1 300.7C222.8 287.7 243.6 269.6 255.1 254.5C266.6 239.4 277.7 226 288.1 210.3C298.6 194.6 306 168.3 317.7 160.3C329.5 152.2 346.3 153.7 358.7 161.9Z", idx: false, label: "", lx: 0, ly: 0 },
        { d: "M357.4 176C367.2 182.7 375.1 202 383.5 214.3C392 226.6 398.7 237.2 408.2 249.7C417.7 262.1 438 278.8 440.6 288.8C443.1 298.9 435.7 306.8 423.6 310C411.6 313.2 386.2 308.5 368.3 307.8C350.4 307.1 334.6 305.1 316 305.7C297.5 306.4 268.6 314.9 257.1 311.6C245.7 308.4 244.3 296.4 247.1 286.2C249.9 275.9 265.4 262 274.2 250.1C283 238.1 291.7 227 300 214.3C308.4 201.7 314.8 180.6 324.4 174.2C333.9 167.8 347.5 169.3 357.4 176Z", idx: true, label: "75", lx: 311.7, ly: 318.4 },
        { d: "M356 190C363.4 195 368.8 209.6 375.3 218.9C381.9 228.2 388 236.3 395.2 245.6C402.4 254.9 416.9 267.3 418.6 274.8C420.4 282.2 414.7 288.2 405.6 290.4C396.5 292.5 377.5 288.3 364 287.9C350.6 287.5 338.5 287.3 324.7 287.9C311 288.4 289.9 293.9 281.3 291.3C272.8 288.8 271.5 280.1 273.5 272.5C275.5 264.9 286.8 254.6 293.3 245.6C299.8 236.6 306 228 312.3 218.5C318.7 209 324.1 193.6 331.4 188.9C338.7 184.1 348.7 185 356 190Z", idx: false, label: "", lx: 0, ly: 0 },
        { d: "M354.7 204C359.5 207.2 363 217.1 367.5 223.3C371.9 229.5 376.7 235.1 381.4 241.3C386.2 247.4 395.2 255.5 396.2 260.4C397.2 265.2 393.5 269.2 387.4 270.6C381.4 272 368.9 268.8 359.9 268.7C350.9 268.6 342.7 269.4 333.5 269.8C324.4 270.3 310.9 273.1 305.2 271.3C299.5 269.5 298.2 264.2 299.5 259.1C300.7 254.1 308.4 247.2 312.7 241.1C317 235.1 320.9 229.1 325.2 222.9C329.5 216.7 333.6 206.9 338.5 203.7C343.4 200.6 349.9 200.7 354.7 204Z", idx: true, label: "", lx: 0, ly: 0 }
    ];
    // the 640 x 560 drawing scaled to fit, centred
    property <float> k: min(root.width / 640px, root.height / 560px);
    property <length> ox: (root.width - 640px * root.k) / 2;
    property <length> oy: (root.height - 560px * root.k) / 2;
    property <color> apex-a: #2F6BFF;
    property <color> apex-b: #1FC6EE;
    // The connecting sweep outlives `connecting` by its fade, and `sweep-t` freezes at the phase the sweep
    // had reached when the request ended, so the segment fades out where it is instead of being removed in
    // one frame (which reads as the bar snapping back to 0).
    property <bool> sweeping: false;
    property <duration> sweep-end: 0ms;
    property <float> sweep-t: !Motion.on ? 0.6 : root.connecting ? mod(animation-tick() / 1100ms, 1) : mod(root.sweep-end / 1100ms, 1);
    changed connecting => {
        if root.connecting { root.sweeping = true; }
        else if root.sweeping { root.sweep-end = animation-tick(); sweep-hold.running = true; }
    }
    sweep-hold := Timer {
        interval: 320ms;
        running: false;
        triggered => { self.running = false; root.sweeping = false; }
    }
    rings-layer := Rectangle {
        opacity: root.paused ? 0.55 : 1;
        animate opacity { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        for ring[i] in root.rings: Rectangle {
            property <bool> shown: !Motion.on;
            Timer {
                interval: ((root.rings.length - 1 - i) * 55 + 160) * 1ms;
                running: root.run && !parent.shown && Motion.on;
                triggered => { self.running = false; parent.shown = true; }
            }
            x: root.ox;
            y: root.oy;
            width: 640px * root.k;
            height: 560px * root.k;
            opacity: self.shown ? 1 : 0;
            transform-scale: self.shown ? 1 : 0.94;
            transform-origin: { x: 352px * root.k, y: 232px * root.k };
            animate opacity { duration: Motion.on ? 520ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
            animate transform-scale { duration: Motion.on ? 900ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 640;
                viewbox-height: 560;
                commands: ring.d;
                fill: transparent;
                stroke: root.success ? (ring.idx ? Theme.accent.mix(Theme.rule-strong, 0.52) : Theme.accent.mix(Theme.grid-strong, 0.3)) : (ring.idx ? Theme.rule-strong : Theme.grid-strong);
                stroke-width: ring.idx ? 1.35px : 1px;
                animate stroke { duration: Motion.tint(Motion.slow); }
            }
            // the concept's SVG labels are 11 units in a 640 x 560 viewbox, so they scale with the map (never
            // below 11 px); the baseline sits 3.8 units below the label point (Martian Mono's ascent is 1 em)
            if ring.label != "": Text {
                x: ring.lx * root.k * 1px - self.preferred-width / 2;
                y: (ring.ly + 3.8) * root.k * 1px - self.font-size;
                text: ring.label;
                font-family: Type.mono;
                font-size: max(Type.caption, 11px * root.k);
                color: Theme.ink-4;
            }
        }
    }
    summit := Rectangle {
        property <bool> shown: !Motion.on;
        Timer {
            interval: 620ms;
            running: root.run && !parent.shown && Motion.on;
            triggered => { self.running = false; parent.shown = true; }
        }
        x: root.ox + (352px - 21px) * root.k;
        y: root.oy + (232px - 22px) * root.k;
        width: 42px * root.k;
        height: 42px * root.k;
        opacity: self.shown ? 1 : 0;
        transform-scale: !self.shown ? 0.6 : root.success ? 1.08 : 1;
        animate opacity { duration: Motion.on ? 260ms : 0ms; }
        animate transform-scale { duration: Motion.on ? 520ms : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
        AppLogo { size: parent.width; }
    }
    // scale bar: four alternating 64-unit segments, labelled 0..100; it sweeps while connecting and fills with
    // the Apex ramp on success
    scalebar := Rectangle {
        x: root.ox + 52px * root.k;
        y: root.oy + 498px * root.k;
        width: 256px * root.k;
        height: 7px * root.k;
        border-width: 1px;
        border-color: Theme.rule-strong;
        background: Theme.paper;
        property <bool> filled: !Motion.on;
        Timer {
            interval: 760ms;
            running: root.run && !parent.filled && Motion.on;
            triggered => { self.running = false; parent.filled = true; }
        }
        Rectangle {
            x: 0px;
            width: scalebar.filled ? parent.width : 0px;
            clip: true;
            animate width { duration: Motion.on ? 900ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            for k in 4: Rectangle {
                x: k * scalebar.width / 4;
                width: scalebar.width / 4;
                height: scalebar.height;
                background: mod(k, 2) == 0 ? Theme.ink-3 : Theme.paper;
                border-width: 1px;
                border-color: mod(k, 2) == 0 ? Theme.ink-3 : Theme.rule-strong;
            }
        }
        // success: the Apex ramp fills the bar left to right
        Rectangle {
            x: 0px;
            width: root.success ? parent.width : 0px;
            animate width { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            background: @linear-gradient(90deg, root.apex-a 0%, root.apex-b 100%);
        }
        // connecting: one bright segment travels along the bar (a loop only while the request runs), then
        // freezes and fades out where it ended
        Rectangle {
            x: 0px;
            width: parent.width;
            clip: true;
            opacity: root.connecting ? 1 : 0;
            animate opacity { duration: Motion.on ? Motion.med : 0ms; }
            if root.sweeping: Rectangle {
                x: (-72 + root.sweep-t * (256 + 72)) * root.k * 1px;
                width: 72px * root.k;
                background: @linear-gradient(90deg, root.apex-a.with-alpha(0) 0%, root.apex-a.with-alpha(0.85) 60%, root.apex-b 100%);
            }
        }
        // baselines 24 viewbox units below the bar's top, like the concept's scale labels
        for k in 5: Text {
            x: k * scalebar.width / 4 - self.preferred-width / 2;
            y: 24px * root.k - self.font-size;
            text: k * 25;
            font-family: Type.mono;
            font-size: max(Type.caption, 11px * root.k);
            color: Theme.ink-3;
        }
    }
    // map crop marks in the corners
    for c in 4: Rectangle {
        x: mod(c, 2) == 0 ? root.ox + 8px * root.k : root.ox + (640px - 22px) * root.k;
        y: c < 2 ? root.oy + 8px * root.k : root.oy + (560px - 22px) * root.k;
        width: 14px * root.k;
        height: 14px * root.k;
        Rectangle { x: mod(c, 2) == 0 ? 0px : parent.width - 1.25px; width: 1.25px; height: parent.height; background: Theme.ink-4; }
        Rectangle { y: c < 2 ? 0px : parent.height - 1.25px; height: 1.25px; width: parent.width; background: Theme.ink-4; }
    }
}

// The faint cartographic grid behind the page: 24 px minor and 96 px major lines (the dashboard's PaperGrid).
component SignInGrid inherits Rectangle {
    property <int> cols: ceil(root.width / 24px) + 1;
    property <int> rows: ceil(root.height / 24px) + 1;
    for i in root.cols: Rectangle {
        x: i * 24px;
        width: 1px;
        height: root.height;
        background: mod(i, 4) == 0 ? Theme.paper-grid-major : Theme.paper-grid-minor;
    }
    for j in root.rows: Rectangle {
        y: j * 24px;
        width: root.width;
        height: 1px;
        background: mod(j, 4) == 0 ? Theme.paper-grid-major : Theme.paper-grid-minor;
    }
}

// The password strength meter of the first-run form: one bar with quarter ticks; the fill eases to its width
// (never past it) and takes the severity colour of its level.
export component StrengthMeter inherits VerticalLayout {
    in property <StrengthView> data;
    spacing: 6px;
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        clip: true;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.data.pct, 0, 100) / 100;
            border-radius: 3px;
            background: root.data.lv >= 4 ? @linear-gradient(90deg, Theme.calm-a 0%, Theme.calm 100%)
                : root.data.lv == 3 ? @linear-gradient(90deg, Theme.warn-a 0%, Theme.warn 100%)
                : @linear-gradient(90deg, Theme.crit-a 0%, Theme.crit 100%);
            animate width { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        }
        for t in 3: Rectangle { x: (t + 1) * parent.width / 4; y: 1px; width: 1px; height: 4px; background: Theme.track-tick; }
    }
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.data.hint; font-size: Type.small; color: Theme.ink-3; overflow: elide; horizontal-stretch: 1; }
        Text {
            text: root.data.word;
            font-size: 12.5px;
            font-weight: 640;
            color: root.data.lv >= 4 ? Theme.good-text : root.data.lv == 3 ? Theme.warn-text : root.data.lv > 0 ? Theme.crit-text : Theme.ink-3;
            horizontal-stretch: 0;
        }
    }
}

// The in-card scale bar of the mobile tiers (4.5.1): 4 px of track that carries the states the motif's map
// bar carries on the desktop - it sweeps while connecting, drains while sign-in is paused, and fills with the
// Apex ramp on success.
component CardScale inherits Rectangle {
    in property <bool> connecting;
    in property <bool> signed-in;
    in property <bool> paused;
    in property <int> left;
    in property <int> total;
    height: 4px;
    border-radius: 2px;
    background: Theme.track;
    clip: true;
    property <color> apex-a: #2F6BFF;
    property <color> apex-b: #1FC6EE;
    property <bool> sweeping: false;
    property <duration> sweep-end: 0ms;
    property <float> sweep-t: !Motion.on ? 0.6 : root.connecting ? mod(animation-tick() / 1100ms, 1) : mod(root.sweep-end / 1100ms, 1);
    changed connecting => {
        if root.connecting { root.sweeping = true; }
        else if root.sweeping { root.sweep-end = animation-tick(); sweep-hold.running = true; }
    }
    sweep-hold := Timer {
        interval: 320ms;
        running: false;
        triggered => { self.running = false; root.sweeping = false; }
    }
    // rate limited: the bar drains with the countdown
    Rectangle {
        x: 0px;
        width: root.paused ? parent.width * clamp(root.left / max(1, root.total), 0, 1) : 0px;
        border-radius: 2px;
        background: @linear-gradient(90deg, Theme.warn-a 0%, Theme.warn 100%);
        animate width { duration: Motion.on ? 1000ms : 0ms; easing: linear; }
    }
    // success: the Apex ramp fills the bar
    Rectangle {
        x: 0px;
        width: root.signed-in ? parent.width : 0px;
        animate width { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        background: @linear-gradient(90deg, root.apex-a 0%, root.apex-b 100%);
    }
    // connecting: one bright segment travels along the bar, then freezes and fades where it ended
    Rectangle {
        x: 0px;
        width: parent.width;
        clip: true;
        opacity: root.connecting ? 1 : 0;
        animate opacity { duration: Motion.on ? Motion.med : 0ms; }
        if root.sweeping: Rectangle {
            x: (root.sweep-t - 0.22) * parent.width;
            width: parent.width * 0.28;
            background: @linear-gradient(90deg, root.apex-a.with-alpha(0) 0%, root.apex-a.with-alpha(0.85) 60%, root.apex-b 100%);
        }
    }
}

// The sign-in card of the phone and foldable tiers (4.5.1) and of the short two-column layout: the banner,
// the fields, the message slot, Remember me, the submit button and the scale bar. The login fields are the
// real HTML inputs' hosts (index.html #aac-login): their geometry goes out through `login-overlay-report`
// whenever the layout moves them, so the inputs follow on every frame.
component TouchCard inherits Rectangle {
    in property <AuthView> auth;
    in property <StrengthView> strength;
    in property <bool> busy;
    in property <bool> signed-in;
    in property <bool> connecting;
    in property <bool> can-submit;
    in property <bool> form;
    in property <bool> setup;
    in property <bool> limited;
    in property <bool> wrong;
    in property <bool> expired;
    in property <bool> has-banner;
    in property <bool> overlay-on;
    in property <string> login-focus;
    in property <string> login-hover;
    in property <length> band-top: 0px;
    in property <length> login-size: 17px;
    in property <bool> with-title: true;
    in property <bool> with-note: true;
    in property <bool> leaving: false;
    in property <int> left: 0;
    in property <int> limit-total: 1;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> remember-me: true;
    callback login-overlay-report(LoginOverlay);
    callback fire-submit(string, string, bool);
    callback fire-create(string, string, string, string);
    callback fire-recheck();
    callback fire-focus(string);

    property <string> state: root.auth.state;
    property <bool> can-type: root.can-submit || root.wrong;
    property <int> nonce: root.auth.nonce;
    property <bool> shaking: false;
    property <duration> shake-start: 0ms;
    changed nonce => {
        if Motion.on {
            root.shake-start = animation-tick();
            root.shaking = true;
            shake-end.running = true;
        }
    }
    shake-end := Timer { interval: 460ms; running: false; triggered => { self.running = false; root.shaking = false; } }
    property <float> shake-p: root.shaking ? clamp((animation-tick() - root.shake-start) / 440ms, 0, 1) : 1;
    // a wrong password shakes the fields: a short decaying sideways oscillation, like the desktop page
    property <length> shake-x: root.shaking ? 7px * pow(1 - root.shake-p, 2) * sin(root.shake-p * 4 * 360deg) : 0px;

    // the fields' boxes, copied out of the conditional form below whenever the layout moves them (the
    // keyboard scroll, a resize, a banner opening, the wrong-password shake)
    property <LoginBox> user-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> user-text-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> pass-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> pass-text-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> confirm-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> confirm-text-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> code-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> code-text-box: { x: 0px, y: 0px, width: 0px, height: 0px };
    property <LoginBox> check-box: { x: 0px, y: 0px, width: 0px, height: 0px };

    // the HTML inputs' geometry, published on every layout change (login-bridge.mjs place)
    property <bool> inputs-on: root.overlay-on && root.form;
    property <LoginOverlay> report: {
        on: root.inputs-on,
        enabled: root.can-type,
        mode: root.setup ? "setup" : "login",
        revealed: pass-plain,
        remember: root.remember-me,
        user-visible: self.box-in-band(root.user-box),
        pass-visible: self.box-in-band(root.pass-box),
        confirm-visible: self.box-in-band(root.confirm-box),
        code-visible: self.box-in-band(root.code-box),
        user: root.user-box,
        user-text: root.user-text-box,
        pass: root.pass-box,
        pass-text: root.pass-text-box,
        confirm: root.confirm-box,
        confirm-text: root.confirm-text-box,
        code: root.code-box,
        code-text: root.code-text-box,
        check: root.check-box,
        submit: { x: submit-btn.absolute-position.x, y: submit-btn.absolute-position.y, width: submit-btn.width, height: submit-btn.height },
        font-size: root.login-size,
        ink: Theme.ink.with-alpha(root.can-type ? 1 : 0.72),
        placeholder: Theme.ink-4,
        selection: Theme.accent.with-alpha(0.25),
        accent: Theme.accent,
    };
    property <bool> pass-plain: false;
    changed report => { root.login-overlay-report(self.report); }
    init => { root.login-overlay-report(self.report); }
    // A field whose box starts under the safe-top strip hides its HTML input (visibility, not removal):
    // the strip would paint over the box but the input floats above the canvas. Fields further down the page
    // stay live even below the fold or under the keyboard, so Return-next can reach them and the keyboard
    // scroll then brings them into view; they sit off screen, so nothing paints wrongly.
    pure function box-in-band(box: LoginBox) -> bool {
        return box.height <= 0px || box.y >= root.band-top - 0.5px;
    }

    function go() {
        if !root.can-submit { return; }
        if root.setup {
            root.fire-create(root.username, root.password, LoginExtra.confirm, LoginExtra.code);
        } else {
            root.fire-submit(root.username, root.password, root.remember-me);
        }
    }

    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.paper;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 12px;
    transform-scale: root.leaving ? 0.99 : 1;
    animate transform-scale { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    body := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 0px;
        if root.with-title: Text {
            text: root.signed-in ? "Signed in" : root.setup ? "Set up sign-in" : root.expired ? "Sign in again" : "Sign in";
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.6px;
            color: Theme.ink;
        }
        if root.with-title: Rectangle { height: 4px; }
        if root.with-title: HorizontalLayout {
            spacing: 0px;
            alignment: start;
            Text { text: root.signed-in ? "Opening your dashboard." : root.auth.host == "" ? "Your accounts and subscription usage" : "Dashboard on "; font-size: 14px; color: Theme.ink-3; }
            if root.auth.host != "" && !root.signed-in: Text { text: root.auth.host; font-family: Type.tab; font-size: 14px; font-weight: 580; color: Theme.ink-2; overflow: elide; }
        }
        if root.with-title: Rectangle { height: 12px; }

        // the scale bar keeps its states on the tiers without the motif (4.5.1)
        CardScale {
            connecting: root.connecting;
            signed-in: root.signed-in;
            paused: root.limited;
            left: root.left;
            total: root.limit-total;
        }
        Rectangle { height: 16px; }

        // the banner: session ended, rate limited, or set up on the server (no tinted box, no side bar)
        banner-box := Rectangle {
            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: root.has-banner ? "signin-banner" : ""; }
            property <length> natural: banner.preferred-height;
            height: root.has-banner ? self.natural : 0px;
            animate height { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
            clip: true;
            banner := VerticalLayout {
                y: 0px;
                height: banner-box.natural;
                spacing: 0px;
                opacity: root.has-banner ? 1 : 0;
                animate opacity { duration: Motion.on ? Motion.med : 0ms; delay: Motion.on && root.has-banner ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                HorizontalLayout {
                    spacing: 12px;
                    padding-top: 2px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 1px;
                        horizontal-stretch: 0;
                        Icon {
                            name: root.limited ? "timer" : root.setup ? "terminal" : "logout";
                            tint: root.limited ? Theme.warn-text : Theme.accent-text;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: root.auth.banner-title; font-size: 14px; font-weight: 640; color: Theme.ink; wrap: word-wrap; }
                        StyledText {
                            text: root.auth.banner-strong != ""
                                ? @markdown("\{root.auth.banner-body} **\{root.auth.banner-strong}**.")
                                : @markdown("\{root.auth.banner-body}");
                            default-color: Theme.ink-2;
                            default-font-size: 13px;
                            default-font-family: Type.tab;
                        }
                    }
                    // the desktop banner's countdown column and drain bar are dropped below D: the countdown
                    // sits under the button and the scale bar drains (4.5.4)
                }
                Rectangle { height: 16px; }
            }
        }

        // the fields (hidden while the server has to set sign-in up itself)
        if root.form: Rectangle {
          min-height: fields.preferred-height;
          preferred-height: fields.preferred-height;
          // the login fields' boxes, handed to the root for the HTML inputs laid over them
          property <LoginBox> user-at: { x: user.box-x, y: user.box-y, width: user.box-width, height: user.box-h };
          property <LoginBox> user-text-at: { x: user.text-x, y: user.text-y, width: user.text-width, height: user.text-height };
          property <LoginBox> pass-at: { x: pass.box-x, y: pass.box-y, width: pass.box-width, height: pass.box-h };
          property <LoginBox> pass-text-at: { x: pass.text-x, y: pass.text-y, width: pass.text-width, height: pass.text-height };
          property <bool> usable: user.enabled;
          property <bool> plain: pass.plain;
          function publish() {
              root.user-box = self.user-at;
              root.user-text-box = self.user-text-at;
              root.pass-box = self.pass-at;
              root.pass-text-box = self.pass-text-at;
              root.pass-plain = self.plain;
          }
          init => { self.publish(); }
          changed user-at => { self.publish(); }
          changed user-text-at => { self.publish(); }
          changed pass-at => { self.publish(); }
          changed pass-text-at => { self.publish(); }
          changed usable => { self.publish(); }
          changed plain => { self.publish(); }
          fields := VerticalLayout {
            x: root.shake-x;
            width: parent.width;
            height: parent.height;
            spacing: 12px;
            Rectangle {
                min-height: user.preferred-height;
                user := Field {
                    width: parent.width;
                    label: "Username";
                    aside: root.setup ? "letters, numbers, - and _" : "";
                    text <=> root.username;
                    enabled: root.can-type;
                    bad: root.setup && root.auth.field == "user";
                    box-height: 52px;
                    mirror: true;
                    covered: root.overlay-on;
                    text-size: root.login-size;
                    ext-focus: root.overlay-on && root.login-focus == "user";
                    ext-hover: root.overlay-on && root.login-hover == "user";
                    focus-request => { root.fire-focus("user"); }
                }
                ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-user"; }
            }
            Rectangle {
                min-height: pass.preferred-height;
                pass := Field {
                    width: parent.width;
                    label: "Password";
                    password: true;
                    text <=> root.password;
                    enabled: root.can-type;
                    bad: root.wrong || (root.setup && root.auth.field == "pass");
                    box-height: 52px;
                    mirror: true;
                    covered: root.overlay-on;
                    text-size: root.login-size;
                    ext-focus: root.overlay-on && root.login-focus == "pass";
                    ext-hover: root.overlay-on && root.login-hover == "pass";
                    focus-request => { root.fire-focus("pass"); }
                }
                ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-pass"; }
            }
            if root.setup: StrengthMeter { data: root.strength; }
            if root.setup: Rectangle {
              min-height: confirm-field.preferred-height;
              property <LoginBox> confirm-at: { x: confirm-field.box-x, y: confirm-field.box-y, width: confirm-field.box-width, height: confirm-field.box-h };
              property <LoginBox> confirm-text-at: { x: confirm-field.text-x, y: confirm-field.text-y, width: confirm-field.text-width, height: confirm-field.text-height };
              init => { root.confirm-box = self.confirm-at; root.confirm-text-box = self.confirm-text-at; }
              changed confirm-at => { root.confirm-box = self.confirm-at; root.confirm-text-box = self.confirm-text-at; }
              changed confirm-text-at => { root.confirm-box = self.confirm-at; root.confirm-text-box = self.confirm-text-at; }
              ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-confirm"; }
              confirm-field := Field {
                width: parent.width;
                label: "Confirm password";
                password: true;
                aside: root.strength.matches ? "Matches" : "";
                aside-good: root.strength.matches;
                ok: root.strength.matches;
                text <=> LoginExtra.confirm;
                enabled: root.can-submit;
                bad: root.auth.field == "confirm";
                box-height: 52px;
                mirror: true;
                covered: root.overlay-on;
                text-size: root.login-size;
                ext-focus: root.overlay-on && root.login-focus == "confirm";
                ext-hover: root.overlay-on && root.login-hover == "confirm";
                focus-request => { root.fire-focus("confirm"); }
              }
            }
            if root.setup && root.auth.code-required: Rectangle {
              min-height: code-field.preferred-height;
              property <LoginBox> code-at: { x: code-field.box-x, y: code-field.box-y, width: code-field.box-width, height: code-field.box-h };
              property <LoginBox> code-text-at: { x: code-field.text-x, y: code-field.text-y, width: code-field.text-width, height: code-field.text-height };
              init => { root.code-box = self.code-at; root.code-text-box = self.code-text-at; }
              changed code-at => { root.code-box = self.code-at; root.code-text-box = self.code-text-at; }
              changed code-text-at => { root.code-box = self.code-at; root.code-text-box = self.code-text-at; }
              ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-code"; }
              code-field := Field {
                width: parent.width;
                label: "Setup code";
                aside: "printed in the server's terminal";
                placeholder: "e.g. EXAM-PLE0";
                text <=> LoginExtra.code;
                enabled: root.can-submit;
                bad: root.auth.field == "code";
                box-height: 52px;
                mirror: true;
                covered: root.overlay-on;
                text-size: root.login-size;
                ext-focus: root.overlay-on && root.login-focus == "code";
                ext-hover: root.overlay-on && root.login-hover == "code";
                focus-request => { root.fire-focus("code"); }
              }
            }
            if root.setup && root.auth.code-required: Text {
                text: "Also saved on the server in ~/.ccs/auth/setup-code";
                font-size: Type.small;
                color: Theme.ink-3;
            }
          }
        }
        // the message slot keeps its height, so an error never moves the button
        if root.form: Rectangle { height: 10px; }
        if root.form: msg := Rectangle {
            property <bool> on: root.auth.message != "" || root.connecting;
            property <bool> info: root.connecting || root.auth.notice;
            min-height: max(38px, msg-row.preferred-height);
            ProbeMark { x: 0px; y: 0px; width: parent.width; height: msg.height; id: msg.on ? "signin-message" : ""; }
            msg-row := HorizontalLayout {
                y: msg.on ? 0px : -3px;
                height: self.preferred-height;
                opacity: msg.on ? 1 : 0;
                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                animate y { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: start;
                    padding-top: 1px;
                    horizontal-stretch: 0;
                    Icon {
                        name: root.connecting ? "server" : msg.info ? "info" : "alert-circle";
                        tint: msg.info ? Theme.accent-text : Theme.crit-text;
                        width: 15px;
                        height: 15px;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    Text {
                        text: root.connecting ? (root.setup ? "Creating the sign-in on the server." : "Checking with the server.") : root.auth.message;
                        font-size: Type.small;
                        font-weight: msg.info ? 400 : 640;
                        color: msg.info ? Theme.ink-2 : Theme.crit-text;
                        wrap: word-wrap;
                    }
                    if root.auth.message-sub != "" && !root.connecting: Text {
                        text: root.auth.message-sub;
                        font-size: Type.small;
                        color: Theme.ink-3;
                        wrap: word-wrap;
                    }
                }
            }
        }
        if root.form: Rectangle { height: 10px; }

        // Remember me (login only): off gives a browser-session cookie, on the configured session
        // lifetime. The HTML form's checkbox (public/login-bridge.mjs) lies over the box as its keyboard
        // focus target and stays in step with it.
        if root.form && !root.setup: Rectangle {
            min-height: max(44px, remember-row.preferred-height);
            property <LoginBox> where: { x: check.absolute-position.x, y: check.absolute-position.y, width: check.width, height: check.height };
            init => { root.check-box = self.where; }
            changed where => { root.check-box = self.where; }
            remember-row := HorizontalLayout {
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    check := Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.remember-me ? Theme.accent : Theme.rule-strong;
                        background: root.remember-me ? Theme.accent : Theme.paper;
                        Icon { x: 2px; y: 2px; width: 18px; height: 18px; name: "check"; tint: Theme.accent-ink; opacity: root.remember-me ? 1 : 0; }
                    }
                }
                Text { text: "Remember me"; font-size: Type.body; color: Theme.ink; vertical-alignment: center; }
                Text { text: root.remember-me ? "stays signed in" : "signs out with the browser"; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; }
            }
            ProbeMark { x: 0px; y: 0px; width: 22px; height: parent.height; id: "signin-remember"; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remember-me = !root.remember-me; }
            }
        }
        if root.form && !root.setup: Rectangle { height: 8px; }

        // submit: the label, a spinner and a check cross-fade in one button
        submit-btn := Rectangle {
            property <bool> off: (root.limited || root.state == "loading") && !root.signed-in;
            height: 52px;
            border-radius: 10px;
            clip: true;
            background: root.signed-in ? Theme.calm
                : self.off ? Theme.paper-3
                : sb-ta.has-hover && root.can-submit ? Theme.accent.mix(Theme.ink, 0.88) : Theme.accent;
            animate background { duration: Motion.tint(Motion.med); easing: cubic-bezier(0.65, 0, 0.35, 1); }
            transform-scale: sb-ta.pressed && root.can-submit ? 0.97 : 1;
            animate transform-scale { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            property <color> fg: root.signed-in ? Theme.paper : self.off ? Theme.ink-3 : Theme.accent-ink;
            property <string> label: root.setup && !root.auth.setup-form ? "Check again" : root.setup ? "Create sign-in" : "Sign in";
            // idle label
            Text {
                y: (parent.height - self.preferred-height) / 2 + (root.connecting || root.signed-in ? -10px : 0px);
                opacity: root.connecting || root.signed-in ? 0 : 1;
                animate y, opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                text: submit-btn.label;
                font-size: 15px;
                font-weight: 620;
                color: submit-btn.fg;
            }
            // busy
            HorizontalLayout {
                y: (parent.height - 18px) / 2 + (root.connecting ? 0px : 10px);
                height: 18px;
                opacity: root.connecting ? 1 : 0;
                animate y, opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                alignment: center;
                spacing: 9px;
                Rectangle {
                    width: 17px;
                    height: 17px;
                    transform-rotation: root.connecting ? mod(animation-tick() / 800ms, 1) * 360deg : 0deg;
                    Path {
                        width: 17px; height: 17px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M12 3 A9 9 0 1 1 11.99 3";
                        stroke: Theme.accent-ink.with-alpha(0.28); stroke-width: 2.2px; fill: transparent;
                    }
                    Path {
                        width: 17px; height: 17px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M21 12 A9 9 0 0 0 12 3";
                        stroke: Theme.accent-ink; stroke-width: 2.2px; stroke-line-cap: round; fill: transparent;
                    }
                }
                Text {
                    text: root.setup ? "Creating sign-in" : "Signing in";
                    font-size: 15px;
                    font-weight: 620;
                    color: Theme.accent-ink;
                    vertical-alignment: center;
                }
            }
            // done
            HorizontalLayout {
                y: (parent.height - 18px) / 2 + (root.signed-in ? 0px : 10px);
                height: 18px;
                opacity: root.signed-in ? 1 : 0;
                animate y, opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                alignment: center;
                spacing: 9px;
                VerticalLayout { alignment: center; Icon { name: "check"; tint: Theme.paper; width: 18px; height: 18px; } }
                Text { text: "Signed in"; font-size: 15px; font-weight: 620; color: Theme.paper; vertical-alignment: center; }
            }
            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-submit"; }
            sb-ta := TouchArea {
                mouse-cursor: root.can-submit ? pointer : root.connecting ? progress : default;
                clicked => {
                    if root.setup && !root.auth.setup-form {
                        if !root.busy { root.fire-recheck(); }
                    } else {
                        root.go();
                    }
                }
            }
        }

        // rate limited below D: the countdown sits under the button (4.5.4); the scale bar drains
        if root.limited && root.auth.retry-seconds > 0: Rectangle { height: 10px; }
        if root.limited && root.auth.retry-seconds > 0: countdown-row := HorizontalLayout {
            alignment: center;
            spacing: 6px;
            property <string> mmss: floor(root.left / 60) + ":" + (mod(root.left, 60) < 10 ? "0" : "") + mod(root.left, 60);
            VerticalLayout { alignment: center; Icon { name: "timer"; tint: Theme.warn-text; width: 15px; height: 15px; } }
            Text { text: countdown-row.mmss; font-family: Type.tab; font-size: 15px; font-weight: 640; color: Theme.warn-text; vertical-alignment: center; }
            Text { text: "left"; font-size: Type.small; color: Theme.ink-3; vertical-alignment: center; }
        }

        // the network note
        if root.with-note: Rectangle { height: 16px; }
        if root.with-note: Rectangle { height: 1px; background: Theme.rule-2; }
        if root.with-note: Rectangle { height: 12px; }
        if root.with-note: Rectangle {
            min-height: note.preferred-height;
            preferred-height: note.preferred-height;
            note := VerticalLayout {
                padding-left: 24px;
                Text { text: root.auth.transport-note; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; }
            }
            Icon { x: 0px; y: 1px; name: "lock"; tint: Theme.ink-3; width: 15px; height: 15px; }
            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-note"; }
        }
    }
}
// The offline card (4.6): at launch, when /api cannot be reached, the sign-in layout carries this card
// instead of the form. No readings exist and none are invented; the words come from auth-view.mjs.
component OfflineCard inherits Rectangle {
    in property <AuthView> auth;
    in property <bool> busy;
    callback try-again();
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.rule;
    background: Theme.paper;
    drop-shadow-color: Theme.shadow-2;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 12px;
    form := VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 0px;
        Text {
            text: root.auth.offline-title != "" ? root.auth.offline-title : "Can't reach the dashboard";
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.6px;
            color: Theme.ink;
        }
        Rectangle { height: 6px; }
        StyledText {
            text: @markdown("**\{root.auth.offline-strong}** \{root.auth.offline-body}");
            default-color: Theme.ink-2;
            default-font-size: Type.body;
        }
        Rectangle { height: 16px; }
        Rectangle {
            height: 48px;
            border-radius: 10px;
            clip: true;
            background: root.busy ? Theme.accent.mix(Theme.ink, 0.88) : Theme.accent;
            animate background { duration: Motion.tint(Motion.med); easing: cubic-bezier(0.65, 0, 0.35, 1); }
            transform-scale: retry-ta.pressed && !root.busy ? 0.97 : 1;
            animate transform-scale { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            HorizontalLayout {
                alignment: center;
                spacing: 9px;
                opacity: root.busy ? 1 : 0;
                animate opacity { duration: Motion.on ? Motion.fast : 0ms; }
                Rectangle {
                    width: 17px;
                    height: 17px;
                    transform-rotation: root.busy ? mod(animation-tick() / 800ms, 1) * 360deg : 0deg;
                    Path {
                        width: 17px; height: 17px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M12 3 A9 9 0 1 1 11.99 3";
                        stroke: Theme.accent-ink.with-alpha(0.28); stroke-width: 2.2px; fill: transparent;
                    }
                    Path {
                        width: 17px; height: 17px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M21 12 A9 9 0 0 0 12 3";
                        stroke: Theme.accent-ink; stroke-width: 2.2px; stroke-line-cap: round; fill: transparent;
                    }
                }
            }
            Text {
                text: "Try again";
                font-size: 15px;
                font-weight: 620;
                color: Theme.accent-ink;
                opacity: root.busy ? 0 : 1;
                animate opacity { duration: Motion.on ? Motion.fast : 0ms; }
            }
            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: "signin-offline-try"; }
            retry-ta := TouchArea {
                mouse-cursor: root.busy ? progress : pointer;
                clicked => { if !root.busy { root.try-again(); } }
            }
        }
        Rectangle { height: 12px; }
        Text {
            text: root.auth.offline-meta;
            font-size: Type.small;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
}

// The brand row of the scrolled sign-in pages (4.5.1): 56 tall, the Apex mark and the name.
component BrandRow inherits HorizontalLayout {
    height: 56px;
    spacing: 10px;
    alignment: start;
    VerticalLayout { alignment: center; AppLogo { size: 28px; } }
    Text { text: "AI Account Center"; font-size: 16px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
}

// One footer line of the scrolled sign-in pages (4.5.1): a small icon and a wrapping small text.
component FootLine inherits HorizontalLayout {
    in property <string> icon;
    in property <string> text;
    spacing: 8px;
    alignment: start;
    VerticalLayout { alignment: start; padding-top: 2px; horizontal-stretch: 0; Icon { name: root.icon; tint: Theme.ink-4; width: 14px; height: 14px; } }
    Text { text: root.text; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; horizontal-stretch: 1; }
}

// A vertical Flickable page under the safe-top strip; its scroll offset is bound to SigninScroll.current,
// which the layer drives for the keyboard (4.5.2). The card slots in through @children.
component ScrolledHost inherits Rectangle {
    in property <AuthView> auth;
    in property <bool> brand: true;
    in property <bool> footer: true;
    in property <bool> f-gap: false;
    in property <length> card-max: 440px;
    flick := Flickable {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(self.height, Device.safe-top + content.preferred-height);
        content-y <=> SigninScroll.current;
        changed content-height => { SigninScroll.max-scroll = max(0px, self.content-height - self.height); }
        changed height => { SigninScroll.max-scroll = max(0px, self.content-height - self.height); }
        init => { SigninScroll.max-scroll = max(0px, self.content-height - self.height); }
        content := Rectangle {
            y: Device.safe-top;
            width: flick.width;
            height: col.preferred-height;
            col := VerticalLayout {
                width: 100%;
                padding-left: 16px + Device.safe-left;
                padding-right: 16px + Device.safe-right;
                if root.brand: BrandRow { }
                if root.brand: Rectangle { height: 16px; }
                // F: the card's top sits at max(safe-top + 72, 16 % of the height) (4.5.1)
                if root.f-gap: Rectangle { height: max(0px, root.height * 0.16 - Device.safe-top - 72px); }
                slot := HorizontalLayout {
                    alignment: center;
                    @children
                }
                if root.footer: Rectangle { height: 20px; }
                if root.footer: VerticalLayout {
                    spacing: 8px;
                    FootLine { icon: "clock"; text: "Sessions last " + (root.auth.session-hours > 0 ? root.auth.session-hours : 24) + " hours"; }
                    FootLine { icon: "link"; text: "The Mac and Windows trays stay signed in with their own device tokens"; }
                }
                Rectangle { height: 16px + Device.safe-bottom; }
            }
        }
    }
}

// The short two-column page (4.5.1): brand, title, host line, network note and footer lines on the left,
// the 360 px card on the right; it all scrolls when it does not fit.
component ShortHost inherits Rectangle {
    in property <AuthView> auth;
    in property <bool> footer: true;
    flick := Flickable {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(self.height, Device.safe-top + content.preferred-height);
        content-y <=> SigninScroll.current;
        changed content-height => { SigninScroll.max-scroll = max(0px, self.content-height - self.height); }
        changed height => { SigninScroll.max-scroll = max(0px, self.content-height - self.height); }
        init => { SigninScroll.max-scroll = max(0px, self.content-height - self.height); }
        content := Rectangle {
            y: Device.safe-top;
            width: flick.width;
            height: rowcol.preferred-height;
            rowcol := HorizontalLayout {
                width: 100%;
                padding-left: Breakpoints.gutter + Device.safe-left;
                padding-right: Breakpoints.gutter + Device.safe-right;
                padding-top: 24px;
                padding-bottom: 24px + Device.safe-bottom;
                spacing: 24px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    BrandRow { }
                    Rectangle { height: 12px; }
                    Text {
                        text: root.auth.state == "setup" ? "Set up sign-in" : root.auth.state == "expired" ? "Sign in again" : "Sign in";
                        font-size: 24px;
                        font-weight: 700;
                        letter-spacing: -0.6px;
                        color: Theme.ink;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 4px; }
                    HorizontalLayout {
                        spacing: 0px;
                        alignment: start;
                        Text { text: root.auth.host == "" ? "Your accounts and subscription usage" : "Dashboard on "; font-size: 14px; color: Theme.ink-3; }
                        if root.auth.host != "": Text { text: root.auth.host; font-family: Type.tab; font-size: 14px; font-weight: 580; color: Theme.ink-2; overflow: elide; }
                    }
                    Rectangle { height: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout { alignment: start; padding-top: 2px; horizontal-stretch: 0; Icon { name: "lock"; tint: Theme.ink-3; width: 15px; height: 15px; } }
                        Text { text: root.auth.transport-note; font-size: Type.small; color: Theme.ink-3; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                    if root.footer: Rectangle { height: 16px; }
                    if root.footer: VerticalLayout {
                        spacing: 8px;
                        FootLine { icon: "clock"; text: "Sessions last " + (root.auth.session-hours > 0 ? root.auth.session-hours : 24) + " hours"; }
                        FootLine { icon: "link"; text: "The Mac and Windows trays stay signed in with their own device tokens"; }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    @children
                }
            }
        }
    }
}

export component SignInLayer inherits Rectangle {
    in property <AuthView> auth;
    in property <StrengthView> strength;
    in property <bool> busy;
    in property <bool> shown;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> remember-me: true;
    callback submit(string, string, bool);
    callback create(string, string, string, string);
    callback typing(string, string);
    callback recheck();
    callback limit-over();
    // The login form's real HTML inputs (index.html #aac-login, public/login-bridge.mjs) lie over the username and
    // password boxes, so password managers can see and fill them; their focus and hover come back in here.
    in property <string> login-focus;
    in property <string> login-hover;
    callback login-overlay(LoginOverlay);
    callback login-focus-request(string);

    property <string> state: root.auth.state;
    property <bool> success: root.state == "success";
    // bridge.js marks the session authenticated 650 ms after the success answer, and this layer then needs
    // 420 ms more to fade out. `success` drops at the start of that fade, so every success visual - above all
    // the scale bar's Apex fill - animated back to empty on the way out: the bar reached 100 and then drained
    // to 0 while the page was still on screen. `signed-in` holds the success look until the layer is really
    // invisible, so nothing snaps back while it can be seen; the reset happens out of sight and the next
    // sign-in (a sign-out, an ended session) starts from an empty bar. Asking for the page again clears the
    // hold at once, so a sign-out landing inside the fade can never leave the form stuck in its success look.
    property <bool> success-held: false;
    property <bool> signed-in: root.success || root.success-held;
    changed success => { if root.success { root.success-held = true; } }
    changed visible => { if !root.visible { root.success-held = false; } }
    changed shown => { if root.shown { root.success-held = false; } }
    property <bool> loading: root.state == "loading";
    // Only while the page is asked for: a busy slot taken by a dashboard action must not start the sweep on
    // an invisible page, and `signed-in` keeps the sweep off during the success fade.
    property <bool> connecting: root.shown && (root.state == "connecting" || (root.busy && !root.signed-in));
    property <bool> setup: root.state == "setup";
    property <bool> form: !root.setup || root.auth.setup-form;
    property <bool> limited: root.state == "limited";
    property <bool> wrong: root.state == "wrong";
    property <bool> expired: root.state == "expired";
    // the offline screen (4.6): /api was unreachable at launch (the shell came from the service-worker cache)
    property <bool> offline: root.state == "offline";
    property <bool> can-submit: !root.busy && !root.loading && !root.limited && !root.signed-in && !root.connecting && root.form;
    property <bool> has-banner: root.expired || root.limited || (root.setup && !root.auth.setup-form);
    property <bool> entered: false;
    init => { root.entered = true; }

    // tiers (DESIGN-MOBILE.md 4.5.1): the motif layout on T and D, the scrolled column on P and F, the
    // two-column short page in landscape. The desktop compact look stays height < 760 on D only.
    property <bool> mobile: Breakpoints.below-d;
    property <bool> stacked: root.mobile && !Breakpoints.tier-t;
    property <bool> mshort: root.mobile && Breakpoints.short;
    property <bool> dshort: !root.mobile && root.height < 760px;
    property <bool> scrollable: root.stacked || root.mshort;
    // the real HTML inputs draw 17 px below D so iOS never zooms on focus; the Slint mirror text matches.
    // On D with touch (iPad 13 landscape) they draw 16 px for the same reason (2.1); mouse desktops keep today.
    property <length> login-size: root.mobile ? 17px : Device.coarse ? 16px : Type.body;
    // the safe-top strip's bottom edge: boxes starting above it hide their HTML input (TouchCard box-in-band)
    property <length> band-top: Device.safe-top;

    // The HTML inputs are on screen only while the login form is on screen and still: the layer fully faded in
    // and asked for, the card's load-in finished (SigninScroll.ready), and the page neither loading, nor signed
    // in (the success look and the fade into the dashboard), nor on the offline card. The first-run form is
    // covered like the login one (mode "setup"). In every other moment the inputs are hidden and the Slint
    // fields draw the same text themselves.
    property <bool> overlay-on: root.visible && root.shown && root.opacity > 0.999 && SigninScroll.ready
        && root.form && !root.signed-in && !root.loading && !root.offline;
    // where the fields are on the desktop layout, copied out of the conditional form below whenever the layout
    // moves them (a resize, the short layout, a breakpoint, a banner opening, the wrong-password shake)
    property <LoginBox> user-box;
    property <LoginBox> user-text-box;
    property <LoginBox> pass-box;
    property <LoginBox> pass-text-box;
    property <LoginBox> check-box;
    property <bool> fields-enabled;
    property <bool> pass-plain;
    property <LoginOverlay> overlay-off: { on: false, revealed: root.pass-plain, remember: root.remember-me };
    // only read while the inputs are on screen, so a load-in or a fade never reports a frame it does not need
    property <LoginOverlay> overlay-live: {
        on: true,
        enabled: root.fields-enabled,
        mode: "login",
        revealed: root.pass-plain,
        remember: root.remember-me,
        // the desktop page never scrolls: its fields are always out in the open
        user-visible: true,
        pass-visible: true,
        confirm-visible: true,
        code-visible: true,
        user: root.user-box,
        user-text: root.user-text-box,
        pass: root.pass-box,
        pass-text: root.pass-text-box,
        check: root.check-box,
        submit: { x: submit-btn.absolute-position.x, y: submit-btn.absolute-position.y, width: submit-btn.width, height: submit-btn.height },
        font-size: root.login-size,
        // a disabled field fades its box to 0.72, text included
        ink: Theme.ink.with-alpha(root.fields-enabled ? 1 : 0.72),
        placeholder: Theme.ink-4,
        selection: Theme.accent.with-alpha(0.25),
        accent: Theme.accent,
    };
    property <LoginOverlay> overlay: !root.scrollable && root.overlay-on ? root.overlay-live : root.overlay-off;
    changed overlay => { root.login-overlay(self.overlay); }
    // the scrolled tiers report through their TouchCard; the layer only remembers it for the keyboard scroll
    changed login-focus => { root.retarget(); }
    // a paused sign-in forgets the typed password, as the concept does; a wrong one takes the keyboard back
    changed state => {
        if root.limited { root.password = ""; }
        if root.wrong { root.login-focus-request("pass"); }
        if root.offline { root.login-overlay(root.overlay-off); }
    }

    // rate limited: the countdown runs from the server's Retry-After, a second at a time
    property <int> left: root.auth.retry-seconds;
    property <int> limit-total: max(1, root.auth.limit-seconds > 0 ? root.auth.limit-seconds : root.auth.retry-seconds);
    property <int> retry-seed: root.auth.retry-seconds;
    changed retry-seed => { root.left = root.retry-seed; }
    Timer {
        interval: 1s;
        running: root.limited && root.left > 0;
        triggered => {
            root.left = max(0, root.left - 1);
            if root.left == 0 { root.limit-over(); }
        }
    }
    pure function mmss(s: int) -> string {
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }

    // a wrong password or a refused first-run field shakes the desktop fields: a short decaying sideways
    // oscillation (the scrolled tiers' TouchCard shakes itself)
    property <int> nonce: root.auth.nonce;
    property <duration> shake-start: 0ms;
    property <bool> shaking: false;
    changed nonce => {
        if Motion.on {
            root.shake-start = animation-tick();
            root.shaking = true;
            shake-end.running = true;
        }
    }
    shake-end := Timer { interval: 460ms; running: false; triggered => { self.running = false; root.shaking = false; } }
    property <float> shake-p: root.shaking ? clamp((animation-tick() - root.shake-start) / 440ms, 0, 1) : 1;
    property <length> shake-x: root.shaking ? 7px * pow(1 - root.shake-p, 2) * sin(root.shake-p * 4 * 360deg) : 0px;

    // ---- keyboard scroll (4.5.2, 2.5): bring the Sign in button 12 px above the keyboard without pushing
    // the focused field's top above safe-top + 8; never scroll back on blur ----
    property <length> kbd-h: Device.keyboard;
    changed kbd-h => { root.retarget(); }
    changed height => { root.retarget(); }
    pure function focused-y() -> length {
        if root.login-focus == "pass" { return SigninScroll.report.pass.y; }
        if root.login-focus == "confirm" { return SigninScroll.report.confirm.y; }
        if root.login-focus == "code" { return SigninScroll.report.code.y; }
        return SigninScroll.report.user.y;
    }
    // the boxes' content coordinates are stable while the scroll animates: box and offset move together
    pure function scroll-target() -> length {
        return max(
            min(max(min(0px, root.height - max(Device.keyboard, Device.safe-bottom) - 12px
                - SigninScroll.report.submit.height - (SigninScroll.report.submit.y - SigninScroll.current)),
                Device.safe-top + 8px - (self.focused-y() - SigninScroll.current)), 0px),
            -SigninScroll.max-scroll);
    }
    function retarget() {
        if !root.scrollable || Device.keyboard <= 0px || !SigninScroll.report.on { return; }
        self.scroll-to(self.scroll-target());
    }
    property <length> tween-from: 0px;
    property <length> tween-to: 0px;
    property <duration> tween-t0: 0ms;
    function scroll-to(target: length) {
        if !Motion.on || target == SigninScroll.current {
            SigninScroll.current = target;
            return;
        }
        root.tween-from = SigninScroll.current;
        root.tween-to = target;
        root.tween-t0 = animation-tick();
        tween-timer.running = true;
    }
    tween-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            SigninScroll.current = root.tween-from + (root.tween-to - root.tween-from)
                * (1 - pow(1 - clamp((animation-tick() - root.tween-t0) / 200ms, 0, 1), 3));
            if (animation-tick() - root.tween-t0) / 200ms >= 1 { self.running = false; }
        }
    }

    function go() {
        if !root.can-submit { return; }
        if root.setup {
            root.create(root.username, root.password, LoginExtra.confirm, LoginExtra.code);
        } else {
            root.submit(root.username, root.password, root.remember-me);
        }
    }

    background: Theme.bg;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.005;
    animate opacity { duration: Motion.on ? 420ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }

    // swallow input meant for the dashboard underneath
    TouchArea { }
    SignInGrid { width: root.width; height: root.height; }
    // a quiet daylight wash centred on the summit
    // a square, so the circle fades to nothing before any edge (no visible box)
    Rectangle {
        property <length> side: max(root.width * 0.8, root.height * 1.3);
        x: root.width * 0.68 - self.side / 2;
        y: root.height * 0.42 - self.side / 2;
        width: self.side;
        height: self.side;
        background: @radial-gradient(circle, Theme.accent.with-alpha(Theme.dark ? 0.09 : 0.07) 0%, Theme.accent.with-alpha(0) 68%);
    }

    // ---- the scrolled pages: P and F column, short two-column (4.5.1) ----
    if root.stacked: ScrolledHost {
        width: root.width;
        height: root.height;
        auth: root.auth;
        f-gap: Breakpoints.tier-f;
        brand: !root.offline;
        footer: !root.offline;
        stack-reveal := Reveal {
            delay: 124ms;
            width: min(440px, parent.width);
            changed level => { SigninScroll.ready = self.level > 0.999; }
            init => { SigninScroll.ready = self.level > 0.999; }
            if root.offline: OfflineCard {
                width: parent.width;
                auth: root.auth;
                busy: root.busy;
                try-again => { root.recheck(); }
            }
            if !root.offline: TouchCard {
                width: parent.width;
                auth: root.auth;
                strength: root.strength;
                busy: root.busy;
                signed-in: root.signed-in;
                connecting: root.connecting;
                can-submit: root.can-submit;
                form: root.form;
                setup: root.setup;
                limited: root.limited;
                wrong: root.wrong;
                expired: root.expired;
                has-banner: root.has-banner;
                overlay-on: root.overlay-on;
                login-focus: root.login-focus;
                login-hover: root.login-hover;
                band-top: root.band-top;
                login-size: root.login-size;
                leaving: root.signed-in && !root.shown;
                left: root.left;
                limit-total: root.limit-total;
                username <=> root.username;
                password <=> root.password;
                remember-me <=> root.remember-me;
                login-overlay-report(report) => { SigninScroll.report = report; root.login-overlay(report); }
                fire-submit(user, pass, remember) => { root.submit(user, pass, remember); }
                fire-create(user, pass, confirm, code) => { root.create(user, pass, confirm, code); }
                fire-recheck => { root.recheck(); }
                fire-focus(field) => { root.login-focus-request(field); }
            }
        }
    }
    if root.mshort: ShortHost {
        width: root.width;
        height: root.height;
        auth: root.auth;
        footer: !root.offline;
        short-reveal := Reveal {
            delay: 124ms;
            width: 360px;
            horizontal-stretch: 0;
            changed level => { SigninScroll.ready = self.level > 0.999; }
            init => { SigninScroll.ready = self.level > 0.999; }
            if root.offline: OfflineCard {
                width: parent.width;
                auth: root.auth;
                busy: root.busy;
                try-again => { root.recheck(); }
            }
            if !root.offline: TouchCard {
                width: parent.width;
                with-title: false;
                with-note: false;
                auth: root.auth;
                strength: root.strength;
                busy: root.busy;
                signed-in: root.signed-in;
                connecting: root.connecting;
                can-submit: root.can-submit;
                form: root.form;
                setup: root.setup;
                limited: root.limited;
                wrong: root.wrong;
                expired: root.expired;
                has-banner: root.has-banner;
                overlay-on: root.overlay-on;
                login-focus: root.login-focus;
                login-hover: root.login-hover;
                band-top: root.band-top;
                login-size: root.login-size;
                leaving: root.signed-in && !root.shown;
                left: root.left;
                limit-total: root.limit-total;
                username <=> root.username;
                password <=> root.password;
                remember-me <=> root.remember-me;
                login-overlay-report(report) => { SigninScroll.report = report; root.login-overlay(report); }
                fire-submit(user, pass, remember) => { root.submit(user, pass, remember); }
                fire-create(user, pass, confirm, code) => { root.create(user, pass, confirm, code); }
                fire-recheck => { root.recheck(); }
                fire-focus(field) => { root.login-focus-request(field); }
            }
        }
    }

    // ---- the desktop layout (T and D, unchanged apart from the safe top and the T sizes) ----
    top := HorizontalLayout {
        visible: !root.scrollable;
        x: max(0px, (root.width - Breakpoints.max-content) / 2);
        y: (root.entered || !Motion.on ? 0px : -8px) + Device.safe-top;
        width: min(root.width, Breakpoints.max-content);
        height: 62px;
        animate y { duration: Motion.on ? 520ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        padding-left: Breakpoints.gutter;
        padding-right: Breakpoints.gutter;
        spacing: 10px;
        alignment: start;
        VerticalLayout { alignment: center; AppLogo { size: 26px; } }
        Text { text: "AI Account Center"; font-size: 15.5px; font-weight: 640; color: Theme.ink; vertical-alignment: center; }
    }

    property <length> main-max: Breakpoints.ultra ? 1680px : 1400px;
    property <length> main-pad: Breakpoints.compact ? 32px : 48px;
    property <length> card-w: Breakpoints.ultra ? 440px : Breakpoints.compact ? 384px : 404px;
    property <length> card-pad: Breakpoints.ultra ? 36px : Breakpoints.compact ? 28px : 32px;
    property <length> foot-h: root.dshort ? 46px : 56px;
    main := HorizontalLayout {
        visible: !root.scrollable;
        x: max(0px, (root.width - root.main-max) / 2);
        y: 62px + Device.safe-top;
        width: min(root.width, root.main-max);
        height: root.height - 62px - root.foot-h - Device.safe-top;
        padding-left: root.main-pad;
        padding-right: root.main-pad;
        padding-top: root.dshort ? 0px : 12px;
        padding-bottom: root.dshort ? 12px : 20px;
        spacing: Breakpoints.compact ? 44px : clamp(root.width * 0.052, 40px, 120px);
        VerticalLayout {
            alignment: center;
            width: root.card-w;
            card-reveal := Reveal {
                delay: 124ms;
                changed level => { if !root.scrollable { SigninScroll.ready = self.level > 0.999; } }
                init => { if !root.scrollable { SigninScroll.ready = self.level > 0.999; } }
                card := Rectangle {
                    min-height: form.preferred-height;
                    preferred-height: form.preferred-height;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Theme.rule;
                    background: Theme.paper;
                    drop-shadow-color: Theme.shadow-2;
                    drop-shadow-blur: 28px;
                    drop-shadow-offset-y: 12px;
                    // leaving: the card steps back a little while the page fades into the dashboard
                    transform-scale: root.signed-in && !root.shown ? 0.99 : 1;
                    animate transform-scale { duration: Motion.on ? Motion.slow : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    form := VerticalLayout {
                        padding-left: root.card-pad;
                        padding-right: root.card-pad;
                        padding-top: root.dshort ? 22px : root.card-pad - 2px;
                        padding-bottom: root.dshort ? 18px : 24px;
                        spacing: 0px;
                        // title and lede
                        Text {
                            text: root.signed-in ? "Signed in" : root.setup ? "Set up sign-in" : root.expired ? "Sign in again" : "Sign in";
                            font-size: root.dshort ? 24px : Breakpoints.ultra ? 30px : Breakpoints.compact ? 25px : 27px;
                            font-weight: 640;
                            letter-spacing: -0.6px;
                            color: Theme.ink;
                        }
                        Rectangle { height: root.dshort ? 5px : 7px; }
                        if root.signed-in || root.loading || (root.setup && root.auth.setup-form) || root.auth.host == "": Text {
                            text: root.signed-in ? "Opening your dashboard."
                                : root.loading ? "Connecting to AI Account Center…"
                                : root.setup ? "No sign-in is set up yet. Choose the username and password for this dashboard; each tray asks for them once."
                                : "Your accounts and subscription usage";
                            font-size: root.dshort ? 13px : 13.5px;
                            color: Theme.ink-3;
                            wrap: word-wrap;
                        }
                        if !(root.signed-in || root.loading || (root.setup && root.auth.setup-form) || root.auth.host == ""): HorizontalLayout {
                            spacing: 0px;
                            alignment: start;
                            Text { text: "Dashboard on "; font-size: root.dshort ? 13px : 13.5px; color: Theme.ink-3; }
                            Text { text: root.auth.host; font-family: Type.tab; font-size: root.dshort ? 13px : 13.5px; font-weight: 580; color: Theme.ink-2; overflow: elide; }
                        }
                        Rectangle { height: root.dshort ? 14px : 20px; }

                        // the banner: session ended, rate limited, or set up on the server (no tinted box, no side bar)
                        banner-box := Rectangle {
                            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable && root.has-banner ? "signin-banner" : ""; }
                            property <length> natural: banner.preferred-height;
                            height: root.has-banner ? self.natural : 0px;
                            animate height { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                            clip: true;
                            banner := VerticalLayout {
                                y: 0px;
                                height: banner-box.natural;
                                spacing: 0px;
                                opacity: root.has-banner ? 1 : 0;
                                animate opacity { duration: Motion.on ? Motion.med : 0ms; delay: Motion.on && root.has-banner ? 60ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                                HorizontalLayout {
                                    spacing: 12px;
                                    padding-top: 2px;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: 1px;
                                        horizontal-stretch: 0;
                                        Icon {
                                            name: root.limited ? "timer" : root.setup ? "terminal" : "logout";
                                            tint: root.limited ? Theme.warn-text : Theme.accent-text;
                                            width: 18px;
                                            height: 18px;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text { text: root.auth.banner-title; font-size: 14px; font-weight: 640; color: Theme.ink; wrap: word-wrap; }
                                        StyledText {
                                            text: root.auth.banner-strong != ""
                                                ? @markdown("\{root.auth.banner-body} **\{root.auth.banner-strong}**.")
                                                : @markdown("\{root.auth.banner-body}");
                                            default-color: Theme.ink-2;
                                            default-font-size: 13px;
                                            default-font-family: Type.tab;
                                        }
                                    }
                                    if root.limited && root.auth.retry-seconds > 0: VerticalLayout {
                                        horizontal-stretch: 0;
                                        alignment: start;
                                        spacing: 5px;
                                        Rectangle {
                                            min-width: countdown.preferred-width;
                                            preferred-width: countdown.preferred-width;
                                            min-height: countdown.preferred-height;
                                            countdown := Text {
                                                width: parent.width;
                                                text: root.mmss(root.left);
                                                font-family: Type.tab;
                                                font-size: 26px;
                                                font-weight: 640;
                                                letter-spacing: -0.4px;
                                                color: Theme.warn-text;
                                                horizontal-alignment: right;
                                            }
                                            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-countdown" : ""; }
                                        }
                                        Text { text: "left"; font-size: Type.small; color: Theme.ink-3; horizontal-alignment: right; }
                                    }
                                }
                                if root.limited && root.auth.retry-seconds > 0: HorizontalLayout {
                                    padding-left: 30px;
                                    padding-top: 10px;
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.track;
                                        clip: true;
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * clamp(root.left / root.limit-total, 0, 1);
                                            border-radius: 3px;
                                            background: @linear-gradient(90deg, Theme.warn-a 0%, Theme.warn 100%);
                                            animate width { duration: Motion.on ? 1000ms : 0ms; easing: linear; }
                                        }
                                    }
                                }
                                Rectangle { height: root.dshort ? 14px : 18px; }
                                Rectangle { height: 1px; background: Theme.rule-2; }
                                Rectangle { height: root.dshort ? 14px : 18px; }
                            }
                        }

                        // the fields (hidden while the server has to set sign-in up itself)
                        if root.form: Rectangle {
                          min-height: fields.preferred-height;
                          preferred-height: fields.preferred-height;
                          // the login fields' boxes, handed to the root for the HTML inputs laid over them
                          property <LoginBox> user-at: { x: user.box-x, y: user.box-y, width: user.box-width, height: user.box-h };
                          property <LoginBox> user-text-at: { x: user.text-x, y: user.text-y, width: user.text-width, height: user.text-height };
                          property <LoginBox> pass-at: { x: pass.box-x, y: pass.box-y, width: pass.box-width, height: pass.box-h };
                          property <LoginBox> pass-text-at: { x: pass.text-x, y: pass.text-y, width: pass.text-width, height: pass.text-height };
                          property <bool> usable: user.enabled;
                          property <bool> plain: pass.plain;
                          function publish() {
                              root.user-box = self.user-at;
                              root.user-text-box = self.user-text-at;
                              root.pass-box = self.pass-at;
                              root.pass-text-box = self.pass-text-at;
                              root.fields-enabled = self.usable;
                              root.pass-plain = self.plain;
                          }
                          init => { self.publish(); }
                          changed user-at => { self.publish(); }
                          changed user-text-at => { self.publish(); }
                          changed pass-at => { self.publish(); }
                          changed pass-text-at => { self.publish(); }
                          changed usable => { self.publish(); }
                          changed plain => { self.publish(); }
                          fields := VerticalLayout {
                            x: root.shake-x;
                            width: parent.width;
                            height: parent.height;
                            spacing: root.dshort ? 10px : 14px;
                            Rectangle {
                                min-height: user.preferred-height;
                                user := Field {
                                    width: parent.width;
                                    label: "Username";
                                    aside: root.setup ? "letters, numbers, - and _" : "";
                                    text <=> root.username;
                                    enabled: root.can-submit || root.wrong;
                                    bad: root.setup && root.auth.field == "user";
                                    box-height: Breakpoints.tier-t ? 48px : root.dshort ? 38px : Breakpoints.ultra ? 46px : 42px;
                                    mirror: !root.setup;
                                    covered: root.overlay-on;
                                    text-size: root.login-size;
                                    ext-focus: root.overlay-on && root.login-focus == "user";
                                    ext-hover: root.overlay-on && root.login-hover == "user";
                                    focus-request => { root.login-focus-request("user"); }
                                    accepted => { pass.focus-input(); }
                                }
                                ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-user" : ""; }
                            }
                            Rectangle {
                                min-height: pass.preferred-height;
                                pass := Field {
                                    width: parent.width;
                                    label: "Password";
                                    password: true;
                                    text <=> root.password;
                                    enabled: root.can-submit || root.wrong;
                                    bad: root.wrong || (root.setup && root.auth.field == "pass");
                                    box-height: Breakpoints.tier-t ? 48px : root.dshort ? 38px : Breakpoints.ultra ? 46px : 42px;
                                    mirror: !root.setup;
                                    covered: root.overlay-on;
                                    text-size: root.login-size;
                                    ext-focus: root.overlay-on && root.login-focus == "pass";
                                    ext-hover: root.overlay-on && root.login-hover == "pass";
                                    focus-request => { root.login-focus-request("pass"); }
                                    edited(v) => { if root.setup { root.typing(v, LoginExtra.confirm); } }
                                    accepted => { if !root.setup { root.go(); } }
                                }
                                ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-pass" : ""; }
                            }
                            if root.setup: StrengthMeter { data: root.strength; }
                            if root.setup: Rectangle {
                              min-height: confirm-field.preferred-height;
                              ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-confirm" : ""; }
                              confirm-field := Field {
                                width: parent.width;
                                label: "Confirm password";
                                password: true;
                                aside: root.strength.matches ? "Matches" : "";
                                aside-good: root.strength.matches;
                                ok: root.strength.matches;
                                text <=> LoginExtra.confirm;
                                enabled: root.can-submit;
                                bad: root.auth.field == "confirm";
                                box-height: Breakpoints.tier-t ? 48px : root.dshort ? 38px : Breakpoints.ultra ? 46px : 42px;
                                text-size: root.login-size;
                                edited(v) => { root.typing(root.password, v); }
                                accepted => { if !root.auth.code-required { root.go(); } }
                              }
                            }
                            if root.setup && root.auth.code-required: Rectangle {
                              min-height: code-field.preferred-height;
                              ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-code" : ""; }
                              code-field := Field {
                                width: parent.width;
                                label: "Setup code";
                                aside: "printed in the server's terminal";
                                placeholder: "e.g. EXAM-PLE0";
                                text <=> LoginExtra.code;
                                enabled: root.can-submit;
                                bad: root.auth.field == "code";
                                box-height: Breakpoints.tier-t ? 48px : root.dshort ? 38px : Breakpoints.ultra ? 46px : 42px;
                                text-size: root.login-size;
                                accepted => { root.go(); }
                              }
                            }
                            if root.setup && root.auth.code-required: Text {
                                text: "Also saved on the server in ~/.ccs/auth/setup-code";
                                font-size: Type.small;
                                color: Theme.ink-3;
                            }
                          }
                        }
                        // the message slot keeps its height, so an error never moves the button
                        if root.form: Rectangle { height: root.dshort ? 8px : 12px; }
                        if root.form: msg := Rectangle {
                            property <bool> on: root.auth.message != "" || root.connecting;
                            property <bool> info: root.connecting || root.auth.notice;
                            min-height: max(root.dshort ? 34px : 38px, msg-row.preferred-height);
                            ProbeMark { x: 0px; y: 0px; width: parent.width; height: msg.height; id: !root.scrollable && msg.on ? "signin-message" : ""; }
                            msg-row := HorizontalLayout {
                                y: msg.on ? 0px : -3px;
                                height: self.preferred-height;
                                opacity: msg.on ? 1 : 0;
                                animate opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
                                animate y { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: start;
                                    padding-top: 1px;
                                    horizontal-stretch: 0;
                                    Icon {
                                        name: root.connecting ? "server" : msg.info ? "info" : "alert-circle";
                                        tint: msg.info ? Theme.accent-text : Theme.crit-text;
                                        width: 15px;
                                        height: 15px;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 0px;
                                    Text {
                                        text: root.connecting ? (root.setup ? "Creating the sign-in on the server." : "Checking with the server.") : root.auth.message;
                                        font-size: 12.5px;
                                        font-weight: msg.info ? 400 : 640;
                                        color: msg.info ? Theme.ink-2 : Theme.crit-text;
                                        wrap: word-wrap;
                                    }
                                    if root.auth.message-sub != "" && !root.connecting: Text {
                                        text: root.auth.message-sub;
                                        font-size: 12.5px;
                                        color: Theme.ink-3;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if root.form: Rectangle { height: root.dshort ? 8px : 12px; }

                        // Remember me (login only): off gives a browser-session cookie, on the
                        // configured session lifetime. The HTML form's checkbox (public/login-bridge.mjs)
                        // lies over the box as its keyboard focus target and stays in step with it.
                        if root.form && !root.setup: Rectangle {
                            min-height: remember-row.preferred-height;
                            property <LoginBox> where: { x: check.absolute-position.x, y: check.absolute-position.y, width: check.width, height: check.height };
                            init => { root.check-box = self.where; }
                            changed where => { root.check-box = self.where; }
                            remember-row := HorizontalLayout {
                                spacing: 9px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    check := Rectangle {
                                        width: Breakpoints.tier-t ? 20px : 16px;
                                        height: Breakpoints.tier-t ? 20px : 16px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: root.remember-me ? Theme.accent : Theme.rule-strong;
                                        background: root.remember-me ? Theme.accent : Theme.paper;
                                        Icon { x: 1.5px; y: 1.5px; width: parent.width - 3px; height: parent.height - 3px; name: "check"; tint: Theme.accent-ink; opacity: root.remember-me ? 1 : 0; }
                                    }
                                }
                                Text { text: "Remember me"; font-size: 12.5px; color: Theme.ink; vertical-alignment: center; }
                                Text { text: root.remember-me ? "stays signed in" : "signs out with the browser"; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; }
                            }
                            ProbeMark { x: 0px; y: 0px; width: 16px; height: parent.height; id: !root.scrollable ? "signin-remember" : ""; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.remember-me = !root.remember-me; }
                            }
                        }
                        if root.form && !root.setup: Rectangle { height: 10px; }

                        // submit: the label, a spinner and a check cross-fade in one button
                        submit-btn := Rectangle {
                            property <bool> off: (root.limited || root.loading) && !root.signed-in;
                            height: root.dshort ? 40px : Breakpoints.tier-t || Breakpoints.ultra ? 48px : 44px;
                            border-radius: 10px;
                            clip: true;
                            background: root.signed-in ? Theme.calm
                                : self.off ? Theme.paper-3
                                : sb-ta.has-hover && root.can-submit ? Theme.accent.mix(Theme.ink, 0.88) : Theme.accent;
                            animate background { duration: Motion.tint(Motion.med); easing: cubic-bezier(0.65, 0, 0.35, 1); }
                            transform-scale: sb-ta.pressed && root.can-submit ? 0.97 : 1;
                            animate transform-scale { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            property <color> fg: root.signed-in ? Theme.paper : self.off ? Theme.ink-3 : Theme.accent-ink;
                            property <string> label: root.setup && !root.auth.setup-form ? "Check again" : root.setup ? "Create sign-in" : "Sign in";
                            // idle label
                            Text {
                                y: (parent.height - self.preferred-height) / 2 + (root.connecting || root.signed-in ? -10px : 0px);
                                opacity: root.connecting || root.signed-in ? 0 : 1;
                                animate y, opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                                text: submit-btn.label;
                                font-size: Breakpoints.tier-t || Breakpoints.ultra ? 15px : 14px;
                                font-weight: 620;
                                color: submit-btn.fg;
                            }
                            // busy
                            HorizontalLayout {
                                y: (parent.height - 18px) / 2 + (root.connecting ? 0px : 10px);
                                height: 18px;
                                opacity: root.connecting ? 1 : 0;
                                animate y, opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                                alignment: center;
                                spacing: 9px;
                                Rectangle {
                                    width: 17px;
                                    height: 17px;
                                    transform-rotation: root.connecting ? mod(animation-tick() / 800ms, 1) * 360deg : 0deg;
                                    Path {
                                        width: 17px; height: 17px; viewbox-width: 24; viewbox-height: 24;
                                        commands: "M12 3 A9 9 0 1 1 11.99 3";
                                        stroke: Theme.accent-ink.with-alpha(0.28); stroke-width: 2.2px; fill: transparent;
                                    }
                                    Path {
                                        width: 17px; height: 17px; viewbox-width: 24; viewbox-height: 24;
                                        commands: "M21 12 A9 9 0 0 0 12 3";
                                        stroke: Theme.accent-ink; stroke-width: 2.2px; stroke-line-cap: round; fill: transparent;
                                    }
                                }
                                Text {
                                    text: root.setup ? "Creating sign-in" : "Signing in";
                                    font-size: 14px;
                                    font-weight: 620;
                                    color: Theme.accent-ink;
                                    vertical-alignment: center;
                                }
                            }
                            // done
                            HorizontalLayout {
                                y: (parent.height - 18px) / 2 + (root.signed-in ? 0px : 10px);
                                height: 18px;
                                opacity: root.signed-in ? 1 : 0;
                                animate y, opacity { duration: Motion.on ? Motion.med : 0ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
                                alignment: center;
                                spacing: 9px;
                                VerticalLayout { alignment: center; Icon { name: "check"; tint: Theme.paper; width: 18px; height: 18px; } }
                                Text { text: "Signed in"; font-size: 14px; font-weight: 620; color: Theme.paper; vertical-alignment: center; }
                            }
                            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-submit" : ""; }
                            sb-ta := TouchArea {
                                mouse-cursor: root.can-submit ? pointer : root.connecting ? progress : default;
                                clicked => {
                                    if root.setup && !root.auth.setup-form {
                                        if !root.busy { root.recheck(); }
                                    } else {
                                        root.go();
                                    }
                                }
                            }
                        }

                        // the network note
                        Rectangle { height: root.dshort ? 12px : 16px; }
                        Rectangle { height: 1px; background: Theme.rule-2; }
                        Rectangle { height: root.dshort ? 11px : 14px; }
                        Rectangle {
                            min-height: note.preferred-height;
                            preferred-height: note.preferred-height;
                            note := VerticalLayout {
                                padding-left: 24px;
                                Text { text: root.auth.transport-note; font-size: 12.5px; color: Theme.ink-3; wrap: word-wrap; }
                            }
                            Icon { x: 0px; y: 1px; name: "lock"; tint: Theme.ink-3; width: 15px; height: 15px; }
                            ProbeMark { x: 0px; y: 0px; width: parent.width; height: parent.height; id: !root.scrollable ? "signin-note" : ""; }
                        }
                    }
                }
            }
        }
        Reveal {
            delay: 188ms;
            horizontal-stretch: 1;
            Motif {
                min-height: 200px;
                run: root.entered;
                success: root.signed-in;
                connecting: root.connecting;
                paused: root.limited;
            }
        }
    }
    foot := HorizontalLayout {
        visible: !root.scrollable;
        x: max(0px, (root.width - root.main-max) / 2);
        y: root.height - root.foot-h;
        width: min(root.width, root.main-max);
        height: root.foot-h;
        padding-left: root.main-pad;
        padding-right: root.main-pad;
        padding-bottom: (root.dshort ? 14px : 22px) + Device.safe-bottom;
        spacing: 18px;
        alignment: start;
        opacity: root.entered || !Motion.on ? 1 : 0;
        animate opacity { duration: Motion.on ? 520ms : 0ms; delay: Motion.on ? 252ms : 0ms; easing: cubic-bezier(0.65, 0, 0.35, 1); }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { name: "clock"; tint: Theme.ink-4; width: 15px; height: 15px; } }
            Text {
                text: "Sessions last " + (root.auth.session-hours > 0 ? root.auth.session-hours : 24) + " hours";
                font-size: 12.5px;
                color: Theme.ink-3;
                vertical-alignment: center;
            }
        }
        VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: Theme.rule-strong; } }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { name: "link"; tint: Theme.ink-4; width: 15px; height: 15px; } }
            Text { text: "The Mac and Windows trays stay signed in with their own device tokens"; font-size: 12.5px; color: Theme.ink-3; vertical-alignment: center; }
        }
    }

    // the safe-top strip (2.4): page background over the scrolled content, so nothing runs under the
    // status bar text; zero on desktop browsers, so the desktop look is unchanged
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: Device.safe-top;
        background: Theme.bg;
    }
}
