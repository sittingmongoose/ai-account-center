{
  "name": "@sittingmongoose/ai-account-center",
  "version": "8.10.0",
  "description": "AI Account Center - account usage and limits, reset claims, analytics and native desktop bars",
  "keywords": [
    "cli",
    "claude",
    "glm",
    "ai",
    "profile",
    "switch"
  ],
  "homepage": "https://github.com/sittingmongoose/ai-account-center",
  "bugs": {
    "url": "https://github.com/sittingmongoose/ai-account-center/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sittingmongoose/ai-account-center.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Tam Nhu Tran (Kai)",
    "email": "kaitranntt@users.noreply.github.com"
  },
  "bin": {
    "ai-account-center": "dist/native/ai-account-center",
    "ccs": "dist/native/ccs",
    "ccs-droid": "dist/native/ccs-droid",
    "ccsd": "dist/native/ccsd",
    "ccs-codex": "dist/native/ccs-codex",
    "ccsx": "dist/native/ccsx",
    "ccsxp": "dist/native/ccsxp"
  },
  "files": [
    "dist/",
    "scripts/account-usage/",
    "scripts/agent-usage/",
    "scripts/postinstall.js",
    "scripts/postuninstall.js",
    "scripts/deploy-lineage.js",
    "browser-bridge/",
    "macos-bar/Package.swift",
    "macos-bar/Scripts/",
    "macos-bar/Sources/",
    "macos-bar/Resources/",
    "macos-bar/Tests/",
    "macos-bar/README.md",
    "macos-bar/LICENSE",
    "macos-bar/VERSION",
    "windows-bar/CCSBar/",
    "windows-bar/scripts/",
    "windows-bar/README.md",
    "windows-bar/LICENSE",
    "crates/aac-store/Cargo.toml",
    "Cargo.toml",
    "Cargo.lock",
    "crates/aac-store/build.rs",
    "crates/aac-store/rust-toolchain.toml",
    "crates/aac-store/rustfmt.toml",
    "crates/aac-store/registry.json",
    "crates/aac-store/src/",
    "native/shared/",
    "config/agent-artifacts.json",
    "config/rust-service-routes.json",
    "config/secret-policy.json",
    "config/tables/",
    "config/private-files.json",
    "config/memory-budget.json",
    "tests/spec/wire-words.json",
    "tests/fixtures/secret-policy-cases.json",
    "tests/fixtures/run-corrections.json",
    "crates/aac-status/Cargo.toml",
    "crates/aac-status/build.rs",
    "crates/aac-status/rust-toolchain.toml",
    "crates/aac-status/rustfmt.toml",
    "crates/aac-status/src/",
    "crates/aac-core/",
    "crates/aac-files/",
    "crates/aac-num/",
    "crates/aac-api/",
    "web-dashboard/public/",
    "web-dashboard/leptos/Cargo.toml",
    "web-dashboard/leptos/Cargo.lock",
    "web-dashboard/leptos/.cargo/config.toml",
    "web-dashboard/leptos/rust-toolchain.toml",
    "web-dashboard/leptos/index.html",
    "web-dashboard/leptos/build/",
    "web-dashboard/leptos/fonts/",
    "web-dashboard/leptos/src/",
    "web-dashboard/leptos/style/",
    "VERSION",
    "README.md",
    "assets/screenshots/README.md",
    "LICENSE",
    "docs/agent-reports/schemas/",
    "docs/agent-reports/catalog/"
  ],
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "preferGlobal": true,
  "scripts": {
    "postuninstall": "node scripts/postuninstall.js",
    "build": "bun run build:all",
    "build:server": "node scripts/build-dashboard-native.js && node scripts/build-native.js --copy-only && node scripts/build-status-native.js --copy-only && node scripts/build-usage-scan.js --stage && node scripts/build-agent.js --copy-only && node scripts/build-cursor-account.js --copy-only && node scripts/deploy-lineage.js record-build",
    "build:all": "bun run ui:build && bun run build:server",
    "prebuild": "node scripts/clean-dist.js",
    "prebuild:server": "node scripts/clean-dist.js",
    "prebuild:all": "rm -rf dist",
    "postbuild:all": "node scripts/verify-bundle.js",
    "validate": "bun run test:fast",
    "validate:ci-parity": "bash scripts/ci-parity-gate.sh",
    "check:personal": "node scripts/personal-detail-guard.js",
    "verify:bundle": "node scripts/verify-bundle.js",
    "store:build": "node scripts/build-native.js",
    "store:test": "node scripts/store-cargo.js test",
    "store:check": "node scripts/store-cargo.js check",
    "status:build": "node scripts/build-status-native.js",
    "status:test": "node scripts/status-cargo.js test",
    "status:check": "node scripts/status-cargo.js check",
    "test": "bun run build && bun run test:all",
    "test:ci": "bun run test:all",
    "test:fast": "node scripts/run-test-bucket.js fast",
    "test:slow": "node scripts/run-test-bucket.js slow",
    "test:all": "node scripts/run-test-bucket.js all",
    "test:unit": "bun test tests/unit",
    "test:npm": "bun test tests/npm/",
    "dev": "bun run build && node scripts/run-dashboard-native.js --no-open",
    "ui:build": "node scripts/build-ui.js",
    "usage-scan:build": "node scripts/build-usage-scan.js",
    "agent:build": "node scripts/build-agent.js",
    "cursor-account:build": "node scripts/build-cursor-account.js",
    "ui:preview": "node scripts/run-dashboard-native.js",
    "ui:validate": "node scripts/validate-ui.js",
    "prepack": "node scripts/check-line-endings.js && bun run build:all",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "perf:memory": "node scripts/perf/memory-budget.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/bun": "1.4.4",
    "bcrypt": "^6.0.0",
    "binaryen": "132.0.0",
    "husky": "^9.1.7",
    "smol-toml": "^1.6.1",
    "ws": "8.22.2"
  }
}
