{
  "version": 2,
  "patterns": [
    {
      "kind": "a private key",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "flags": ""
    },
    {
      "kind": "an API key",
      "pattern": "\\bsk-(?:ant-[A-Za-z0-9_-]{16,}|(?:proj-)?[A-Za-z0-9_-]{20,})",
      "flags": ""
    },
    {
      "kind": "a GitHub token",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,})",
      "flags": ""
    },
    {
      "kind": "a Slack token",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "flags": ""
    },
    {
      "kind": "an AWS key",
      "pattern": "\\bAKIA[0-9A-Z]{16}",
      "flags": ""
    },
    {
      "kind": "a GitLab token",
      "pattern": "\\bglpat-[A-Za-z0-9_-]{18,}",
      "flags": ""
    },
    {
      "kind": "an npm token",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "flags": ""
    },
    {
      "kind": "a Hugging Face token",
      "pattern": "\\bhf_[A-Za-z0-9]{30,}\\b",
      "flags": ""
    },
    {
      "kind": "a Google API key",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}",
      "flags": ""
    },
    {
      "kind": "a JSON web token",
      "scan": "jwt"
    },
    {
      "kind": "a bearer token",
      "pattern": "\\bBearer\\s+[A-Za-z0-9._~+/-]{20,}",
      "flags": "i"
    },
    {
      "kind": "a credential field",
      "pattern": "\"(?:password|passwd|secret|client_?secret|api_?key|access_?token|refresh_?token|session_?token|cookie|(?:proxy[_-]?)?authorization(?:[_-]?header)?|authentication|auth[_-]?(?:token|header))\"\\s*:\\s*\"[^\"]{6,}\"",
      "flags": "i"
    },
    {
      "kind": "a credential in a URL",
      "pattern": "[?&](?:access_token|token|api_key|apikey|key|sig|signature|password|code)=[^&\\s\"]{8,}",
      "flags": "i"
    },
    {
      "kind": "a private key",
      "pattern": "-----BEGIN |PRIVATE KEY-----",
      "flags": ""
    },
    {
      "kind": "a dashboard token",
      "pattern": "\\baacd_[A-Za-z0-9_-]{16,}",
      "flags": ""
    },
    {
      "kind": "an authorization credential",
      "scan": "authorization"
    },
    {
      "kind": "an authorization credential",
      "pattern": "\\bDigest\\s+[A-Za-z][A-Za-z0-9_-]*\\s*=\\s*(?:\"[^\"]*\"|[^,\\s]+)",
      "flags": "i"
    },
    {
      "kind": "a credential assignment",
      "pattern": "\\b(?:api[_-]?key|access[_-]?token|refresh[_-]?token|secret)(?:=|%3d)[A-Za-z0-9._~+/=-]{8,}",
      "flags": "i"
    },
    {
      "kind": "URL userinfo",
      "pattern": "//[^/?#\\s\"<>]*@",
      "flags": ""
    },
    {
      "kind": "an email address",
      "scan": "email"
    }
  ],
  "credentialKey": "(?:password|passwd|secret|client_?secret|api_?key|access_?token|refresh_?token|session_?token|cookie|(?:proxy[_-]?)?authorization(?:[_-]?header)?|authentication|auth[_-]?(?:token|header))",
  "credentialMin": 6,
  "embeddedBudget": 4194304,
  "embeddedFailures": 256,
  "email": {
    "localChar": "[A-Za-z0-9._%+-]",
    "domain": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}\\b",
    "domainWindow": 256
  },
  "jwt": {
    "prefix": "eyJ",
    "min": 8,
    "char": "[A-Za-z0-9_-]",
    "wordChar": "[A-Za-z0-9_]",
    "signatureMin": 0
  },
  "whitespace": "[\\x09-\\x0d\\x20\\u{a0}\\u{1680}\\u{2000}-\\u{200a}\\u{2028}\\u{2029}\\u{202f}\\u{205f}\\u{3000}\\u{feff}]",
  "refusedKey": "(?:password|passwd|secret|api_key|access_token|refresh_token|session_token|cookie|(?:proxy[_-]?)?authorization(?:[_-]?header)?|authentication|auth[_-]?(?:token|header))",
  "authorization": {
    "pattern": "\\b(Bearer|Basic|Token|Digest)\\s+([A-Za-z0-9._~+/=-]+)",
    "legacyMin": 16,
    "opaqueMin": 20,
    "basicMin": 4,
    "digit": "[0-9]",
    "upper": "[A-Z]",
    "lower": "[a-z]",
    "base64": "^[A-Za-z0-9+/]+={0,2}$"
  }
}
