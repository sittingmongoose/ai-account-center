{
  "manifest_version": 3,
  "name": "AI Account Center Browser Usage Bridge",
  "description": "Read the signed-in OpenCode wallet and Muse subscription limits for AI Account Center.",
  "version": "1.3.2",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://opencode.ai/*",
    "https://dev.meta.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync browser usage for AI Account Center"
  }
}
