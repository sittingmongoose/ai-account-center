{
  "manifest_version": 3,
  "name": "AI Account Center Qwen Usage Bridge",
  "version": "0.1.3",
  "description": "Show Qwen usage in AI Account Center through this browser’s existing sign-in while keeping that sign-in on Windows.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://qwencloud.com/*",
    "*://home.qwencloud.com/*",
    "*://cs-data.qwencloud.com/*",
    "*://aliyun.com/*",
    "*://bailian.console.aliyun.com/*",
    "*://bailian-cs.console.aliyun.com/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Account Center Qwen usage"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
