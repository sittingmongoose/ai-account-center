# Retired integrated-image filename: reuse the source-built dashboard image.
# Build it first from the repository root:
#   docker build -f docker/Dockerfile -t ai-account-center:local .
# New Compose deployments use docker/Dockerfile directly. No CLIProxy service,
# upstream npm package, or AI CLI tool is installed by this compatibility alias.
ARG AI_ACCOUNT_CENTER_IMAGE=ai-account-center:local
FROM ${AI_ACCOUNT_CENTER_IMAGE}
