# Git and GitHub
.git
.github
.husky

# Dependencies
node_modules

# Build outputs (rebuilt in container)
dist
*.tsbuildinfo
native/*/target
native/*/prebuilt
target
crates/*/target
crates/*/prebuilt
web-dashboard/target
web-dashboard/pkg
web-dashboard/leptos/target
web-dashboard/leptos/pkg

# Test and coverage (includes the fixture test homes)
coverage
tests
**/__tests__
# ...except the wire table crates/aac-core embeds; the status module's build reads it (L2).
!tests/spec/wire-words.json

# Environment files (SECURITY: prevent secret leakage)
.env
.env.*
.env.local
.env.production
.env.development

# Documentation (not needed for runtime)
docs
*.md
!README.md
!LICENSE
# ...except what the server reads at runtime, as the npm package ships it.
!docs/agent-reports/schemas
!docs/agent-reports/catalog

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# IDE and editor
.vscode
.idea
*.swp
*.swo

# Misc
*.tgz
*.tar.gz
*.bundle
