{
  "request": {
    "method": "GET",
    "path": "/api/auth/session-lifetime",
    "role": "session"
  },
  "response": {
    "body": {
      "days": 7,
      "hours": 168,
      "options": [
        1,
        7,
        30,
        90,
        365
      ]
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json; charset=utf-8",
      "etag": "<etag>",
      "set-cookie": "connect.sid=<session-cookie>; Path=/; Expires=<http-date>; HttpOnly; SameSite=Strict"
    },
    "status": 200
  }
}
