{
  "request": {
    "method": "GET",
    "path": "/v0/management/auth-files",
    "role": "bar"
  },
  "response": {
    "body": {
      "code": "rate_limited",
      "error": "Too many wrong usage hub keys. Try again later.",
      "retryAfterSeconds": 900
    },
    "headers": {
      "cache-control": "no-store",
      "content-type": "application/json; charset=utf-8",
      "etag": "<etag>",
      "retry-after": "900",
      "set-cookie": "connect.sid=<session-cookie>; Path=/; Expires=<http-date>; HttpOnly; SameSite=Strict"
    },
    "status": 429
  }
}
