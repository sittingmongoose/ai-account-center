set -e

# No TypeScript production source remains, so there is no typecheck, lint or format step.
# Protected branches still enforce full CI parity in .husky/pre-push.
# Feature branches use a faster pre-push gate plus GitHub CI.

# Validate current Leptos sources and the already-built production browser assets.
if git diff --cached --name-only | grep -qE '^(web-dashboard/|scripts/(build-ui|validate-ui|verify-bundle)\.js|package\.json)'; then
  echo "[i] UI changes detected, running ui:validate..."
  bun run ui:validate
fi
